{"version":1,"chunks":[{"id":"chunk_410ee03044af07f6","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: authentication, password handling, token management, caching, HTTP/API, encryption/cryptography\n\n          done\n          [[ \"$name\" =~ ^[A-Za-z0-9_.-]+$ ]] || { bad \"Invalid server name.\"; return 1; }\n          case \"$url\" in http://*|https://*) : ;; *) bad \"URL must start with http:// or https://.\"; return 1 ;; esac\n          # refuse literal credentials\n          local h hname hval\n          for h in \"${headers[@]+\"${headers[@]}\"}\"; do\n            hname=\"${h%%:*}\"; hval=\"${h#*: }\"\n            if [ \"$store_literal\" -eq 0 ]; then\n              if echo \"$hname\" | grep -qiE 'auth|token|key|secret|cookie|password'; then\n                if ! echo \"$hval\" | grep -q '\\${'; then\n                  bad \"Refusing literal credential in header '$hname'. Use \\${ENV_VAR} form, or --store-literal.\"\n                  return 1","tokenCount":219}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: authentication, password handling, token management, caching, HTTP/API, encryption/cryptography\n\n          done\n          [[ \"$name\" =~ ^[A-Za-z0-9_.-]+$ ]] || { bad \"Invalid server name.\"; return 1; }\n          case \"$url\" in http://*|https://*) : ;; *) bad \"URL must start with http:// or https://.\"; return 1 ;; esac\n          # refuse literal credentials\n          local h hname hval\n          for h in \"${headers[@]+\"${headers[@]}\"}\"; do\n            hname=\"${h%%:*}\"; hval=\"${h#*: }\"\n            if [ \"$store_literal\" -eq 0 ]; then\n              if echo \"$hname\" | grep -qiE 'auth|token|key|secret|cookie|password'; then\n                if ! echo \"$hval\" | grep -q '\\${'; then\n                  bad \"Refusing literal credential in header '$hname'. Use \\${ENV_VAR} form, or --store-literal.\"\n                  return 1","content":"          done\n          [[ \"$name\" =~ ^[A-Za-z0-9_.-]+$ ]] || { bad \"Invalid server name.\"; return 1; }\n          case \"$url\" in http://*|https://*) : ;; *) bad \"URL must start with http:// or https://.\"; return 1 ;; esac\n          # refuse literal credentials\n          local h hname hval\n          for h in \"${headers[@]+\"${headers[@]}\"}\"; do\n            hname=\"${h%%:*}\"; hval=\"${h#*: }\"\n            if [ \"$store_literal\" -eq 0 ]; then\n              if echo \"$hname\" | grep -qiE 'auth|token|key|secret|cookie|password'; then\n                if ! echo \"$hval\" | grep -q '\\${'; then\n                  bad \"Refusing literal credential in header '$hname'. Use \\${ENV_VAR} form, or --store-literal.\"\n                  return 1","contentHash":"249e27d6df3ec4e6","metadata":{"filePath":"engine/mcp-wire.sh","startLine":331,"endLine":342,"chunkType":"function_definition","name":"main","language":"bash","hash":"249e27d6df3ec4e6"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":2,"lastAttempt":"2026-10-17T11:47:10.962Z"}
{"version":1,"chunks":[{"id":"chunk_2083c52cb86b22fa","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: authentication, caching, file operations, configuration, state management\n\n                if ! echo \"$hval\" | grep -q '\\${'; then\n                  bad \"Refusing literal credential in header '$hname'. Use \\${ENV_VAR} form, or --store-literal.\"\n                  return 1\n                fi\n              fi\n            fi\n          done\n          # atomic write\n          local dir\n          dir=$(dirname \"$CONFIG\")\n          mkdir -p \"$dir\"; chmod 700 \"$dir\" 2>/dev/null || true\n          local tmpf","tokenCount":139}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: authentication, caching, file operations, configuration, state management\n\n                if ! echo \"$hval\" | grep -q '\\${'; then\n                  bad \"Refusing literal credential in header '$hname'. Use \\${ENV_VAR} form, or --store-literal.\"\n                  return 1\n                fi\n              fi\n            fi\n          done\n          # atomic write\n          local dir\n          dir=$(dirname \"$CONFIG\")\n          mkdir -p \"$dir\"; chmod 700 \"$dir\" 2>/dev/null || true\n          local tmpf","content":"                if ! echo \"$hval\" | grep -q '\\${'; then\n                  bad \"Refusing literal credential in header '$hname'. Use \\${ENV_VAR} form, or --store-literal.\"\n                  return 1\n                fi\n              fi\n            fi\n          done\n          # atomic write\n          local dir\n          dir=$(dirname \"$CONFIG\")\n          mkdir -p \"$dir\"; chmod 700 \"$dir\" 2>/dev/null || true\n          local tmpf","contentHash":"0392535aaec6e751","metadata":{"filePath":"engine/mcp-wire.sh","startLine":340,"endLine":351,"chunkType":"function_definition","name":"main","language":"bash","hash":"0392535aaec6e751"}}],"error":"Google embedding provider returned HTTP 400.","att