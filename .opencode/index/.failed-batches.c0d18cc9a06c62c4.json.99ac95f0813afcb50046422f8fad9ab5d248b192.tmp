{"version":1,"chunks":[{"id":"chunk_31790ee624d6b698","texts":[{"text":"bash block\nin scripts/gen-tokens.sh\nPurpose: token management, data parsing, configuration\n\n#!/usr/bin/env bash\nset -euo pipefail\n[ $# -eq 2 ] || { echo 'Usage: gen-tokens <vars.json> <outdir>' >&2; exit 1; }\nsrc=\"$1\"; out=\"$2\"\nmkdir -p \"$out\"\n# Tailwind v3\njq -r 'to_entries | sort_by(.key) | \"module.exports = { theme: { extend: { colors: {\" + (map(.key + \": \" + (.value|tojson)) | join(\", \")) + \"} } } };\"' \"$src\" > \"$out/tailwind.config.js\"\n# CSS vars light\n{ echo ':root {'; jq -r 'to_entries | sort_by(.key)[] | \"  --\" + .key + \": \" + (.value|tostring) + \";\"' \"$src\"; echo '}'; } > \"$out/tokens.css\"\n# TS\n{ echo 'export const tokens = {'; jq -r 'to_entries | sort_by(.key)[] | \"  \" + .key + \": \" + (.value|tojson) + \",\"' \"$src\"; echo '} as const;'; } > \"$out/tokens.ts\"\necho \"generated\"","tokenCount":198}],"storageText":"bash block\nin scripts/gen-tokens.sh\nPurpose: token management, data parsing, configuration\n\n#!/usr/bin/env bash\nset -euo pipefail\n[ $# -eq 2 ] || { echo 'Usage: gen-tokens <vars.json> <outdir>' >&2; exit 1; }\nsrc=\"$1\"; out=\"$2\"\nmkdir -p \"$out\"\n# Tailwind v3\njq -r 'to_entries | sort_by(.key) | \"module.exports = { theme: { extend: { colors: {\" + (map(.key + \": \" + (.value|tojson)) | join(\", \")) + \"} } } };\"' \"$src\" > \"$out/tailwind.config.js\"\n# CSS vars light\n{ echo ':root {'; jq -r 'to_entries | sort_by(.key)[] | \"  --\" + .key + \": \" + (.value|tostring) + \";\"' \"$src\"; echo '}'; } > \"$out/tokens.css\"\n# TS\n{ echo 'export const tokens = {'; jq -r 'to_entries | sort_by(.key)[] | \"  \" + .key + \": \" + (.value|tojson) + \",\"' \"$src\"; echo '} as const;'; } > \"$out/tokens.ts\"\necho \"generated\"","content":"#!/usr/bin/env bash\nset -euo pipefail\n[ $# -eq 2 ] || { echo 'Usage: gen-tokens <vars.json> <outdir>' >&2; exit 1; }\nsrc=\"$1\"; out=\"$2\"\nmkdir -p \"$out\"\n# Tailwind v3\njq -r 'to_entries | sort_by(.key) | \"module.exports = { theme: { extend: { colors: {\" + (map(.key + \": \" + (.value|tojson)) | join(\", \")) + \"} } } };\"' \"$src\" > \"$out/tailwind.config.js\"\n# CSS vars light\n{ echo ':root {'; jq -r 'to_entries | sort_by(.key)[] | \"  --\" + .key + \": \" + (.value|tostring) + \";\"' \"$src\"; echo '}'; } > \"$out/tokens.css\"\n# TS\n{ echo 'export const tokens = {'; jq -r 'to_entries | sort_by(.key)[] | \"  \" + .key + \": \" + (.value|tojson) + \",\"' \"$src\"; echo '} as const;'; } > \"$out/tokens.ts\"\necho \"generated\"","contentHash":"6682f3e37c667982","metadata":{"filePath":"scripts/gen-tokens.sh","startLine":1,"endLine":12,"chunkType":"block","language":"bash","hash":"6682f3e37c667982"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":6,"lastAttempt":"2026-10-17T11:47:10.974Z"}
