{"version":1,"chunks":[{"id":"chunk_ed3fea14365efe7e","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\n      *)\n        [ -f \"$CONFIG\" ] || { bad \"Unknown server. Pass a URL or create a named server in servers.json.\"; return 1; }\n        local entry\n        entry=$(jq -ec --arg n \"$target\" '.servers[$n] | select(type == \"object\")' \"$CONFIG\") || { bad \"Server name not found in the registry.\"; return 1; }\n        jq -e '(.headerEnv // {}) | type == \"object\" and all(to_entries[]; (.value|type)==\"string\")' <<<\"$entry\" >/dev/null || { bad \"headerEnv must map header names to environment variable names.\"; return 1; }\n        URL=$(jq -r '.url // empty' <<<\"$entry\")\n        STDIO=$(jq -c '.command // empty' <<<\"$entry\")\n        # allow_http honored\n        local allow_http\n        allow_http=$(jq -r '.allow_http // false' <<<\"$entry\")\n        [ \"$allow_http\" != true ] || ALLOW_HTTP=1\n        # headers array with ${VAR} expansion","tokenCount":231}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\n      *)\n        [ -f \"$CONFIG\" ] || { bad \"Unknown server. Pass a URL or create a named server in servers.json.\"; return 1; }\n        local entry\n        entry=$(jq -ec --arg n \"$target\" '.servers[$n] | select(type == \"object\")' \"$CONFIG\") || { bad \"Server name not found in the registry.\"; return 1; }\n        jq -e '(.headerEnv // {}) | type == \"object\" and all(to_entries[]; (.value|type)==\"string\")' <<<\"$entry\" >/dev/null || { bad \"headerEnv must map header names to environment variable names.\"; return 1; }\n        URL=$(jq -r '.url // empty' <<<\"$entry\")\n        STDIO=$(jq -c '.command // empty' <<<\"$entry\")\n        # allow_http honored\n        local allow_http\n        allow_http=$(jq -r '.allow_http // false' <<<\"$entry\")\n        [ \"$allow_http\" != true ] || ALLOW_HTTP=1\n        # headers array with ${VAR} expansion","content":"      *)\n        [ -f \"$CONFIG\" ] || { bad \"Unknown server. Pass a URL or create a named server in servers.json.\"; return 1; }\n        local entry\n        entry=$(jq -ec --arg n \"$target\" '.servers[$n] | select(type == \"object\")' \"$CONFIG\") || { bad \"Server name not found in the registry.\"; return 1; }\n        jq -e '(.headerEnv // {}) | type == \"object\" and all(to_entries[]; (.value|type)==\"string\")' <<<\"$entry\" >/dev/null || { bad \"headerEnv must map header names to environment variable names.\"; return 1; }\n        URL=$(jq -r '.url // empty' <<<\"$entry\")\n        STDIO=$(jq -c '.command // empty' <<<\"$entry\")\n        # allow_http honored\n        local allow_http\n        allow_http=$(jq -r '.allow_http // false' <<<\"$entry\")\n        [ \"$allow_http\" != true ] || ALLOW_HTTP=1\n        # headers array with ${VAR} expansion","contentHash":"18c2a6d6cf6611ca","metadata":{"filePath":"engine/mcp-wire.sh","startLine":394,"endLine":405,"chunkType":"function_definition","name":"main","language":"bash","hash":"18c2a6d6cf6611ca"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":2,"lastAttempt":"2026-10-17T11:47:10.962Z"}
{"version":1,"chunks":[{"id":"chunk_c1d0dae0a33d5f31","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, file operations, configuration\n\n        allow_http=$(jq -r '.allow_http // false' <<<\"$entry\")\n        [ \"$allow_http\" != true ] || ALLOW_HTTP=1\n        # headers array with ${VAR} expansion\n        local hline varname\n        while IFS= read -r hline; do\n          [ -n \"$hline\" ] || continue\n          # expand ${VAR}\n          while [[ \"$hline\" =~ \\$\\{([A-Za-z_][A-Za-z_0-9]*)\\} ]]; do\n            varname=\"${BASH_REMATCH[1]}\"\n            [ -n \"${!varname:-}\" ] || { bad \"Required header environment variable is unset: $varname\"; return 1; }\n            hline=\"${hline//\\$\\{$varname\\}/${!varname}}\"\n          done","tokenCount":170}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, file operations, configuration\n\n        allow_http=$(jq -r '.allow_http // false' <<<\"$entry\")\n        [ \"$allow_http\" != true ] || ALLOW_HTTP=1\n        # headers array with ${VAR} expansion\n        local hline varname\n        while IFS= read -r hline; do\n          [ -n \"$hline\" ] || continue\n          # expand ${VAR}\n          while [[ \"$hline\" =~ \\$\\{([A-Za-z_][A-Za-z_0-9]*)\\} ]]; do\n            varname=\"${BASH_REMATCH[1]}\"\n            [ -n \"${!varname:-}\" ] || { bad \"Required header environment variable is unset: $varname\"; return 1; }\n            hline=\"${hline//\\$\\{$varname\\}/${!varname}}\"\n          done","content":"        allow_http=$(jq -r '.allow_http // false' <<<\"$entry\")\n        [ \"$allow_http\" != true ] || ALLOW_HTTP=1\n        # headers array with ${VAR} expansion\n        local hline varname\n        while IFS= read -r hline; do\n          [ -n \"$hline\" ] || continue\n          # expand ${VAR}\n          while [[ \"$hline\" =~ \\$\\{([A-Za-z_][A-Za-z_0-9]*)\\} ]]; do\n            varname=\"${BASH_REMATCH[1]}\"\n            [ -n \"${!varname:-}\" ] || { bad \"Required header environment variable is unset: $varname\"; return 1; }\n            hline=\"${hline//\\$\\{$varname\\}/${!varname}}\"\n          done","contentHash":"b71716c684c4de02","metadata":{"filePath":"engine/mcp-wire.sh","startLine":403,"endLine":414,"chunkType":"function_definition","name":"main","language":"bash","hash":"b71716c684c4de02"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":2,"lastAttempt":"2026-10-17T11:47:10.962Z"}
{"version":1,"chunks":[{"id":"chunk_50b2242deb7b5970","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: file operations, configuration\n\n            [ -n \"${!varname:-}\" ] || { bad \"Required header environment variable is unset: $varname\"; return 1; }\n            hline=\"${hline//\\$\\{$varname\\}/${!varname}}\"\n          done\n          HEADERS+=(\"$hline\")\n        done < <(jq -r '.headers[]? // empty' <<<\"$entry\")\n        # env allowlist from config\n        while IFS= read -r _e; do\n          [ -n \"$_e\" ] && STDIO_ENV+=(\"$_e\")\n        done < <(jq -r '.env[]? // empty' <<<\"$entry\")\n        local envname headername\n        while IFS=$'\\t' read -r headername envname; do\n          [ -n \"$headername\" ] || continue","tokenCount":165}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: file operations, configuration\n\n            [ -n \"${!varname:-}\" ] || { bad \"Required header environment variable is unset: $varname\"; return 1; }\n            hline=\"${hline//\\$\\{$varname\\}/${!varname}}\"\n          done\n          HEADERS+=(\"$hline\")\n        done < <(jq -r '.headers[]? // empty' <<<\"$entry\")\n        # env allowlist from config\n        while IFS= read -r _e; do\n          [ -n \"$_e\" ] && STDIO_ENV+=(\"$_e\")\n        done < <(jq -r '.env[]? // empty' <<<\"$entry\")\n        local envname headername\n        while IFS=$'\\t' read -r headername envname; do\n          [ -n \"$headername\" ] || continue","content":"            [ -n \"${!varname:-}\" ] || { bad \"Required header environment variable is unset: $varname\"; return 1; }\n            hline=\"${hline//\\$\\{$varname\\}/${!varname}}\"\n          done\n          HEADERS+=(\"$hline\")\n        done < <(jq -r '.headers[]? // empty' <<<\"$entry\")\n        # env allowlist from config\n        while IFS= read -r _e; do\n          [ -n \"$_e\" ] && STDIO_ENV+=(\"$_e\")\n        done < <(jq -r '.env[]? // empty' <<<\"$entry\")\n        local envname headername\n        while IFS=$'\\t' read -r headername envname; do\n          [ -n \"$headername\" ] || continue","contentHash":"1ece78b7cfd17302","metadata":{"filePath":"engine/mcp-wire.sh","startLine":412,"endLine":423,"chunkType":"function_definition","name":"main","language":"bash","hash":"1ece78b7cfd17302"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":2,"lastAttempt":"2026-10-17T11:47:10.962Z"}
{"version":1,"chunks":[{"id":"chunk_bb64988f179ab73f","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: file operations, configuration\n\n        local envname headername\n        while IFS=$'\\t' read -r headername envname; do\n          [ -n \"$headername\" ] || continue\n          [[ \"$envname\" =~ ^[A-Za-z_][A-Za-z_0-9]*$ ]] && [[ \"$headername\" =~ ^[A-Za-z0-9-]+$ ]] || { bad \"Invalid headerEnv entry.\"; return 1; }\n          [ -n \"${!envname:-}\" ] || { bad \"Required header environment variable is unset.\"; return 1; }\n          [[ \"${!envname}\" != *$'\\r'* && \"${!envname}\" != *$'\\n'* ]] || { bad \"Header values cannot contain line breaks.\"; return 1; }\n          HEADERS+=(\"$headername: ${!envname}\")\n        done < <(jq -r '.headerEnv // {} | to_entries[] | [.key,.value] | @tsv' <<<\"$entry\") ;;\n    esac\n  fi\n  if [ -n \"$STDIO\" ]; then\n    [ -z \"$URL\" ] || { bad \"Choose one transport: URL or stdio.\"; return 1; }","tokenCount":216}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: file operations, configuration\n\n        local envname headername\n        while IFS=$'\\t' read -r headername envname; do\n          [ -n \"$headername\" ] || continue\n          [[ \"$envname\" =~ ^[A-Za-z_][A-Za-z_0-9]*$ ]] && [[ \"$headername\" =~ ^[A-Za-z0-9-]+$ ]] || { bad \"Invalid headerEnv entry.\"; return 1; }\n          [ -n \"${!envname:-}\" ] || { bad \"Required header environment variable is unset.\"; return 1; }\n          [[ \"${!envname}\" != *$'\\r'* && \"${!envname}\" != *$'\\n'* ]] || { bad \"Header values cannot contain line breaks.\"; return 1; }\n          HEADERS+=(\"$headername: ${!envname}\")\n        done < <(jq -r '.headerEnv // {} | to_entries[] | [.key,.value] | @tsv' <<<\"$entry\") ;;\n    esac\n  fi\n  if [ -n \"$STDIO\" ]; then\n    [ -z \"$URL\" ] || { bad \"Choose one transport: URL or stdio.\"; return 1; }","content":"        local envname headername\n        while IFS=$'\\t' read -r headername envname; do\n          [ -n \"$headername\" ] || continue\n          [[ \"$envname\" =~ ^[A-Za-z_][A-Za-z_0-9]*$ ]] && [[ \"$headername\" =~ ^[A-Za-z0-9-]+$ ]] || { bad \"Invalid headerEnv entry.\"; return 1; }\n          [ -n \"${!envname:-}\" ] || { bad \"Required header environment variable is unset.\"; return 1; }\n          [[ \"${!envname}\" != *$'\\r'* && \"${!envname}\" != *$'\\n'* ]] || { bad \"Header values cannot contain line breaks.\"; return 1; }\n          HEADERS+=(\"$headername: ${!envname}\")\n        done < <(jq -r '.headerEnv // {} | to_entries[] | [.key,.value] | @tsv' <<<\"$entry\") ;;\n    esac\n  fi\n  if [ -n \"$STDIO\" ]; then\n    [ -z \"$URL\" ] || { bad \"Choose one transport: URL or stdio.\"; return 1; }","contentHash":"a7d153335d2bbaa9","metadata":{"filePath":"engine/mcp-wire.sh","startLine":421,"endLine":432,"chunkType":"function_definition","name":"main","language":"bash","hash":"a7d153335d2bbaa9"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":2,"lastAttempt":"2026-10-17T11:47:10.962Z"}
{"version":1,"chunks":[{"id":"chunk_a5746f29981c7549","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, data parsing\n\n  fi\n  if [ -n \"$STDIO\" ]; then\n    [ -z \"$URL\" ] || { bad \"Choose one transport: URL or stdio.\"; return 1; }\n    jq -e 'type == \"array\" and length > 0 and all(.[]; type == \"string\" and (contains(\"\\n\")|not) and (contains(\"\\u0000\")|not)) and .[0] != \"\"' <<<\"$STDIO\" >/dev/null 2>&1 || { bad \"--stdio requires a JSON command array.\"; return 1; }\n  else\n    case \"$URL\" in\n      https://*) : ;; http://*) [ \"$ALLOW_HTTP\" -eq 1 ] || { bad \"Refusing plain HTTP. Pass --allow-http for trusted development.\"; return 1; } ;;\n      *) bad \"Server URL must start with http:// or https://.\"; return 1 ;;\n    esac\n  fi\n  cmd=\"${1:-}\"; [ $# -eq 0 ] || shift\n  [ \"$doctor\" -eq 0 ] || cmd=doctor","tokenCount":189}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, data parsing\n\n  fi\n  if [ -n \"$STDIO\" ]; then\n    [ -z \"$URL\" ] || { bad \"Choose one transport: URL or stdio.\"; return 1; }\n    jq -e 'type == \"array\" and length > 0 and all(.[]; type == \"string\" and (contains(\"\\n\")|not) and (contains(\"\\u0000\")|not)) and .[0] != \"\"' <<<\"$STDIO\" >/dev/null 2>&1 || { bad \"--stdio requires a JSON command array.\"; return 1; }\n  else\n    case \"$URL\" in\n      https://*) : ;; http://*) [ \"$ALLOW_HTTP\" -eq 1 ] || { bad \"Refusing plain HTTP. Pass --allow-http for trusted development.\"; return 1; } ;;\n      *) bad \"Server URL must start with http:// or https://.\"; return 1 ;;\n    esac\n  fi\n  cmd=\"${1:-}\"; [ $# -eq 0 ] || shift\n  [ \"$doctor\" -eq 0 ] || cmd=doctor","content":"  fi\n  if [ -n \"$STDIO\" ]; then\n    [ -z \"$URL\" ] || { bad \"Choose one transport: URL or stdio.\"; return 1; }\n    jq -e 'type == \"array\" and length > 0 and all(.[]; type == \"string\" and (contains(\"\\n\")|not) and (contains(\"\\u0000\")|not)) and .[0] != \"\"' <<<\"$STDIO\" >/dev/null 2>&1 || { bad \"--stdio requires a JSON command array.\"; return 1; }\n  else\n    case \"$URL\" in\n      https://*) : ;; http://*) [ \"$ALLOW_HTTP\" -eq 1 ] || { bad \"Refusing plain HTTP. Pass --allow-http for trusted development.\"; return 1; } ;;\n      *) bad \"Server URL must start with http:// or https://.\"; return 1 ;;\n    esac\n  fi\n  cmd=\"${1:-}\"; [ $# -eq 0 ] || shift\n  [ \"$doctor\" -eq 0 ] || cmd=doctor","contentHash":"3e5899e4cc2f2cda","metadata":{"filePath":"engine/mcp-wire.sh","startLine":430,"endLine":441,"chunkType":"function_definition","name":"main","language":"bash","hash":"3e5899e4cc2f2cda"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":2,"lastAttempt":"2026-10-17T11:47:10.962Z"}
{"version":1,"chunks":[{"id":"chunk_8c3ad9299037eae3","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\n\n  fi\n  cmd=\"${1:-}\"; [ $# -eq 0 ] || shift\n  [ \"$doctor\" -eq 0 ] || cmd=doctor\n  local method='' params='{}' key='' tool='' body data tool_args='{}'\n  case \"$cmd\" in\n    doctor) method=ping ;;\n    list|describe) method=tools/list; key=tools; tool=\"${1:-}\"; if [ \"$cmd\" = describe ] && [ -z \"$tool\" ]; then bad \"describe requires a tool name.\"; return 1; fi ;;\n    call)\n      method=tools/call; tool=\"${1:-}\"; [ -n \"$tool\" ] || { bad \"call requires a tool name.\"; return 1; }; shift\n      if [ $# -gt 0 ]; then\n        case \"$1\" in\n          -) tool_args=$(cat); shift ;;","tokenCount":154}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\n\n  fi\n  cmd=\"${1:-}\"; [ $# -eq 0 ] || shift\n  [ \"$doctor\" -eq 0 ] || cmd=doctor\n  local method='' params='{}' key='' tool='' body data tool_args='{}'\n  case \"$cmd\" in\n    doctor) method=ping ;;\n    list|describe) method=tools/list; key=tools; tool=\"${1:-}\"; if [ \"$cmd\" = describe ] && [ -z \"$tool\" ]; then bad \"describe requires a tool name.\"; return 1; fi ;;\n    call)\n      method=tools/call; tool=\"${1:-}\"; [ -n \"$tool\" ] || { bad \"call requires a tool name.\"; return 1; }; shift\n      if [ $# -gt 0 ]; then\n        case \"$1\" in\n          -) tool_args=$(cat); shift ;;","content":"  fi\n  cmd=\"${1:-}\"; [ $# -eq 0 ] || shift\n  [ \"$doctor\" -eq 0 ] || cmd=doctor\n  local method='' params='{}' key='' tool='' body data tool_args='{}'\n  case \"$cmd\" in\n    doctor) method=ping ;;\n    list|describe) method=tools/list; key=tools; tool=\"${1:-}\"; if [ \"$cmd\" = describe ] && [ -z \"$tool\" ]; then bad \"describe requires a tool name.\"; return 1; fi ;;\n    call)\n      method=tools/call; tool=\"${1:-}\"; [ -n \"$tool\" ] || { bad \"call requires a tool name.\"; return 1; }; shift\n      if [ $# -gt 0 ]; then\n        case \"$1\" in\n          -) tool_args=$(cat); shift ;;","contentHash":"90b7deae82385538","metadata":{"filePath":"engine/mcp-wire.sh","startLine":439,"endLine":450,"chunkType":"function_definition","name":"main","language":"bash","hash":"90b7deae82385538"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":2,"lastAttempt":"2026-10-17T11:47:10.962Z"}
{"version":1,"chunks":[{"id":"chunk_db25118b7a90b193","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: error handling, file operations, data parsing\n\n      if [ $# -gt 0 ]; then\n        case \"$1\" in\n          -) tool_args=$(cat); shift ;;\n          @*) \n            [ -f \"${1#@}\" ] || { bad \"File not found: ${1#@}\"; return 1; }\n            tool_args=$(cat \"${1#@}\"); shift ;;\n          *) tool_args=\"$1\"; shift ;;\n        esac\n      fi\n      params=$(jq -nc --arg name \"$tool\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" then {name:$name,arguments:$a} else error(\"object required\") end' 2>/dev/null) || { bad \"Tool arguments must be a JSON object.\"; return 1; } ;;\n    resources)\n      case \"${1:-list}\" in","tokenCount":166}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: error handling, file operations, data parsing\n\n      if [ $# -gt 0 ]; then\n        case \"$1\" in\n          -) tool_args=$(cat); shift ;;\n          @*) \n            [ -f \"${1#@}\" ] || { bad \"File not found: ${1#@}\"; return 1; }\n            tool_args=$(cat \"${1#@}\"); shift ;;\n          *) tool_args=\"$1\"; shift ;;\n        esac\n      fi\n      params=$(jq -nc --arg name \"$tool\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" then {name:$name,arguments:$a} else error(\"object required\") end' 2>/dev/null) || { bad \"Tool arguments must be a JSON object.\"; return 1; } ;;\n    resources)\n      case \"${1:-list}\" in","content":"      if [ $# -gt 0 ]; then\n        case \"$1\" in\n          -) tool_args=$(cat); shift ;;\n          @*) \n            [ -f \"${1#@}\" ] || { bad \"File not found: ${1#@}\"; return 1; }\n            tool_args=$(cat \"${1#@}\"); shift ;;\n          *) tool_args=\"$1\"; shift ;;\n        esac\n      fi\n      params=$(jq -nc --arg name \"$tool\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" then {name:$name,arguments:$a} else error(\"object required\") end' 2>/dev/null) || { bad \"Tool arguments must be a JSON object.\"; return 1; } ;;\n    resources)\n      case \"${1:-list}\" in","contentHash":"281b201722be6d63","metadata":{"filePath":"engine/mcp-wire.sh","startLine":448,"endLine":459,"chunkType":"function_definition","name":"main","language":"bash","hash":"281b201722be6d63"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":2,"lastAttempt":"2026-10-17T11:47:10.974Z"}
{"version":1,"chunks":[{"id":"chunk_713ebf433c77e609","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: error handling, file operations, data parsing, UI rendering\n\n      params=$(jq -nc --arg name \"$tool\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" then {name:$name,arguments:$a} else error(\"object required\") end' 2>/dev/null) || { bad \"Tool arguments must be a JSON object.\"; return 1; } ;;\n    resources)\n      case \"${1:-list}\" in\n        list) method=resources/list; key=resources ;;\n        templates) method=resources/templates/list; key=resourceTemplates ;;\n        read) [ -n \"${2:-}\" ] || { bad \"resources read requires a URI.\"; return 1; }; method=resources/read; params=$(jq -nc --arg uri \"$2\" '{uri:$uri}') ;;\n        *) bad \"Use resources list, templates, or read <uri>.\"; return 1 ;;\n      esac ;;\n    prompts)\n      case \"${1:-list}\" in\n        list) method=prompts/list; key=prompts ;;\n        get) [ -n \"${2:-}\" ] || { bad \"prompts get requires a name.\"; return 1; }; method=prompts/get","tokenCount":240}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: error handling, file operations, data parsing, UI rendering\n\n      params=$(jq -nc --arg name \"$tool\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" then {name:$name,arguments:$a} else error(\"object required\") end' 2>/dev/null) || { bad \"Tool arguments must be a JSON object.\"; return 1; } ;;\n    resources)\n      case \"${1:-list}\" in\n        list) method=resources/list; key=resources ;;\n        templates) method=resources/templates/list; key=resourceTemplates ;;\n        read) [ -n \"${2:-}\" ] || { bad \"resources read requires a URI.\"; return 1; }; method=resources/read; params=$(jq -nc --arg uri \"$2\" '{uri:$uri}') ;;\n        *) bad \"Use resources list, templates, or read <uri>.\"; return 1 ;;\n      esac ;;\n    prompts)\n      case \"${1:-list}\" in\n        list) method=prompts/list; key=prompts ;;\n        get) [ -n \"${2:-}\" ] || { bad \"prompts get requires a name.\"; return 1; }; method=prompts/get","content":"      params=$(jq -nc --arg name \"$tool\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" then {name:$name,arguments:$a} else error(\"object required\") end' 2>/dev/null) || { bad \"Tool arguments must be a JSON object.\"; return 1; } ;;\n    resources)\n      case \"${1:-list}\" in\n        list) method=resources/list; key=resources ;;\n        templates) method=resources/templates/list; key=resourceTemplates ;;\n        read) [ -n \"${2:-}\" ] || { bad \"resources read requires a URI.\"; return 1; }; method=resources/read; params=$(jq -nc --arg uri \"$2\" '{uri:$uri}') ;;\n        *) bad \"Use resources list, templates, or read <uri>.\"; return 1 ;;\n      esac ;;\n    prompts)\n      case \"${1:-list}\" in\n        list) method=prompts/list; key=prompts ;;\n        get) [ -n \"${2:-}\" ] || { bad \"prompts get requires a name.\"; return 1; }; method=prompts/get","contentHash":"e2458779d8039f5b","metadata":{"filePath":"engine/mcp-wire.sh","startLine":457,"endLine":468,"chunkType":"function_definition","name":"main","language":"bash","hash":"e2458779d8039f5b"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":2,"lastAttempt":"2026-10-17T11:47:10.974Z"}
{"version":1,"chunks":[{"id":"chunk_4b31d618b3bd1978","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: error handling, HTTP/API, data parsing\n\n      case \"${1:-list}\" in\n        list) method=prompts/list; key=prompts ;;\n        get) [ -n \"${2:-}\" ] || { bad \"prompts get requires a name.\"; return 1; }; method=prompts/get\n          [ $# -lt 3 ] || tool_args=\"$3\"\n          params=$(jq -nc --arg name \"$2\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" and all($a[];type==\"string\") then {name:$name,arguments:$a} else error(\"string arguments required\") end' 2>/dev/null) || { bad \"Prompt arguments must be a JSON object of strings.\"; return 1; } ;;\n        *) bad \"Use prompts list or get <name>.\"; return 1 ;;\n      esac ;;\n    raw)\n      body=\"${1:-}\"\n      jq -e 'type==\"object\" and .jsonrpc==\"2.0\" and (.method|type)==\"string\" and has(\"id\") and (.id != null)' <<<\"$body\" >/dev/null 2>&1 || { bad \"raw requires a JSON-RPC request with an ID.\"; return 1; } ;;\n    *) bad \"Unknown command. Use --help.\"; return 1 ;;\n  esac","tokenCount":244}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: error handling, HTTP/API, data parsing\n\n      case \"${1:-list}\" in\n        list) method=prompts/list; key=prompts ;;\n        get) [ -n \"${2:-}\" ] || { bad \"prompts get requires a name.\"; return 1; }; method=prompts/get\n          [ $# -lt 3 ] || tool_args=\"$3\"\n          params=$(jq -nc --arg name \"$2\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" and all($a[];type==\"string\") then {name:$name,arguments:$a} else error(\"string arguments required\") end' 2>/dev/null) || { bad \"Prompt arguments must be a JSON object of strings.\"; return 1; } ;;\n        *) bad \"Use prompts list or get <name>.\"; return 1 ;;\n      esac ;;\n    raw)\n      body=\"${1:-}\"\n      jq -e 'type==\"object\" and .jsonrpc==\"2.0\" and (.method|type)==\"string\" and has(\"id\") and (.id != null)' <<<\"$body\" >/dev/null 2>&1 || { bad \"raw requires a JSON-RPC request with an ID.\"; return 1; } ;;\n    *) bad \"Unknown command. Use --help.\"; return 1 ;;\n  esac","content":"      case \"${1:-list}\" in\n        list) method=prompts/list; key=prompts ;;\n        get) [ -n \"${2:-}\" ] || { bad \"prompts get requires a name.\"; return 1; }; method=prompts/get\n          [ $# -lt 3 ] || tool_args=\"$3\"\n          params=$(jq -nc --arg name \"$2\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" and all($a[];type==\"string\") then {name:$name,arguments:$a} else error(\"string arguments required\") end' 2>/dev/null) || { bad \"Prompt arguments must be a JSON object of strings.\"; return 1; } ;;\n        *) bad \"Use prompts list or get <name>.\"; return 1 ;;\n      esac ;;\n    raw)\n      body=\"${1:-}\"\n      jq -e 'type==\"object\" and .jsonrpc==\"2.0\" and (.method|type)==\"string\" and has(\"id\") and (.id != null)' <<<\"$body\" >/dev/null 2>&1 || { bad \"raw requires a JSON-RPC request with an ID.\"; return 1; } ;;\n    *) bad \"Unknown command. Use --help.\"; return 1 ;;\n  esac","contentHash":"f9087b2551075a65","metadata":{"filePath":"engine/mcp-wire.sh","startLine":466,"endLine":477,"chunkType":"function_definition","name":"main","language":"bash","hash":"f9087b2551075a65"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":2,"lastAttempt":"2026-10-17T11:47:10.974Z"}
{"version":1,"chunks":[{"id":"chunk_649ae0053e1a7234","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, file operations, data parsing\n\n      jq -e 'type==\"object\" and .jsonrpc==\"2.0\" and (.method|type)==\"string\" and has(\"id\") and (.id != null)' <<<\"$body\" >/dev/null 2>&1 || { bad \"raw requires a JSON-RPC request with an ID.\"; return 1; } ;;\n    *) bad \"Unknown command. Use --help.\"; return 1 ;;\n  esac\n  [ \"$cmd\" = raw ] || body=$(jq -nc --arg m \"$method\" --argjson p \"$params\" '{jsonrpc:\"2.0\",id:2,method:$m,params:$p}')\n  if [ \"$DRY_RUN\" -eq 1 ]; then\n    jq -n --arg transport \"$(if [ -n \"$STDIO\" ]; then echo stdio; else echo http; fi)\" --arg method \"$(jq -r .method <<<\"$body\")\" '{dryRun:true,transport:$transport,method:$method}'\n    return\n  fi\n  umask 077\n  WORK=$(mktemp -d) || return 1\n  HEADERS_FILE=\"$WORK/headers.txt\"\n  : > \"$HEADERS_FILE\"","tokenCount":204}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, file operations, data parsing\n\n      jq -e 'type==\"object\" and .jsonrpc==\"2.0\" and (.method|type)==\"string\" and has(\"id\") and (.id != null)' <<<\"$body\" >/dev/null 2>&1 || { bad \"raw requires a JSON-RPC request with an ID.\"; return 1; } ;;\n    *) bad \"Unknown command. Use --help.\"; return 1 ;;\n  esac\n  [ \"$cmd\" = raw ] || body=$(jq -nc --arg m \"$method\" --argjson p \"$params\" '{jsonrpc:\"2.0\",id:2,method:$m,params:$p}')\n  if [ \"$DRY_RUN\" -eq 1 ]; then\n    jq -n --arg transport \"$(if [ -n \"$STDIO\" ]; then echo stdio; else echo http; fi)\" --arg method \"$(jq -r .method <<<\"$body\")\" '{dryRun:true,transport:$transport,method:$method}'\n    return\n  fi\n  umask 077\n  WORK=$(mktemp -d) || return 1\n  HEADERS_FILE=\"$WORK/headers.txt\"\n  : > \"$HEADERS_FILE\"","content":"      jq -e 'type==\"object\" and .jsonrpc==\"2.0\" and (.method|type)==\"string\" and has(\"id\") and (.id != null)' <<<\"$body\" >/dev/null 2>&1 