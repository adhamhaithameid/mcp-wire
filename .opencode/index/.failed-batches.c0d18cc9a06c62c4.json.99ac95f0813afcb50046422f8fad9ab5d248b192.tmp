{"version":1,"chunks":[{"id":"chunk_d76d57e1aa3becb0","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, file operations\n\n  WORK=$(mktemp -d) || return 1\n  HEADERS_FILE=\"$WORK/headers.txt\"\n  : > \"$HEADERS_FILE\"\n  for _h in \"${HEADERS[@]+\"${HEADERS[@]}\"}\"; do printf '%s\\n' \"$_h\" >> \"$HEADERS_FILE\"; done\n  chmod 600 \"$HEADERS_FILE\"\n  connect || return 1\n  data=$(request_all \"$body\" \"$key\") || return 1\n  case \"$cmd\" in\n    doctor) jq -n --arg t \"$TRANSPORT\" --arg r \"$REPLY\" '{ok:true,initialized:true,ping:true,transport:$t,reply:$r}' ;;\n    describe)\n      local tdata\n      tdata=$(jq -ec --arg t \"$tool\" '.result.tools[] | select(.name==$t)' <<<\"$data\") || {","tokenCount":155}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, file operations\n\n  WORK=$(mktemp -d) || return 1\n  HEADERS_FILE=\"$WORK/headers.txt\"\n  : > \"$HEADERS_FILE\"\n  for _h in \"${HEADERS[@]+\"${HEADERS[@]}\"}\"; do printf '%s\\n' \"$_h\" >> \"$HEADERS_FILE\"; done\n  chmod 600 \"$HEADERS_FILE\"\n  connect || return 1\n  data=$(request_all \"$body\" \"$key\") || return 1\n  case \"$cmd\" in\n    doctor) jq -n --arg t \"$TRANSPORT\" --arg r \"$REPLY\" '{ok:true,initialized:true,ping:true,transport:$t,reply:$r}' ;;\n    describe)\n      local tdata\n      tdata=$(jq -ec --arg t \"$tool\" '.result.tools[] | select(.name==$t)' <<<\"$data\") || {","content":"  WORK=$(mktemp -d) || return 1\n  HEADERS_FILE=\"$WORK/headers.txt\"\n  : > \"$HEADERS_FILE\"\n  for _h in \"${HEADERS[@]+\"${HEADERS[@]}\"}\"; do printf '%s\\n' \"$_h\" >> \"$HEADERS_FILE\"; done\n  chmod 600 \"$HEADERS_FILE\"\n  connect || return 1\n  data=$(request_all \"$body\" \"$key\") || return 1\n  case \"$cmd\" in\n    doctor) jq -n --arg t \"$TRANSPORT\" --arg r \"$REPLY\" '{ok:true,initialized:true,ping:true,transport:$t,reply:$r}' ;;\n    describe)\n      local tdata\n      tdata=$(jq -ec --arg t \"$tool\" '.result.tools[] | sel