{"version":1,"chunks":[{"id":"chunk_7e74096d639d3e1a","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\n          dir=$(dirname \"$CONFIG\")\n          mkdir -p \"$dir\"; chmod 700 \"$dir\" 2>/dev/null || true\n          local tmpf\n          tmpf=$(mktemp \"$dir/.servers.XXXXXX\") || return 1\n          if [ -f \"$CONFIG\" ]; then cp \"$CONFIG\" \"$tmpf.base\"; else echo '{\"servers\":{}}' > \"$tmpf.base\"; fi\n          # build entry\n          local entry\n          entry=$(jq -nc --arg url \"$url\" --argjson ah \"$allow_http\" '{url:$url,allow_http:($ah==1)}')\n          if [ ${#headers[@]} -gt 0 ]; then\n            local hjson\n            hjson=$(printf '%s\\n' \"${headers[@]}\" | jq -R . | jq -sc .)\n            entry=$(jq -c --argjson h \"$hjson\" '.headers=$h' <<<\"$entry\")","tokenCount":186}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\n          dir=$(dirname \"$CONFIG\")\n          mkdir -p \"$dir\"; chmod 700 \"$dir\" 2>/dev/null || true\n          local tmpf\n          tmpf=$(mktemp \"$dir/.servers.XXXXXX\") || return 1\n          if [ -f \"$CONFIG\" ]; then cp \"$CONFIG\" \"$tmpf.base\"; else echo '{\"servers\":{}}' > \"$tmpf.base\"; fi\n          # build entry\n          local entry\n          entry=$(jq -nc --arg url \"$url\" --argjson ah \"$allow_http\" '{url:$url,allow_http:($ah==1)}')\n          if [ ${#headers[@]} -gt 0 ]; then\n            local hjson\n            hjson=$(printf '%s\\n' \"${headers[@]}\" | jq -R . | jq -sc .)\n            entry=$(jq -c --argjson h \"$hjson\" '.headers=$h' <<<\"$entry\")","content":"          dir=$(dirname \"$CONFIG\")\n          mkdir -p \"$dir\"; chmod 700 \"$dir\" 2>/dev/null || true\n          local tmpf\n          tmpf=$(mktemp \"$dir/.servers.XXXXXX\") || return 1\n          if [ -f \"$CONFIG\" ]; then cp \"$CONFIG\" \"$tmpf.base\"; else echo '{\"servers\":{}}' > \"$tmpf.base\"; fi\n          # build entry\n          local entry\n          entry=$(jq -nc --arg url \"$url\" --argjson ah \"$allow_http\" '{url:$url,allow_http:($ah==1)}')\n          if [ ${#headers[@]} -gt 0 ]; then\n            local hjson\n            hjson=$(printf '%s\\n' \"${headers[@]}\" | jq -R . | jq -sc .)\n            entry=$(jq -c --argjson h \"$hjson\" '.headers=$h' <<<\"$entry\")","contentHash":"af3f61785029b879","metadata":{"filePath":"engine/mcp-wire.sh","startLine":349,"endLine":360,"chunkType":"function_definition","name":"main","language":"bash","hash":"af3f61785029b879"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":2,"lastAttempt":"2026-10-17T11:47:10.962Z"}
{"version":1,"chunks":[{"id":"chunk_26726252fac1b40b","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: authentication, logging, caching, data parsing, configuration, state management\n\n            local hjson\n            hjson=$(printf '%s\\n' \"${headers[@]}\" | jq -R . | jq -sc .)\n            entry=$(jq -c --argjson h \"$hjson\" '.headers=$h' <<<\"$entry\")\n          fi\n          jq --arg name \"$name\" --argjson entry \"$entry\" '.servers[$name]=$entry' \"$tmpf.base\" > \"$tmpf\"\n          chmod 600 \"$tmpf\"\n          mv \"$tmpf\" \"$CONFIG\"\n          rm -f \"$tmpf.base\"\n          if [ \"$store_literal\" -eq 1 ]; then echo \"warning: stored literal credential\" >&2; fi\n          ok \"added $name\"\n          return 0 ;;\n        rm)","tokenCount":167}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: authentication, logging, caching, data parsing, configuration, state management\n\n            local hjson\n            hjson=$(printf '%s\\n' \"${headers[@]}\" | jq -R . | jq -sc .)\n            entry=$(jq -c --argjson h \"$hjson\" '.headers=$h' <<<\"$entry\")\n          fi\n          jq --arg name \"$name\" --argjson entry \"$entry\" '.servers[$name]=$entry' \"$tmpf.base\" > \"$tmpf\"\n          chmod 600 \"$tmpf\"\n          mv \"$tmpf\" \"$CONFIG\"\n          rm -f \"$tmpf.base\"\n          if [ \"$store_literal\" -eq 1 ]; then echo \"warning: stored literal credential\" >&2; fi\n          ok \"added $name\"\n          return 0 ;;\n        rm)","content":"            local hjson\n            hjson=$(printf '%s\\n' \"${headers[@]}\" | jq -R . | jq -sc .)\n            entry=$(jq -c --argjson h \"$hjson\" '.headers=$h' <<<\"$entry\")\n          fi\n          jq --arg name \"$name\" --argjson entry \"$entry\" '.servers[$name]=$entry' \"$tmpf.base\" > \"$tmpf\"\n          chmod 600 \"$tmpf\"\n          mv \"$tmpf\" \"$CONFIG\"\n          rm -f \"$tmpf.base\"\n          if [ \"$store_literal\" -eq 1 ]; then ec