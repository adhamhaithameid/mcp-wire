{"version":1,"chunks":[{"id":"chunk_f6df9adbf657a850","texts":[{"text":"bash function \"stdio_receive\"\nin engine/mcp-wire.sh\nPurpose: user management, validation, error handling, logging, HTTP/API, file operations\n\nstdio_receive() {\n  local id=\"$1\" line deadline=$((SECONDS + TIMEOUT)) remaining\n  while [ \"$SECONDS\" -lt \"$deadline\" ]; do\n    remaining=$((deadline - SECONDS))\n    IFS= read -r -t \"$remaining\" line <&4 || break\n    if jq -e --argjson id \"$id\" 'type == \"object\" and .id == $id and (has(\"result\") or has(\"error\"))' <<<\"$line\" >/dev/null 2>&1; then\n      printf '%s\\n' \"$line\"; return 0\n    fi\n    # A one-shot client cannot answer server-initiated requests for user input.\n    if jq -e 'has(\"method\") and has(\"id\")' <<<\"$line\" >/dev/null 2>&1; then\n      stdio_send \"$(jq -c '{jsonrpc:\"2.0\",id:.id,error:{code:-32601,message:\"Client callbacks are not supported\"}}' <<<\"$line\")\" || return 1\n    fi\n  done\n  bad \"No matching stdio response. Check the command and keep server logs on stderr.\"\n  return 1\n}","tokenCount":236}],"storageText":"bash function \"stdio_receive\"\nin engine/mcp-wire.sh\nPurpose: user management, validation, error handling, logging, HTTP/API, file operations\n\nstdio_receive() {\n  local id=\"$1\" line deadline=$((SECONDS + TIMEOUT)) remaining\n  while [ \"$SECONDS\" -lt \"$deadline\" ]; do\n    remaining=$((deadline - SECONDS))\n    IFS= read -r -t \"$remaining\" line <&4 || break\n    if jq -e --argjson id \"$id\" 'type == \"object\" and .id == $id and (has(\"result\") or has(\"error\"))' <<<\"$line\" >/dev/null 2>&1; then\n      printf '%s\\n' \"$line\"; return 0\n    fi\n    # A one-shot client cannot answer server-initiated requests for user input.\n    if jq -e 'has(\"method\") and has(\"id\")' <<<\"$line\" >/dev/null 2>&1; then\n      stdio_send \"$(jq -c '{jsonrpc:\"2.0\",id:.id,error:{code:-32601,message:\"Client callbacks are not supported\"}}' <<<\"$line\")\" || return 1\n    fi\n  done\n  bad \"No matching stdio response. Check the command and keep server logs on stderr.\"\n  return 1\n}","content":"stdio_receive() {\n  local id=\"$1\" line deadline=$((SECONDS + TIMEOUT)) remaining\n  while [ \"$SECONDS\" -lt \"$deadline\" ]; do\n    remaining=$((deadline - SECONDS))\n    IFS= read -r -t \"$remaining\" line <&4 || break\n    if jq -e --argjson id \"$id\" 'type == \"object\" and .id == $id and (has(\"result\") or has(\"error\"))' <<<\"$line\" >/dev/null 2>&1; then\n      printf '%s\\n' \"$line\"; return 0\n    fi\n    # A one-shot client cannot answer server-initiated requests for user input.\n    if jq -e 'has(\"method\") and has(\"id\")' <<<\"$line\" >/dev/null 2>&1; then\n      stdio_send \"$(jq -c '{jsonrpc:\"2.0\",id:.id,error:{code:-32601,message:\"Client callbacks are not supported\"}}' <<<\"$line\")\" || return 1\n    fi\n  done\n  bad \"No matching stdio response. Check the command and keep server logs on stderr.\"\n  return 1\n}","contentHash":"e5bb6fee85cf00be","metadata":{"filePath":"engine/mcp-wire.sh","startLine":129,"endLine":144,"chunkType":"function_definition","name":"stdio_receive","language":"bash","hash":"e5bb6fee85cf00be"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":2,"lastAttempt":"2026-10-17T11:47:10.962Z"}
{"version":1,"chunks":[{"id":"chunk_9067a76b33fe5ae0","texts":[{"text":"bash function \"connect\"\nin engine/mcp-wire.sh\nPurpose: logging, file operations, data parsing, configuration\n\nconnect() {\n  local init data version\n  init=$(jq -nc --arg p \"$PROTOCOL\" --arg v \"$VERSION\" '{jsonrpc:\"2.0\",id:1,method:\"initialize\",params:{protocolVersion:$p,capabilities:{},clientInfo:{name:\"mcp-wire\",version:$v}}}')\n  if [ -n \"$STDIO\" ]; then\n    local command=() arg\n    while IFS= read -r arg; do command+=(\"$arg\"); done < <(jq -r '.[]' <<<\"$STDIO\")\n    mkfifo \"$WORK/in\" \"$WORK/out\" || return 1\n    # Open both ends before launch to avoid FIFO-open deadlocks on Bash 3.2.\n    exec 3<>\"$WORK/in\" 4<>\"$WORK/out\"\n    local env_args=(\"PATH=${PATH:-}\" \"HOME=${HOME:-}\" \"TMPDIR=${TMPDIR:-}\" \"LANG=${LANG:-}\" \"TERM=${TERM:-}\")\n    local e\n    for e in \"${STDIO_ENV[@]+\"${STDIO_ENV[@]}\"}\"; do","tokenCount":201}],"storageText":"bash function \"connect\"\nin engine/mcp-wire.sh\nPurpose: logging, file operations, data parsing, configuration\n\nconnect() {\n  local init data version\n  init=$(jq -nc --arg p \"$PROTOCOL\" --arg v \"$VERSION\" '{jsonrpc:\"2.0\",id:1,method:\"initialize\",params:{protocolVersion:$p,capabilities:{},clientInfo:{name:\"mcp-wire\",version:$v}}}')\n  if [ -n \"$STDIO\" ]; then\n    local command=() arg\n    while IFS= read -r arg; do command+=(\"$arg\"); done < <(jq -r '.[]' <<<\"$STDIO\")\n    mkfifo \"$WORK/in\" \"$WORK/out\" || return 1\n    # Open both ends before launch to avoid FIFO-open deadlocks on Bash 3.2.\n    exec 3<>\"$WORK/in\" 4<>\"$WORK/out\"\n    local env_args=(\"PATH=${PATH:-}\" \"HOME=${HOME:-}\" \"TMPDIR=${TMPDIR:-}\" \"LANG=${LANG:-}\" \"TERM=${TERM:-}\")\n    local e\n    for e in \"${STDIO_ENV[@]+\"${STDIO_ENV[@]}\"}\"; do","content":"connect() {\n  local init data version\n  init=$(jq -nc --arg p \"$PROTOCOL\" --arg v \"$VERSION\" '{jsonrpc:\"2.0\",id:1,method:\"initialize\",params:{protocolVersion:$p,capabilities:{},clientInfo:{name:\"mcp-wire\",version:$v}}}')\n  if [ -n \"$STDIO\" ]; then\n    local command=() arg\n    while IFS= read -r arg; do command+=(\"$arg\"); done < <(jq -r '.[]' <<<\"$STDIO\")\n    mkfifo \"$WORK/in\" \"$WORK/out\" || return 1\n    # Open both ends before launch to avoid FIFO-open deadlocks on Bash 3.2.\n    exec 3<>\"$WORK/in\" 4<>\"$WORK/out\"\n    local env_args=(\"PATH=${PATH:-}\" \"HOME=${HOME:-}\" \"TMPDIR=${TMPDIR:-}\" \"LANG=${LANG:-}\" \"TERM=${TERM:-}\")\n    local e\n    for e in \"${STDIO_ENV[@]+\"${STDIO_ENV[@]}\"}\"; do","contentHash":"eaa6febe9d0fb1a1","metadata":{"filePath":"engine/mcp-wire.sh","startLine":146,"endLine":157,"chunkType":"function_definition","name":"connect","language":"bash","hash":"eaa6febe9d0fb1a1"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":2,"lastAttempt":"2026-10-17T11:47:10.962Z"}
{"version":1,"chunks":[{"id":"chunk_49cfa1146facb54e","texts":[{"text":"bash function \"connect\"\nin engine/mcp-wire.sh\nPurpose: logging, file operations, configuration\n\n    local env_args=(\"PATH=${PATH:-}\" \"HOME=${HOME:-}\" \"TMPDIR=${TMPDIR:-}\" \"LANG=${LANG:-}\" \"TERM=${TERM:-}\")\n    local e\n    for e in \"${STDIO_ENV[@]+\"${STDIO_ENV[@]}\"}\"; do\n      case \"$e\" in\n        *=*) env_args+=(\"$e\") ;;\n        *) [ -n \"${!e:-}\" ] && env_args+=(\"$e=${!e}\") ;;\n      esac\n    done\n    env -i \"${env_args[@]}\" \"${command[@]}\" <\"$WORK/in\" >\"$WORK/out\" 2>\"$WORK/server.log\" &\n    SERVER_PID=$!\n    stdio_send \"$init\" || return 1\n    data=$(stdio_receive 1) || return 1","tokenCount":146}],"storageText":"bash function \"connect\"\nin engine/mcp-wire.sh\nPurpose: logging, file operations, configuration\n\n    local env_args=(\"PATH=${PATH:-}\" \"HOME=${HOME:-}\" \"TMPDIR=${TMPDIR:-}\" \"LANG=${LANG:-}\" \"TERM=${TERM:-}\")\n    local e\n    for e in \"${STDIO_ENV[@]+\"${STDIO_ENV[@]}\"}\"; do\n      case \"$e\" in\n        *=*) env_args+=(\"$e\") ;;\n        *) [ -n \"${!e:-}\" ] && env_args+=(\"$e=${!e}\") ;;\n      esac\n    done\n    env -i \"${env_args[@]}\" \"${command[@]}\" <\"$WORK/in\" >\"$WORK/out\" 2>\"$WORK/server.log\" &\n    SERVER_PID=$!\n    stdio_send \"$init\" || return 1\n    data=$(stdio_receive 1) || return 1","content":"    local env_args=(\"PATH=${PATH:-}\" \"HOME=${HOME:-}\" \"TMPDIR=${TMPDIR:-}\" \"LANG=${LANG:-}\" \"TERM=${TERM:-}\")\n    local e\n    for e in \"${STDIO_ENV[@]+\"${STDIO_ENV[@]}\"}\"; do\n      case \"$e\" in\n        *=*) env_args+=(\"$e\") ;;\n        *) [ -n \"${!e:-}\" ] && env_args+=(\"$e=${!e}\") ;;\n      esac\n    done\n    env -i \"${env_args[@]}\" \"${command[@]}\" <\"$WORK/in\" >\"$WORK/out\" 2>\"$WORK/server.log\" &\n    SERVER_PID=$!\n    stdio_send \"$init\" || return 1\n    data=$(stdio_receive 1) || return 1","contentHash":"7772a37c3869b97f","metadata":{"filePath":"engine/mcp-wire.sh","startLine":155,"endLine":166,"chunkType":"function_definition","name":"connect","language":"bash","hash":"7772a37c3869b97f"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":2,"lastAttempt":"2026-10-17T11:47:10.962Z"}
{"version":1,"chunks":[{"id":"chunk_540dc6be0e0b5f20","texts":[{"text":"bash function \"connect\"\nin engine/mcp-wire.sh\nPurpose: authorization, validation, error handling, HTTP/API, data parsing, state management\n\n    SERVER_PID=$!\n    stdio_send \"$init\" || return 1\n    data=$(stdio_receive 1) || return 1\n  else\n    http_post \"$init\" || return 1\n    data=$(parse_response \"$WORK/body\" 1) || { bad \"Invalid initialize response. Check that the URL serves MCP.\"; return 1; }\n    local session\n    session=$(awk 'tolower($1)==\"mcp-session-id:\" {sub(/\\r$/, \"\", $2); print $2; exit}' \"$WORK/headers\")\n    if [ -n \"$session\" ]; then SESSION_ID=\"$session\"; SESSION_HEADERS+=(\"-H\" \"Mcp-Session-Id: $session\"); TRANSPORT='session'; else TRANSPORT='stateless'; fi\n    if grep -qi '^content-type:.*application/json' \"$WORK/headers\"; then REPLY='json'; else REPLY='sse'; fi\n  fi\n  jq -e '.error' <<<\"$data\" >/dev/null 2>&1 && { bad \"MCP initialization failed. Check server access and protocol support.\"; return 1; }","tokenCount":233}],"storageText":"bash function \"connect\"\nin engine/mcp-wire.sh\nPurpose: authorization, validation, error handling, HTTP/API, data parsing, state management\n\n    SERVER_PID=$!\n    stdio_send \"$init\" || return 1\n    data=$(stdio_receive 1) || return 1\n  else\n    http_post \"$init\" || return 1\n    data=$(parse_response \"$WORK/body\" 1) || { bad \"Invalid initialize response. Check that the URL serves MCP.\"; return 1; }\n    local session\n    session=$(awk 'tolower($1)==\"mcp-session-id:\" {sub(/\\r$/, \"\", $2); print $2; exit}' \"$WORK/headers\")\n    if [ -n \"$session\" ]; then SESSION_ID=\"$session\"; SESSION_HEADERS+=(\"-H\" \"Mcp-Session-Id: $session\"); TRANSPORT='session'; else TRANSPORT='stateless'; fi\n    if grep -qi '^content-type:.*application/json' \"$WORK/headers\"; then REPLY='json'; else REPLY='sse'; fi\n  fi\n  jq -e '.error' <<<\"$data\" >/dev/null 2>&1 && { bad \"MCP initialization failed. Check server access and protocol support.\"; return 1; }","content":"    SERVER_PID=$!\n    stdio_send \"$init\" || return 1\n    data=$(stdio_receive 1) || return 1\n  else\n    http_post \"$init\" || return 1\n    data=$(parse_response \"$WORK/body\" 1) || { bad \"Invalid initialize response. Check that the URL serves MCP.\"; return 1; }\n    local session\n    session=$(awk 'tolower($1)==\"mcp-session-id:\" {sub(/\\r$/, \"\", $2); print $2; exit}' \"$WORK/headers\")\n    if [ -n \"$session\" ]; then SESSION_ID=\"$session\"; SESSION_HEADERS+=(\"-H\" \"Mcp-Session-Id: $session\"); TRANSPORT='session'; else TRANSPORT='stateless'; fi\n    if grep -qi '^content-type:.*application/json' \"$WORK/headers\"; then REPLY='json'; else REPLY='sse'; fi\n  fi\n  jq -e '.error' <<<\"$data\" >/dev/null 2>&1 && { bad \"MCP initialization failed. Check server access and protocol support.\"; return 1; }","contentHash":"e22a7e2ea6660de6","metadata":{"filePath":"engine/mcp-wire.sh","startLine":164,"endLine":175,"chunkType":"function_definition","name":"connect","language":"bash","hash":"e22a7e2ea6660de6"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":2,"lastAttempt":"2026-10-17T11:47:10.962Z"}
{"version":1,"chunks":[{"id":"chunk_f1f8dd48e2594eb8","texts":[{"text":"bash function \"connect\"\nin engine/mcp-wire.sh\nPurpose: authorization, validation, error handling, data parsing\n\n    if grep -qi '^content-type:.*application/json' \"$WORK/headers\"; then REPLY='json'; else REPLY='sse'; fi\n  fi\n  jq -e '.error' <<<\"$data\" >/dev/null 2>&1 && { bad \"MCP initialization failed. Check server access and protocol support.\"; return 1; }\n  version=$(jq -r '.result.protocolVersion // empty' <<<\"$data\")\n  case \"$version\" in\n    2025-03-26|2025-06-18|2025-11-25) : ;;\n    *) bad \"Unsupported negotiated MCP version. Use a server with a supported protocol version.\"; return 1 ;;\n  esac\n  if [ -n \"$STDIO\" ]; then\n    stdio_send '{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}'\n  else\n    SESSION_HEADERS+=(\"-H\" \"MCP-Protocol-Version: $version\")","tokenCount":194}],"storageText":"bash function \"connect\"\nin engine/mcp-wire.sh\nPurpose: authorization, validation, error handling, data parsing\n\n    if grep -qi '^content-type:.*application/json' \"$WORK/headers\"; then REPLY='json'; else REPLY='sse'; fi\n  fi\n  jq -e '.error' <<<\"$data\" >/dev/null 2>&1 && { bad \"MCP initialization failed. Check server access and protocol support.\"; return 1; }\n  version=$(jq -r '.result.protocolVersion // empty' <<<\"$data\")\n  case \"$version\" in\n    2025-03-26|2025-06-18|2025-11-25) : ;;\n    *) bad \"Unsupported negotiated MCP version. Use a server with a supported protocol version.\"; return 1 ;;\n  esac\n  if [ -n \"$STDIO\" ]; then\n    stdio_send '{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}'\n  else\n    SESSION_HEADERS+=(\"-H\" \"MCP-Protocol-Version: $version\")","content":"    if grep -qi '^content-type:.*application/json' \"$WORK/headers\"; then REPLY='json'; else REPLY='sse'; fi\n  fi\n  jq -e '.error' <<<\"$data\" >/dev/null 2>&1 && { bad \"MCP initialization failed. Check server access and protocol support.\"; return 1; }\n  version=$(jq -r '.result.protocolVersion // empty' <<<\"$data\")\n  case \"$version\" in\n    2025-03-26|2025-06-18|2025-11-25) : ;;\n    *) bad \"Unsupported negotiated MCP version. Use a server with a supported protocol version.\"; return 1 ;;\n  esac\n  if [ -n \"$STDIO\" ]; then\n    stdio_send '{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}'\n  else\n    SESSION_HEADERS+=(\"-H\" \"MCP-Protocol-Version: $version\")","contentHash":"40c8aacd84ee4e97","metadata":{"filePath":"engine/mcp-wire.sh","startLine":173,"endLine":184,"chunkType":"function_definition","name":"connect","language":"bash","hash":"40c8aacd84ee4e97"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":2,"lastAttempt":"2026-10-17T11:47:10.962Z"}
{"version":1,"chunks":[{"id":"chunk_bfbb7387c5954699","texts":[{"text":"bash function \"connect\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, data parsing\n\n    stdio_send '{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}'\n  else\n    SESSION_HEADERS+=(\"-H\" \"MCP-Protocol-Version: $version\")\n    http_post '{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}'\n  fi\n}","tokenCount":74}],"storageText":"bash function \"connect\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, data parsing\n\n    stdio_send '{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}'\n  else\n    SESSION_HEADERS+=(\"-H\" \"MCP-Protocol-Version: $version\")\n    http_post '{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}'\n  fi\n}","content":"    stdio_send '{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}'\n  else\n    SESSION_HEADERS+=(\"-H\" \"MCP-Protocol-Version: $version\")\n    http_post '{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}'\n  fi\n}","contentHash":"c01832cbf58232a5","metadata":{"filePath":"engine/mcp-wire.sh","startLine":182,"endLine":187,"chunkType":"function_definition","name":"connect","language":"bash","hash":"c01832cbf58232a5"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":2,"lastAttempt":"2026-10-17T11:47:10.962Z"}
{"version":1,"chunks":[{"id":"chunk_f2efdf5aca938eb8","texts":[{"text":"bash function \"send_request\"\nin engine/mcp-wire.sh\nPurpose: authorization, validation, error handling, HTTP/API, data parsing, testing\n\nsend_request() {\n  local body=\"$1\" id data\n  id=$(jq -c '.id' <<<\"$body\")\n  if [ -n \"$STDIO\" ]; then\n    stdio_send \"$body\" || return 1\n    data=$(stdio_receive \"$id\") || return 1\n  else\n    http_post \"$body\" || return 1\n    data=$(parse_response \"$WORK/body\" \"$id\") || { bad \"Invalid MCP response. Check the server response format.\"; return 1; }\n  fi\n  if jq -e 'has(\"error\")' <<<\"$data\" >/dev/null 2>&1; then\n    bad \"MCP request failed (code $(jq -r '.error.code // \"unknown\"' <<<\"$data\")). Inspect the tool schema and server access.\"\n    return 1\n  fi\n  printf '%s\\n' \"$data\"\n}","tokenCount":180}],"storageText":"bash function \"send_request\"\nin engine/mcp-wire.sh\nPurpose: authorization, validation, error handling, HTTP/API, data parsing, testing\n\nsend_request() {\n  local body=\"$1\" id data\n  id=$(jq -c '.id' <<<\"$body\")\n  if [ -n \"$STDIO\" ]; then\n    stdio_send \"$body\" || return 1\n    data=$(stdio_receive \"$id\") || return 1\n  else\n    http_post \"$body\" || return 1\n    data=$(parse_response \"$WORK/body\" \"$id\") || { bad \"Invalid MCP response. Check the server response format.\"; return 1; }\n  fi\n  if jq -e 'has(\"error\")' <<<\"$data\" >/dev/null 2>&1; then\n    bad \"MCP request failed (code $(jq -r '.error.code // \"unknown\"' <<<\"$data\")). Inspect the tool schema and server access.\"\n    return 1\n  fi\n  printf '%s\\n' \"$data\"\n}","content":"send_request() {\n  local body=\"$1\" id data\n  id=$(jq -c '.id' <<<\"$body\")\n  if [ -n \"$STDIO\" ]; then\n    stdio_send \"$body\" || return 1\n    data=$(stdio_receive \"$id\") || return 1\n  else\n    http_post \"$body\" || return 1\n    data=$(parse_response \"$WORK/body\" \"$id\") || { bad \"Invalid MCP response. Check the server response format.\"; return 1; }\n  fi\n  if jq -e 'has(\"error\")' <<<\"$data\" >/dev/null 2>&1; then\n    bad \"MCP request failed (code $(jq -r '.error.code // \"unknown\"' <<<\"$data\")). Inspect the tool schema and server access.\"\n    return 1\n  fi\n  printf '%s\\n' \"$data\"\n}","contentHash":"935f29f98965cc1c","metadata":{"filePath":"engine/mcp-wire.sh","startLine":189,"endLine":204,"chunkType":"function_definition","name":"send_request","language":"bash","hash":"935f29f98965cc1c"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":2,"lastAttempt":"2026-10-17T11:47:10.962Z"}
{"version":1,"chunks":[{"id":"chunk_b99529c169f64344","texts":[{"text":"bash function \"request_all\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, database, data parsing\n\n# Follow opaque cursors within one session; reject cycles and unbounded pagination.\nrequest_all() {\n  local body=\"$1\" key=\"$2\" data result='[]' cursor='' seen='[]' page=0\n  while :; do\n    data=$(send_request \"$body\") || return 1\n    [ -n \"$key\" ] || { printf '%s\\n' \"$data\"; return 0; }\n    jq -e --arg k \"$key\" '.result[$k] | type == \"array\"' <<<\"$data\" >/dev/null || { bad \"Invalid list response.\"; return 1; }\n    result=$(jq -nc --argjson a \"$result\" --argjson b \"$(jq -c --arg k \"$key\" '.result[$k]' <<<\"$data\")\" '$a+$b')\n    cursor=$(jq -r '.result.nextCursor // empty' <<<\"$data\")\n    [ -n \"$cursor\" ] || break\n    page=$((page+1))\n    if [ \"$page\" -ge 50 ] || jq -e --arg c \"$cursor\" 'index($c) != null' <<<\"$seen\" >/dev/null; then\n      bad \"Pagination did not finish. Narrow the server query or fix its cursor sequence.\"; return 1\n    fi\n    seen=$(jq -c --arg c \"$cursor\" '.+[$c]' <<<\"$seen\")\n    body=$(jq -c --arg c \"$cursor\" '.params.cursor=$c' <<<\"$body\")\n  done\n  jq -c --arg k \"$key\" --argjson a \"$result\" '.result[$k]=$a | del(.result.nextCursor)' <<<\"$data\"\n}","tokenCount":293}],"storageText":"bash function \"request_all\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, database, data parsing\n\n# Follow opaque cursors within one session; reject cycles and unbounded pagination.\nrequest_all() {\n  local body=\"$1\" key=\"$2\" data result='[]' cursor='' seen='[]' page=0\n  while :; do\n    data=$(send_request \"$body\") || return 1\n    [ -n \"$key\" ] || { printf '%s\\n' \"$data\"; return 0; }\n    jq -e --arg k \"$key\" '.result[$k] | type == \"array\"' <<<\"$data\" >/dev/null || { bad \"Invalid list response.\"; return 1; }\n    result=$(jq -nc --argjson a \"$result\" --argjson b \"$(jq -c --arg k \"$key\" '.result[$k]' <<<\"$data\")\" '$a+$b')\n    cursor=$(jq -r '.result.nextCursor // empty' <<<\"$data\")\n    [ -n \"$cursor\" ] || break\n    page=$((page+1))\n    if [ \"$page\" -ge 50 ] || jq -e --arg c \"$cursor\" 'index($c) != null' <<<\"$seen\" >/dev/null; then\n      bad \"Pagination did not finish. Narrow the server query or fix its cursor sequence.\"; return 1\n    fi\n    seen=$(jq -c --arg c \"$cursor\" '.+[$c]' <<<\"$seen\")\n    body=$(jq -c --arg c \"$cursor\" '.params.cursor=$c' <<<\"$body\")\n  done\n  jq -c --arg k \"$key\" --argjson a \"$result\" '.result[$k]=$a | del(.result.nextCursor)' <<<\"$data\"\n}","content":"# Follow opaque cursors within one session; reject cycles and unbounded pagination.\nrequest_all() {\n  local body=\"$1\" key=\"$2\" data result='[]' cursor='' seen='[]' page=0\n  while :; do\n    data=$(send_request \"$body\") || return 1\n    [ -n \"$key\" ] || { printf '%s\\n' \"$data\"; return 0; }\n    jq -e --arg k \"$key\" '.result[$k] | type == \"array\"' <<<\"$data\" >/dev/null || { bad \"Invalid list response.\"; return 1; }\n    result=$(jq -nc --argjson a \"$result\" --argjson b \"$(jq -c --arg k \"$key\" '.result[$k]' <<<\"$data\")\" '$a+$b')\n    cursor=$(jq -r '.result.nextCursor // empty' <<<\"$data\")\n    [ -n \"$cursor\" ] || break\n    page=$((page+1))\n    if [ \"$page\" -ge 50 ] || jq -e --arg c \"$cursor\" 'index($c) != null' <<<\"$seen\" >/dev/null; then\n      bad \"Pagination did not finish. Narrow the server query or fix its cursor sequence.\"; return 1\n    fi\n    seen=$(jq -c --arg c \"$cursor\" '.+[$c]' <<<\"$seen\")\n    body=$(jq -c --arg c \"$cursor\" '.params.cursor=$c' <<<\"$body\")\n  done\n  jq -c --arg k \"$key\" --argjson a \"$result\" '.result[$k]=$a | del(.result.nextCursor)' <<<\"$data\"\n}","contentHash":"56b3685b2dd24ff0","metadata":{"filePath":"engine/mcp-wire.sh","startLine":206,"endLine":224,"chunkType":"function_definition","name":"request_all","language":"bash","hash":"56b3685b2dd24ff0"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":2,"lastAttempt":"2026-10-17T11:47:10.962Z"}
{"version":1,"chunks":[{"id":"chunk_a594620453af9e5c","texts":[{"text":"bash function \"emit_result\"\nin engine/mcp-wire.sh\nPurpose: file operations, data parsing\n\nemit_result() { # emit_result <data-line> <out-prefix>\n  local data=\"$1\" prefix=\"$2\" img_n=0 saved='' item itype itext imgfile mime ext\n  if jq -e '.result | has(\"content\") and (.content|type)!=\"array\"' <<<\"$data\" >/dev/null 2>&1; then bad \"Invalid tool content array.\"; return 1; fi\n  if [ -n \"$prefix\" ]; then : > \"${prefix}.txt\"; fi\n  if [ \"$JSON_OUT\" -eq 1 ]; then\n    jq '.result' <<<\"$data\"\n  else\n    while IFS= read -r item; do\n      itype=$(jq -r '.type // empty' <<<\"$item\")\n      case \"$itype\" in\n        text|resource|resource_link)\n          itext=$(jq -r '.text // .resource.text // .uri // .resource.uri // empty' <<<\"$item\")","tokenCount":183}],"storageText":"bash function \"emit_result\"\nin engine/mcp-wire.sh\nPurpose: file operations, data parsing\n\nemit_result() { # emit_result <data-line> <out-prefix>\n  local data=\"$1\" prefix=\"$2\" img_n=0 saved='' item itype itext imgfile mime ext\n  if jq -e '.result | has(\"content\") and (.content|type)!=\"array\"' <<<\"$data\" >/dev/null 2>&1; then bad \"Invalid tool content array.\"; return 1; fi\n  if [ -n \"$prefix\" ]; then : > \"${prefix}.txt\"; fi\n  if [ \"$JSON_OUT\" -eq 1 ]; then\n    jq '.result' <<<\"$data\"\n  else\n    while IFS= read -r item; do\n      itype=$(jq -r '.type // empty' <<<\"$item\")\n      case \"$itype\" in\n        text|resource|resource_link)\n          itext=$(jq -r '.text // .resource.text // .uri // .resource.uri // empty' <<<\"$item\")","content":"emit_result() { # emit_result <data-line> <out-prefix>\n  local data=\"$1\" prefix=\"$2\" img_n=0 saved='' item itype itext imgfile mime ext\n  if jq -e '.result | has(\"content\") and (.content|type)!=\"array\"' <<<\"$data\" >/dev/null 2>&1; then bad \"Invalid tool content array.\"; return 1; fi\n  if [ -n \"$prefix\" ]; then : > \"${prefix}.txt\"; fi\n  if [ \"$JSON_OUT\" -eq 1 ]; then\n    jq '.result' <<<\"$data\"\n  else\n    while IFS= read -r item; do\n      itype=$(jq -r '.type // empty' <<<\"$item\")\n      case \"$itype\" in\n        text|resource|resource_link)\n          itext=$(jq -r '.text // .resource.text // .uri // .resource.uri // empty' <<<\"$item\")","contentHash":"50a1e78c6b252501","metadata":{"filePath":"engine/mcp-wire.sh","startLine":226,"endLine":237,"chunkType":"function_definition","name":"emit_result","language":"bash","hash":"50a1e78c6b252501"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":2,"lastAttempt":"2026-10-17T11:47:10.962Z"}
{"version":1,"chunks":[{"id":"chunk_145f131a8e6eb674","texts":[{"text":"bash function \"emit_result\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, file operations, data parsing, testing\n\n      case \"$itype\" in\n        text|resource|resource_link)\n          itext=$(jq -r '.text // .resource.text // .uri // .resource.uri // empty' <<<\"$item\")\n          if [ -n \"$prefix\" ]; then printf '%s\\n' \"$itext\" >> \"${prefix}.txt\" || return 1; saved=\"$saved ${prefix}.txt\"\n          else printf '%s\\n' \"$itext\"; fi ;;\n        image)\n          img_n=$((img_n+1)); mime=$(jq -r '.mimeType // \"image/png\"' <<<\"$item\")\n          case \"$mime\" in image/png) ext=png ;; image/jpeg) ext=jpg ;; image/webp) ext=webp ;; *) bad \"Unsupported image MIME type; use --json to inspect the response.\"; return 1 ;; esac\n          imgfile=\"${prefix:-${MCP_WIRE_IMAGE_PREFIX:-mcp-wire}}-${img_n}.${ext}\"\n          jq -r '.data // empty' <<<\"$item\" | b64decode >\"$imgfile\" 2>/dev/null || { rm -f \"$imgfile\"; bad \"Invalid image data.\"; return 1; }\n          saved=\"$saved $imgfile\" ;;\n        *)","tokenCount":247}],"storageText":"bash function \"emit_result\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, file operations, data parsing, testing\n\n      case \"$itype\" in\n        text|resource|resource_link)\n          itext=$(jq -r '.text // .resource.text // .uri // .resource.uri // empty' <<<\"$item\")\n          if [ -n \"$prefix\" ]; then printf '%s\\n' \"$itext\" >> \"${prefix}.txt\" || return 1; saved=\"$saved ${prefix}.txt\"\n          else printf '%s\\n' \"$itext\"; fi ;;\n        image)\n          img_n=$((img_n+1)); mime=$(jq -r '.mimeType // \"image/png\"' <<<\"$item\")\n          case \"$mime\" in image/png) ext=png ;; image/jpeg) ext=jpg ;; image/webp) ext=webp ;; *) bad \"Unsupported image MIME type; use --json to inspect the response.\"; return 1 ;; esac\n          imgfile=\"${prefix:-${MCP_WIRE_IMAGE_PREFIX:-mcp-wire}}-${img_n}.${ext}\"\n          jq -r '.data // empty' <<<\"$item\" | b64decode >\"$imgfile\" 2>/dev/null || { rm -f \"$imgfile\"; bad \"Invalid image data.\"; return 1; }\n          saved=\"$saved $imgfile\" ;;\n        *)","content":"      case \"$itype\" in\n        text|resource|resource_link)\n          itext=$(jq -r '.text // .resource.text // .uri // .resource.uri // empty' <<<\"$item\")\n          if [ -n \"$prefix\" ]; then printf '%s\\n' \"$itext\" >> \"${prefix}.txt\" || return 1; saved=\"$saved ${prefix}.txt\"\n          else printf '%s\\n' \"$itext\"; fi ;;\n        image)\n          img_n=$((img_n+1)); mime=$(jq -r '.mimeType // \"image/png\"' <<<\"$item\")\n          case \"$mime\" in image/png) ext=png ;; image/jpeg) ext=jpg ;; image/webp) ext=webp ;; *) bad \"Unsupported image MIME type; use --json to inspect the response.\"; return 1 ;; esac\n          imgfile=\"${prefix:-${MCP_WIRE_IMAGE_PREFIX:-mcp-wire}}-${img_n}.${ext}\"\n          jq -r '.data // empty' <<<\"$item\" | b64decode >\"$imgfile\" 2>/dev/null || { rm -f \"$imgfile\"; bad \"Invalid image data.\"; return 1; }\n          saved=\"$saved $imgfile\" ;;\n        *)","contentHash":"2b5399c14b799772","metadata":{"filePath":"engine/mcp-wire.sh","startLine":235,"endLine":246,"chunkType":"function_definition","name":"emit_result","language":"bash","hash":"2b5399c14b799772"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":2,"lastAttempt":"2026-10-17T11:47:10.962Z"}
{"version":1,"chunks":[{"id":"chunk_d41822687c43f270","texts":[{"text":"bash function \"emit_result\"\nin engine/mcp-wire.sh\nPurpose: file operations\n\n          jq -r '.data // empty' <<<\"$item\" | b64decode >\"$imgfile\" 2>/dev/null || { rm -f \"$imgfile\"; bad \"Invalid image data.\"; return 1; }\n          saved=\"$saved $imgfile\" ;;\n        *)\n          # Preserve unfamiliar content as data instead of silently dropping it.\n          if [ -n \"$prefix\" ]; then jq . <<<\"$item\" >>\"$prefix.txt\" || return 1; saved=\"$saved $prefix.txt\"\n          else jq . <<<\"$item\"; fi ;;\n      esac\n    done < <(jq -c '.result.content[]?' <<<\"$data\")\n    [ -z \"$saved\" ] || ok \"saved:$saved\"\n    if ! jq -e '.result | type == \"object\" and has(\"content\")' <<<\"$data\" >/dev/null; then jq '.result' <<<\"$data\"\n    elif jq -e '.result | (.content|length)==0 and has(\"structuredContent\")' <<<\"$data\" >/dev/null; then jq '.result.structuredContent' <<<\"$data\"; fi\n  fi","tokenCount":217}],"storageText":"bash function \"emit_result\"\nin engine/mcp-wire.sh\nPurpose: file operations\n\n          jq -r '.data // empty' <<<\"$item\" | b64decode >\"$imgfile\" 2>/dev/null || { rm -f \"$imgfile\"; bad \"Invalid image data.\"; return 1; }\n          saved=\"$saved $imgfile\" ;;\n        *)\n          # Preserve unfamiliar content as data instead of silently dropping it.\n          if [ -n \"$prefix\" ]; then jq . <<<\"$item\" >>\"$prefix.txt\" || return 1; saved=\"$saved $prefix.txt\"\n          else jq . <<<\"$item\"; fi ;;\n      esac\n    done < <(jq -c '.result.content[]?' <<<\"$data\")\n    [ -z \"$saved\" ] || ok \"saved:$saved\"\n    if ! jq -e '.result | type == \"object\" and has(\"content\")' <<<\"$data\" >/dev/null; then jq '.result' <<<\"$data\"\n    elif jq -e '.result | (.content|length)==0 and has(\"structuredContent\")' <<<\"$data\" >/dev/null; then jq '.result.structuredContent' <<<\"$data\"; fi\n  fi","content":"          jq -r '.data // empty' <<<\"$item\" | b64decode >\"$imgfile\" 2>/dev/null || { rm -f \"$imgfile\"; bad \"Invalid image data.\"; return 1; }\n          saved=\"$saved $imgfile\" ;;\n        *)\n          # Preserve unfamiliar content as data instead of silently dropping it.\n          if [ -n \"$prefix\" ]; then jq . <<<\"$item\" >>\"$prefix.txt\" || return 1; saved=\"$saved $prefix.txt\"\n          else jq . <<<\"$item\"; fi ;;\n      esac\n    done < <(jq -c '.result.content[]?' <<<\"$data\")\n    [ -z \"$saved\" ] || ok \"saved:$saved\"\n    if ! jq -e '.result | type == \"object\" and has(\"content\")' <<<\"$data\" >/dev/null; then jq '.result' <<<\"$data\"\n    elif jq -e '.result | (.content|length)==0 and has(\"structuredContent\")' <<<\"$data\" >/dev/null; then jq '.result.structuredContent' <<<\"$data\"; fi\n  fi","contentHash":"42950f89223da581","metadata":{"filePath":"engine/mcp-wire.sh","startLine":244,"endLine":255,"chunkType":"function_definition","name":"emit_result","language":"bash","hash":"42950f89223da581"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":2,"lastAttempt":"2026-10-17T11:47:10.962Z"}
{"version":1,"chunks":[{"id":"chunk_7e0410fe0e5ae456","texts":[{"text":"bash function \"emit_result\"\nin engine/mcp-wire.sh\nPurpose: error handling\n\n    if ! jq -e '.result | type == \"object\" and has(\"content\")' <<<\"$data\" >/dev/null; then jq '.result' <<<\"$data\"\n    elif jq -e '.result | (.content|length)==0 and has(\"structuredContent\")' <<<\"$data\" >/dev/null; then jq '.result.structuredContent' <<<\"$data\"; fi\n  fi\n  if jq -e '.result.isError == true' <<<\"$data\" >/dev/null; then bad \"Tool reported an error.\"; return 1; fi\n}","tokenCount":114}],"storageText":"bash function \"emit_result\"\nin engine/mcp-wire.sh\nPurpose: error handling\n\n    if ! jq -e '.result | type == \"object\" and has(\"content\")' <<<\"$data\" >/dev/null; then jq '.result' <<<\"$data\"\n    elif jq -e '.result | (.content|length)==0 and has(\"structuredContent\")' <<<\"$data\" >/dev/null; then jq '.result.structuredContent' <<<\"$data\"; fi\n  fi\n  if jq -e '.result.isError == true' <<<\"$data\" >/dev/null; then bad \"Tool reported an error.\"; return 1; fi\n}","content":"    if ! jq -e '.result | type == \"object\" and has(\"content\")' <<<\"$data\" >/dev/null; then jq '.result' <<<\"$data\"\n    elif jq -e '.result | (.content|length)==0 and has(\"structuredContent\")' <<<\"$data\" >/dev/null; then jq '.result.structuredContent' <<<\"$data\"; fi\n  fi\n  if jq -e '.result.isError == true' <<<\"$data\" >/dev/null; then bad \"Tool reported an error.\"; return 1; fi\n}","contentHash":"aa597b6894e654ae","metadata":{"filePath":"engine/mcp-wire.sh","startLine":253,"endLine":257,"chunkType":"function_definition","name":"emit_result","language":"bash","hash":"aa597b6894e654ae"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":2,"lastAttempt":"2026-10-17T11:47:10.962Z"}
{"version":1,"chunks":[{"id":"chunk_6bff86374ef18689","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\nmain() (\n  local HEADERS=() SESSION_HEADERS=() args=() URL='' STDIO='' TIMEOUT=90 JSON_OUT=0 DRY_RUN=0 ALLOW_HTTP=0 PREFIX='' SESSION_ID='' TRANSPORT='session' REPLY='sse' STDIO_ENV=()\n  local CONFIG=\"${MCP_WIRE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/mcp-wire/servers.json}\" WORK='' SERVER_PID=''\n  cleanup() { if [ -n \"${SERVER_PID:-}\" ]; then pkill -P \"$SERVER_PID\" 2>/dev/null; kill \"$SERVER_PID\" 2>/dev/null; wait \"$SERVER_PID\" 2>/dev/null; fi; if [ -n \"${SESSION_ID:-}\" ] && [ -n \"${URL:-}\" ]; then curl -q -sS --max-time 2 -X DELETE \"$URL\" -H \"Mcp-Session-Id: $SESSION_ID\" >/dev/null 2>&1 || true; fi; [ -z \"${WORK:-}\" ] || rm -rf \"$WORK\"; }\n  trap cleanup EXIT INT TERM\n  while [ $# -gt 0 ]; do\n    case \"$1\" in\n      --json) JSON_OUT=1; shift ;;\n      --dry-run) DRY_RUN=1; shift ;;\n      --allow-http) ALLOW_HTTP=1; shift ;;\n      --header|--header-env|--timeout|--config|--stdio|-o|--env)\n        [ $# -ge 2 ] && [ -n \"$2\" ] || { bad \"Missing value for $1.\"; return 1; }","tokenCount":269}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\nmain() (\n  local HEADERS=() SESSION_HEADERS=() args=() URL='' STDIO='' TIMEOUT=90 JSON_OUT=0 DRY_RUN=0 ALLOW_HTTP=0 PREFIX='' SESSION_ID='' TRANSPORT='session' REPLY='sse' STDIO_ENV=()\n  local CONFIG=\"${MCP_WIRE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/mcp-wire/servers.json}\" WORK='' SERVER_PID=''\n  cleanup() { if [ -n \"${SERVER_PID:-}\" ]; then pkill -P \"$SERVER_PID\" 2>/dev/null; kill \"$SERVER_PID\" 2>/dev/null; wait \"$SERVER_PID\" 2>/dev/null; fi; if [ -n \"${SESSION_ID:-}\" ] && [ -n \"${URL:-}\" ]; then curl -q -sS --max-time 2 -X DELETE \"$URL\" -H \"Mcp-Session-Id: $SESSION_ID\" >/dev/null 2>&1 || true; fi; [ -z \"${WORK:-}\" ] || rm -rf \"$WORK\"; }\n  trap cleanup EXIT INT TERM\n  while [ $# -gt 0 ]; do\n    case \"$1\" in\n      --json) JSON_OUT=1; shift ;;\n      --dry-run) DRY_RUN=1; shift ;;\n      --allow-http) ALLOW_HTTP=1; shift ;;\n      --header|--header-env|--timeout|--config|--stdio|-o|--env)\n        [ $# -ge 2 ] && [ -n \"$2\" ] || { bad \"Missing value for $1.\"; return 1; }","content":"main() (\n  local HEADERS=() SESSION_HEADERS=() args=() URL='' STDIO='' TIMEOUT=90 JSON_OUT=0 DRY_RUN=0 ALLOW_HTTP=0 PREFIX='' SESSION_ID='' TRANSPORT='session' REPLY='sse' STDIO_ENV=()\n  local CONFIG=\"${MCP_WIRE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/mcp-wire/servers.json}\" WORK='' SERVER_PID=''\n  cleanup() { if [ -n \"${SERVER_PID:-}\" ]; then pkill -P \"$SERVER_PID\" 2>/dev/null; kill \"$SERVER_PID\" 2>/dev/null; wait \"$SERVER_PID\" 2>/dev/null; fi; if [ -n \"${SESSION_ID:-}\" ] && [ -n \"${URL:-}\" ]; then curl -q -sS --max-time 2 -X DELETE \"$URL\" -H \"Mcp-Session-Id: $SESSION_ID\" >/dev/null 2>&1 || true; fi; [ -z \"${WORK:-}\" ] || rm -rf \"$WORK\"; }\n  trap cleanup EXIT INT TERM\n  while [ $# -gt 0 ]; do\n    case \"$1\" in\n      --json) JSON_OUT=1; shift ;;\n      --dry-run) DRY_RUN=1; shift ;;\n      --allow-http) ALLOW_HTTP=1; shift ;;\n      --header|--header-env|--timeout|--config|--stdio|-o|--env)\n        [ $# -ge 2 ] && [ -n \"$2\" ] || { bad \"Missing value for $1.\"; return 1; }","contentHash":"5a91c731d941d83b","metadata":{"filePath":"engine/mcp-wire.sh","startLine":259,"endLine":270,"chunkType":"function_definition","name":"main","language":"bash","hash":"5a91c731d941d83b"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":2,"lastAttempt":"2026-10-17T11:47:10.962Z"}
{"version":1,"chunks":[{"id":"chunk_14e7e7c83101d35a","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, configuration\n\n      --allow-http) ALLOW_HTTP=1; shift ;;\n      --header|--header-env|--timeout|--config|--stdio|-o|--env)\n        [ $# -ge 2 ] && [ -n \"$2\" ] || { bad \"Missing value for $1.\"; return 1; }\n        case \"$1\" in\n          --header) HEADERS+=(\"$2\") ;;\n          --header-env)\n            local hn=\"${2%%=*}\" en=\"${2#*=}\"\n            [[ \"$en\" =~ ^[A-Za-z_][A-Za-z_0-9]*$ ]] && [[ \"$hn\" =~ ^[A-Za-z0-9-]+$ ]] || { bad \"Use --header-env Header=ENV_NAME.\"; return 1; }\n            [ -n \"${!en:-}\" ] || { bad \"Required header environment variable is unset.\"; return 1; }\n            HEADERS+=(\"$hn: ${!en}\") ;;\n          --timeout) TIMEOUT=\"$2\" ;; --config) CONFIG=\"$2\" ;; --stdio) STDIO=\"$2\" ;; -o) PREFIX=\"$2\" ;; --env) STDIO_ENV+=(\"$2\") ;;\n        esac","tokenCount":207}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, configuration\n\n      --allow-http) ALLOW_HTTP=1; shift ;;\n      --header|--header-env|--timeout|--config|--stdio|-o|--env)\n        [ $# -ge 2 ] && [ -n \"$2\" ] || { bad \"Missing value for $1.\"; return 1; }\n        case \"$1\" in\n          --header) HEADERS+=(\"$2\") ;;\n          --header-env)\n            local hn=\"${2%%=*}\" en=\"${2#*=}\"\n            [[ \"$en\" =~ ^[A-Za-z_][A-Za-z_0-9]*$ ]] && [[ \"$hn\" =~ ^[A-Za-z0-9-]+$ ]] || { bad \"Use --header-env Header=ENV_NAME.\"; return 1; }\n            [ -n \"${!en:-}\" ] || { bad \"Required header environment variable is unset.\"; return 1; }\n            HEADERS+=(\"$hn: ${!en}\") ;;\n          --timeout) TIMEOUT=\"$2\" ;; --config) CONFIG=\"$2\" ;; --stdio) STDIO=\"$2\" ;; -o) PREFIX=\"$2\" ;; --env) STDIO_ENV+=(\"$2\") ;;\n        esac","content":"      --allow-http) ALLOW_HTTP=1; shift ;;\n      --header|--header-env|--timeout|--config|--stdio|-o|--env)\n        [ $# -ge 