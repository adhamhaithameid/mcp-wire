{"version":1,"chunks":[{"id":"chunk_f7b5b2257bb110a3","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\n      jq -n --argjson ok \"$dok\" '{ok:($ok==1),dependencies:[\"bash\",\"curl\",\"jq\",\"base64\"]}'\n      return\n    fi ;;\n  esac\n  if [ -z \"$STDIO\" ]; then target=\"$1\"; shift; fi\n  case \"$target\" in @*) target=\"${target#@}\";; esac\n  if [ -n \"$target\" ]; then\n    case \"$target\" in\n      http://*|https://*) URL=\"$target\" ;;\n      *)\n        [ -f \"$CONFIG\" ] || { bad \"Unknown server. Pass a URL or create a named server in servers.json.\"; return 1; }\n        local entry","tokenCount":139}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\n      jq -n --argjson ok \"$dok\" '{ok:($ok==1),dependencies:[\"bash\",\"curl\",\"jq\",\"base64\"]}'\n      return\n    fi ;;\n  esac\n  if [ -z \"$STDIO\" ]; then target=\"$1\"; shift; fi\n  case \"$target\" in @*) target=\"${target#@}\";; esac\n  if [ -n \"$target\" ]; then\n    case \"$target\" in\n      http://*|https://*) URL=\"$target\" ;;\n      *)\n        [ -f \"$CONFIG\" ] || { bad \"Unknown server. Pass a URL or create a named server in servers.json.\"; return 1; }\n        local entry","content":"      jq -n --argjson ok \"$dok\" '{ok:($ok==1),dependencies:[\"bash\",\"curl\",\"jq\",\"base64\"]}'\n      return\n    fi ;;\n  esac\n  if [ -z \"$STDIO\" ]; then target=\"$1\"; shift; fi\n  case \"$target\" in @*) target=\"${target#@}\";; esac\n  if [ -n \"$target\" ]; then\n    case \"$target\" in\n      http://*|https://*) URL=\"$target\" ;;\n      *)\n        [ -f \"$CONFIG\" ] || { bad \"Unknown server. Pass a URL or create a named server in servers.json.\"; return 1; }\n        local entry","contentHash":"b6d50b97df82b3a3","metadata":{"filePath":"engine/mcp-wire.sh","startLine":385,"endLine":396,"chunkType":"function_definition","name":"main","language":"bash","hash":