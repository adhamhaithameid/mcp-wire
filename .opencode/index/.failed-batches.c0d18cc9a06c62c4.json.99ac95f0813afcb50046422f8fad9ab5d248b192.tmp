{"version":1,"chunks":[{"id":"chunk_1a821b104d0581b4","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: caching, HTTP/API, data parsing, state management\n\n          # parse flags\n          local allow_http=0 store_literal=0 headers=()\n          while [ $# -gt 0 ]; do\n            case \"$1\" in\n              --header) headers+=(\"$2\"); shift 2 ;;\n              --allow-http) allow_http=1; shift ;;\n              --store-literal) store_literal=1; shift ;;\n              *) bad \"Unknown flag $1\"; return 1 ;;\n            esac\n          done\n          [[ \"$name\" =~ ^[A-Za-z0-9_.-]+$ ]] || { bad \"Invalid server name.\"; return 1; }\n          case \"$url\" in http://*|https://*) : ;; *) bad \"URL must start with http:// or https://.\"; return 1 ;; esac","tokenCount":173}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: caching, HTTP/API, data parsing, state management\n\n          # parse flags\n          local allow_http=0 store_literal=0 headers=()\n          while [ $# -gt 0 ]; do\n            case \"$1\" in\n              --header) headers+=(\"$2\"); shift 2 ;;\n              --allow-http) allow_http=1; shift ;;\n              --store-literal) store_literal=1; shift ;;\n              *) bad \"Unknown flag $1\"; return 1 ;;\n            esac\n          done\n          [[ \"$name\" =~ ^[A-Za-z0-9_.-]+$ ]] || { bad \"Invalid server name.\"; return 1; }\n          case \"$url\" in http://*|https://*) : ;; *) bad \"URL must start with http:// or https://.\"; return 1 ;; esac","content":"          # parse flags\n          local allow_http=0 store_literal=0 headers=()\n          while [ $# -gt 0 ]; do\n            case \"$1\" in\n              --header) headers+=(\"$2\"); shift 2 ;;\n              --allow-http) allow_http=1; shift ;;\n              --store-literal) store_literal=1; shift ;;\n              *) bad \"Unknown flag $1\"; return 1 ;;\n            esac\n          done\n          [[ \"$name\" =~ ^[A-Za-z0