{"version":1,"chunks":[{"id":"chunk_0e731554c613ac55","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: placeholder(), data parsing\n\n      echo 'example:'\n      jq -c --argjson req \"$(jq -c '.inputSchema.required // []' <<<\"$tdata\")\" --argjson props \"$props\" '\n        def placeholder($t):\n          if $t == \"string\" then \"...\"\n          elif ($t == \"number\" or $t == \"integer\") then 0\n          elif $t == \"boolean\" then false\n          elif $t == \"array\" then []\n          else {} end;\n        (reduce $req[] as $k ({}; .[$k] = placeholder((($props[$k].type // \"string\") | if type==\"array\" then (.[0] // \"string\") else . end)))) as $ex |\n        if ($req|length)==0 then \"{}\" else ($ex|tojson) end\n      ' -n\n      ;;","tokenCount":167}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: placeholder(), data parsing\n\n      echo 'example:'\n      jq -c --argjson req \"$(jq -c '.inputSchema.required // []' <<<\"$tdata\")\" --argjson props \"$props\" '\n        def placeholder($t):\n          if $t == \"string\" then \"...\"\n          elif ($t == \"number\" or $t == \"integer\") then 0\n          elif $t == \"boolean\" then false\n          elif $t == \"array\" then []\n          else {} end;\n        (reduce $req[] as $k ({}; .[$k] = placeholder((($props[$k].type // \"string\") | if type==\"array\" then (.[0] // \"string\") else . end)))) as $ex |\n        if ($req|length)==0 then \"{}\" else ($ex|tojson) end\n      ' -n\n      ;;","content":"      echo 'example:'\n      jq -c --argjson req \"$(jq -c '.inputSchema.required // []' <<<\"$tdata\")\" --argjson props \"$props\" '\n        def placeholder($t):\n          if $t == \"string\" then \"...\"\n          elif ($t == \"number\" or $t == \"integer\") then 0\n          elif $t == \"boolean\" then false\n          elif $t == \"array\" then []\n          else {} end;\n        (reduce $req[] as $k ({}; .[$k] = placeholder((($props[$k].type // 