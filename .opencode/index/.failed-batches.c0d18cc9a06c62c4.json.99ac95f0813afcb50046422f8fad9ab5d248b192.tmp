{"version":1,"chunks":[{"id":"chunk_97205fc7c954c83a","texts":[{"text":"bash function \"main\"\nin figma-pages/scripts/mcp-wire.sh\nPurpose: error handling, HTTP/API, data parsing\n\n          params=$(jq -nc --arg name \"$2\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" and all($a[];type==\"string\") then {name:$name,arguments:$a} else error(\"string arguments required\") end' 2>/dev/null) || { bad \"Prompt arguments must be a JSON object of strings.\"; return 1; } ;;\n        *) bad \"Use prompts list or get <name>.\"; return 1 ;;\n      esac ;;\n    raw)\n      body=\"${1:-}\"\n      jq -e 'type==\"object\" and .jsonrpc==\"2.0\" and (.method|type)==\"string\" and has(\"id\") and (.id != null)' <<<\"$body\" >/dev/null 2>&1 || { bad \"raw requires a JSON-RPC request with an ID.\"; return 1; } ;;\n    *) bad \"Unknown command. Use --help.\"; return 1 ;;\n  esac\n  [ \"$cmd\" = raw ] || body=$(jq -nc --arg m \"$method\" --argjson p \"$params\" '{jsonrpc:\"2.0\",id:2,method:$m,params:$p}')\n  if [ \"$DRY_RUN\" -eq 1 ]; then\n    jq -n --arg transport \"$(if [ -n \"$STDIO\" ]; then echo stdio; else echo http; fi)\" --arg method \"$(jq -r .method <<<\"$body\")\" '{dryRun:true,transport:$transport,method:$method}'\n    return","tokenCount":278}],"storageText":"bash function \"main\"\nin figma-pages/scripts/mcp-wire.sh\nPurpose: error handling, HTTP/API, data parsing\n\n          params=$(jq -nc --arg name \"$2\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" and all($a[];type==\"string\") then {name:$name,arguments:$a} else error(\"string arguments required\") end' 2>/dev/null) || { bad \"Prompt arguments must be a JSON object of strings.\"; return 1; } ;;\n        *) bad \"Use prompts list or get <name>.\"; return 1 ;;\n      esac ;;\n    raw)\n      body=\"${1:-}\"\n      jq -e 'type==\"object\" and .jsonrpc==\"2.0\" and (.method|type)==\"string\" and has(\"id\") and (.id != null)' <<<\"$body\" >/dev/null 2>&1 || { bad \"raw requires a JSON-RPC request with an ID.\"; return 1; } ;;\n    *) bad \"Unknown command. Use --help.\"; return 1 ;;\n  esac\n  [ \"$cmd\" = raw ] || body=$(jq -nc --arg m \"$method\" --argjson p \"$params\" '{jsonrpc:\"2.0\",id:2,method:$m,params:$p}')\n  if [ \"$DRY_RUN\" -eq 1 ]; then\n    jq -n --arg transport \"$(if [ -n \"$STDIO\" ]; then echo stdio; else echo http; fi)\" --arg method \"$(jq -r .method <<<\"$body\")\" '{dryRun:true,transport:$transport,method:$method}'\n    return","content":"          params=$(jq -nc --arg name \"$2\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" and all($a[];type==\"string\") then {name:$name,arguments:$a} else error(\"string arguments required\") end' 2>/dev/null) || { bad \"Prompt arguments must be a JSON object of strings.\"; return 1; } ;;\n        *) bad \"Use prompts list or get <name>.\"; return 1 ;;\n      esac ;;\n    raw)\n      body=\"${1:-}\"\n      jq -e 'type==\"object\" and .jsonrpc==\"2.0\" and (.method|type)==\"string\" and has(\"id\") and (.id != null)' <<<\"$body\" >/dev/null 2>&1 || { bad \"raw requires a JSON-RPC request with an ID.\"; return 1; } ;;\n    *) bad \"Unknown command. Use --help.\"; return 1 ;;\n  esac\n  [ \"$cmd\" = raw ] || body=$(jq -nc --arg m \"$method\" --argjson p \"$params\" '{jsonrpc:\"2.0\",id:2,method:$m,params:$p}')\n  if [ \"$DRY_RUN\" -eq 1 ]; then\n    jq -n --arg transport \"$(if [ -n \"$STDIO\" ]; then echo stdio; else echo http; fi)\" --arg method \"$(jq -r .method <<<\"$body\")\" '{dryRun:true,transport:$transport,method:$method}'\n    return","contentHash":"27112073cc115cae","metadata":{"filePath":"skills/figma-pages/scripts/mcp-wire.sh","startLine":458,"endLine":469,"chunkType":"function_definition","name":"main","language":"bash","hash":"27112073cc115cae"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":22,"lastAttempt":"2026-10-17T11:47:11.054Z"}
{"version":1,"chunks":[{"id":"chunk_19f8cf466ebcb662","texts":[{"text":"bash function \"main\"\nin figma-pages/scripts/mcp-wire.sh\nPurpose: HTTP/API, file operations\n\n  if [ \"$DRY_RUN\" -eq 1 ]; then\n    jq -n --arg transport \"$(if [ -n \"$STDIO\" ]; then echo stdio; else echo http; fi)\" --arg method \"$(jq -r .method <<<\"$body\")\" '{dryRun:true,transport:$transport,method:$method}'\n    return\n  fi\n  umask 077\n  WORK=$(mktemp -d) || return 1\n  HEADERS_FILE=\"$WORK/headers.txt\"\n  : > \"$HEADERS_FILE\"\n  for _h in \"${HEADERS[@]+\"${HEADERS[@]}\"}\"; do printf '%s\\n' \"$_h\" >> \"$HEADERS_FILE\"; done\n  chmod 600 \"$HEADERS_FILE\"\n  connect || return 1\n  data=$(request_all \"$body\" \"$key\") || return 1","tokenCount":154}],"storageText":"bash function \"main\"\nin figma-pages/scripts/mcp-wire.sh\nPurpose: HTTP/API, file operations\n\n  if [ \"$DRY_RUN\" -eq 1 ]; then\n    jq -n --arg transport \"$(if [ -n \"$STDIO\" ]; then echo stdio; else echo http; fi)\" --arg method \"$(jq -r .method <<<\"$body\")\" '{dryRun:true,transport:$transport,method:$method}'\n    return\n  fi\n  umask 077\n  WORK=$(mktemp -d) || return 1\n  HEADERS_FILE=\"$WORK/headers.txt\"\n  : > \"$HEADERS_FILE\"\n  for _h in \"${HEADERS[@]+\"${HEADERS[@]}\"}\"; do printf '%s\\n' \"$_h\" >> \"$HEADERS_FILE\"; done\n  chmod 600 \"$HEADERS_FILE\"\n  connect || return 1\n  data=$(request_all \"$body\" \"$key\") || return 1","content":"  if [ \"$DRY_RUN\" -eq 1 ]; then\n    jq -n --arg transport \"$(if [ -n \"$STDIO\" ]; then echo stdio; else echo http; fi)\" --arg method \"$(jq -r .method <<<\"$body\")\" '{dryRun:true,transport:$transport,method:$method}'\n    return\n  fi\n  umask 077\n  WORK=$(mktemp -d) || return 1\n  HEADERS_FILE=\"$WORK/headers.txt\"\n  : > \"$HEADERS_FILE\"\n  for _h in \"${HEADERS[@]+\"${HEADERS[@]}\"}\"; do printf '%s\\n' \"$_h\" >> \"$HEADERS_FILE\"; done\n  chmod 600 \"$HEADERS_FILE\"\n  connect || return 1\n  data=$(request_all \"$body\" \"$key\") || return 1","contentHash":"b87a5712f42c82dd","metadata":{"filePath":"skills/figma-pages/scripts/mcp-wire.sh","startLine":467,"endLine":478,"chunkType":"function_definition","name":"main","language":"bash","hash":"b87a5712f42c82dd"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":22,"lastAttempt":"2026-10-17T11:47:11.054Z"}
{"version":1,"chunks":[{"id":"chunk_2421bc9df9bdf9a6","texts":[{"text":"bash block\nin scripts/eval-routing.sh\nPurpose: validation, HTTP/API, data parsing, testing, configuration\n\n#!/usr/bin/env bash\nset -u\nROOT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"\ncd \"$ROOT\"\npython3 - <<'PY'\nimport json\np=\"evals/routing.jsonl\"\nn=0\nfor line in open(p):\n    line=line.strip()\n    if not line: continue\n    o=json.loads(line)\n    assert \"prompt\" in o and \"expected\" in o\n    n+=1\nprint(\"validated\", n, \"prompts\")\nPY\nif [ -n \"${ANTHROPIC_API_KEY:-}\" ]; then echo \"model step would run\"; else echo \"no API key; skipping model step (exit 0)\"; fi\nexit 0","tokenCount":144}],"storageText":"bash block\nin scripts/eval-routing.sh\nPurpose: validation, HTTP/API, data parsing, testing, configuration\n\n#!/usr/bin/env bash\nset -u\nROOT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"\ncd \"$ROOT\"\npython3 - <<'PY'\nimport json\np=\"evals/routing.jsonl\"\nn=0\nfor line in open(p):\n    line=line.strip()\n    if not line: continue\n    o=json.loads(line)\n    assert \"prompt\" in o and \"expected\" in o\n    n+=1\nprint(\"validated\", n, \"prompts\")\nPY\nif [ -n \"${ANTHROPIC_API_KEY:-}\" ]; then echo \"model step would run\"; else echo \"no API key; skipping model step (exit 0)\"; fi\nexit 0","content":"#!/usr/bin/env bash\nset -u\nROOT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"\ncd \"$ROOT\"\npython3 - <<'PY'\nimport json\np=\"evals/routing.jsonl\"\nn=0\nfor line in open(p):\n    line=line.strip()\n    if not line: continue\n    o=json.loads(line)\n    assert \"prompt\" in o and \"expected\" in o\n    n+=1\nprint(\"validated\", n, \"prompts\")\nPY\nif [ -n \"${ANTHROPIC_API_KEY:-}\" ]; then echo \"model step would run\"; else echo \"no API key; skipping model step (exit 0)\"; fi\nexit 0","contentHash":"07cc4e2af1d29b46","metadata":{"filePath":"scripts/eval-routing.sh","startLine":1,"endLine":18,"chunkType":"block","lang