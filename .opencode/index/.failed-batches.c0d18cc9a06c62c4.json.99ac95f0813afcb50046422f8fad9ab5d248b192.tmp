{"version":1,"chunks":[{"id":"chunk_60b49cbb20152d52","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: file operations, configuration\n\n          ok \"added $name\"\n          return 0 ;;\n        rm)\n          local name=\"${1:-}\"\n          [ -f \"$CONFIG\" ] || { bad \"No registry.\"; return 1; }\n          jq --arg name \"$name\" 'del(.servers[$name])' \"$CONFIG\" > \"$CONFIG.tmp\" && mv \"$CONFIG.tmp\" \"$CONFIG\"\n          ok \"removed $name\"\n          return 0 ;;\n        *) bad \"Use servers add|list|rm|path.\"; return 1 ;;\n      esac\n      return ;;\n    doctor) doctor=1; shift; if [ $# -eq 0 ]; then","tokenCount":135}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: file operations, configuration\n\n          ok \"added $name\"\n          return 0 ;;\n        rm)\n          local name=\"${1:-}\"\n          [ -f \"$CONFIG\" ] || { bad \"No registry.\"; return 1; }\n          jq --arg name \"$name\" 'del(.servers[$name])' \"$CONFIG\" > \"$CONFIG.tmp\" && mv \"$CONFIG.tmp\" \"$CONFIG\"\n          ok \"removed $name\"\n          return 0 ;;\n        *) bad \"Use servers add|list|rm|path.\"; return 1 ;;\n      esac\n      return ;;\n    doctor) doctor=1; shift; if [ $# -eq 0 ]; then","content":"          ok \"added $name\"\n          return 0 ;;\n        rm)\n          local name=\"${1:-}\"\n          [ -f \"$CONFIG\" ] || { bad \"No registry.\"; return 1; }\n          jq --arg name \"$name\" 'del(.servers[$name])' \"$CONFIG\" > \"$CONFIG.tmp\" && mv \"$CONFIG.tmp\" \"$CONFIG\"\n          ok \"removed $name\"\n          return 0 ;;\n        *) bad \"Use servers add|list|rm|path.\"; return 1 ;;\n      esac\n      return ;;\n    doctor) doctor=1; shift; if [ $# -eq 0 ]; then","contentHash":"0f8174564be89499","metadata":{"filePath":"engine/mcp-wire.sh","startLine":367,"endLine":378,"chunkType":"function_definition","name":"main","language":"bash","hash":"0f8174564be89499"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":2,"lastAttempt":"2026-10-17T11:47:10.962Z"}
