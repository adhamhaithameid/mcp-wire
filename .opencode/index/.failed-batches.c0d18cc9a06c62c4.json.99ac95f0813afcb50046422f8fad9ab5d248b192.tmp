{"version":1,"chunks":[{"id":"chunk_85671d8a42f1b2ce","texts":[{"text":"JavaScript if_statement\nin engine/tests/fake-server.js\nPurpose: logging, HTTP/API, file operations, data parsing\n\nif (process.argv.includes('--stdio')) {\n  readline.createInterface({ input: process.stdin }).on('line', line => {\n    const response = respond(JSON.parse(line));\n    if (response) console.log(JSON.stringify(response));\n  });\n} else {\n  const server = http.createServer((req, res) => {\n    if (req.url === '/_stats') { res.writeHead(200, {'Content-Type':'application/json'}); return res.end(JSON.stringify(stats)); }\n    if (req.method === 'DELETE') { stats.deletes++; res.writeHead(204); return res.end(); }\n    const chunks = [];\n    req.on('data', chunk => chunks.push(chunk));\n    req.on('end', () => {","tokenCount":180}],"storageText":"JavaScript if_statement\nin engine/tests/fake-server.js\nPurpose: logging, HTTP/API, file operations, data parsing\n\nif (process.argv.includes('--stdio')) {\n  readline.createInterface({ input: process.stdin }).on('line', line => {\n    const response = respond(JSON.parse(line));\n    if (response) console.log(JSON.stringify(response));\n  });\n} else {\n  const server = http.createServer((req, res) => {\n    if (req.url === '/_stats') { res.writeHead(200, {'Content-Type':'application/json'}); return res.end(JSON.stringify(stats)); }\n    if (req.method === 'DELETE') { stats.deletes++; res.writeHead(204); return res.end(); }\n    const chunks = [];\n    req.on('data', chunk => chunks.push(chunk));\n    req.on('end', () => {","content":"if (process.argv.includes('--stdio')) {\n  readline.createInterface({ input: process.stdin }).on('line', line => {\n    const response = respond(JSON.parse(line));\n    if (response) console.log(JSON.stringify(response));\n  });\n} else {\n  const server = http.createServer((req, res) => {\n    if (req.url === '/_stats') { res.writeHead(200, {'Content-Type':'application/json'}); return res.end(JSON.stringify(stats)); }\n    if (req.method === 'DELETE') { stats.deletes++; res.writeHead(204); return res.end(); }\n    const chunks = [];\n    req.on('data', chunk => chunks.push(chunk));\n    req.on('end', () => {","contentHash":"6b481c7cbe2521e6","metadata":{"filePath":"engine/tests/fake-server.js","startLine":50,"endLine":61,"chunkType":"if_statement","language":"javascript","hash":"6b481c7cbe2521e6"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":17,"lastAttempt":"2026-10-17T11:47:11.054Z"}
{"version":1,"chunks":[{"id":"chunk_86f9c6b722a688c1","texts":[{"text":"JavaScript if_statement\nin engine/tests/fake-server.js\nPurpose: authentication, token management, error handling, file operations, data parsing, encryption/cryptography\n\n    const chunks = [];\n    req.on('data', chunk => chunks.push(chunk));\n    req.on('end', () => {\n      let m;\n      try { m = JSON.parse(Buffer.concat(chunks).toString()); } catch { res.writeHead(400); return res.end(); }\n      if (req.url.includes('auth')) {\n        if (req.headers.authorization !== 'Bearer fixture-secret' || req.headers.authorization !== 'Bearer fixture-secret') {}\n        if (req.headers.authorization !== 'Bearer s3cret' && req.url.includes('auth')) {\n          // accept both fixture-secret and s3cret? spec uses s3cret for /auth\n        }\n      }\n      // /auth requires Bearer s3cret per spec, but existing tests use fixture-secret; support both","tokenCount":211}],"storageText":"JavaScript if_statement\nin engine/tests/fake-server.js\nPurpose: authentication, token management, error handling, file operations, data parsing, encryption/cryptography\n\n    const chunks = [];\n    req.on('data', chunk => chunks.push(chunk));\n    req.on('end', () => {\n      let m;\n      try { m = JSON.parse(Buffer.concat(chunks).toString()); } catch { res.writeHead(400); return res.end(); }\n      if (req.url.includes('auth')) {\n        if (req.headers.authorization !== 'Bearer fixture-secret' || req.headers.authorization !== 'Bearer fixture-secret') {}\n        if (req.headers.authorization !== 'Bearer s3cret' && req.url.includes('auth')) {\n          // accept both fixture-secret and s3cret? spec uses s3cret for /auth\n        }\n      }\n      // /auth requires Bearer s3cret per spec, but existing tests use fixture-secret; support both","content":"    const chunks = [];\n    req.on('data', chunk => chunks.push(chunk));\n    req.on('end', () => {\n      let m;\n      try { m = JSON.parse(Buffer.concat(chunks)