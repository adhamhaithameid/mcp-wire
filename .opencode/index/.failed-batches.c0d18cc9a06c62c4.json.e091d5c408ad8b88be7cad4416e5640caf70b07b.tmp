{"version":1,"chunks":[{"id":"chunk_cfd83322b67d07f6","texts":[{"text":"bash function \"main\"\nin figma-design/scripts/mcp-wire.sh\nPurpose: configuration\n\n            HEADERS+=(\"$hn: ${!en}\") ;;\n          --timeout) TIMEOUT=\"$2\" ;; --config) CONFIG=\"$2\" ;; --stdio) STDIO=\"$2\" ;; -o) PREFIX=\"$2\" ;;\n        esac\n        shift 2 ;;\n      --header=*) HEADERS+=(\"${1#--header=}\"); shift ;;\n      --timeout=*) TIMEOUT=\"${1#--timeout=}\"; shift ;;\n      -o=*) PREFIX=\"${1#-o=}\"; shift ;;\n      -h|--help) usage; return 0 ;;\n      --version|-V) echo \"mcp-wire $VERSION\"; return 0 ;;\n      -) args+=(\"$1\"); shift ;;\n      -*) bad \"Unknown flag. Use --help.\"; return 1 ;;\n      *) args+=(\"$1\"); shift ;;","tokenCount":155}],"storageText":"bash function \"main\"\nin figma-design/scripts/mcp-wire.sh\nPurpose: configuration\n\n            HEADERS+=(\"$hn: ${!en}\") ;;\n          --timeout) TIMEOUT=\"$2\" ;; --config) CONFIG=\"$2\" ;; --stdio) STDIO=\"$2\" ;; -o) PREFIX=\"$2\" ;;\n        esac\n        shift 2 ;;\n      --header=*) HEADERS+=(\"${1#--header=}\"); shift ;;\n      --timeout=*) TIMEOUT=\"${1#--timeout=}\"; shift ;;\n      -o=*) PREFIX=\"${1#-o=}\"; shift ;;\n      -h|--help) usage; return 0 ;;\n      --version|-V) echo \"mcp-wire $VERSION\"; return 0 ;;\n      -) args+=(\"$1\"); shift ;;\n      -*) bad \"Unknown flag. Use --help.\"; return 1 ;;\n      *) args+=(\"$1\"); shift ;;","content":"            HEADERS+=(\"$hn: ${!en}\") ;;\n          --timeout) TIMEOUT=\"$2\" ;; --config) CONFIG=\"$2\" ;; --stdio) STDIO=\"$2\" ;; -o) PREFIX=\"$2\" ;;\n        esac\n        shift 2 ;;\n      --header=*) HEADERS+=(\"${1#--header=}\"); shift ;;\n      --timeout=*) TIMEOUT=\"${1#--timeout=}\"; shift ;;\n      -o=*) PREFIX=\"${1#-o=}\"; shift ;;\n      -h|--help) usage; return 0 ;;\n      --version|-V) echo \"mcp-wire $VERSION\"; return 0 ;;\n      -) args+=(\"$1\"); shift ;;\n      -*) bad \"Unknown flag. Use --help.\"; return 1 ;;\n      *) args+=(