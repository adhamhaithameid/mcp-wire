{"version":1,"chunks":[{"id":"chunk_3bb2036b2301d9d3","texts":[{"text":"bash function \"main\"\nin figma-design/scripts/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\n          [ -n \"${!envname:-}\" ] || { bad \"Required header environment variable is unset.\"; return 1; }\n          [[ \"${!envname}\" != *$'\\r'* && \"${!envname}\" != *$'\\n'* ]] || { bad \"Header values cannot contain line breaks.\"; return 1; }\n          HEADERS+=(\"$headername: ${!envname}\")\n        done < <(jq -r '.headerEnv // {} | to_entries[] | [.key,.value] | @tsv' <<<\"$entry\") ;;\n    esac\n  fi\n  if [ -n \"$STDIO\" ]; then\n    [ -z \"$URL\" ] || { bad \"Choose one transport: URL or stdio.\"; return 1; }\n    jq -e 'type == \"array\" and length > 0 and all(.[]; type == \"string\" and (contains(\"\\n\")|not) and (contains(\"\\u0000\")|not)) and .[0] != \"\"' <<<\"$STDIO\" >/dev/null 2>&1 || { bad \"--stdio requires a JSON command array.\"; return 1; }\n  else\n    case \"$URL\" in\n      https://*) : ;; http://*) [ \"$ALLOW_HTTP\" -eq 1 ] || { bad \"Refusing plain HTTP. Pass --allow-http for trusted development.\"; return 1; } ;;","tokenCount":254}],"storageText":"bash function \"main\"\nin figma-design/scripts/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\n          [ -n \"${!envname:-}\" ] || { bad \"Required header environment variable is unset.\"; return 1; }\n          [[ \"${!envname}\" != *$'\\r'* && \"${!envname}\" != *$'\\n'* ]] || { bad \"Header values cannot contain line breaks.\"; return 1; }\n          HEADERS+=(\"$headername: ${!envname}\")\n        done < <(jq -r '.headerEnv // {} | to_entries[] | [.key,.value] | @tsv' <<<\"$entry\") ;;\n    esac\n  fi\n  if [ -n \"$STDIO\" ]; then\n    [ -z \"$URL\" ] || { bad \"Choose one transport: URL or stdio.\"; return 1; }\n    jq -e 'type == \"array\" and length > 0 and all(.[]; type == \"string\" and (contains(\"\\n\")|not) and (contains(\"\\u0000\")|not)) and .[0] != \"\"' <<<\"$STDIO\" >/dev/