{"version":1,"chunks":[{"id":"chunk_02ee8d49ad680391","texts":[{"text":"bash function \"cmd_doctor\"\nin figma-code/scripts/figma-wire.sh\nPurpose: validation, file operations, data parsing, configuration\n\n      if [ \"$cfg_url\" != \"$url\" ]; then\n        ensure_config_exists \"$target\" \"$path\"\n        set_local_entry \"$target\" \"$url\" \"$path\" && { [ \"$json_out\" -eq 1 ] || ok \"[${target}] fixed: figma-local -> ${url}\"; }\n      fi\n    fi\n    # re-verify quietly\n    rc=0\n    if [ \"$target\" = \"all\" ]; then\n      for h in $(all_harnesses); do\n        [ -f \"$(harness_config_path \"$h\")\" ] || continue\n        [ \"$(local_entry_url \"$h\" \"$(harness_config_path \"$h\")\")\" = \"$url\" ] || rc=1\n      done","tokenCount":155}],"storageText":"bash function \"cmd_doctor\"\nin figma-code/scripts/figma-wire.sh\nPurpose: validation, file operations, data parsing, configuration\n\n      if [ \"$cfg_url\" != \"$url\" ]; then\n        ensure_config_exists \"$target\" \"$path\"\n        set_local_entry \"$target\" \"$url\" \"$path\" && { [ \"$json_out\" -eq 1 ] || ok \"[${target}] fixed: figma-local -> ${url}\"; }\n      fi\n    fi\n    # re-verify quietly\n    rc=0\n    if [ \"$target\" = \"all\" ]; then\n      for h in $(all_harnesses); do\n        [ -f \"$(harness_config_path \"$h\")\" ] || continue\n        [ \"$(local_entry_url \"$h\" \"$(harness_config_path \"$h\")\")\" = \"$url\" ] || rc=1\n      done","content":"      if [ \"$cfg_url\" != \"$url\" ]; then\n        ensure_config_exists \"$target\" \"$path\"\n        set_local_entry \"$target\" \"$url\" \"$path\" && { [ \"$json_out\" -eq 1 ] || ok \"[${target}] fixed: figma-local -> ${url}\"; }\n      fi\n    fi\n    # re-verify quietly\n    rc=0\n    if [ \"$target\" = \"all\" ]; then\n      for h in $(all_harnesses); do\n        [ -f \"$(harness_config_path \"$h\")\" ] || continue\n        [ \"$(local_entry_url \"$h\" \"$(harness_config_path \"$h\")\")\" = \"$url\" ] || rc=1\n      done","co