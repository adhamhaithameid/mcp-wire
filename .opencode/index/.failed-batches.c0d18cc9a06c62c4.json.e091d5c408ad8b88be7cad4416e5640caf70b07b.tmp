{"version":1,"chunks":[{"id":"chunk_5d5e26ea379bba65","texts":[{"text":"bash function \"main\"\nin figma-design/scripts/mcp-wire.sh\nPurpose: file operations, configuration\n\n          ok \"added $name\"\n          return 0 ;;\n        rm)\n          local name=\"${1:-}\"\n          [ -f \"$CONFIG\" ] || { bad \"No registry.\"; return 1; }\n          jq --arg name \"$name\" 'del(.servers[$name])' \"$CONFIG\" > \"$CONFIG.tmp\" && mv \"$CONFIG.tmp\" \"$CONFIG\"\n          ok \"removed $name\"\n          return 0 ;;\n        *) bad \"Use servers add|list|rm|path.\"; return 1 ;;\n      esac\n      return ;;\n    doctor) doctor=1; shift; if [ $# -eq 0 ]; then","tokenCount":138}],"storageText":"bash function \"main\"\nin figma-design/scripts/mcp-wire.sh\nPurpose: file operations, configuration\n\n          ok \"added $name\"\n          return 0 ;;\n        rm)\n          local name=\"${1:-}\"\n          [ -f \"$CONFIG\" ] || { bad \"No registry.\"; return 1; }\n          jq --arg name \"$name\" 'del(.servers[$name])' \"$CONFIG\" > \"$CONFIG.tmp\" && mv \"$CONFIG.tmp\" \"$CONFIG\"\n          ok \"removed $name\"\n          return 0 ;;\n        *) bad \"Use servers add|list|rm|path.\"; return 1 ;;\n      esac\n      return ;;\n    doctor) doctor=1; shift; if [ $# -eq 0 ]; then","content":"          ok \"added $name\"\n          return 0 ;;\n        rm)\n          local name=\"${1:-}\"\n          [ -f \"$CONFIG\" ] || { bad \"No registry.\"; return 1; }\n          jq --arg name \"$name\" 'del(.servers[$name])' \"$CONFIG\" > \"$CONFIG.tmp\" && mv \"$CONFIG.tmp\" \"$CONFIG\"\n          ok \"removed $name\"\n          return 0 ;;\n        *) bad \"Use servers add|list|rm|path.\"; return 1 ;;\n      esac\n      return ;;\n    doctor) doctor=1; shift; if [ $# -eq 0 ]; then","contentHash":"0f8174564be89499","metadata":{"filePath":"skills/figma-design/scripts/mcp-wire.sh","startLine":359,"endLine":370,"chunkType":"function_definition","name":"main","language":"bash","hash":"0f8174564be89499"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.825Z"}
