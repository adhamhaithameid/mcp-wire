{"version":1,"chunks":[{"id":"chunk_523aecf24d9dbb88","texts":[{"text":"bash function \"main\"\nin figma-wire/scripts/mcp-wire.sh\nPurpose: HTTP/API\n\n  else\n    case \"$URL\" in\n      https://*) : ;; http://*) [ \"$ALLOW_HTTP\" -eq 1 ] || { bad \"Refusing plain HTTP. Pass --allow-http for trusted development.\"; return 1; } ;;\n      *) bad \"Server URL must start with http:// or https://.\"; return 1 ;;\n    esac\n  fi\n  cmd=\"${1:-}\"; [ $# -eq 0 ] || shift\n  [ \"$doctor\" -eq 0 ] || cmd=doctor\n  local method='' params='{}' key='' tool='' body data tool_args='{}'\n  case \"$cmd\" in\n    doctor) method=ping ;;\n    list|describe) method=tools/list; key=tools; tool=\"${1:-}\"; if [ \"$cmd\" = describe ] && [ -z \"$tool\" ]; then bad \"describe requires a tool name.\"; return 1; fi ;;","tokenCount":173}],"storageText":"bash function \"main\"\nin figma-wire/scripts/mcp-wire.sh\nPurpose: HTTP/API\n\n  else\n    case \"$URL\" in\n      https://*) : ;; http://*) [ \"$ALLOW_HTTP\" -eq 1 ] || { bad \"Refusing plain HTTP. Pass --allow-http for trusted development.\"; return 1; } ;;\n      *) bad \"Server URL must start with http:// or https://.\"; return 1 ;;\n    esac\n  fi\n  cmd=\"${1:-}\"; [ $# -eq 0 ] || shift\n  [ \"$doctor\" -eq 0 ] || cmd=doctor\n  local method='' params='{}' key='' tool='' body data tool_args='{}'\n  case \"$cmd\" in\n    doctor) method=ping ;;\n    list|describe) method=tools/list; key=tools; tool=\"${1:-}\"; if [ \"$cmd\" = describe ] && [ -z \"$tool\" ]; then bad \"describe requires a tool name.\"; return 1; fi ;;","content":"  else\n    case \"$URL\" in\n      https://*) : ;; http://*) [ \"$ALLOW_HTTP\" -eq 1 ] || { bad \"Refusing plain HTTP. Pass --allow-http for trusted development.\"; return 1; } ;;\n      *) bad \"Server URL must start with http:// or https://.\"; return 1 ;;\n    esac\n  fi\n  cmd=\"${1:-}\"; [ $# -eq 0 ] || shift\n  [ \"$doctor\" -eq 0 ] || cmd=doctor\n  local method='' params='{}' key='' tool='' body data tool_ar