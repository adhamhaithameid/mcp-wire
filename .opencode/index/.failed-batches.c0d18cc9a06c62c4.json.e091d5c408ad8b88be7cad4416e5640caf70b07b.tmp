{"version":1,"chunks":[{"id":"chunk_12a5abb22f113031","texts":[{"text":"bash function \"main\"\nin figma-wire/scripts/mcp-wire.sh\nPurpose: caching, HTTP/API, data parsing, state management\n\n          # parse flags\n          local allow_http=0 store_literal=0 headers=()\n          while [ $# -gt 0 ]; do\n            case \"$1\" in\n              --header) headers+=(\"$2\"); shift 2 ;;\n              --allow-http) allow_http=1; shift ;;\n              --store-literal) store_literal=1; shift ;;\n              *) bad \"Unknown flag $1\"; return 1 ;;\n            esac\n          done\n          [[ \"$name\" =~ ^[A-Za-z0-9_.-]+$ ]] || { bad \"Invalid server name.\"; return 1; }\n          case \"$url\" in http://*|https://*) : ;; *) bad \"URL must start with http:// or https://.\"; return 1 ;; esac","tokenCount":176}],"storageText":"bash function \"main\"\nin figma-wire/scripts/mcp-wire.sh\nPurpose: caching, HTTP/API, data parsing, state management\n\n          # parse flags\n          local allow_http=0 store_literal=0 headers=()\n          while [ $# -gt 0 ]; do\n            case \"$1\" in\n              --header) headers+=(\"$2\"); shift 2 ;;\n              --allow-http) allow_http=1; shift ;;\n              --store-literal) store_literal=1; shift ;;\n              *) bad \"Unknown flag $1\"; return 1 ;;\n            esac\n          done\n          [[ \"$name\" =~ ^[A-Za-z0-9_.-]+$ ]] || { bad \"Invalid server name.\"; return 1; }\n          case \"$url\" in http://*|https://*) : ;; *) bad \"URL must start with http:// or https://.\"; return 1 ;; esac","content":"          # parse flags\n          local allow_http=0 store_literal=0 headers=()\n          while [ $# -gt 0 ]; do\n            case \"$1\" in\n              --header) headers+=(\"$2\"); shift 2 ;;\n              --allow-http) allow_http=1; shift ;;\n              --store-literal) store_literal=1; shift ;;\n              *) bad \"Unknown flag $1\"; return 1 ;;\n            esac\n          done\n          [[ \"$name\" =~ ^[A-Za-z0-9_.-]+$ ]] || { bad \"Invalid server name.\"; return 1; }\n          case \"$url\" in http://*|https://*) : ;; *) bad \"URL must start with http:// or https://.\"; return 1 ;; esac","contentHash":"a880be0983902e60","metadata":{"filePath":"skills/figma-wire/scripts/mcp-wire.sh","startLine":314,"endLine":325,"chunkType":"function_definition","name":"main","language":"bash","hash":"a880be0983902e60"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.678Z"}
{"version":1,"chunks":[{"id":"chunk_b3efc6d63992e207","texts":[{"text":"bash function \"main\"\nin figma-wire/scripts/mcp-wire.sh\nPurpose: authentication, password handling, token management, caching, HTTP/API, encryption/cryptography\n\n          done\n          [[ \"$name\" =~ ^[A-Za-z0-9_.-]+$ ]] || { bad \"Invalid server name.\"; return 1; }\n          case \"$url\" in http://*|https://*) : ;; *) bad \"URL must start with http:// or https://.\"; return 1 ;; esac\n          # refuse literal credentials\n          local h hname hval\n          for h in \"${headers[@]+\"${headers[@]}\"}\"; do\n            hname=\"${h%%:*}\"; hval=\"${h#*: }\"\n            if [ \"$store_literal\" -eq 0 ]; then\n              if echo \"$hname\" | grep -qiE 'auth|token|key|secret|cookie|password'; then\n                if ! echo \"$hval\" | grep -q '\\${'; then\n                  bad \"Refusing literal credential in header '$hname'. Use \\${ENV_VAR} form, or --store-literal.\"\n                  return 1","tokenCount":222}],"storageText":"bash function \"main\"\nin figma-wire/scripts/mcp-wire.sh\nPurpose: authentication, password handling, token management, caching, HTTP/API, encryption/cryptography\n\n          done\n          [[ \"$name\" =~ ^[A-Za-z0-9_.-]+$ ]] || { bad \"Invalid server name.\"; return 1; }\n          case \"$url\" in http://*|https://*) : ;; *) bad \"URL must start with http:// or https://.\"; return 1 ;; esac\n          # refuse literal credentials\n          local h hname hval\n          for h in \"${headers[@]+\"${headers[@]}\"}\"; do\n            hname=\"${h%%:*}\"; hval=\"${h#*: }\"\n            if [ \"$store_literal\" -eq 0 ]; then\n              if echo \"$hname\" | grep -qiE 'auth|token|key|secret|cookie|password'; then\n                if ! echo \"$hval\" | grep -q '\\${'; then\n                  bad \"Refusing literal credential in header '$hname'. Use \\${ENV_VAR} form, or --store-literal.\"\n                  return 1","content":"          done\n          [[ \"$name\" =~ ^[A-Za-z0-9_.-]+$ ]] || { bad \"Invalid server name.\"; return 1; }\n          case \"$url\" in http://*|https://*) : ;; *) bad \"URL must start with http:// or https://.\"; return 1 ;; esac\n          # refuse literal credentials\n          local h hname hval\n          for h in \"${headers[@]+\"${headers[@]}\"}\"; do\n            hname=\"${h%%:*}\"; hval=\"${h#*: }\"\n            if [ \"$store_literal\" -eq 0 ]; then\n              if echo \"$hname\" | grep -qiE 'auth|token|key|secret|cookie|password'; then\n                if ! echo \"$hval\" | grep -q '\\${'; then\n                  bad \"Refusing literal credential in header '$hname'. Use \\${ENV_VAR} form, or --store-literal.\"\n                  return 1","contentHash":"249e27d6df3ec4e6","metadata":{"filePath":"skills/figma-wire/scripts/mcp-wire.sh","startLine":323,"endLine":334,"chunkType":"function_definition","name":"main","language":"bash","hash":"249e27d6df3ec4e6"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.678Z"}
{"version":1,"chunks":[{"id":"chunk_7b645ee7f6954a47","texts":[{"text":"bash function \"main\"\nin figma-wire/scripts/mcp-wire.sh\nPurpose: authentication, caching, file operations, configuration, state management\n\n                if ! echo \"$hval\" | grep -q '\\${'; then\n                  bad \"Refusing literal credential in header '$hname'. Use \\${ENV_VAR} form, or --store-literal.\"\n                  return 1\n                fi\n              fi\n            fi\n          done\n          # atomic write\n          local dir\n          dir=$(dirname \"$CONFIG\")\n          mkdir -p \"$dir\"; chmod 700 \"$dir\" 2>/dev/null || true\n          local tmpf","tokenCount":142}],"storageText":"bash function \"main\"\nin figma-wire/scripts/mcp-wire.sh\nPurpose: authentication, caching, file operations, configuration, state management\n\n                if ! echo \"$hval\" | grep -q '\\${'; then\n                  bad \"Refusing literal credential in header '$hname'. Use \\${ENV_VAR} form, or --store-literal.\"\n                  return 1\n                fi\n              fi\n            fi\n          done\n          # atomic write\n          local dir\n          dir=$(dirname \"$CONFIG\")\n          mkdir -p \"$dir\"; chmod 700 \"$dir\" 2>/dev/null || true\n          local tmpf","content":"                if ! echo \"$hval\" | grep -q '\\${'; then\n                  bad \"Refusing literal credential in header '$hname'. Use \\${ENV_VAR} form, or --store-literal.\"\n                  return 1\n                fi\n              fi\n            fi\n          done\n          # atomic write\n          local dir\n          dir=$(dirname \"$CONFIG\")\n          mkdir -p \"$dir\"; chmod 700 \"$dir\" 2>/dev/null || true\n          local tmpf","contentHash":"0392535aaec6e751","metadata":{"filePath":"skills/figma-wire/scripts/mcp-wire.sh","startLine":332,"endLine":343,"chunkType":"function_definition","name":"main","language":"bash","hash":"0392535aaec6e751"}}],"error":"Google 