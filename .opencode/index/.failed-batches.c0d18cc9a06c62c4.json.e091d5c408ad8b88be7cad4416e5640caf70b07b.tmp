{"version":1,"chunks":[{"id":"chunk_4b24ae334017f5d3","texts":[{"text":"bash function \"main\"\nin figma-design/scripts/mcp-wire.sh\nPurpose: HTTP/API, file operations\n\n  chmod 600 \"$HEADERS_FILE\"\n  connect || return 1\n  data=$(request_all \"$body\" \"$key\") || return 1\n  case \"$cmd\" in\n    doctor) jq -n --arg t \"$TRANSPORT\" --arg r \"$REPLY\" '{ok:true,initialized:true,ping:true,transport:$t,reply:$r}' ;;\n    describe)\n      local tdata\n      tdata=$(jq -ec --arg t \"$tool\" '.result.tools[] | select(.name==$t)' <<<\"$data\") || {\n        bad \"Tool not found. Available tools: $(jq -r '.result.tools[].name' <<<\"$data\" | head -20 | tr '\\n' ' ')\"\n        return 1\n      }\n      jq -r '.name' <<<\"$tdata\"","tokenCount":156}],"storageText":"bash function \"main\"\nin figma-design/scripts/mcp-wire.sh\nPurpose: HTTP/API, file operations\n\n  chmod 600 \"$HEADERS_FILE\"\n  connect || return 1\n  data=$(request_all \"$body\" \"$key\") || return 1\n  case \"$cmd\" in\n    doctor) jq -n --arg t \"$TRANSPORT\" --arg r \"$REPLY\" '{ok:true,initialized:true,ping:true,transport:$t,reply:$r}' ;;\n    describe)\n      local tdata\n      tdata=$(jq -ec --arg t \"$tool\" '.result.tools[] | select(.name==$t)' <<<\"$data\") || {\n        bad \"Tool not found. Available tools: $(jq -r '.result.tools[].name' <<<\"$data\" | head -20 | tr '\\n' ' ')\"\n        return 1\n      }\n      jq -r '.name' <<<\"$tdata\"","content":"  chmod 600 \"$HEADERS_FILE\"\n  connect || return 1\n  data=$(request_all \"$body\" \"$key\") || return 1\n  case \"$cmd\" in\n    doctor) jq -n --arg t \"$TRANSPORT\" --arg r \"$REPLY\" '{ok:true,initialized:true,ping:true,transport:$t,reply:$r}' ;;\n    describe)\n      local tdata\n      tdata=$(jq -ec --arg t \"$tool\" '.result.tools[] | select(.name==$t)' <<<\"$data\") || {\n        bad \"Tool not found. Available tools: $(jq -r '.result.tools[].name' <<<\"$data\" | head -20 | tr '\\n' ' ')\"\n        return 1\n      }\n      jq -r '.name' <<<\"$tdata\"","contentHash":"f5771f3b951d25ad","metadata":{"filePath":"skills/figma-design/scripts/mcp-wire.sh","startLine":476,"endLine":487,"chunkType":"function_definition","name":"main","language":"bash","hash":"f5771f3b951d25ad"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.825Z"}
{"version":1,"chunks":[{"id":"chunk_29b090ab739f42c0","texts":[{"text":"bash function \"main\"\nin figma-design/scripts/mcp-wire.sh\nPurpose: data parsing\n\n        return 1\n      }\n      jq -r '.name' <<<\"$tdata\"\n      jq -r '.description // empty' <<<\"$tdata\"\n      echo 'arguments:'\n      local props\n      props=$(jq -c '.inputSchema.properties // {}' <<<\"$tdata\")\n      if [ \"$(jq 'length' <<<\"$props\")\" -eq 0 ]; then echo '  (none)'; else\n        jq -r --argjson req \"$(jq -c '.inputSchema.required // []' <<<\"$tdata\")\" '\n          def tstr: if type == \"array\" then (map(tostring)|join(\"|\")) else tostring end;\n          to_entries[] |\n          \"  \" + .key + \" (\" + ((.value.type // \"any\") | tstr) + (if (.key as $k | $req | index($k)) then \", required\" else \"\" end) + \") — \" + (.value.description // \"\")","tokenCount":184}],"storageText":"bash function \"main\"\nin figma-design/scripts/mcp-wire.sh\nPurpose: data parsing\n\n        return 1\n      }\n      jq -r '.name' <<<\"$tdata\"\n      jq -r '.description // empty' <<<\"$tdata\"\n      echo 'arguments:'\n      local props\n      props=$(jq -c '.inputSchema.properties // {}' <<<\"$tdata\")\n      if [ \"$(jq 'length' <<<\"$props\")\" -eq 0 ]; then echo '  (none)'; else\n        jq -r --argjson req \"$(jq -c '.inputSchema.required // []' <<<\"$tdata\")\" '\n          def tstr: if type == \"array\" then (map(tostring)|join(\"|\")) else tostring end;\n          to_entries[] |\n          \"  \" + .key + \" (\" + ((.value.type // \"any\") | tstr) + (if (.key as $k | $req | index($k)) then \", required\" else \"\" end) + \") — \" + (.value.description // \"\")","content":"        return 1\n      }\n      jq -r '.name' <<<\"$tdata\"\n      jq -r '.description // empty' <<<\"$tdata\"\n      echo 'arguments:'\n      local props\n      props=$(jq -c '.inputSchema.properties // {}' <<<\"$tdata\")\n      if [ \"$(jq 'length' <<<\"$props\")\" -eq 0 ]; then echo '  (none)'; else\n       