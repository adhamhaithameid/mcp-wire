{"version":1,"chunks":[{"id":"chunk_ccb507e269d0e2b2","texts":[{"text":"bash function \"main\"\nin figma-wire/scripts/mcp-wire.sh\nPurpose: file operations\n\n  case \"$cmd\" in\n    doctor) method=ping ;;\n    list|describe) method=tools/list; key=tools; tool=\"${1:-}\"; if [ \"$cmd\" = describe ] && [ -z \"$tool\" ]; then bad \"describe requires a tool name.\"; return 1; fi ;;\n    call)\n      method=tools/call; tool=\"${1:-}\"; [ -n \"$tool\" ] || { bad \"call requires a tool name.\"; return 1; }; shift\n      if [ $# -gt 0 ]; then\n        case \"$1\" in\n          -) tool_args=$(cat); shift ;;\n          @*) \n            [ -f \"${1#@}\" ] || { bad \"File not found: ${1#@}\"; return 1; }\n            tool_args=$(cat \"${1#@}\"); shift ;;\n          *) tool_args=\"$1\"; shift ;;","tokenCount":170}],"storageText":"bash function \"main\"\nin figma-wire/scripts/mcp-wire.sh\nPurpose: file operations\n\n  case \"$cmd\" in\n    doctor) method=ping ;;\n    list|describe) method=tools/list; key=tools; tool=\"${1:-}\"; if [ \"$cmd\" = describe ] && [ -z \"$tool\" ]; then bad \"describe requires a tool name.\"; return 1; fi ;;\n    call)\n      method=tools/call; tool=\"${1:-}\"; [ -n \"$tool\" ] || { bad \"call requires a tool name.\"; return 1; }; shift\n      if [ $# -gt 0 ]; then\n        case \"$1\" in\n          -) tool_args=$(cat); shift ;;\n          @*) \n            [ -f \"${1#@}\" ] || { bad \"File not found: ${1#@}\"; return 1; }\n            tool_args=$(cat \"${1#@}\"); shift ;;\n          *) tool_args=\"$1\"; shift ;;","content":"  case \"$cmd\" in\n    doctor) method=ping ;;\n    list|describe) method=tools/list; key=tools; tool=\"${1:-}\"; if [ \"$cmd\" = describe ] && [ -z \"$tool\" ]; then bad \"describe requires a tool name.\"; return 1; fi ;;\n    call)\n      method=tools/call; tool=\"${1:-}\"; [ -n \"$tool\" ] || { bad \"call requires a tool name.\"; return 1; }; shift\n      if [ $# -gt 0 ]; then\n        case \"$1\" in\n          -) tool_args=$(cat); shift ;;\n          @*) \n            [ -f \"${1#@}\" ] || { bad \"File not found: ${1#@}\"; return 1; }\n            tool_args=$(cat \"${1#@}\"); shift ;;\n          *) tool_args=\"$1\"; shift ;;","contentHash":"1802825a984e7126","metadata":{"filePath":"skills/figma-wire/scripts/mcp-wire.sh","startLine":431,"endLine":442,"chunkType":"function_definition","name":"main","language":"bash","hash":"1802825a984e7126"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.911Z"}
{"version":1,"chunks":[{"id":"chunk_645aee1941518ed8","texts":[{"text":"bash function \"main\"\nin figma-wire/scripts/mcp-wire.sh\nPurpose: error handling, file operations, data parsing, UI rendering\n\n            [ -f \"${1#@}\" ] || { bad \"File not found: ${1#@}\"; return 1; }\n            tool_args=$(cat \"${1#@}\"); shift ;;\n          *) tool_args=\"$1\"; shift ;;\n        esac\n      fi\n      params=$(jq -nc --arg name \"$tool\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" then {name:$name,arguments:$a} else error(\"object required\") end' 2>/dev/null) || { bad \"Tool arguments must be a JSON object.\"; return 1; } ;;\n    resources)\n      case \"${1:-list}\" in\n        list) method=resources/list; key=resources ;;\n        templates) method=resources/templates/list; key=resourceTemplates ;;\n        read) [ -n \"${2:-}\" ] || { bad \"resources read requires a URI.\"; return 1; }; method=resources/read; params=$(jq -nc --arg uri \"$2\" '{uri:$uri}') ;;\n        *) bad \"Use resources list, templates, or read <uri>.\"; return 1 ;;","tokenCount":237}],"storageText":"bash function \"main\"\nin figma-wire/scripts/mcp-wire.sh\nPurpose: error handling, file operations, data parsing, UI rendering\n\n            [ -f \"${1#@}\" ] || { bad \"File not found: ${1#@}\"; return 1; }\n            tool_args=$(cat \"${1#@}\"); shift ;;\n          *) tool_args=\"$1\"; shift ;;\n        esac\n      fi\n      params=$(jq -nc --arg name \"$tool\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" then {name:$name,arguments:$a} else error(\"object required\") end' 2>/dev/null) || { bad \"Tool arguments must be a JSON object.\"; return 1; } ;;\n    resources)\n      case \"${1:-list}\" in\n        list) method=resources/list; key=resources ;;\n        templates) method=resources/templates/list; key=resourceTemplates ;;\n        read) [ -n \"${2:-}\" ] || { bad \"resources read requires a URI.\"; return 1; }; method=resources/read; params=$(jq -nc --arg uri \"$2\" '{uri:$uri}') ;;\n        *) bad \"Use resources list, templates, or read <uri>.\"; return 1 ;;","content":"            [ -f \"${1#@}\" ] || { bad \"File not found: ${1#@}\"; return 1; }\n            tool_args=$(cat \"${1#@}\"); shift ;;\n          *) tool_args=\"$1\"; shift ;;\n        esac\n      fi\n      params=$(jq -nc --arg name \"$tool\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" then {name:$name,arguments:$a} else error(\"object required\") end' 2>/dev/null) || { bad \"Tool arguments must be a JSON object.\"; return 1; } ;;\n    resources)\n      case \"${1:-list}\" in\n        list) method=resources/list; key=resources ;;\n        templates) method=resources/templates/list; key=resourceTemplates ;;\n        read) [ -n \"${2:-}\" ] || { bad \"resources read requires a URI.\"; return 1; }; method=resources/read; params=$(jq -nc --arg uri \"$2\" '{uri:$uri}') ;;\n        *) bad \"Use resources list, templates, or read <uri>.\"; return 1 ;;","contentHash":"81ee660d8e7cbf8d","metadata":{"filePath":"skills/figma-wire/scripts/mcp-wire.sh","startLine":440,"endLine":451,"chunkType":"function_definition","name":"main","language":"bash","hash":"81ee660d8e7cbf8d"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.911Z"}
{"version":1,"chunks":[{"id":"chunk_0a55d992cd13ce9a","texts":[{"text":"bash function \"main\"\nin figma-verify/scripts/mcp-wire.sh\nPurpose: HTTP/API, file operations, configuration\n\n        allow_http=$(jq -r '.allow_http // false' <<<\"$entry\")\n        [ \"$allow_http\" != true ] || ALLOW_HTTP=1\n        # headers array with ${VAR} expansion\n        local hline varname\n        while IFS= read -r hline; do\n          [ -n \"$hline\" ] || continue\n          # expand ${VAR}\n          while [[ \"$hline\" =~ \\$\\{([A-Za-z_][A-Za-z_0-9]*)\\} ]]; do\n            varname=\"${BASH_REMATCH[1]}\"\n            [ -n \"${!varname:-}\" ] || { bad \"Required header environment variable is unset: $varname\"; return 1; }\n            hline=\"${hline//\\$\\{$varname\\}/${!varname}}\"\n          done","tokenCount":173}],"storageText":"bash function \"main\"\nin figma-verify/scripts/mcp-wire.sh\nPurpose: HTTP/API, file operations, configuration\n\n        allow_http=$(jq -r '.allow_http // false' <<<\"$entry\")\n        [ \"$allow_http\" != true ] || ALLOW_HTTP=1\n        # headers array with ${VAR} expansion\n        local hline varname\n        while IFS= read -r hline; do\n          [ -n \"$hline\" ] || continue\n          # expand ${VAR}\n          while [[ \"$hline\" =~ \\$\\{([A-Za-z_][A-Za-z_0-9]*)\\} ]]; do\n            varname=\"${BASH_REMATCH[1]}\"\n            [ -n \"${!varname:-}\" ] || { bad \"Required header environment variable is unset: $varname\"; return 1; }\n            hline=\"${hline//\\$\\{$varname\\}/${!varname}}\"\n          done","content":"        allow_http=$(jq -r '.allow_http // false' <<<\"$entry\")\n        [ \"$allow_http\" != true ] || ALLOW_HTTP=1\n        # headers array with ${VAR} expansion\n        local hline varname\n        while IFS= read -r hline; do\n          [ -n \"$hline\" ] || continue\n          # expand ${VAR}\n          while [[ \"$hline\" =~ \\$\\{([A-Za-z_][A-Za-z_0-9]*)\\} ]]; do\n            varname=\"${BASH_REMATCH[1]}\