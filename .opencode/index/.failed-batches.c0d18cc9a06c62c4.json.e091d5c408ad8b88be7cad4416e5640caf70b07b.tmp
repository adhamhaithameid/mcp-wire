{"version":1,"chunks":[{"id":"chunk_dce4beb03fbbb88f","texts":[{"text":"bash function \"state_set\"\nin figma-code/scripts/figma-wire.sh\nPurpose: file operations, state management\n\nstate_set() {\n  mkdir -p \"$(dirname \"$STATE_FILE\")\"\n  [ -s \"$STATE_FILE\" ] || echo '{}' > \"$STATE_FILE\"\n  local tmp; tmp=\"$(mktemp)\"\n  if jq \"$1\" \"$STATE_FILE\" > \"$tmp\" 2>/dev/null; then mv -f \"$tmp\" \"$STATE_FILE\"; else rm -f \"$tmp\"; fi\n}","tokenCount":86}],"storageText":"bash function \"state_set\"\nin figma-code/scripts/figma-wire.sh\nPurpose: file operations, state management\n\nstate_set() {\n  mkdir -p \"$(dirname \"$STATE_FILE\")\"\n  [ -s \"$STATE_FILE\" ] || echo '{}' > \"$STATE_FILE\"\n  local tmp; tmp=\"$(mktemp)\"\n  if jq \"$1\" \"$STATE_FILE\" > \"$tmp\" 2>/dev/null; then mv -f \"$tmp\" \"$STATE_FILE\"; else rm -f \"$tmp\"; fi\n}","content":"state_set() {\n  mkdir -p \"$(dirname \"$STATE_FILE\")\"\n  [ -s \"$STATE_FILE\" ] || echo '{}' > \"$STATE_FILE\"\n  local tmp; tmp=\"$(mktemp)\"\n  if jq \"$1\" \"$STATE_FILE\" > \"$tmp\" 2>/dev/null; then mv -f \"$tmp\" \"$STATE_FILE\"; else rm -f \"$tmp\"; fi\n}","contentHash":"95f29e1163810f2f","metadata":{"filePath":"skills/figma-code/scripts/figma-wire.sh","startLine":55,"endLine":60,"chunkType":"function_definition","name":"state_set","language":"bash","hash":"95f29e1163810f2f"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":11,"lastAttempt":"2026-10-17T11:40:24.003Z"}
{"version":1,"chunks":[{"id":"chunk_d4c4b78c8a31dc54","texts":[{"text":"bash function \"json_set_remote_auth\"\nin figma-code/scripts/figma-wire.sh\nPurpose: authentication, token management, HTTP/API, file operations, data parsing\n\njson_set_remote_auth() { # $1 harness $2 bearer-token $3 region(\"\"=none) $4 file\n  local hdrs='{\"Authorization\":$auth}'\n  [ -n \"$3\" ] && hdrs='{\"Authorization\":$auth,\"X-Figma-Region\":$region}'\n  local expr tmp; tmp=\"$(mktemp)\"\n  case \"$1\" in\n    zcode)   expr=\".mcp.servers.figma = ((.mcp.servers.figma // {\\\"type\\\":\\\"http\\\",\\\"url\\\":\\$rurl}) | .headers = $hdrs | .enabled = true)\" ;;\n    vscode)  expr=\".mcp.servers.figma = ((.mcp.servers.figma // {\\\"type\\\":\\\"http\\\",\\\"url\\\":\\$rurl}) | .headers = $hdrs)\" ;;\n    claude|generic|cursor)\n             expr=\".mcpServers.figma = ((.mcpServers.figma // {\\\"type\\\":\\\"http\\\",\\\"url\\\":\\$rurl}) | .headers = $hdrs | .enabled = true)\" ;;\n    windsurf) expr=\".mcpServers.figma = ((.mcpServers.figma // {\\\"serverUrl\\\":\\$rurl}) | .headers = $hdrs)\" ;;\n    gemini)  expr=\".mcpServers.figma = ((.mcpServers.figma // {\\\"httpUrl\\\":\\$rurl}) | .headers = $hdrs)\" ;;\n    *) rm -f \"$tmp\"; return 1 ;;\n  esac\n  if jq --arg rurl \"$REMOTE_URL\" --arg auth \"Bearer $2\" --arg region \"$3\" \"$expr\" \"$4\" > \"$tmp\" 2>/dev/null; then\n    mv -f \"$tmp\" \"$4\"\n  else rm -f \"$tmp\"; return 1; fi\n}","tokenCount":316}],"storageText":"bash function \"json_set_remote_auth\"\nin figma-code/scripts/figma-wire.sh\nPurpose: authentication, token management, HTTP/API, file operations, data parsing\n\njson_set_remote_auth() { # $1 harness $2 bearer-token $3 region(\"\"=none) $4 file\n  local hdrs='{\"Authorization\":$auth}'\n  [ -n \"$3\" ] && hdrs='{\"Authorization\":$auth,\"X-Figma-Region\":$region}'\n  local expr tmp; tmp=\"$(mktemp)\"\n  case \"$1\" in\n    zcode)   expr=\".mcp.servers.figma = ((.mcp.servers.figma // {\\\"type\\\":\\\"http\\\"