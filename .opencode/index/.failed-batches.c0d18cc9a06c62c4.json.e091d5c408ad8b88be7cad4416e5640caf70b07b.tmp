{"version":1,"chunks":[{"id":"chunk_1d437e5658eedd6a","texts":[{"text":"JavaScript function \"respond\"\nin engine/tests/fake-server.js\nPurpose: respond(m, path), logging, file operations\n\nfunction respond(m, path = '') {\n  let result;\n  switch (m.method) {\n    case 'initialize': result = { protocolVersion: '2025-11-25', capabilities: {}, serverInfo: { name: 'fake-mcp', version: '1' } }; break;\n    case 'notifications/initialized': return null;\n    case 'ping': result = {}; break;\n    case 'tools/list':\n      if (path.includes('pages')) {\n        result = m.params?.cursor ? { tools: tools.slice(1,2) } : { tools: tools.slice(0,1), nextCursor: 'page two' };\n      } else { result = { tools }; }\n      break;\n    case 'tools/call':","tokenCount":166}],"storageText":"JavaScript function \"respond\"\nin engine/tests/fake-server.js\nPurpose: respond(m, path), logging, file operations\n\nfunction respond(m, path = '') {\n  let result;\n  switch (m.method) {\n    case 'initialize': result = { protocolVersion: '2025-11-25', capabilities: {}, serverInfo: { name: 'fake-mcp', version: '1' } }; break;\n    case 'notifications/initialized': return null;\n    case 'ping': result = {}; break;\n    case 'tools/list':\n      if (path.includes('pages')) {\n        result = m.params?.cursor ? { tools: tools.slice(1,2) } : { tools: tools.slice(0,1), nextCursor: 'page two' };\n      } else { result = { tools }; }\n      break;\n    case 'tools/call':","content":"function respond(m, path = '') {\n  let result;\n  switch (m.method) {\n    case 'initialize': result = { protocolVersion: '2025-11-25', capabilities: {}, serverInfo: { name: 'fake-mcp', version: '1' } }; break;\n    case 'notifications/initialized': return null;\n    case 'ping': result = {}; break;\n    case 'tools/list':\n      if (path.includes('pages')) {\n        result = m.params?.cursor ? { tools: tools.slice(1,2) } : { tools: tools.slice(0,1), nextCursor: 'page two' };\n      } else { result = { tools }; }\n 