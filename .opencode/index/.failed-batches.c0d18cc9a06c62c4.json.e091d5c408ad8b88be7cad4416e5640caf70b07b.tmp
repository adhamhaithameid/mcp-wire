{"version":1,"chunks":[{"id":"chunk_419e8190a1f20b9b","texts":[{"text":"bash function \"main\"\nin figma-wire/scripts/mcp-wire.sh\n\n      -) args+=(\"$1\"); shift ;;\n      -*) bad \"Unknown flag. Use --help.\"; return 1 ;;\n      *) args+=(\"$1\"); shift ;;\n    esac\n  done\n  [[ \"$TIMEOUT\" =~ ^[1-9][0-9]*$ ]] || { bad \"--timeout requires a positive integer.\"; return 1; }\n  local dep\n  for dep in curl jq; do command -v \"$dep\" >/dev/null || { bad \"Missing $dep. Install $dep and retry.\"; return 1; }; done\n  local h\n  for h in \"${HEADERS[@]+\"${HEADERS[@]}\"}\"; do [[ \"$h\" != *$'\\n'* && \"$h\" != *$'\\r'* ]] || { bad \"Header values cannot contain line breaks.\"; return 1; }; done\n  local hname\n  for h in \"${HEADERS[@]+\"${HEADERS[@]}\"}\"; do","tokenCount":164}],"storageText":"bash function \"main\"\nin figma-wire/scripts/mcp-wire.sh\n\n      -) args+=(\"$1\"); shift ;;\n      -*) bad \"Unknown flag. Use --help.\"; return 1 ;;\n      *) args+=(\"$1\"); shift ;;\n    esac\n  done\n  [[ \"$TIMEOUT\" =~ ^[1-9][0-9]*$ ]] || { bad \"--timeout requires a positive integer.\"; return 1; }\n  local dep\n  for dep in curl jq; do command -v \"$dep\" >/dev/null || { bad \"Missing $dep. Install $dep and retry.\"; return 1; }; done\n  local h\n  for h in \"${HEADERS[@]+\"${HEADERS[@]}\"}\"; do [[ \"$h\" != *$'\\n'* && \"$h\" != *$'\\r'* ]] || { bad \"Header values cannot contain line breaks.\"; return 1; }; done\n  local hname\n  for h in \"${HEADERS[@]+\"${HEADERS[@]}\"}\"; do","content":"      -) args+=(\"$1\"); shift ;;\n      -*) bad \"Unknown flag. Use --help.\"; return 1 ;;\n      *) args+=(\"$1\"); shift ;;\n    esac\n  done\n  [[ \"$TIMEOUT\" =~ ^[1-9][0-9]*$ ]] || { bad \"--timeout requires a positive integer.\"; return 1; }\n  local dep\n  for dep in curl jq; do command -v \"$dep\" >/dev/null || { bad \"Missing $dep. Install $dep and retry.\"; return 1; }; done\n  local h\n  for h in \"${HEADERS[@]+\"${HEADERS[@]}\"}\"; do [[ \"$h\" != *$'\\n'* && \"$h\" != *$'\\r'* ]] || { bad \"Header values cannot contain line breaks.\"; return 1; }; done\n  local hname\n  for h in \"${HEADERS[@]+\"${HEADERS[@]}\"}\"; do","contentHash":"e088a44b4889350b","metadata":{"filePath":"skills/figma-wire/scripts/mcp-wire.sh","startLine":278,"endLine":289,"chunkType":"function_definition","name":"main","language":"bash","hash":"e088a44b4889350b"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.911Z"}
{"version":1,"chunks":[{"id":"chunk_da2dcfe87a12d56c","texts":[{"text":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: caching, HTTP/API, file operations, data parsing, configuration, state management\n\n      shift\n      local sub=\"${1:-list}\"; [ $# -eq 0 ] || shift\n      case \"$sub\" in\n        path) printf '%s\\n' \"$CONFIG\"; return 0 ;;\n        list)\n          if [ ! -f \"$CONFIG\" ]; then echo '[]'; return 0; fi\n          jq -e '.servers | to_entries | map({name:.key,transport:(if .value.command then \"stdio\" else \"http\" end)})' \"$CONFIG\"; return ;;\n        add)\n          local name=\"${1:-}\" url=\"${2:-}\"; shift 2 2>/dev/null || true\n          # parse flags\n          local allow_http=0 store_literal=0 headers=()\n          while [ $# -gt 0 ]; do","tokenCount":174}],"storageText":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: caching, HTTP/API, file operations, data parsing, configuration, state management\n\n      shift\n      local sub=\"${1:-list}\"; [ $# -eq 0 ] || shift\n      case \"$sub\" in\n        path) printf '%s\\n' \"$CONFIG\"; return 0 ;;\n        list)\n          if [ ! -f \"$CONFIG\" ]; then echo '[]'; return 0; fi\n          jq -e '.servers | to_entries | map({name:.key,transport:(if .value.command then \"stdio\" else \"http\" end)})' \"$CONFIG\"; return ;;\n        add)\n          local name=\"${1:-}\" url=\"${2:-}\"; shift 2 2>/dev/null || true\n          # parse flags\n          local allow_http=0 store_literal=0 headers=()\n          while [ $# -gt 0 ]; do","content":"      shift\n      local sub=\"${1:-list}\"; [ $# -eq 0 ] || shift\n      case \"$sub\" in\n        path) printf '%s\\n' \"$CONFIG\"; return 0 ;;\n        list)\n          if [ ! -f \"$CONFIG\" ]; then echo '[]'; return 0; fi\n          jq -e '.servers | to_entries | map({name:.key,transport:(if .value.command then \"stdio\" else \"http\" end)})' \"$CONFIG\"; return ;;\n        add)\n          local name=\"${1:-}\