{"version":1,"chunks":[{"id":"chunk_16eedac4ce705bb8","texts":[{"text":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\n          [ -n \"${!envname:-}\" ] || { bad \"Required header environment variable is unset.\"; return 1; }\n          [[ \"${!envname}\" != *$'\\r'* && \"${!envname}\" != *$'\\n'* ]] || { bad \"Header values cannot contain line breaks.\"; return 1; }\n          HEADERS+=(\"$headername: ${!envname}\")\n        done < <(jq -r '.headerEnv // {} | to_entries[] | [.key,.value] | @tsv' <<<\"$entry\") ;;\n    esac\n  fi\n  if [ -n \"$STDIO\" ]; then\n    [ -z \"$URL\" ] || { bad \"Choose one transport: URL or stdio.\"; return 1; }\n    jq -e 'type == \"array\" and length > 0 and all(.[]; type == \"string\" and (contains(\"\\n\")|not) and (contains(\"\\u0000\")|not)) and .[0] != \"\"' <<<\"$STDIO\" >/dev/null 2>&1 || { bad \"--stdio requires a JSON command array.\"; return 1; }\n  else\n    case \"$URL\" in\n      https://*) : ;; http://*) [ \"$ALLOW_HTTP\" -eq 1 ] || { bad \"Refusing plain HTTP. Pass --allow-http for trusted development.\"; return 1; } ;;","tokenCount":253}],"storageText":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\n          [ -n \"${!envname:-}\" ] || { bad \"Required header environment variable is unset.\"; return 1; }\n          [[ \"${!envname}\" != *$'\\r'* && \"${!envname}\" != *$'\\n'* ]] || { bad \"Header values cannot contain line breaks.\"; return 1; }\n          HEADERS+=(\"$headername: ${!envname}\")\n        done < <(jq -r '.headerEnv // {} | to_entries[] | [.key,.value] | @tsv' <<<\"$entry\") ;;\n    esac\n  fi\n  if [ -n \"$STDIO\" ]; then\n    [ -z \"$URL\" ] || { bad \"Choose one transport: URL or stdio.\"; return 1; }\n    jq -e 'type == \"array\" and length > 0 and all(.[]; type == \"string\" and (contains(\"\\n\")|not) and (contains(\"\\u0000\")|not)) and .[0] != \"\"' <<<\"$STDIO\" >/dev/null 2>&1 || { bad \"--stdio requires a JSON command array.\"; return 1; }\n  else\n    case \"$URL\" in\n      https://*) : ;; http://*) [ \"$ALLOW_HTTP\" -eq 1 ] || { bad \"Refusing plain HTTP. Pass --allow-http for trusted development.\"; return 1; } ;;","content":"          [ -n \"${!envname:-}\" ] || { bad \"Required header environment variable is unset.\"; return 1; }\n          [[ \"${!envname}\" != *$'\\r'* && \"${!envname}\" != *$'\\n'* ]] || { bad \"Header values cannot contain line breaks.\"; return 1; }\n          HEADERS+=(\"$headername: ${!envname}\")\n        done < <(jq -r '.headerEnv // {} | to_entries[] | [.key,.value] | @tsv' <<<\"$entry\") ;;\n    esac\n  fi\n  if [ -n \"$STDIO\" ]; then\n    [ -z \"$URL\" ] || { bad \"Choose one transport: URL or stdio.\"; return 1; }\n    jq -e 'type == \"array\" and length > 0 and all(.[]; type == \"string\" and (contains(\"\\n\")|not) and (contains(\"\\u0000\")|not)) and .[0] != \"\"' <<<\"$STDIO\" >/dev/null 2>&1 || { bad \"--stdio requires a JSON command array.\"; return 1; }\n  else\n    case \"$URL\" in\n      https://*) : ;; http://*) [ \"$ALLOW_HTTP\" -eq 1 ] || { bad \"Refusing plain HTTP. Pass --allow-http for trusted development.\"; return 1; } ;;","contentHash":"a10ae338ad68139a","metadata":{"filePath":"skills/figma-code/scripts/mcp-wire.sh","startLine":413,"endLine":424,"chunkType":"function_definition","name":"main","language":"bash","hash":"a10ae338ad68139a"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.681Z"}
{"version":1,"chunks":[{"id":"chunk_ec87de67ebd2c2ce","texts":[{"text":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: HTTP/API\n\n  else\n    case \"$URL\" in\n      https://*) : ;; http://*) [ \"$ALLOW_HTTP\" -eq 1 ] || { bad \"Refusing plain HTTP. Pass --allow-http for trusted development.\"; return 1; } ;;\n      *) bad \"Server URL must start with http:// or https://.\"; return 1 ;;\n    esac\n  fi\n  cmd=\"${1:-}\"; [ $# -eq 0 ] || shift\n  [ \"$doctor\" -eq 0 ] || cmd=doctor\n  local method='' params='{}' key='' tool='' body data tool_args='{}'\n  case \"$cmd\" in\n    doctor) method=ping ;;\n    list|describe) method=tools/list; key=tools; tool=\"${1:-}\"; if [ \"$cmd\" = describe ] && [ -z \"$tool\" ]; then bad \"describe requires a tool name.\"; return 1; fi ;;","tokenCount":173}],"storageText":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: HTTP/API\n\n  else\n    case \"$URL\" in\n      https://*) : ;; http://*) [ \"$ALLOW_HTTP\" -eq 1 ] || { bad \"Refusing plain HTTP. Pass --allow-http for trusted development.\"; return 1; } ;;\n      *) bad \"Server URL must start with http:// or https://.\"; return 1 ;;\n    esac\n  fi\n  cmd=\"${1:-}\"; [ $# -eq 0 ] || shift\n  [ \"$doctor\" -eq 0 ] || cmd=doctor\n  local method='' params='{}' key='' tool='' body data tool_args='{}'\n  case \"$cmd\" in\n    doctor) method=ping ;;\n    list|describe) method=tools/list; key=tools; tool=\"${1:-}\"; if [ \"$cmd\" = describe ] && [ -z \"$tool\" ]; then bad \"describe requires a tool name.\"; return 1; fi ;;","content":"  else\n    case \"$URL\" in\n      https://*) : ;; http://*) [ \"$ALLOW_HTTP\" -eq 1 ] || { bad \"Refusing plain HTTP. Pass --allow-http for trusted development.\"; return 1; } ;;\n      *) bad \"Server URL must start with http:// or https://.\"; return 1 ;;\n    esac\n  fi\n  cmd=\"${1:-}\"; [ $# -eq 0 ] || shift\n  [ \"$doctor\" -eq 0 ] || cmd=doctor\n  local method='' params='{}' key='' tool='' body data tool_args='{}'\n  case \"$cmd\" in\n    doctor) method=ping ;;\n    list|describe) method=tools/list; key=tools; tool=\"${1:-}\"; if [ \"$cmd\" = describe ] && [ -z \"$tool\" ]; then bad \"describe requires a tool name.\"; return 1; fi ;;","contentHash":"2657902efd096ff9","metadata":{"filePath":"skills/figma-code/scripts/mcp-wire.sh","startLine":422,"endLine":433,"chunkType":"function_definition","name":"main","language":"bash","hash":"2657902efd096ff9"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.681Z"}
{"version":1,"chunks":[{"id":"chunk_f84ca26cd0d18698","texts":[{"text":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: file operations\n\n  case \"$cmd\" in\n    doctor) method=ping ;;\n    list|describe) method=tools/list; key=tools; tool=\"${1:-}\"; if [ \"$cmd\" = describe ] && [ -z \"$tool\" ]; then bad \"describe requires a tool name.\"; return 1; fi ;;\n    call)\n      method=tools/call; tool=\"${1:-}\"; [ -n \"$tool\" ] || { bad \"call requires a tool name.\"; return 1; }; shift\n      if [ $# -gt 0 ]; then\n        case \"$1\" in\n          -) tool_args=$(cat); shift ;;\n          @*) \n            [ -f \"${1#@}\" ] || { bad \"File not found: ${1#@}\"; return 1; }\n            tool_args=$(cat \"${1#@}\"); shift ;;\n          *) tool_args=\"$1\"; shift ;;","tokenCount":170}],"storageText":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: file operations\n\n  case \"$cmd\" in\n    doctor) method=ping ;;\n    list|describe) method=tools/list; key=tools; tool=\"${1:-}\"; if [ \"$cmd\" = describe ] && [ -z \"$tool\" ]; then bad \"describe requires a tool name.\"; return 1; fi ;;\n    call)\n      method=tools/call; tool=\"${1:-}\"; [ -n \"$tool\" ] || { bad \"call requires a tool name.\"; return 1; }; shift\n      if [ $# -gt 0 ]; then\n        case \"$1\" in\n          -) tool_args=$(cat); shift ;;\n          @*) \n            [ -f \"${1#@}\" ] || { bad \"File not found: ${1#@}\"; return 1; }\n            tool_args=$(cat \"${1#@}\"); shift ;;\n          *) tool_args=\"$1\"; shift ;;","content":"  case \"$cmd\" in\n    doctor) method=ping ;;\n    list|describe) method=tools/list; key=tools; tool=\"${1:-}\"; if [ \"$cmd\" = describe ] && [ -z \"$tool\" ]; then bad \"describe requires a tool name.\"; return 1; fi ;;\n    call)\n      method=tools/call; tool=\"${1:-}\"; [ -n \"$tool\" ] || { bad \"call requires a tool name.\"; return 1; }; shift\n      if [ $# -gt 0 ]; then\n        case \"$1\" in\n          -) tool_args=$(cat); shift ;;\n          @*) \n            [ -f \"${1#@}\" ] || { bad \"File not found: ${1#@}\"; return 1; }\n            tool_args=$(cat \"${1#@}\"); shift ;;\n          *) tool_args=\"$1\"; shift ;;","contentHash":"1802825a984e7126","metadata":{"filePath":"skills/figma-code/scripts/mcp-wire.sh","startLine":431,"endLine":442,"chunkType":"function_definition","name":"main","language":"bash","hash":"1802825a984e7126"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.681Z"}
{"version":1,"chunks":[{"id":"chunk_c6c4398522e1f0ab","texts":[{"text":"bash function \"connect\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: authorization, validation, error handling, logging, HTTP/API, file operations\n\nconnect() {\n  local init data version\n  init=$(jq -nc --arg p \"$PROTOCOL\" --arg v \"$VERSION\" '{jsonrpc:\"2.0\",id:1,method:\"initialize\",params:{protocolVersion:$p,capabilities:{},clientInfo:{name:\"mcp-wire\",version:$v}}}')\n  if [ -n \"$STDIO\" ]; then\n    local command=() arg\n    while IFS= read -r arg; do command+=(\"$arg\"); done < <(jq -r '.[]' <<<\"$STDIO\")\n    mkfifo \"$WORK/in\" \"$WORK/out\" || return 1\n    # Open both ends before launch to avoid FIFO-open deadlocks on Bash 3.2.\n    exec 3<>\"$WORK/in\" 4<>\"$WORK/out\"\n    \"${command[@]}\" <\"$WORK/in\" >\"$WORK/out\" 2>\"$WORK/server.log\" &\n    SERVER_PID=$!\n    stdio_send \"$init\" || return 1\n    data=$(stdio_receive 1) || return 1\n  else\n    http_post \"$init\" || return 1\n    data=$(parse_response \"$WORK/body\" 1) || { bad \"Invalid initialize response. Check that the URL serves MCP.\"; return 1; }\n    local session\n    session=$(awk 'tolower($1)==\"mcp-session-id:\" {sub(/\\r$/, \"\", $2); print $2; exit}' \"$WORK/headers\")\n    if [ -n \"$session\" ]; then SESSION_ID=\"$session\"; SESSION_HEADERS+=(\"-H\" \"Mcp-Session-Id: $session\"); TRANSPORT='session'; else TRANSPORT='stateless'; fi\n    if grep -qi '^content-type:.*application/json' \"$WORK/headers\"; then REPLY='json'; else REPLY='sse'; fi\n  fi\n  jq -e '.error' <<<\"$data\" >/dev/null 2>&1 && { bad \"MCP initialization failed. Check server access and protocol support.\"; return 1; }\n  version=$(jq -r '.result.protocolVersion // empty' <<<\"$data\")\n  case \"$version\" in\n    2025-03-26|2025-06-18|2025-11-25) : ;;\n    *) bad \"Unsupported negotiated MCP version. Use a server with a supported protocol version.\"; return 1 ;;\n  esac\n  if [ -n \"$STDIO\" ]; then\n    stdio_send '{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}'\n  else\n    SESSION_HEADERS+=(\"-H\" \"MCP-Protocol-Version: $version\")\n    http_post '{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}'\n  fi\n}","tokenCount":504}],"storageText":"bash function \"connect\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: authorization, validation, error handling, logging, HTTP/API, file operations\n\nconnect() {\n  local init data version\n  init=$(jq -nc --arg p \"$PROTOCOL\" --arg v \"$VERSION\" '{jsonrpc:\"2.0\",id:1,method:\"initialize\",params:{protocolVersion:$p,capabilities:{},clientInfo:{name:\"mcp-wire\",version:$v}}}')\n  if [ -n \"$STDIO\" ]; then\n    local command=() arg\n    while IFS= read -r arg; do command+=(\"$arg\"); done < <(jq -r '.[]' <<<\"$STDIO\")\n    mkfifo \"$WORK/in\" \"$WORK/out\" || return 1\n    # Open both ends before launch to avoid FIFO-open deadlocks on Bash 3.2.\n    exec 3<>\"$WORK/in\" 4<>\"$WORK/out\"\n    \"${command[@]}\" <\"$WORK/in\" >\"$WORK/out\" 2>\"$WORK/server.log\" &\n    SERVER_PID=$!\n    stdio_send \"$init\" || return 1\n    data=$(stdio_receive 1) || return 1\n  else\n    http_post \"$init\" || return 1\n    data=$(parse_response \"$WORK/body\" 1) || { bad \"Invalid initialize response. Check that the URL serves MCP.\"; return 1; }\n    local session\n    session=$(awk 'tolower($1)==\"mcp-session-id:\" {sub(/\\r$/, \"\", $2); print $2; exit}' \"$WORK/headers\")\n    if [ -n \"$session\" ]; then SESSION_ID=\"$session\"; SESSION_HEADERS+=(\"-H\" \"Mcp-Session-Id: $session\"); TRANSPORT='session'; else TRANSPORT='stateless'; fi\n    if grep -qi '^content-type:.*application/json' \"$WORK/headers\"; then REPLY='json'; else REPLY='sse'; fi\n  fi\n  jq -e '.error' <<<\"$data\" >/dev/null 2>&1 && { bad \"MCP initialization failed. Check server access and protocol support.\"; return 1; }\n  version=$(jq -r '.result.protocolVersion // empty' <<<\"$data\")\n  case \"$version\" in\n    2025-03-26|2025-06-18|2025-11-25) : ;;\n    *) bad \"Unsupported negotiated MCP version. Use a server with a supported protocol version.\"; return 1 ;;\n  esac\n  if [ -n \"$STDIO\" ]; then\n    stdio_send '{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}'\n  else\n    SESSION_HEADERS+=(\"-H\" \"MCP-Protocol-Version: $version\")\n    http_post '{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}'\n  fi\n}","content":"connect() {\n  local init data version\n  init=$(jq -nc --arg p \"$PROTOCOL\" --arg v \"$VERSION\" '{jsonrpc:\"2.0\",id:1,method:\"initialize\",params:{protocolVersion:$p,capabilities:{},clientInfo:{name:\"mcp-wire\",version:$v}}}')\n  if [ -n \"$STDIO\" ]; then\n    local command=() arg\n    while IFS= read -r arg; do command+=(\"$arg\"); done < <(jq -r '.[]' <<<\"$STDIO\")\n    mkfifo \"$WORK/in\" \"$WORK/out\" || return 1\n    # Open both ends before launch to avoid FIFO-open deadlocks on Bash 3.2.\n    exec 3<>\"$WORK/in\" 4<>\"$WORK/out\"\n    \"${command[@]}\" <\"$WORK/in\" >\"$WORK/out\" 2>\"$WORK/server.log\" &\n    SERVER_PID=$!\n    stdio_send \"$init\" || return 1\n    data=$(stdio_receive 1) || return 1\n  else\n    http_post \"$init\" || return 1\n    data=$(parse_response \"$WORK/body\" 1) || { bad \"Invalid initialize response. Check that the URL serves MCP.\"; return 1; }\n    local session\n    session=$(awk 'tolower($1)==\"mcp-session-id:\" {sub(/\\r$/, \"\", $2); print $2; exit}' \"$WORK/headers\")\n    if [ -n \"$session\" ]; then SESSION_ID=\"$session\"; SESSION_HEADERS+=(\"-H\" \"Mcp-Session-Id: $session\"); TRANSPORT='session'; else TRANSPORT='stateless'; fi\n    if grep -qi '^content-type:.*application/json' \"$WORK/headers\"; then REPLY='json'; else REPLY='sse'; fi\n  fi\n  jq -e '.error' <<<\"$data\" >/dev/null 2>&1 && { bad \"MCP initialization failed. Check server access and protocol support.\"; return 1; }\n  version=$(jq -r '.result.protocolVersion // empty' <<<\"$data\")\n  case \"$version\" in\n    2025-03-26|2025-06-18|2025-11-25) : ;;\n    *) bad \"Unsupported negotiated MCP version. Use a server with a supported protocol version.\"; return 1 ;;\n  esac\n  if [ -n \"$STDIO\" ]; then\n    stdio_send '{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}'\n  else\n    SESSION_HEADERS+=(\"-H\" \"MCP-Protocol-Version: $version\")\n    http_post '{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}'\n  fi\n}","contentHash":"bee45fab0ce8bad8","metadata":{"filePath":"skills/figma-code/scripts/mcp-wire.sh","startLine":146,"endLine":179,"chunkType":"function_definition","name":"connect","language":"bash","hash":"bee45fab0ce8bad8"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.771Z"}
{"version":1,"chunks":[{"id":"chunk_5add0304ef248a64","texts":[{"text":"bash function \"send_request\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: authorization, validation, error handling, HTTP/API, data parsing, testing\n\nsend_request() {\n  local body=\"$1\" id data\n  id=$(jq -c '.id' <<<\"$body\")\n  if [ -n \"$STDIO\" ]; then\n    stdio_send \"$body\" || return 1\n    data=$(stdio_receive \"$id\") || return 1\n  else\n    http_post \"$body\" || return 1\n    data=$(parse_response \"$WORK/body\" \"$id\") || { bad \"Invalid MCP response. Check the server response format.\"; return 1; }\n  fi\n  if jq -e 'has(\"error\")' <<<\"$data\" >/dev/null 2>&1; then\n    bad \"MCP request failed (code $(jq -r '.error.code // \"unknown\"' <<<\"$data\")). Inspect the tool schema and server access.\"\n    return 1\n  fi\n  printf '%s\\n' \"$data\"\n}","tokenCount":183}],"storageText":"bash function \"send_request\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: authorization, validation, error handling, HTTP/API, data parsing, testing\n\nsend_request() {\n  local body=\"$1\" id data\n  id=$(jq -c '.id' <<<\"$body\")\n  if [ -n \"$STDIO\" ]; then\n    stdio_send \"$body\" || return 1\n    data=$(stdio_receive \"$id\") || return 1\n  else\n    http_post \"$body\" || return 1\n    data=$(parse_response \"$WORK/body\" \"$id\") || { bad \"Invalid MCP response. Check the server response format.\"; return 1; }\n  fi\n  if jq -e 'has(\"error\")' <<<\"$data\" >/dev/null 2>&1; then\n    bad \"MCP request failed (code $(jq -r '.error.code // \"unknown\"' <<<\"$data\")). Inspect the tool schema and server access.\"\n    return 1\n  fi\n  printf '%s\\n' \"$data\"\n}","content":"send_request() {\n  local body=\"$1\" id data\n  id=$(jq -c '.id' <<<\"$body\")\n  if [ -n \"$STDIO\" ]; then\n    stdio_send \"$body\" || return 1\n    data=$(stdio_receive \"$id\") || return 1\n  else\n    http_post \"$body\" || return 1\n    data=$(parse_response \"$WORK/body\" \"$id\") || { bad \"Invalid MCP response. Check the server response format.\"; return 1; }\n  fi\n  if jq -e 'has(\"error\")' <<<\"$data\" >/dev/null 2>&1; then\n    bad \"MCP request failed (code $(jq -r '.error.code // \"unknown\"' <<<\"$data\")). Inspect the tool schema and server access.\"\n    return 1\n  fi\n  printf '%s\\n' \"$data\"\n}","contentHash":"935f29f98965cc1c","metadata":{"filePath":"skills/figma-code/scripts/mcp-wire.sh","startLine":181,"endLine":196,"chunkType":"function_definition","name":"send_request","language":"bash","hash":"935f29f98965cc1c"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.771Z"}
{"version":1,"chunks":[{"id":"chunk_6fa2f77a1a03e479","texts":[{"text":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\n          dir=$(dirname \"$CONFIG\")\n          mkdir -p \"$dir\"; chmod 700 \"$dir\" 2>/dev/null || true\n          local tmpf\n          tmpf=$(mktemp \"$dir/.servers.XXXXXX\") || return 1\n          if [ -f \"$CONFIG\" ]; then cp \"$CONFIG\" \"$tmpf.base\"; else echo '{\"servers\":{}}' > \"$tmpf.base\"; fi\n          # build entry\n          local entry\n          entry=$(jq -nc --arg url \"$url\" --argjson ah \"$allow_http\" '{url:$url,allow_http:($ah==1)}')\n          if [ ${#headers[@]} -gt 0 ]; then\n            local hjson\n            hjson=$(printf '%s\\n' \"${headers[@]}\" | jq -R . | jq -sc .)\n            entry=$(jq -c --argjson h \"$hjson\" '.headers=$h' <<<\"$entry\")","tokenCount":189}],"storageText":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\n          dir=$(dirname \"$CONFIG\")\n          mkdir -p \"$dir\"; chmod 700 \"$dir\" 2>/dev/null || true\n          local tmpf\n          tmpf=$(mktemp \"$dir/.servers.XXXXXX\") || return 1\n          if [ -f \"$CONFIG\" ]; then cp \"$CONFIG\" \"$tmpf.base\"; else echo '{\"servers\":{}}' > \"$tmpf.base\"; fi\n          # build entry\n          local entry\n          entry=$(jq -nc --arg url \"$url\" --argjson ah \"$allow_http\" '{url:$url,allow_http:($ah==1)}')\n          if [ ${#headers[@]} -gt 0 ]; then\n            local hjson\n            hjson=$(printf '%s\\n' \"${headers[@]}\" | jq -R . | jq -sc .)\n            entry=$(jq -c --argjson h \"$hjson\" '.headers=$h' <<<\"$entry\")","content":"          dir=$(dirname \"$CONFIG\")\n          mkdir -p \"$dir\"; chmod 700 \"$dir\" 2>/dev/null || true\n          local tmpf\n          tmpf=$(mktemp \"$dir/.servers.XXXXXX\") || return 1\n          if [ -f \"$CONFIG\" ]; then cp \"$CONFIG\" \"$tmpf.base\"; else echo '{\"servers\":{}}' > \"$tmpf.base\"; fi\n          # build entry\n          local entry\n          entry=$(jq -nc --arg url \"$url\" --argjson ah \"$allow_http\" '{url:$url,allow_http:($ah==1)}')\n          if [ ${#headers[@]} -gt 0 ]; then\n            local hjson\n            hjson=$(printf '%s\\n' \"${headers[@]}\" | jq -R . | jq -sc .)\n            entry=$(jq -c --argjson h \"$hjson\" '.headers=$h' <<<\"$entry\")","contentHash":"af3f61785029b879","metadata":{"filePath":"skills/figma-code/scripts/mcp-wire.sh","startLine":341,"endLine":352,"chunkType":"function_definition","name":"main","language":"bash","hash":"af3f61785029b879"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.771Z"}
{"version":1,"chunks":[{"id":"chunk_27e9297163bec132","texts":[{"text":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: authentication, logging, caching, data parsing, configuration, state management\n\n            local hjson\n            hjson=$(printf '%s\\n' \"${headers[@]}\" | jq -R . | jq -sc .)\n            entry=$(jq -c --argjson h \"$hjson\" '.headers=$h' <<<\"$entry\")\n          fi\n          jq --arg name \"$name\" --argjson entry \"$entry\" '.servers[$name]=$entry' \"$tmpf.base\" > \"$tmpf\"\n          chmod 600 \"$tmpf\"\n          mv \"$tmpf\" \"$CONFIG\"\n          rm -f \"$tmpf.base\"\n          if [ \"$store_literal\" -eq 1 ]; then echo \"warning: stored literal credential\" >&2; fi\n          ok \"added $name\"\n          return 0 ;;\n        rm)","tokenCount":170}],"storageText":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: authentication, logging, caching, data parsing, configuration, state management\n\n            local hjson\n            hjson=$(printf '%s\\n' \"${headers[@]}\" | jq -R . | jq -sc .)\n            entry=$(jq -c --argjson h \"$hjson\" '.headers=$h' <<<\"$entry\")\n          fi\n          jq --arg name \"$name\" --argjson entry \"$entry\" '.servers[$name]=$entry' \"$tmpf.base\" > \"$tmpf\"\n          chmod 600 \"$tmpf\"\n          mv \"$tmpf\" \"$CONFIG\"\n          rm -f \"$tmpf.base\"\n          if [ \"$store_literal\" -eq 1 ]; then echo \"warning: stored literal credential\" >&2; fi\n          ok \"added $name\"\n          return 0 ;;\n        rm)","content":"            local hjson\n            hjson=$(printf '%s\\n' \"${headers[@]}\" | jq -R . | jq -sc .)\n            entry=$(jq -c --argjson h \"$hjson\" '.headers=$h' <<<\"$entry\")\n          fi\n          jq --arg name \"$name\" --argjson entry \"$entry\" '.servers[$name]=$entry' \"$tmpf.base\" > \"$tmpf\"\n          chmod 600 \"$tmpf\"\n          mv \"$tmpf\" \"$CONFIG\"\n          rm -f \"$tmpf.base\"\n          if [ \"$store_literal\" -eq 1 ]; then echo \"warning: stored literal credential\" >&2; fi\n          ok \"added $name\"\n          return 0 ;;\n        rm)","contentHash":"b9485cf1d78a1d18","metadata":{"filePath":"skills/figma-code/scripts/mcp-wire.sh","startLine":350,"endLine":361,"chunkType":"function_definition","name":"main","language":"bash","hash":"b9485cf1d78a1d18"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.771Z"}
{"version":1,"chunks":[{"id":"chunk_257459ef9b7e9cfc","texts":[{"text":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: file operations, configuration\n\n          ok \"added $name\"\n          return 0 ;;\n        rm)\n          local name=\"${1:-}\"\n          [ -f \"$CONFIG\" ] || { bad \"No registry.\"; return 1; }\n          jq --arg name \"$name\" 'del(.servers[$name])' \"$CONFIG\" > \"$CONFIG.tmp\" && mv \"$CONFIG.tmp\" \"$CONFIG\"\n          ok \"removed $name\"\n          return 0 ;;\n        *) bad \"Use servers add|list|rm|path.\"; return 1 ;;\n      esac\n      return ;;\n    doctor) doctor=1; shift; if [ $# -eq 0 ]; then","tokenCount":138}],"storageText":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: file operations, configuration\n\n          ok \"added $name\"\n          return 0 ;;\n        rm)\n          local name=\"${1:-}\"\n          [ -f \"$CONFIG\" ] || { bad \"No registry.\"; return 1; }\n          jq --arg name \"$name\" 'del(.servers[$name])' \"$CONFIG\" > \"$CONFIG.tmp\" && mv \"$CONFIG.tmp\" \"$CONFIG\"\n          ok \"removed $name\"\n          return 0 ;;\n        *) bad \"Use servers add|list|rm|path.\"; return 1 ;;\n      esac\n      return ;;\n    doctor) doctor=1; shift; if [ $# -eq 0 ]; then","content":"          ok \"added $name\"\n          return 0 ;;\n        rm)\n          local name=\"${1:-}\"\n          [ -f \"$CONFIG\" ] || { bad \"No registry.\"; return 1; }\n          jq --arg name \"$name\" 'del(.servers[$name])' \"$CONFIG\" > \"$CONFIG.tmp\" && mv \"$CONFIG.tmp\" \"$CONFIG\"\n          ok \"removed $name\"\n          return 0 ;;\n        *) bad \"Use servers add|list|rm|path.\"; return 1 ;;\n      esac\n      return ;;\n    doctor) doctor=1; shift; if [ $# -eq 0 ]; then","contentHash":"0f8174564be89499","metadata":{"filePath":"skills/figma-code/scripts/mcp-wire.sh","startLine":359,"endLine":370,"chunkType":"function_definition","name":"main","language":"bash","hash":"0f8174564be89499"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.771Z"}
{"version":1,"chunks":[{"id":"chunk_e35f1976cc53b7e8","texts":[{"text":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: data parsing\n\n      esac\n      return ;;\n    doctor) doctor=1; shift; if [ $# -eq 0 ]; then\n      # dependency report\n      local dok=1\n      command -v bash >/dev/null || dok=0\n      command -v curl >/dev/null || dok=0\n      command -v jq >/dev/null || dok=0\n      command -v base64 >/dev/null || dok=0\n      jq -n --argjson ok \"$dok\" '{ok:($ok==1),dependencies:[\"bash\",\"curl\",\"jq\",\"base64\"]}'\n      return\n    fi ;;","tokenCount":121}],"storageText":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: data parsing\n\n      esac\n      return ;;\n    doctor) doctor=1; shift; if [ $# -eq 0 ]; then\n      # dependency report\n      local dok=1\n      command -v bash >/dev/null || dok=0\n      command -v curl >/dev/null || dok=0\n      command -v jq >/dev/null || dok=0\n      command -v base64 >/dev/null || dok=0\n      jq -n --argjson ok \"$dok\" '{ok:($ok==1),dependencies:[\"bash\",\"curl\",\"jq\",\"base64\"]}'\n      return\n    fi ;;","content":"      esac\n      return ;;\n    doctor) doctor=1; shift; if [ $# -eq 0 ]; then\n      # dependency report\n      local dok=1\n      command -v bash >/dev/null || dok=0\n      command -v curl >/dev/null || dok=0\n      command -v jq >/dev/null || dok=0\n      command -v base64 >/dev/null || dok=0\n      jq -n --argjson ok \"$dok\" '{ok:($ok==1),dependencies:[\"bash\",\"curl\",\"jq\",\"base64\"]}'\n      return\n    fi ;;","contentHash":"a7d9aca0013dc65a","metadata":{"filePath":"skills/figma-code/scripts/mcp-wire.sh","startLine":368,"endLine":379,"chunkType":"function_definition","name":"main","language":"bash","hash":"a7d9aca0013dc65a"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.771Z"}
{"version":1,"chunks":[{"id":"chunk_9ed0234ed55d9467","texts":[{"text":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\n      jq -n --argjson ok \"$dok\" '{ok:($ok==1),dependencies:[\"bash\",\"curl\",\"jq\",\"base64\"]}'\n      return\n    fi ;;\n  esac\n  if [ -z \"$STDIO\" ]; then target=\"$1\"; shift; fi\n  case \"$target\" in @*) target=\"${target#@}\";; esac\n  if [ -n \"$target\" ]; then\n    case \"$target\" in\n      http://*|https://*) URL=\"$target\" ;;\n      *)\n        [ -f \"$CONFIG\" ] || { bad \"Unknown server. Pass a URL or create a named server in servers.json.\"; return 1; }\n        local entry","tokenCount":142}],"storageText":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\n      jq -n --argjson ok \"$dok\" '{ok:($ok==1),dependencies:[\"bash\",\"curl\",\"jq\",\"base64\"]}'\n      return\n    fi ;;\n  esac\n  if [ -z \"$STDIO\" ]; then target=\"$1\"; shift; fi\n  case \"$target\" in @*) target=\"${target#@}\";; esac\n  if [ -n \"$target\" ]; then\n    case \"$target\" in\n      http://*|https://*) URL=\"$target\" ;;\n      *)\n        [ -f \"$CONFIG\" ] || { bad \"Unknown server. Pass a URL or create a named server in servers.json.\"; return 1; }\n        local entry","content":"      jq -n --argjson ok \"$dok\" '{ok:($ok==1),dependencies:[\"bash\",\"curl\",\"jq\",\"base64\"]}'\n      return\n    fi ;;\n  esac\n  if [ -z \"$STDIO\" ]; then target=\"$1\"; shift; fi\n  case \"$target\" in @*) target=\"${target#@}\";; esac\n  if [ -n \"$target\" ]; then\n    case \"$target\" in\n      http://*|https://*) URL=\"$target\" ;;\n      *)\n        [ -f \"$CONFIG\" ] || { bad \"Unknown server. Pass a URL or create a named server in servers.json.\"; return 1; }\n        local entry","contentHash":"b6d50b97df82b3a3","metadata":{"filePath":"skills/figma-code/scripts/mcp-wire.sh","startLine":377,"endLine":388,"chunkType":"function_definiti