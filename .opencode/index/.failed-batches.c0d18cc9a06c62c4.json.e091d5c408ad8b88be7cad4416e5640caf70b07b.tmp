{"version":1,"chunks":[{"id":"chunk_cd4f7080a173cde0","texts":[{"text":"JavaScript variable declaration\nin figma-wire/tests/fake-devmode-server.js\nPurpose: HTTP/API\n\n// Hermetic Figma fixture. Reject incorrect handshakes and answer actual tool calls.\nconst http = require('http');","tokenCount":52}],"storageText":"JavaScript variable declaration\nin figma-wire/tests/fake-devmode-server.js\nPurpose: HTTP/API\n\n// Hermetic Figma fixture. Reject incorrect handshakes and answer actual tool calls.\nconst http = require('http');","content":"// Hermetic Figma fixture. Reject incorrect handshakes and answer actual tool calls.\nconst http = require('http');","contentHash":"7e708cb4f8b15fc8","metadata":{"filePath":"skills/figma-wire/tests/fake-devmode-server.js","startLine":1,"endLine":2,"chunkType":"lexical_declaration","language":"javascript","hash":"7e708cb4f8b15fc8"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":5,"lastAttempt":"2026-10-17T11:40:23.578Z"}
