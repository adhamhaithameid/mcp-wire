{"version":1,"chunks":[{"id":"chunk_6a2f8a7f07f5edd7","texts":[{"text":"bash function \"main\"\nin figma-design/scripts/mcp-wire.sh\nPurpose: file operations\n\n  case \"$cmd\" in\n    doctor) method=ping ;;\n    list|describe) method=tools/list; key=tools; tool=\"${1:-}\"; if [ \"$cmd\" = describe ] && [ -z \"$tool\" ]; then bad \"describe requires a tool name.\"; return 1; fi ;;\n    call)\n      method=tools/call; tool=\"${1:-}\"; [ -n \"$tool\" ] || { bad \"call requires a tool name.\"; return 1; }; shift\n      if [ $# -gt 0 ]; then\n        case \"$1\" in\n          -) tool_args=$(cat); shift ;;\n          @*) \n            [ -f \"${1#@}\" ] || { bad \"File not found: ${1#@}\"; return 1; }\n            tool_args=$(cat \"${1#@}\"); shift ;;\n          *) tool_args=\"$1\"; shift ;;","tokenCount":171}],"storageText":"bash function \"main\"\nin figma-design/scripts/mcp-wire.sh\nPurpose: file operations\n\n  case \"$cmd\" in\n    doctor) method=ping ;;\n    list|describe) method=tools/list; key=tools; tool=\"${1:-}\"; if [ \"$cmd\" = describe ] && [ -z \"$tool\" ]; then bad \"describe requires a tool name.\"; return 1; fi ;;\n    call)\n      method=tools/call; tool=\"${1:-}\"; [ -n \"$tool\" ] || { bad \"call requires a tool name.\"; return 1; }; shift\n      if [ $# -gt 0 ]; then\n        case \"$1\" in\n          -) tool_args=$(cat); shift ;;\n          @*) \n            [ -f \"${1#@}\" ] || { bad \"File not found: ${1#@}\"; return 1; }\n            tool_args=$(cat \"${1#@}\"); shift ;;\n          *) tool_args=\"$1\"; shift ;;","content":"  case \"$cmd\" in\n    doctor) method=ping ;;\n    list|describe) method=tools/list; key=tools; tool=\"${1:-}\"; if [ \"$cmd\" = describe ] && [ -z \"$tool\" ]; then bad \"describe requires a tool name.\"; return 1; fi ;;\n    call)\n      method=tools/call; tool=\"${1:-}\"; [ -n \"$tool\" ] || { bad \"call requires a tool name.\"; return 1; }; shift\n      if [ $# -gt 0 ]; then\n        case \"$1\" in\n          -) tool_args=$(cat); shift ;;\n          @*) \n            [ -f \"${1#@}\" ] || { bad \"File not found: ${1#@}\"; return 1; }\n            tool_args=$(cat \"${1#@}\"); shift ;;\n          *) tool_args=\"$1\"; shift ;;","contentHash":"1802825a984e7126","metadata":{"filePath":"skills/figma-design/scripts/mcp-wire.sh","startLine":431,"endLine":442,"chunkType":"function_definition","name":"main","language":"bash","hash":"1802825a984e7126"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.914Z"}
{"version":1,"chunks":[{"id":"chunk_062354a9cf2e8860","texts":[{"text":"bash function \"main\"\nin figma-design/scripts/mcp-wire.sh\nPurpose: error handling, file operations, data parsing, UI rendering\n\n            [ -f \"${1#@}\" ] || { bad \"File not found: ${1#@}\"; return 1; }\n            tool_args=$(cat \"${1#@}\"); shift ;;\n          *) tool_args=\"$1\"; shift ;;\n        esac\n      fi\n      params=$(jq -nc --arg name \"$tool\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" then {name:$name,arguments:$a} else error(\"object required\") end' 2>/dev/null) || { bad \"Tool arguments must be a JSON object.\"; return 1; } ;;\n    resources)\n      case \"${1:-list}\" in\n        list) method=resources/list; key=resources ;;\n        templates) method=resources/templates/list; key=resourceTemplates ;;\n        read) [ -n \"${2:-}\" ] || { bad \"resources read requires a URI.\"; return 1; }; method=resources/read; params=$(jq -nc --arg uri \"$2\" '{uri:$uri}') ;;\n        *) bad \"Use resources list, templates, or read <uri>.\"; return 1 ;;","tokenCount":238}],"storageText":"bash function \"main\"\nin figma-design/scripts/mcp-wire.sh\nPurpose: error handling, file operations, data parsing, UI rendering\n\n            [ -f \"${1#@}\" ] || { bad \"File not found: ${1#@}\"; return 1; }\n            tool_args=$(cat \"${1#@}\"); shift ;;\n          *) tool_args=\"$1\"; shift ;;\n        esac\n      fi\n      params=$(jq -nc --arg name \"$tool\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" then {name:$name,arguments:$a} else error(\"object required\") end' 2>/dev/null) || { bad \"Tool arguments must be a JSON object.\"; return 1; } ;;\n    resources)\n      case \"${1:-list}\" in\n        list) method=resources/list; key=resources ;;\n        templates) method=resources/templates/list; key=resourceTemplates ;;\n        read) [ -n \"${2:-}\" ] || { bad \"resources read requires a URI.\"; return 1; }; method=resources/read; params=$(jq -nc --arg uri \"$2\" '{uri:$uri}') ;;\n        *) bad \"Use resources list, templates, or read <uri>.\"; return 1 ;;","content":"            [ -f \"${1#@}\" ] || { bad \"File not found: ${1#@}\"; return 1; }\n            tool_args=$(cat \"${1#@}\"); shift ;;\n          *) tool_args=\"$1\"; shift ;;\n        esac\n      fi\n      params=$(jq -nc --arg name \"$tool\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" then {name:$name,arguments:$a} else error(\"object required\") end' 2>/dev/null) || { bad \"Tool arguments must be a JSON object.\"; return 1; } ;;\n    resources)\n      case \"${1:-list}\" in\n        list) method=resources/list; key=resources ;;\n        templates) method=resources/templates/list; key=resourceTemplates ;;\n        read) [ -n \"${2:-}\" ] || { bad \"resources read requires a URI.\"; return 1; }; method=resources/read; params=$(jq -nc --arg uri \"$2\" '{uri:$uri}') ;;\n        *) bad \"Use resources list, templates, or read <uri>.\"; return 1 ;;","contentHash":"81ee660d8e7cbf8d","metadata":{"filePath":"skills/figma-design/scripts/mcp-wire.sh","startLine":440,"endLine":451,"chunkType":"function_definition","name":"main","language":"bash","hash":"81ee660d8e7cbf8d"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.914Z"}
{"version":1,"chunks":[{"id":"chunk_0e852b746189dced","texts":[{"text":"bash function \"probe\"\nin figma-code/scripts/figma-wire.sh\nPurpose: HTTP/API, file operations, data parsing\n\nprobe() { # probe <url> [extra curl args...]\n  local url=\"$1\"; shift\n  local tf hdr\n  tf=\"$(mktemp)\"; hdr=\"$(mktemp)\"\n  PROBE_CODE=$(curl -sS -D \"$hdr\" -o \"$tf\" -w '%{http_code}' --max-time \"$PROBE_MAXTIME\" -X POST \"$url\" \\\n    -H 'Content-Type: application/json' -H 'Accept: application/json, text/event-stream' \\\n    -d \"$INIT_BODY\" \"$@\" 2>/dev/null) || PROBE_CODE=\"000\"\n  PROBE_BODY=\"$(tr '\\r\\n' '  ' < \"$tf\")\"\n  rm -f \"$tf\" \"$hdr\"\n}","tokenCount":136}],"storageText":"bash function \"probe\"\nin figma-code/scripts/figma-wire.sh\nPurpose: HTTP/API, file operations, data parsing\n\nprobe() { # probe <url> [extra curl args...]\n  local url=\"$1\"; shift\n  local tf hdr\n  tf=\"$(mktemp)\"; hdr=\"$(mktemp)\"\n  PROBE_CODE=$(curl -sS -D \"$hdr\" -o \"$tf\" -w '%{http_code}' --max-time \"$PROBE_MAXTIME\" -X POST \"$url\" \\\n    -H 'Content-Type: application/json' -H 'Accept: application/json, text/event-stream' \\\n    -d \"$INIT_BODY\" \"$@\" 2>/dev/null) || PROBE_CODE=\"000\"\n  PROBE_BODY=\"$(tr '\\r\\n' '  ' < \"$tf\")\"\n  rm -f \"$tf\" \"$hdr\"\n}","content":"probe() { # probe <url> [extra curl args...]\n  local url=\"$1\"; shift\n  local tf hdr\n  tf=\"$(mktemp)\"; hdr=\"$(mktemp)\"\n  PROBE_CODE=$(curl -sS -D \"$hdr\" -o \"$tf\" -w '%{http_code}' --max-time \"$PROBE_MAXTIME\" -X POST \"$url\" \\\n    -H 'Content-Type: application/json' -H 'Accept: application/json, text/event-stream' \\\n    -d \"$INIT_BODY\" \"$@\" 2>/dev/null) || PROBE_CODE=\"000\"\n  PROBE_BODY=\"$(tr '\\r\\n' '  ' < \"$tf\")\"\n  rm -f \"$tf\" \"$hdr\"\n}","contentHash":"01185da42cc275b9","metadata":{"filePath":"skills/figma-code/scripts/figma-wire.sh","startLine":65,"endLine":74,"chunkType":"function_definition","name":"probe","language":"bash","hash":"01185da42cc275b9"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":11,"lastAttempt":"2026-10-17T11:40:23.914Z"}
{"version":1,"chunks":[{"id":"chunk_681b4eb9d48c4780","texts":[{"text":"bash function \"is_devmode_body\"\nin figma-code/scripts/figma-wire.sh\n\nis_devmode_body() { grep -q 'Dev Mode MCP Server' <<<\"$PROBE_BODY\"; }","tokenCount":35}],"storageText":"bash function \"is_devmode_body\"\nin figma-code/scripts/figma-wire.sh\n\nis_devmode_body() { grep -q 'Dev Mode MCP Server' <<<\"$PROBE_BODY\"; }","content":"is_devmode_body() { grep -q 'Dev Mode MCP Server' <<<\"$PROBE_BODY\"; }","contentHash":"33ceebfd0142ae7b","metadata":{"filePath":"skills/figma-code/scripts/figma-wire.sh","startLine":75,"endLine":75,"chunkType":"function_definition","name":"is_devmode_body","language":"bash","hash":"33ceebfd0142ae7b"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":11,"lastAttempt":"2026-10-17T11:40:23.914Z"}
