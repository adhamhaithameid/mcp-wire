{"version":1,"chunks":[{"id":"chunk_1b8babd65b89b2fd","texts":[{"text":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: caching, HTTP/API, data parsing, state management\n\n          # parse flags\n          local allow_http=0 store_literal=0 headers=()\n          while [ $# -gt 0 ]; do\n            case \"$1\" in\n              --header) headers+=(\"$2\"); shift 2 ;;\n              --allow-http) allow_http=1; shift ;;\n              --store-literal) store_literal=1; shift ;;\n              *) bad \"Unknown flag $1\"; return 1 ;;\n            esac\n          done\n          [[ \"$name\" =~ ^[A-Za-z0-9_.-]+$ ]] || { bad \"Invalid server name.\"; return 1; }\n          case \"$url\" in http://*|https://*) : ;; *) bad \"URL must start with http:// or https://.\"; return 1 ;; esac","tokenCount":176}],"storageText":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: caching, HTTP/API, data parsing, state management\n\n          # parse flags\n          local allow_http=0 store_literal=0 headers=()\n          while [ $# -gt 0 ]; do\n            case \"$1\" in\n              --header) headers+=(\"$2\"); shift 2 ;;\n              --allow-http) allow_http=1; shift ;;\n              --store-literal) store_literal=1; shift ;;\n              *) bad \"Unknown flag $1\"; return 1 ;;\n            esac\n          done\n          [[ \"$name\" =~ ^[A-Za-z0-9_.-]+$ ]] || { bad \"Invalid server name.\"; return 1; }\n          case \"$url\" in http://*|https://*) : ;; *) bad \"URL must start with http:// or https://.\"; return 1 ;; esac","content":"          # parse flags\n          local allow_http=0 store_literal=0 headers=()\n          while [ $# -gt 0 ]; do\n            case \"$1\" in\n              --header) headers+=(\"$2\"); shift 2 ;;\n              --allow-http) allow_http=1; shift ;;\n              --store-literal) store_literal=1; shift ;;\n              *) bad \"Unknown flag $1\"; return 1 ;;\n            esac\n          done\n          [[ \"$name\" =~ ^[A-Za-z0-9_.-]+$ ]] || { bad \"Invalid server name.\"; return 1; }\n          case \"$url\" in http://*|https://*) : ;; *) bad \"URL must start with http:// or https://.\"; return 1 ;; esac","contentHash":"a880be0983902e60","metadata":{"filePath":"skills/figma-code/scripts/mcp-wire.sh","startLine":314,"endLine":325,"chunkType":"function_definition","name":"main","language":"bash","hash":"a880be0983902e60"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.911Z"}
{"version":1,"chunks":[{"id":"chunk_abbfc85ac0c239e9","texts":[{"text":"bash function \"main\"\nin figma-wire/scripts/mcp-wire.sh\nPurpose: file operations, configuration\n\n            [ -n \"${!varname:-}\" ] || { bad \"Required header environment variable is unset: $varname\"; return 1; }\n            hline=\"${hline//\\$\\{$varname\\}/${!varname}}\"\n          done\n          HEADERS+=(\"$hline\")\n        done < <(jq -r '.headers[]? // empty' <<<\"$entry\")\n        local envname headername\n        while IFS=$'\\t' read -r headername envname; do\n          [ -n \"$headername\" ] || continue\n          [[ \"$envname\" =~ ^[A-Za-z_][A-Za-z_0-9]*$ ]] && [[ \"$headername\" =~ ^[A-Za-z0-9-]+$ ]] || { bad \"Invalid headerEnv entry.\"; return 1; }\n          [ -n \"${!envname:-}\" ] || { bad \"Required header environment variable is unset.\"; return 1; }\n          [[ \"${!envname}\" != *$'\\r'* && \"${!envname}\" != *$'\\n'* ]] || { bad \"Header values cannot contain line breaks.\"; return 1; }\n          HEADERS+=(\"$headername: ${!envname}\")","tokenCount":234}],"storageText":"bash function \"main\"\nin figma-wire/scripts/mcp-wire.sh\nPurpose: file operations, configuration\n\n            [ -n \"${!varname:-}\" ] || { bad \"Required header environment variable is unset: $varname\"; return 1; }\n            hline=\"${hline//\\$\\{$varname\\}/${!varname}}\"\n          done\n          HEADERS+=(\"$hline\")\n        done < <(jq -r '.headers[]? // empty' <<<\"$entry\")\n        local envname headername\n        while IFS=$'\\t' read -r headername envname; do\n          [ -n \"$headername\" ] || continue\n          [[ \"$envname\" =~ ^[A-Za-z_][A-Za-z_0-9]*$ ]] && [[ \"$headername\" =~ ^[A-Za-z0-9-]+$ ]] || { bad \"Invalid headerEnv entry.\"; return 1; }\n          [ -n \"${!envname:-}\" ] || { bad \"Required header environment variable is unset.\"; return 1; }\n          [[ \"${!envname}\" != *$'\\r'* && \"${!envname}\" != *$'\\n'* ]] || { bad \"Header values cannot co