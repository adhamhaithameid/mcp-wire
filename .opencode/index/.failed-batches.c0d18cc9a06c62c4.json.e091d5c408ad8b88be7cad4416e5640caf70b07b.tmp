{"version":1,"chunks":[{"id":"chunk_9d57754b9ad1eef5","texts":[{"text":"bash function \"stdio_send\"\nin figma-pages/scripts/mcp-wire.sh\n\nstdio_send() { printf '%s\\n' \"$1\" >&3; }","tokenCount":26}],"storageText":"bash function \"stdio_send\"\nin figma-pages/scripts/mcp-wire.sh\n\nstdio_send() { printf '%s\\n' \"$1\" >&3; }","content":"stdio_send() { printf '%s\\n' \"$1\" >&3; }","contentHash":"3113aa9514d71bf0","metadata":{"filePath":"skills/figma-pages/scripts/mcp-wire.sh","startLine":128,"endLine":128,"chunkType":"function_definition","name":"stdio_send","language":"bash","hash":"3113aa9514d71bf0"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.911Z"}
{"version":1,"chunks":[{"id":"chunk_5d995a91cf7893b0","texts":[{"text":"bash function \"stdio_receive\"\nin figma-pages/scripts/mcp-wire.sh\nPurpose: user management, validation, error handling, logging, HTTP/API, file operations\n\nstdio_receive() {\n  local id=\"$1\" line deadline=$((SECONDS + TIMEOUT)) remaining\n  while [ \"$SECONDS\" -lt \"$deadline\" ]; do\n    remaining=$((deadline - SECONDS))\n    IFS= read -r -t \"$remaining\" line <&4 || break\n    if jq -e --argjson id \"$id\" 'type == \"object\" and .id == $id and (has(\"result\") or has(\"error\"))' <<<\"$line\" >/dev/null 2>&1; then\n      printf '%s\\n' \"$line\"; return 0\n    fi\n    # A one-shot client cannot answer server-initiated requests for user input.\n    if jq -e 'has(\"method\") and has(\"id\")' <<<\"$line\" >/dev/null 2>&1; then\n      stdio_send \"$(jq -c '{jsonrpc:\"2.0\",id:.id,error:{code:-32601,message:\"Client callbacks are not supported\"}}' <<<\"$line\")\" || return 1\n    fi\n  done\n  bad \"No matching stdio response. Check the command and keep server logs on stderr.\"\n  return 1\n}","tokenCount":240}],"storageText":"bash function \"stdio_receive\"\nin figma-pages/scripts/mcp-wire.sh\nPurpose: user management, validation, error handling, logging, HTTP/API, file operations\n\nstdio_receive() {\n  local id=\"$1\" line deadline=$((SECONDS + TIMEOUT)) remaining\n  while [ \"$SECONDS\" -lt \"$deadline\" ]; do\n    remaining=$((deadline - SECONDS))\n    IFS= read -r -t \"$remaining\" line <&4 || break\n    if jq -e --argjson id \"$id\" 'type == \"object\" and .id == $id and (has(\"result\") or has(\"error\"))' <<<\"$line\" >/dev/null 2>&1; then\n      printf '%s\\n' \"$line\"; return 0\n    fi\n    # A one-shot client cannot answer server-initiated requests for user input.\n    if jq -e 'has(\"method\") and has(\"id\")' <<<\"$line\" >/dev/null 2>&1; then\n      stdio_send \"$(jq -c '{jsonrpc:\"2.0\",id:.id,error:{code:-32601,message:\"Client callbacks are not supported\"}}' <<<\"$line\")\" || return 1\n    fi\n  done\n  bad \"No matching stdio response. Check the command and keep server logs on stderr.\"\n  return 1\n}","content":"stdio_receive() {\n  local id=\"$1\" line deadline=$((SECONDS + TIMEOUT)) remaining\n  while [ \"$SECONDS\" -lt \"$deadline\" ]; do\n    remaining=$((deadline - SECONDS))\n    IFS= read -r -t \"$remaining\" line <&4 || break\n    if jq -e --argjson id \"$id\" 'type == \"object\" and .id == $id and (has(\"result\") or has(\"error\"))' <<<\"$line\" >/dev/null 2>&1; then\n      printf '%s\\n' \"$line\"; return 0\n    fi\n    # A one-shot client cannot answer server-initiated requests for user input.\n    if jq -e 'has(\"method\") and has(\"id\")' <<<\"$line\" >/dev/null 2>&1; then\n      stdio_send \"$(jq -c '{jsonrpc:\"2.0\",id:.id,error:{code:-32601,message:\"Client callbacks are not supported\"}}' <<<\"$line\")\" || return 1\n    fi\n  done\n  bad \"No matching stdio response. Check the command and keep server logs on stderr.\"\n  return 1\n}","contentHash":"e5bb6fee85cf00be","metadata":{"filePath":"skills/figma-pages/scripts/mcp-wire.sh","startLine":129,"endLine":144,"chunkType":"function_definition","name":"stdio_receive","language":"bash","hash":"e5bb6fee85cf00be"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.911Z"}
{"version":1,"chunks":[{"id":"chunk_7439ec1f08a87082","texts":[{"text":"bash function \"connect\"\nin figma-pages/scripts/mcp-wire.sh\nPurpose: authorization, validation, error handling, logging, HTTP/API, file operations\n\nconnect() {\n  local init data version\n  init=$(jq -nc --arg p \"$PROTOCOL\" --arg v \"$VERSION\" '{jsonrpc:\"2.0\",id:1,method:\"initialize\",params:{protocolVersion:$p,capabilities:{},clientInfo:{name:\"mcp-wire\",version:$v}}}')\n  if [ -n \"$STDIO\" ]; then\n    local command=() arg\n    while IFS= read -r arg; do command+=(\"$arg\"); done < <(jq -r '.[]' <<<\"$STDIO\")\n    mkfifo \"$WORK/in\" \"$WORK/out\" || return 1\n    # Open both ends before launch to avoid FIFO-open deadlocks on Bash 3.2.\n    exec 3<>\"$WORK/in\" 4<>\"$WORK/out\"\n    \"${command[@]}\" <\"$WORK/in\" >\"$WORK/out\" 2>\"$WORK/server.log\" &\n    SERVER_PID=$!\n    stdio_send \"$init\" || return 1\n    data=$(stdio_receive 1) || return 1\n  else\n    http_post \"$init\" || return 1\n    data=$(parse_response \"$WORK/body\" 1) || { bad \"Invalid initialize response. Check that the URL serves MCP.\"; return 1; }\n    local session\n    session=$(awk 'tolower($1)==\"mcp-session-id:\" {sub(/\\r$/, \"\", $2); print $2; exit}' \"$WORK/headers\")\n    if [ -n \"$session\" ]; then SESSION_ID=\"$session\"; SESSION_HEADERS+=(\"-H\" \"Mcp-Session-Id: $session\"); TRANSPORT='session'; else TRANSPORT='stateless'; fi\n    if grep -qi '^content-type:.*application/json' \"$WORK/headers\"; then REPLY='json'; else REPLY='sse'; fi\n  fi\n  jq -e '.error' <<<\"$data\" >/dev/null 2>&1 && { bad \"MCP initialization failed. Check server access and protocol support.\"; return 1; }\n  version=$(jq -r '.result.protocolVersion // empty' <<<\"$data\")\n  case \"$version\" in\n    2025-03-26|2025-06-18|2025-11-25) : ;;\n    *) bad \"Unsupported negotiated MCP version. Use a server with a supported protocol version.\"; return 1 ;;\n  esac\n  if [ -n \"$STDIO\" ]; then\n    stdio_send '{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}'\n  else\n    SESSION_HEADERS+=(\"-H\" \"MCP-Protocol-Version: $version\")\n    http_post '{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}'\n  fi\n}","tokenCount":504}],"storageText":"bash function \"connect\"\nin figma-pages/scripts/mcp-wire.sh\nPurpose: authorization, validation, error handling, logging, HTTP/API, file operations\n\nconnect() {\n  local init data version\n  init=$(jq -nc --arg p \"$PROTOCOL\" --arg v \"$VERSION\" '{jsonrpc:\"2.0\",id:1,method:\"initialize\",params:{protocolVersion:$p,capabilities:{},clientInfo:{name:\"mcp-wire\",version:$v}}}')\n  if [ -n \"$STDIO\" ]; then\n    local command=() arg\n    while IFS= read -r arg; do command+=(\"$arg\"); done < <(jq -r '.[]' <<<\"$STDIO\")\n    mkfifo \"$WORK/in\" \"$WORK/out\" || return 1\n    # Open both ends before launch to avoid FIFO-open deadlocks on Bash 3.2.\n    exec 3<>\"$WORK/in\" 4<>\"$WORK/out\"\n    \"${command[@]}\" <\"$WORK/in\" >\"$WORK/out\" 2>\"$WORK/server.log\" &\n    SERVER_PID=$!\n    stdio_send \"$init\" || return 1\n    data=$(stdio_receive 1) || return 1\n  else\n    http_post \"$init\" || return 1\n    data=$(parse_response \"$WORK/body\" 1) || { bad \"Invalid initialize response. Check that the URL serves MCP.\"; return 1; }\n    local session\n    session=$(awk 'tolower($1)==\"mcp-session-id:\" {sub(/\\r$/, \"\", $2); print $2; exit}' \"$WORK/headers\")\n    if [ -n \"$session\" ]; then SESSION_ID=\"$session\"; SESSION_HEADERS+=(\"-H\" \"Mcp-Session-Id: $session\"); TRANSPORT='session'; else TRANSPORT='stateless'; fi\n    if grep -qi '^content-type:.*application/json' \"$WORK/headers\"; then REPLY='json'; else REPLY='sse'; fi\n  fi\n  jq -e '.error' <<<\"$data\" >/dev/null 2>&1 && { bad \"MCP initialization failed. Check server access and protocol support.\"; return 1; }\n  version=$(jq -r '.result.protocolVersion // empty' <<<\"$data\")\n  case \"$version\" in\n    2025-03-26|2025-06-18|2025-11-25) : ;;\n    *) bad \"Unsupported negotiated MCP version. Use a server with a supported protocol version.\"; return 1 ;;\n  esac\n  if [ -n \"$STDIO\" ]; then\n    stdio_send '{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}'\n  else\n    SESSION_HEADERS+=(\"-H\" \"MCP-Protocol-Version: $version\")\n    http_post '{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}'\n  fi\n}","content":"connect() {\n  local init data version\n  init=$(jq -nc --arg p \"$PROTOCOL\" --arg v \"$VERSION\" '{jsonrpc:\"2.0\",id:1,method:\"initialize\",params:{protocolVersion:$p,capabilities:{},clientInfo:{name:\"mcp-wire\",version:$v}}}')\n  if [ -n \"$STDIO\" ]; then\n    local command=() arg\n    while IFS= read -r arg; do command+=(\"$arg\"); done < <(jq -r '.[]' <<<\"$STDIO\")\n    mkfifo \"$WORK/in\" \"$WORK/out\" || return 1\n    # Open both ends before launch to avoid FIFO-open deadlocks on Bash 3.2.\n    exec 3<>\"$WORK/in\" 4<>\"$WORK/out\"\n    \"${command[@]}\" <\"$WORK/in\" >\"$WORK/out\" 2>\"$WORK/server.log\" &\n    SERVER_PID=$!\n    stdio_send \"$init\" || return 1\n    data=$(stdio_receive 1) || return 1\n  else\n    http_post \"$init\" || return 1\n    data=$(parse_response \"$WORK/body\" 1) || { bad \"Invalid initialize response. Check that the URL serves MCP.\"; return 1; }\n    local session\n    session=$(awk 'tolower($1)==\"mcp-session-id:\" {sub(/\\r$/, \"\", $2); print $2; exit}' \"$WORK/headers\")\n    if [ -n \"$session\" ]; then SESSION_ID=\"$session\"; SESSION_HEADERS+=(\"-H\" \"Mcp-Session-Id: $session\"); TRANSPORT='session'; else TRANSPORT='stateless'; fi\n    if grep -qi '^content-type:.*application/json' \"$WORK/headers\"; then REPLY='json'; else REPLY='sse'; fi\n  fi\n  jq -e '.error' <<<\"$data\" >/dev/null 2>&1 && { bad \"MCP initialization failed. Check server access and protocol support.\"; return 1; }\n  version=$(jq -r '.result.protocolVersion // empty' <<<\"$data\")\n  case \"$version\" in\n    2025-03-26|2025-06-18|2025-11-25) : ;;\n    *) bad \"Unsupported negotiated MCP version. Use a server with a supported protocol version.\"; return 1 ;;\n  esac\n  if [ -n \"$STDIO\" ]; then\n    stdio_send '{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}'\n  else\n    SESSION_HEADERS+=(\"-H\" \"MCP-Protocol-Version: $version\")\n    http_post '{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}'\n  fi\n}","contentHash":"bee45fab0ce8bad8","metadata":{"filePath":"skills/figma-pages/scripts/mcp-wire.sh","startLine":146,"endLine":179,"chunkType":"function_definition","name":"connect","language":"bash","hash":"bee45fab0ce8bad8"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.911Z"}
{"version":1,"chunks":[{"id":"chunk_f4dcd40d6e88b199","texts":[{"text":"bash function \"send_request\"\nin figma-pages/scripts/mcp-wire.sh\nPurpose: authorization, validation, error handling, HTTP/API, data parsing, testing\n\nsend_request() {\n  local body=\"$1\" id data\n  id=$(jq -c '.id' <<<\"$body\")\n  if [ -n \"$STDIO\" ]; then\n    stdio_send \"$body\" || return 1\n    data=$(stdio_receive \"$id\") || return 1\n  else\n    http_post \"$body\" || return 1\n    data=$(parse_response \"$WORK/body\" \"$id\") || { bad \"Invalid MCP response. Check the server response format.\"; return 1; }\n  fi\n  if jq -e 'has(\"error\")' <<<\"$data\" >/dev/null 2>&1; then\n    bad \"MCP request failed (code $(jq -r '.error.code // \"unknown\"' <<<\"$data\")). Inspect the tool schema and server access.\"\n    return 1\n  fi\n  printf '%s\\n' \"$data\"\n}","tokenCount":183}],"storageText":"bash function \"send_request\"\nin figma-pages/scripts/mcp-wire.sh\nPurpose: authorization, validation, error handling, HTTP/API, data parsing, testing\n\nsend_request() {\n  local body=\"$1\" id data\n  id=$(jq -c '.id' <<<\"$body\")\n  if [ -n \"$STDIO\" ]; then\n    stdio_send \"$body\" || return 1\n    data=$(stdio_receive \"$id\") || return 1\n  else\n    http_post \"$body\" || return 1\n    data=$(parse_response \"$WORK/body\" \"$id\") || { bad \"Invalid MCP response. Check the server response format.\"; return 1; }\n  fi\n  if jq -e 'has(\"error\")' <<<\"$data\" >/dev/null 2>&1; then\n    bad \"MCP request failed (code $(jq -r '.error.code // \"unknown\"' <<<\"$data\")). Inspect the tool schema and server access.\"\n    return 1\n  fi\n  printf '%s\\n' \"$data\"\n}","content":"send_request() {\n  local body=\"$1\" id data\n  id=$(jq -c '.id' <<<\"$body\")\n  if [ -n \"$STDIO\" ]; then\n    stdio_send \"$body\" || return 1\n    data=$(stdio_receive \"$id\") || return 1\n  else\n    http_post \"$body\" || return 1\n    data=$(parse_response \"$WORK/body\" \"$id\") || { bad \"Invalid MCP response. Check the server response format.\"; return 1; }\n  fi\n  if jq -e 'has(\"error\")' <<<\"$data\" >/dev/null 2>&1; then\n    bad \"MCP request failed (code $(jq -r '.error.code // \"unknown\"' <<<\"$data\")). Inspect the tool schema and server access.\"\n    return 1\n  fi\n  printf '%s\\n' \"$data\"\n}","contentHash":"935f29f98965cc1c","metadata":{"filePath":"skills/figma-pages/scripts/mcp-wire.sh","startLine":181,"endLine":196,"chunkType":"function_definition","name":"send_request","language":"bash","hash":"935f29f98965cc1c"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.911Z"}
