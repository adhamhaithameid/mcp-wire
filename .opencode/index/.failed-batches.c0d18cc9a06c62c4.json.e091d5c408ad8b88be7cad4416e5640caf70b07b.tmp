{"version":1,"chunks":[{"id":"chunk_9593810907c15a88","texts":[{"text":"bash function \"toml_remove_block\"\nin figma-code/scripts/figma-wire.sh\nPurpose: file operations\n\n# --- TOML (Codex) helpers -------------------------------------------------------\ntoml_remove_block() { # $1 block-name $2 file -> stdout\n  awk -v hdr=\"[$1]\" '\n    $0 == hdr { skip = 1; next }\n    skip && /^\\[/ { skip = 0 }\n    !skip { print }\n  ' \"$2\"\n}","tokenCount":88}],"storageText":"bash function \"toml_remove_block\"\nin figma-code/scripts/figma-wire.sh\nPurpose: file operations\n\n# --- TOML (Codex) helpers -------------------------------------------------------\ntoml_remove_block() { # $1 block-name $2 file -> stdout\n  awk -v hdr=\"[$1]\" '\n    $0 == hdr { skip = 1; next }\n    skip && /^\\[/ { skip = 0 }\n    !skip { print }\n  ' \"$2\"\n}","content":"# --- TOML (Codex) helpers -------------------------------------------------------\ntoml_remove_block() { # $1 block-name $2 file -> stdout\n  awk -v hdr=\"[$1]\" '\n    $0 == hdr { skip = 1; next }\n    skip && /^\\[/ { skip = 0 }\n    !skip { print }\n  ' \"$2\"\n}","contentHash":"28ea9863c0ab4e1a","metadata":{"filePath":"skills/figma-code/scripts/figma-wire.sh","startLine":235,"endLine":242,"chunkType":"function_definition","name":"toml_remove_block","language":"bash","hash":"28ea9863c0ab4e1a"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":11,"lastAttempt":"2026-10-17T11:40:24.003Z"}
{"version":1,"chunks":[{"id":"chunk_5eb48e9c50234979","texts":[{"text":"bash function \"toml_upsert\"\nin figma-code/scripts/figma-wire.sh\nPurpose: file operations\n\ntoml_upsert() { # $1 file $2 block-name $3... key=value lines\n  local file=\"$1\" block=\"$2\"; shift 2\n  local tmp; tmp=\"$(mktemp)\"\n  toml_remove_block \"$block\" \"$file\" > \"$tmp\"\n  printf '\\n[%s]\\n' \"$block\" >> \"$tmp\"\n  local kv; for kv in \"$@\"; do printf '%s\\n' \"$kv\" >> \"$tmp\"; done\n  mv -f \"$tmp\" \"$file\"\n}","tokenCount":99}],"storageText":"bash function \"toml_upsert\"\nin figma-code/scripts/figma-wire.sh\nPurpose: file operations\n\ntoml_upsert() { # $1 file $2 block-name $3... key=value lines\n  local file=\"$1\" block=\"$2\"; shift 2\n  local tmp; tmp=\"$(mktemp)\"\n  toml_remove_block \"$block\" \"$file\" > \"$tmp\"\n  printf '\\n[%s]\\n' \"$block\" >> \"$tmp\"\n  local kv; for kv in \"$@\"; do printf '%s\\n' \"$kv\" >> \"$tmp\"; done\n  mv -f \"$tmp\" \"$file\"\n}","content":"toml_upsert() { # $1 file $2 block-name $3... key=value lines\n  local file=\"$1\" block=\"$2\"; shift 2\n  local tmp; tmp=\"$(mktemp)\"\n  toml_remove_block \"$block\" \"$file\" > \"$tmp\"\n  printf '\\n[%s]\\n' \"$block\" >> \"$tmp\"\n  local kv; for kv in \"$@\"; do printf '%s\\n' \"$kv\" >> \"$tmp\"; done\n  mv -f \"$tmp\" \"$file\"\n}","contentHash":"21204e7e1d17c617","metadata":{"filePath":"skills/figma-code/scripts/figma-wire.sh","startLine":244,"endLine":251,"chunkType":"function_definition","name":"toml_upsert","language":"bash","hash":"21204e7e1d17c617"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":11,"lastAttempt":"2026-10-17T11:40:24.003Z"}
{"version":1,"chunks":[{"id":"chunk_ab764d770d75a132","texts":[{"text":"bash function \"toml_block_url\"\nin figma-code/scripts/figma-wire.sh\nPurpose: file operations\n\ntoml_block_url() { # $1 block-name $2 file -> url or empty\n  awk -v hdr=\"[$1]\" '\n    $0 == hdr { inblk = 1; next }\n    inblk && /^\\[/ { inblk = 0 }\n    inblk && $1 == \"url\" { gsub(/\"/, \"\", $3); print $3; exit }\n  ' \"$2\" 2>/dev/null\n}","tokenCount":82}],"storageText":"bash function \"toml_block_url\"\nin figma-code/scripts/figma-wire.sh\nPurpose: file operations\n\ntoml_block_url() { # $1 block-name $2 file -> url or empty\n  awk -v hdr=\"[$1]\" '\n    $0 == hdr { inblk = 1; next }\n    inblk && /^\\[/ { inblk = 0 }\n    inblk && $1 == \"url\" { gsub(/\"/, \"\", $3); print $3; exit }\n  ' \"$2\" 2>/dev/null\n}","content":"toml_block_url() { # $1 block-name $2 file -> url or empty\n  awk -v hdr=\"[$1]\" '\n    $0 == hdr { inblk = 1; next }\n    inblk && /^\\[/ { inblk = 0 }\n    inblk && $1 == \"url\" { gsub(/\"/, \"\", $3); print $3; exit }\n  ' \"$2\" 2>/dev/null\n}","contentHash":"1cf3bc24adf0748e","metadata":{"filePath":"skills/figma-code/scripts/figma-wire.sh","startLine":253,"endLine":259,"chunkType":"function_definition","name":"toml_block_url","language":"bash","hash":"1cf3bc24adf0748e"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":11,"lastAttempt":"2026-10-17T11:40:24.003Z"}
{"version":1,"chunks":[{"id":"chunk_084293b04b5d7990","texts":[{"text":"bash function \"toml_block_has\"\nin figma-code/scripts/figma-wire.sh\nPurpose: file operations\n\ntoml_block_has() { # $1 block-name $2 file\n  grep -q \"^\\[$1\\]\" \"$2\" 2>/dev/null\n}","tokenCount":44}],"storageText":"bash function \"toml_block_has\"\nin figma-code/scripts/figma-wire.sh\nPurpose: file operations\n\ntoml_block_has() { # $1 block-name $2 file\n  grep -q \"^\\[$1\\]\" \"$2\" 2>/dev/null\n}","content":"toml_block_has() { # $1 block-name $2 file\n  grep -q \"^\\[$1\\]\" \"$2\" 2>/dev/null\n}","contentHash":"499ca00905cef70b","metadata":{"filePath":"skills/figma-code/scripts/figma-wire.sh","startLine":261,"endLine":263,"chunkType":"function_definition","name":"toml_block_has","language":"bash","hash":"499ca00905cef70b"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":11,"lastAttempt":"2026-10-17T11:40:24.003Z"}
{"version":1,"chunks":[{"id":"chunk_5d6c9d9bb0509bf3","texts":[{"text":"bash function \"codex_set_local\"\nin figma-code/scripts/figma-wire.sh\n\ncodex_set_local() { toml_upsert \"$2\" \"mcp_servers.figma-local\" \"url = \\\"$1\\\"\"; }","tokenCount":38}],"storageText":"bash function \"codex_set_local\"\nin figma-code/scripts/figma-wire.sh\n\ncodex_set_local() { toml_upsert \"$2\" \"mcp_servers.figma-local\" \"url = \\\"$1\\\"\"; }","content":"codex_set_local() { toml_upsert \"$2\" \"mcp_servers.figma-local\" \"url = \\\"$1\\\"\"; }","contentHash":"cb273ea80bb56a15","metadata":{"filePath":"skills/figma-code/scripts/figma-wire.sh","startLine":265,"endLine":265,"chunkType":"function_definition","name":"codex_set_local","language":"bash","hash":"cb273ea80bb56a15"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":11,"lastAttempt":"2026-10-17T11:40:24.003Z"}
{"version":1,"chunks":[{"id":"chunk_7cce746f21cec7d8","texts":[{"text":"bash function \"codex_set_remote_auth\"\nin figma-code/scripts/figma-wire.sh\nPurpose: authentication, token management, HTTP/API, file operations\n\ncodex_set_remote_auth() { # $1 token $2 region $3 file\n  local auth region lines\n  auth=$(jq -Rn --arg t \"Bearer $1\" '$t')\n  region=$(jq -Rn --arg r \"$2\" '$r')\n  lines=( \"url = \\\"$REMOTE_URL\\\"\" )\n  if [ -n \"$2\" ]; then lines+=( \"http_headers = { Authorization = $auth, X-Figma-Region = $region }\" )\n  else lines+=( \"http_headers = { Authorization = $auth }\" ); fi\n  toml_upsert \"$3\" \"mcp_servers.figma\" \"${lines[@]}\"\n}","tokenCount":141}],"storageText":"bash function \"codex_set_remote_auth\"\nin figma-code/scripts/figma-wire.sh\nPurpose: authentication, token management, HTTP/API, file operations\n\ncodex_set_remote_auth() { # $1 token $2 region $3 file\n  local auth region lines\n  auth=$(jq -Rn --arg t \"Bearer $1\" '$t')\n  region=$(jq -Rn --arg r \"$2\" '$r')\n  lines=( \"url = \\\"$REMOTE_URL\\\"\" )\n  if [ -n \"$2\" ]; then lines+=( \"http_headers = { Authorization = $auth, X-Figma-Region = $region }\" )\n  else lines+=( \"http_headers = { Authorization = $auth }\" ); fi\n  toml_upsert \"$3\" \"mcp_servers.figma\" \"${lines[@]}\"\n}","content":"codex_set_remote_auth() { # $1 token $2 region $3 file\n  local auth region lines\n  auth=$(jq -Rn --arg t \"Bearer $1\" '$t')\n  region=$(jq -Rn --arg r \"$2\" '$r')\n  lines=( \"url = \\\"$REMOTE_URL\\\"\" )\n  if [ -n \"$2\" ]; then lines+=( \"http_headers = { Authorization = $auth, X-Figma-Region = $region }\" )\n  else lines+=( \"http_headers = { Authorization = $auth }\" ); fi\n  toml_upsert \"$3\" \"mcp_servers.figma\" \"${lines[@]}\"\n}","contentHash":"bd589241451a1896","metadata":{"filePath":"skills/figma-code/scripts/figma-wire.sh","startLine":266,"endLine":274,"chunkType":"function_definition","name":"codex_set_remote_auth","language":"bash","hash":"bd589241451a1896"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":11,"lastAttempt":"2026-10-17T11:40:24.003Z"}
{"version":1,"chunks":[{"id":"chunk_9ec6e46134efb0cd","texts":[{"text":"bash function \"codex_remote_off\"\nin figma-code/scripts/figma-wire.sh\nPurpose: file operations\n\ncodex_remote_off() { # $1 file — Codex has no portable disabled flag; remove the block\n  local tmp; tmp=\"$(mktemp)\"\n  toml_remove_block \"mcp_servers.figma\" \"$1\" > \"$tmp\"\n  mv -f \"$tmp\" \"$1\"\n}","tokenCount":72}],"storageText":"bash function \"codex_remote_off\"\nin figma-code/scripts/figma-wire.sh\nPurpose: file operations\n\ncodex_remote_off() { # $1 file — Codex has no portable disabled flag; remove the block\n  local tmp; tmp=\"$(mktemp)\"\n  toml_remove_block \"mcp_servers.figma\" \"$1\" > \"$tmp\"\n  mv -f \"$tmp\" \"$1\"\n}","content":"codex_remote_off() { # $1 file — Codex has no portable disabled flag; remove the block\n  local tmp; tmp=\"$(mktemp)\"\n  toml_remove_block \"mcp_servers.figma\" \"$1\" > \"$tmp\"\n  mv -f \"$tmp\" \"$1\"\n}","contentHash":"35dbf85876495d4e","metadata":{"filePath":"skills/figma-code/scripts/figma-wire.sh","startLine":275,"endLine":279,"chunkType":"function_definition","name":"codex_remote_off","language":"bash","hash":"35dbf85876495d4e"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":11,"lastAttempt":"2026-10-17T11:40:24.003Z"}
{"version":1,"chunks":[{"id":"chunk_d0b8b94cfab1a87e","texts":[{"text":"bash function \"set_local_entry\"\nin figma-code/scripts/figma-wire.sh\nPurpose: file operations, data parsing\n\n# --- harness-facade ops ---------------------------------------------------------\nset_local_entry() { # $1 harness $2 url $3 file\n  case \"$1\" in\n    codex) codex_set_local \"$2\" \"$3\" ;;\n    *)     json_set_local \"$1\" \"$2\" \"$3\" ;;\n  esac\n}","tokenCount":87}],"storageText":"bash function \"set_local_entry\"\nin figma-code/scripts/figma-wire.sh\nPurpose: file operations, data parsing\n\n# --- harness-facade ops ---------------------------------------------------------\nset_local_entry() { # $1 harness $2 url $3 file\n  case \"$1\" in\n    codex) codex_set_local \"$2\" \"$3\" ;;\n    *)     json_set_local \"$1\" \"$2\" \"$3\" ;;\n  esac\n}","content":"# --- harness-facade ops ---------------------------------------------------------\nset_local_entry() { # $1 harness $2 url $3 file\n  case \"$1\" in\n    codex) codex_set_local \"$2\" \"$3\" ;;\n    *)     json_set_local \"$1\" \"$2\" \"$3\" ;;\n  esac\n}","contentHash":"88ea980cf4f3df79","metadata":{"filePath":"skills/figma-code/scripts/figma-wire.sh","startLine":281,"endLine":287,"chunkType":"function_definition","name":"set_local_entry","language":"bash","hash":"88ea980cf4f3df79"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":11,"lastAttempt":"2026-10-17T11:40:24.003Z"}
