{"version":1,"chunks":[{"id":"chunk_3413c537cc5f0a68","texts":[{"text":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\n      *)\n        [ -f \"$CONFIG\" ] || { bad \"Unknown server. Pass a URL or create a named server in servers.json.\"; return 1; }\n        local entry\n        entry=$(jq -ec --arg n \"$target\" '.servers[$n] | select(type == \"object\")' \"$CONFIG\") || { bad \"Server name not found in the registry.\"; return 1; }\n        jq -e '(.headerEnv // {}) | type == \"object\" and all(to_entries[]; (.value|type)==\"string\")' <<<\"$entry\" >/dev/null || { bad \"headerEnv must map header names to environment variable names.\"; return 1; }\n        URL=$(jq -r '.url // empty' <<<\"$entry\")\n        STDIO=$(jq -c '.command // empty' <<<\"$entry\")\n        # allow_http honored\n        local allow_http\n        allow_http=$(jq -r '.allow_http // false' <<<\"$entry\")\n        [ \"$allow_http\" != true ] || ALLOW_HTTP=1\n        # headers array with ${VAR} expansion","tokenCount":234}],"storageText":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\n      *)\n        [ -f \"$CONFIG\" ] || { bad \"Unknown server. Pass a URL or create a named server in servers.json.\"; return 1; }\n        local entry\n        entry=$(jq -ec --arg n \"$target\" '.servers[$n] | select(type == \"object\")' \"$CONFIG\") || { bad \"Server name not found in the registry.\"; return 1; }\n        jq -e '(.headerEnv // {}) | type == \"object\" and all(to_entries[]; (.value|type)==\"string\")' <<<\"$entry\" >/dev/null || { bad \"headerEnv must map header names to environment variable names.\"; return 1; }\n        URL=$(jq -r '.url // empty' <<<\"$entry\")\n        STDIO=$(jq -c '.command // empty' <<<\"$entry\")\n        # allow_http honored\n        local allow_http\n        allow_http=$(jq -r '.allow_http // false' <<<\"$entry\")\n        [ \"$allow_http\" != true ] || ALLOW_HTTP=1\n        # headers array with ${VAR} expansion","content":"      *)\n        [ -f \"$CONFIG\" ] || { bad \"Unknown server. Pass a URL or create a named server in servers.json.\"; return 1; }\n        local entry\n        entry=$(jq -ec --arg n \"$target\" '.servers[$n] | select(type == \"object\")' \"$CONFIG\") || { bad \"Server name not found in the registry.\"; return 1; }\n        jq -e '(.headerEnv // {}) | type == \"object\" and all(to_entries[]; (.value|type)==\"string\")' <<<\"$entry\" >/dev/null || { bad \"headerEnv must map header names to environment variable names.\"; return 1; }\n        URL=$(jq -r '.url // empty' <<<\"$entry\")\n        STDIO=$(jq -c '.command // empty' <<<\"$entry\")\n        # allow_http honored\n        local allow_http\n        allow_http=$(jq -r '.allow_http // false' <<<\"$entry\")\n        [ \"$allow_http\" != true ] || ALLOW_HTTP=1\n        # headers array with ${VAR} expansion","contentHash":"18c2a6d6cf6611ca","metadata":{"filePath":"skills/figma-code/scripts/mcp-wire.sh","startLine":386,"endLine":397,"chunkType":"function_definition","name":"main","language":"bash","hash":"18c2a6d6cf6611ca"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.771Z"}
{"version":1,"chunks":[{"id":"chunk_e5a803d474e49c23","texts":[{"text":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: HTTP/API, file operations, configuration\n\n        allow_http=$(jq -r '.allow_http // false' <<<\"$entry\")\n        [ \"$allow_http\" != true ] || ALLOW_HTTP=1\n        # headers array with ${VAR} expansion\n        local hline varname\n        while IFS= read -r hline; do\n          [ -n \"$hline\" ] || continue\n          # expand ${VAR}\n          while [[ \"$hline\" =~ \\$\\{([A-Za-z_][A-Za-z_0-9]*)\\} ]]; do\n            varname=\"${BASH_REMATCH[1]}\"\n            [ -n \"${!varname:-}\" ] || { bad \"Required header environment variable is unset: $varname\"; return 1; }\n            hline=\"${hline//\\$\\{$varname\\}/${!varname}}\"\n          done","tokenCount":173}],"storageText":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: HTTP/API, file operations, configuration\n\n        allow_http=$(jq -r '.allow_http // false' <<<\"$entry\")\n        [ \"$allow_http\" != true ] || ALLOW_HTTP=1\n        # headers array with ${VAR} expansion\n        local hline varname\n        while IFS= read -r hline; do\n          [ -n \"$hline\" ] || continue\n          # expand ${VAR}\n          while [[ \"$hline\" =~ \\$\\{([A-Za-z_][A-Za-z_0-9]*)\\} ]]; do\n            varname=\"${BASH_REMATCH[1]}\"\n            [ -n \"${!varname:-}\" ] || { bad \"Required header environment variable is unset: $varname\"; return 1; }\n            hline=\"${hline//\\$\\{$varname\\}/${!varname}}\"\n          done","content":"        allow_http=$(jq -r '.allow_http // false' <<<\"$entry\")\n        [ \"$allow_http\" != true ] || ALLOW_HTTP=1\n        # headers array with ${VAR} expansion\n        local hline varname\n        while IFS= read -r hline; do\n          [ -n \"$hline\" ] || continue\n          # expand ${VAR}\n          while [[ \"$hline\" =~ \\$\\{([A-Za-z_][A-Za-z_0-9]*)\\} ]]; do\n            varname=\"${BASH_REMATCH[1]}\"\n            [ -n \"${!varname:-}\" ] || { bad \"Required header environment variable is unset: $varname\"; return 1; }\n            hline=\"${hline//\\$\\{$varname\\}/${!varname}}\"\n          done","contentHash":"b71716c684c4de02","metadata":{"filePath":"skills/figma-code/scripts/mcp-wire.sh","startLine":395,"endLine":406,"chunkType":"function_definition","name":"main","language":"bash","hash":"b71716c684c4de02"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.771Z"}
{"version":1,"chunks":[{"id":"chunk_c8f3d2e73ae57780","texts":[{"text":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: file operations, configuration\n\n            [ -n \"${!varname:-}\" ] || { bad \"Required header environment variable is unset: $varname\"; return 1; }\n            hline=\"${hline//\\$\\{$varname\\}/${!varname}}\"\n          done\n          HEADERS+=(\"$hline\")\n        done < <(jq -r '.headers[]? // empty' <<<\"$entry\")\n        local envname headername\n        while IFS=$'\\t' read -r headername envname; do\n          [ -n \"$headername\" ] || continue\n          [[ \"$envname\" =~ ^[A-Za-z_][A-Za-z_0-9]*$ ]] && [[ \"$headername\" =~ ^[A-Za-z0-9-]+$ ]] || { bad \"Invalid headerEnv entry.\"; return 1; }\n          [ -n \"${!envname:-}\" ] || { bad \"Required header environment variable is unset.\"; return 1; }\n          [[ \"${!envname}\" != *$'\\r'* && \"${!envname}\" != *$'\\n'* ]] || { bad \"Header values cannot contain line breaks.\"; return 1; }\n          HEADERS+=(\"$headername: ${!envname}\")","tokenCount":234}],"storageText":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: file operations, configuration\n\n            [ -n \"${!varname:-}\" ] || { bad \"Required header environment variable is unset: $varname\"; return 1; }\n            hline=\"${hline//\\$\\{$varname\\}/${!varname}}\"\n          done\n          HEADERS+=(\"$hline\")\n        done < <(jq -r '.headers[]? // empty' <<<\"$entry\")\n        local envname headername\n        while IFS=$'\\t' read -r headername envname; do\n          [ -n \"$headername\" ] || continue\n          [[ \"$envname\" =~ ^[A-Za-z_][A-Za-z_0-9]*$ ]] && [[ \"$headername\" =~ ^[A-Za-z0-9-]+$ ]] || { bad \"Invalid headerEnv entry.\"; return 1; }\n          [ -n \"${!envname:-}\" ] || { bad \"Required header environment variable is unset.\"; return 1; }\n          [[ \"${!envname}\" != *$'\\r'* && \"${!envname}\" != *$'\\n'* ]] || { bad \"Header values cannot contain line breaks.\"; return 1; }\n          HEADERS+=(\"$headername: ${!envname}\")","content":"            [ -n \"${!varname:-}\" ] || { bad \"Required header environment variable is unset: $varname\"; return 1; }\n            hline=\"${hline//\\$\\{$varname\\}/${!varname}}\"\n          done\n          HEADERS+=(\"$hline\")\n        done < <(jq -r '.headers[]? // empty' <<<\"$entry\")\n        local envname headername\n        while IFS=$'\\t' read -r headername envname; do\n          [ -n \"$headername\" ] || continue\n          [[ \"$envname\" =~ ^[A-Za-z_][A-Za-z_0-9]*$ ]] && [[ \"$headername\" =~ ^[A-Za-z0-9-]+$ ]] || { bad \"Invalid headerEnv entry.\"; return 1; }\n          [ -n \"${!envname:-}\" ] || { bad \"Required header environment variable is unset.\"; return 1; }\n          [[ \"${!envname}\" != *$'\\r'* && \"${!envname}\" != *$'\\n'* ]] || { bad \"Header values cannot contain line breaks.\"; return 1; }\n          HEADERS+=(\"$headername: ${!envname}\")","contentHash":"becda311edd1b05e","metadata":{"filePath":"skills/figma-code/scripts/mcp-wire.sh","startLine":404,"endLine":415,"chunkType":"function_definition","name":"main","language":"bash","hash":"becda311edd1b05e"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.771Z"}
{"version":1,"chunks":[{"id":"chunk_41bc4ca05b0832f0","texts":[{"text":"bash function \"main\"\nin figma-wire/scripts/mcp-wire.sh\nPurpose: error handling, file operations, data parsing, UI rendering\n\n        templates) method=resources/templates/list; key=resourceTemplates ;;\n        read) [ -n \"${2:-}\" ] || { bad \"resources read requires a URI.\"; return 1; }; method=resources/read; params=$(jq -nc --arg uri \"$2\" '{uri:$uri}') ;;\n        *) bad \"Use resources list, templates, or read <uri>.\"; return 1 ;;\n      esac ;;\n    prompts)\n      case \"${1:-list}\" in\n        list) method=prompts/list; key=prompts ;;\n        get) [ -n \"${2:-}\" ] || { bad \"prompts get requires a name.\"; return 1; }; method=prompts/get\n          [ $# -lt 3 ] || tool_args=\"$3\"\n          params=$(jq -nc --arg name \"$2\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" and all($a[];type==\"string\") then {name:$name,arguments:$a} else error(\"string arguments required\") end' 2>/dev/null) || { bad \"Prompt arguments must be a JSON object of strings.\"; return 1; } ;;\n        *) bad \"Use prompts list or get <name>.\"; return 1 ;;\n      esac ;;","tokenCount":261}],"storageText":"bash function \"main\"\nin figma-wire/scripts/mcp-wire.sh\nPurpose: error handling, file operations, data parsing, UI rendering\n\n        templates) method=resources/templates/list; key=resourceTemplates ;;\n        read) [ -n \"${2:-}\" ] || { bad \"resources read requires a URI.\"; return 1; }; method=resources/read; params=$(jq -nc --arg uri \"$2\" '{uri:$uri}') ;;\n        *) bad \"Use resources list, templates, or read <uri>.\"; return 1 ;;\n      esac ;;\n    prompts)\n      case \"${1:-list}\" in\n        list) method=prompts/list; key=prompts ;;\n        get) [ -n \"${2:-}\" ] || { bad \"prompts get requires a name.\"; return 1; }; method=prompts/get\n          [ $# -lt 3 ] || tool_args=\"$3\"\n          params=$(jq -nc --arg name \"$2\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" and all($a[];type==\"string\") then {name:$name,arguments:$a} else error(\"string arguments required\") end' 2>/dev/null) || { bad \"Prompt arguments must be a JSON object of strings.\"; return 1; } ;;\n        *) bad \"Use prompts list or get <name>.\"; return 1 ;;\n      esac ;;","content":"        templates) method=resources/templates/list; key=resourceTemplates ;;\n        read) [ -n \"${2:-}\" ] || { bad \"resources read requires a URI.\"; return 1; }; method=resources/read; params=$(jq -nc --arg uri \"$2\" '{uri:$uri}') ;;\n        *) bad \"Use resources list, templates, or read <uri>.\"; return 1 ;;\n      esac ;;\n    prompts)\n      case \"${1:-list}\" in\n        list) method=prompts/list; key=prompts ;;\n        get) [ -n \"${2:-}\" ] || { bad \"prompts get requires a name.\"; return 1; }; method=prompts/get\n          [ $# -lt 3 ] || tool_args=\"$3\"\n          params=$(jq -nc --arg name \"$2\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" and all($a[];type==\"string\") then {name:$name,arguments:$a} else error(\"string arguments required\") end' 2>/dev/null) || { bad \"Prompt arguments must be a JSON object of strings.\"; return 1; } ;;\n        *) bad \"Use prompts list or get <name>.\"; return 1 ;;\n      esac ;;","contentHash":"fea33331a25c0d90","metadata":{"filePath":"skills/figma-wire/scripts/mcp-wire.sh","startLine":449,"endLine":460,"chunkType":"function_definition","name":"main","language":"bash","hash":"fea33331a25c0d90"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.771Z"}
{"version":1,"chunks":[{"id":"chunk_df4d3b7730d38bb7","texts":[{"text":"bash function \"main\"\nin figma-wire/scripts/mcp-wire.sh\nPurpose: error handling, HTTP/API, data parsing\n\n          params=$(jq -nc --arg name \"$2\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" and all($a[];type==\"string\") then {name:$name,arguments:$a} else error(\"string arguments required\") end' 2>/dev/null) || { bad \"Prompt arguments must be a JSON object of strings.\"; return 1; } ;;\n        *) bad \"Use prompts list or get <name>.\"; return 1 ;;\n      esac ;;\n    raw)\n      body=\"${1:-}\"\n      jq -e 'type==\"object\" and .jsonrpc==\"2.0\" and (.method|type)==\"string\" and has(\"id\") and (.id != null)' <<<\"$body\" >/dev/null 2>&1 || { bad \"raw requires a JSON-RPC request with an ID.\"; return 1; } ;;\n    *) bad \"Unknown command. Use --help.\"; return 1 ;;\n  esac\n  [ \"$cmd\" = raw ] || body=$(jq -nc --arg m \"$method\" --argjson p \"$params\" '{jsonrpc:\"2.0\",id:2,method:$m,params:$p}')\n  if [ \"$DRY_RUN\" -eq 1 ]; then\n    jq -n --arg transport \"$(if [ -n \"$STDIO\" ]; then echo stdio; else echo http; fi)\" --arg method \"$(jq -r .method <<<\"$body\")\" '{dryRun:true,transport:$transport,method:$method}'\n    return","tokenCount":278}],"storageText":"bash function \"main\"\nin figma-wire/scripts/mcp-wire.sh\nPurpose: error handling, HTTP/API, data parsing\n\n          params=$(jq -nc --arg name \"$2\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" and all($a[];type==\"string\") then {name:$name,arguments:$a} else error(\"string arguments required\") end' 2>/dev/null) || { bad \"Prompt arguments must be a JSON object of strings.\"; return 1; } ;;\n        *) bad \"Use prompts list or get <name>.\"; return 1 ;;\n      esac ;;\n    raw)\n      body=\"${1:-}\"\n      jq -e 'type==\"object\" and .jsonrpc==\"2.0\" and (.method|type)==\"string\" and has(\"id\") and (.id != null)' <<<\"$body\" >/dev/null 2>&1 || { bad \"raw requires a JSON-RPC request with