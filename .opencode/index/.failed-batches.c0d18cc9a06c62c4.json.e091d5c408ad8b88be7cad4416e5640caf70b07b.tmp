{"version":1,"chunks":[{"id":"chunk_cc54ab42936e0b30","texts":[{"text":"bash function \"main\"\nin figma-design/scripts/mcp-wire.sh\nPurpose: error handling, file operations, data parsing, UI rendering\n\n        templates) method=resources/templates/list; key=resourceTemplates ;;\n        read) [ -n \"${2:-}\" ] || { bad \"resources read requires a URI.\"; return 1; }; method=resources/read; params=$(jq -nc --arg uri \"$2\" '{uri:$uri}') ;;\n        *) bad \"Use resources list, templates, or read <uri>.\"; return 1 ;;\n      esac ;;\n    prompts)\n      case \"${1:-list}\" in\n        list) method=prompts/list; key=prompts ;;\n        get) [ -n \"${2:-}\" ] || { bad \"prompts get requires a name.\"; return 1; }; method=prompts/get\n          [ $# -lt 3 ] || tool_args=\"$3\"\n          params=$(jq -nc --arg name \"$2\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" and all($a[];type==\"string\") then {name:$name,arguments:$a} else error(\"string arguments required\") end' 2>/dev/null) || { bad \"Prompt arguments must be a JSON object of strings.\"; return 1; } ;;\n        *) bad \"Use prompts list or get <name>.\"; return 1 ;;\n      esac ;;","tokenCount":262}],"storageText":"bash function \"main\"\nin figma-design/scripts/mcp-wire.sh\nPurpose: error handling, file operations, data parsing, UI rendering\n\n        templates) method=resources/templates/list; key=resourceTemplates ;;\n        read) [ -n \"${2:-}\" ] || { bad \"resources read requires a URI.\"; return 1; }; method=resources/read; params=$(jq -nc --arg uri \"$2\" '{uri:$uri}') ;;\n        *) bad \"Use resources list, templates, or read <uri>.\"; return 1 ;;\n      esac ;;\n    prompts)\n      case \"${1:-list}\" in\n        list) method=prompts/list; key=prompts ;;\n        get) [ -n \"${2:-}\" ] || { bad \"prompts get requires a name.\"; return 1; }; method=prompts/get\n          [ $# -lt 3 ] || tool_args=\"$3\"\n          params=$(jq -nc --arg name \"$2\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" and all($a[];type==\"string\") then {name:$name,arguments:$a} else error(\"string arguments required\") end' 2>/dev/null) || { bad \"Prompt arguments must be a JSON object of strings.\"; return 1; } ;;\n        *) bad \"Use prompts list or get <name>.\"; return 1 ;;\n      esac ;;","content":"        templates) method=resources/templates/list; key=resourceTemplates ;;\n        read) [ -n \"${2:-}\" ] || { bad \"resources read requires a URI.\"; return 1; }; method=resources/read; params=$(jq -nc --arg uri \"$2\" '{uri:$uri}') ;;\n        *) bad \"Use resources list, templates, or read <uri>.\"; return 1 ;;\n      esac ;;\n    prompts)\n      case \"${1:-list}\" in\n        list) method=prompts/list; key=prompts ;;\n        get) [ -n \"${2:-}\" ] || { bad \"prompts get requires a name.\"; return 1; }; method=prompts/get\n          [ $# -lt 3 ] || tool_args=\"$3\"\n          params=$(jq -nc --arg name \"$2\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" and all($a[];type==\"string\") then {name:$name,arguments:$a} else error(\"string arguments required\") end' 2>/dev/null) || { bad \"Prompt arguments must be a JSON object of strings.\"; return 1; } ;;\n        *) bad \"Use prompts list or get <name>.\"; return 1 ;;\n      esac ;;","contentHash":"fea33331a25c0d90","metadata":{"filePath":"skills/figma-design/scripts/mcp-wire.sh","startLine":449,"endLine":460,"chunkType":"function_definition","name":"main","language":"bash","hash":"fea33331a25c0d90"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.825Z"}
{"version":1,"chunks":[{"id":"chunk_194ec556a4477471","texts":[{"text":"bash function \"main\"\nin figma-design/scripts/mcp-wire.sh\nPurpose: error handling, HTTP/API, data parsing\n\n          params=$(jq -nc --arg name \"$2\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" and all($a[];type==\"string\") then {name:$name,arguments:$a} else error(\"string arguments required\") end' 2>/dev/null) || { bad \"Prompt arguments must be a JSON object of strings.\"; return 1; } ;;\n        *) bad \"Use prompts list or get <name>.\"; return 1 ;;\n      esac ;;\n    raw)\n      body=\"${1:-}\"\n      jq -e 'type==\"object\" and .jsonrpc==\"2.0\" and (.method|type)==\"string\" and has(\"id\") and (.id != null)' <<<\"$body\" >/dev/null 2>&1 || { bad \"raw requires a JSON-RPC request with an ID.\"; return 1; } ;;\n    *) bad \"Unknown command. Use --help.\"; return 1 ;;\n  esac\n  [ \"$cmd\" = raw ] || body=$(jq -nc --arg m \"$method\" --argjson p \"$params\" '{jsonrpc:\"2.0\",id:2,method:$m,params:$p}')\n  if [ \"$DRY_RUN\" -eq 1 ]; then\n    jq -n --arg transport \"$(if [ -n \"$STDIO\" ]; then echo stdio; else echo http; fi)\" --arg method \"$(jq -r .method <<<\"$body\")\" '{dryRun:true,transport:$transport,method:$method}'\n    return","tokenCount":278}],"storageText":"bash function \"main\"\nin figma-design/scripts/mcp-wire.sh\nPurpose: error handling, HTTP/API, data parsing\n\n          params=$(jq -nc --arg name \"$2\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" and all($a[];type==\"string\") then {name:$name,arguments:$a} else error(\"string arguments required\") end' 2>/dev/null) || { bad \"Prompt arguments must be a JSON object of strings.\"; return 1; } ;;\n        *) bad \"Use prompts list or get <name>.\"; return 1 ;;\n      esac ;;\n    raw)\n      body=\"${1:-}\"\n      jq -e 'type==\"object\" and .jsonrpc==\"2.0\" and (.method|type)==\"string\" and has(\"id\") and (.id != null)' <<<\"$body\" >/dev/null 2>&1 || { bad \"raw requires a JSON-RPC request with an ID.\"; return 1; } ;;\n    *) bad \"Unknown command. Use --help.\"; return 1 ;;\n  esac\n  [ \"$cmd\" = raw ] || body=$(jq -nc --arg m \"$method\" --argjson p \"$params\" '{jsonrpc:\"2.0\",id:2,method:$m,params:$p}')\n  if [ \"$DRY_RUN\" -eq 1 ]; then\n    jq -n --arg transport \"$(if [ -n \"$STDIO\" ]; then echo stdio; else echo http; fi)\" --arg method \"$(jq -r .method <<<\"$body\")\" '{dryRun:true,transport:$transport,method:$method}'\n    return","content":"          params=$(jq -nc --arg name \"$2\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" and all($a[];type==\"string\") then {name:$name,arguments:$a} else error(\"string arguments required\") end' 2>/dev/null) || { bad \"Prompt arguments must be a JSON object of strings.\"; return 1; } ;;\n        *) bad \"Use prompts list or get <name>.\"; return 1 ;;\n      esac ;;\n    raw)\n      body=\"${1:-}\"\n      jq -e 'type==\"object\" and .jsonrpc==\"2.0\" and (.method|type)==\"string\" and has(\"id\") and (.id != null)' <<<\"$body\" >/dev/null 2>&1 || { bad \"raw requires a JSON-RPC request with an ID.\"; return 1; } ;;\n    *) bad \"Unknown command. Use --help.\"; return 1 ;;\n  esac\n  [ \"$cmd\" = raw ] || body=$(jq -nc --arg m \"$method\" --argjson p \"$params\" '{jsonrpc:\"2.0\",id:2,method:$m,params:$p}')\n  if [ \"$DRY_RUN\" -eq 1 ]; then\n    jq -n --arg transport \"$(if [ -n \"$STDIO\" ]; then echo stdio; else echo http; fi)\" --arg method \"$(jq -r .method <<<\"$body\")\" '{dryRun:true,transport:$transport,method:$method}'\n    return","contentHash":"27112073cc115cae","metadata":{"filePath":"skills/figma-design/scripts/mcp-wire.sh","startLine":458,"endLine":469,"chunkType":"function_definition","name":"main","language":"bash","hash":"27112073cc115cae"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.825Z"}
{"version":1,"chunks":[{"id":"chunk_909d4e85ea07a152","texts":[{"text":"bash function \"main\"\nin figma-design/scripts/mcp-wire.sh\nPurpose: HTTP/API, file operations\n\n  if [ \"$DRY_RUN\" -eq 1 ]; then\n    jq -n --arg transport \"$(if [ -n \"$STDIO\" ]; then echo stdio; else echo http; fi)\" --arg method \"$(jq -r .method <<<\"$body\")\" '{dryRun:true,transport:$transport,method:$method}'\n    return\n  fi\n  umask 077\n  WORK=$(mktemp -d) || return 1\n  HEADERS_FILE=\"$WORK/headers.txt\"\n  : > \"$HEADERS_FILE\"\n  for _h in \"${HEADERS[@]+\"${HEADERS[@]}\"}\"; do printf '%s\\n' \"$_h\" >> \"$HEADERS_FILE\"; done\n  chmod 600 \"$HEADERS_FILE\"\n  connect || return 1\n  data=$(request_all \"$body\" \"$key\") || return 1","tokenCount":154}],"storageText":"bash function \"main\"\nin figma-design/scripts/mcp-wire.sh\nPurpose: HTTP/API, file operations\n\n  if [ \"$DRY_RUN\" -eq 1 ]; then\n    jq -n --arg transport \"$(if [ -n \"$STDIO\" ]; then echo stdio; else echo http; fi)\" --arg method \"$(jq -r .method <<<\"$body\")\" '{dryRun:true,transport:$transport,method:$method}'\n    return\n  fi\n  umask 077\n  WORK=$(mktemp -d) || return 1\n  HEADERS_FILE=\"$WORK/headers.txt\"\n  : > \"$HEADERS_FILE\"\n  for _h in \"${HEADERS[@]+\"${HEADERS[@]}\"}\"; do printf '%s\\n' \"$_h\" >> \"$HEADERS_FILE\"; done\n  chmod 600 \"$HEADERS_FILE\"\n  connect || return 1\n  data=$(request_all \"$body\" \"$key\") || return 1","content":"  if [ \"$DRY_RUN\" -eq 1 ]; then\n    jq -n --arg transport \"$(if [ -n \"$STDIO\" ]; then echo stdio; else echo http; fi)\" --arg method \"$(jq -r .method <<<\"$body\")\" '{dryRun:true,transport:$transport,method:$method}'\n    return\n  fi\n  umask 077\n  WORK=$(mktemp -d) || return 1\n  HEADERS_FILE=\"$WORK/headers.txt\"\n  : > \"$HEADERS_FILE\"\n  for _h in \"${HEADERS[@]+\"${HEADERS[@]}\"}\"; do printf '%s\\n' \"$_h\" >> \"$HEADERS_FILE\"; done\n  chmod 600 \"$HEADERS_FILE\"\n  connect || return 1\n  data=$(request_all \"$body\" \"$key\") || ret