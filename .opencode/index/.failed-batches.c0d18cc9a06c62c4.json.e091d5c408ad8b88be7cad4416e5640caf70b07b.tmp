{"version":1,"chunks":[{"id":"chunk_839836073714fb10","texts":[{"text":"bash function \"main\"\nin figma-pages/scripts/mcp-wire.sh\nPurpose: placeholder(), data parsing\n\n          def tstr: if type == \"array\" then (map(tostring)|join(\"|\")) else tostring end;\n          to_entries[] |\n          \"  \" + .key + \" (\" + ((.value.type // \"any\") | tstr) + (if (.key as $k | $req | index($k)) then \", required\" else \"\" end) + \") — \" + (.value.description // \"\")\n        ' <<<\"$props\"\n      fi\n      echo 'example:'\n      jq -c --argjson req \"$(jq -c '.inputSchema.required // []' <<<\"$tdata\")\" --argjson props \"$props\" '\n        def placeholder($t):\n          if $t == \"string\" then \"...\"\n          elif ($t == \"number\" or $t == \"integer\") then 0\n          elif $t == \"boolean\" then false\n          elif $t == \"array\" then []","tokenCount":186}],"storageText":"bash function \"main\"\nin figma-pages/scripts/mcp-wire.sh\nPurpose: placeholder(), data parsing\n\n          def tstr: if type == \"array\" then (map(tostring)|join(\"|\")) else tostring end;\n          to_entries[] |\n          \"  \" + .key + \" (\" + ((.value.type // \"any\") | tstr) + (if (.key as $k | $req | index($k)) then \", required\" else \"\" end) + \") — \" + (.value.description // \"\")\n        ' <<<\"$props\"\n      fi\n      echo 'example:'\n      jq -c --argjson req \"$(jq -c '.inputSchema.required // []' <<<\"$tdata\")\" --argjson props \"$props\" '\n        def placeholder($t):\n          if $t == \"string\" then \"...\"\n          elif ($t == \"number\" or $t == \"integer\") then 0\n          elif $t == \"boolean\" then false\n          elif $t == \"array\" then []","content":"          def tstr: if type == \"array\" then (map(tostring)|join(\"|\")) else tostring end;\n          to_entries[] |\n          \"  \" + .key + \" (\" + ((.value.type // \"any\") | tstr) + (if (.key as $k | $req | index($k)) then \", required\" else \"\" end) + \") — \" + (.value.description // \"\")\n        ' <<<\"$props\"\n      fi\n      echo 'example:'\n      jq -c --argjson req \"$(jq -c '.inputSchema.required // []' <<<\"$tdata\")\" --argjson props \"$props\" '\n        def placeholder($t):\n          if $t == \"string\" then \"...\"\n          elif ($t == \"number\" or $t == \"integer\") then 0\n          elif $t == \"boolean\" then false\n          elif $t == \"array\" then []","contentHash":"f47ed4195478464d","metadata":{"filePath":"skills/figma-pages/scripts/mcp-wire.sh","startLine":494,"endLine":505,"chunkType":"function_definition","name":"main","language":"bash","hash":"f47ed4195478464d"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.681Z"}
{"version":1,"chunks":[{"id":"chunk_203d9e8b2e9e9a2e","texts":[{"text":"bash function \"main\"\nin figma-pages/scripts/mcp-wire.sh\nPurpose: data parsing\n\n          elif ($t == \"number\" or $t == \"integer\") then 0\n          elif $t == \"boolean\" then false\n          elif $t == \"array\" then []\n          else {} end;\n        (reduce $req[] as $k ({}; .[$k] = placeholder((($props[$k].type // \"string\") | if type==\"array\" then (.[0] // \"string\") else . end)))) as $ex |\n        if ($req|length)==0 then \"{}\" else ($ex|tojson) end\n      ' -n\n      ;;\n    list)\n      if [ \"$JSON_OUT\" -eq 1 ]; then jq '.result' <<<\"$data\"\n      else jq -r '.result.tools[] | .name+\" :: \"+((.description // \"\")[0:120])' <<<\"$data\"; fi ;;\n    *) emit_result \"$data\" \"$PREFIX\" ;;","tokenCount":170}],"storageText":"bash function \"main\"\nin figma-pages/scripts/mcp-wire.sh\nPurpose: data parsing\n\n          elif ($t == \"number\" or $t == \"integer\") then 0\n          elif $t == \"boolean\" then false\n          elif $t == \"array\" then []\n          else {} end;\n        (reduce $req[] as $k ({}; .[$k] = placeholder((($props[$k].type // \"string\") | if type==\"array\" then (.[0] // \"string\") else . end)))) as $ex |\n        if ($req|length)==0 then \"{}\" else ($ex|tojson) end\n      ' -n\n      ;;\n    list)\n      if [ \"$JSON_OUT\" -eq 1 ]; then jq '.result' <<<\"$data\"\n      else jq -r '.result.tools[] | .name+\" :: \"+((.description // \"\")[0:120])' <<<\"$data\"; fi ;;\n    *) emit_result \"$data\" \"$PREFIX\" ;;","content":"          elif ($t == \"number\" or $t == \"integer\") then 0\n          elif $t == \"boolean\" then false\n          elif $t == \"array\" then []\n          else {} end;\n        (reduce $req[] as $k ({}; .[$k] = placeholder((($props[$k].type // \"string\") | if type==\"array\" then (.[0] // \"string\") else . end)))) as $ex |\n        if ($req|length)==0 then \"{}\" else ($ex|tojson) end\n      ' -n\n      ;;\n    list)\n