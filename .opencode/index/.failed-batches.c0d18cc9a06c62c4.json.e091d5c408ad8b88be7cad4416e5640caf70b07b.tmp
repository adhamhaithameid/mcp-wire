{"version":1,"chunks":[{"id":"chunk_78af0947fb5cdc3d","texts":[{"text":"JavaScript if_statement\nin engine/tests/fake-server.js\nPurpose: logging, HTTP/API, file operations, data parsing\n\n        const headers = {'Content-Type':'application/json'};\n        if (!req.url.includes('json')) headers['Mcp-Session-Id']='fake-session';\n        if (req.url.includes('json')) { /* return first 2 tools */ m = JSON.parse(JSON.stringify(m)); }\n        res.writeHead(200, headers);\n        return res.end(JSON.stringify(response));\n      }\n      // default /mcp: SSE with session\n      res.writeHead(200, {'Content-Type':'text/event-stream','Mcp-Session-Id':'fake-session'});\n      res.end('event: message\\r\\ndata: ' + JSON.stringify(response) + '\\r\\n\\r\\nevent: message\\r\\ndata: {\"jsonrpc\":\"2.0\",\"method\":\"notifications/progress\"}\\r\\n\\r\\n');\n    });\n  });\n  server.listen(Number(process.argv[2] || 0), '127.0.0.1', () => console.log(server.address().port));","tokenCount":218}],"storageText":"JavaScript if_statement\nin engine/tests/fake-server.js\nPurpose: logging, HTTP/API, file operations, data parsing\n\n        const headers = {'Content-Type':'application/json'};\n        if (!req.url.includes('json')) headers['Mcp-Session-Id']='fake-session';\n        if (req.url.includes('json')) { /* return first 2 tools */ m = JSON.parse(JSON.stringify(m)); }\n        res.writeHead(200, headers);\n        return res.end(JSON.stringify(response));\n      }\n      // default /mcp: SSE with session\n      res.writeHead(200, {'Content-Type':'text/event-stream','Mcp-Session-Id':'fake-session'});\n      res.end('event: message\\r\\ndata: ' + JSON.stringify(response) + '\\r\\n\\r\\nevent: message\\r\\ndata: {\"jsonrpc\":\"2.0\",\"method\":\"notifications/progress\"}\\r\\n\\r\\n');\n    });\n  });\n  server.listen(Number(process.argv[2] || 0), '127.0.0.1', () => console.log(server.address().port));","content":"        const headers = {'Content-Type':'application/json'};\n   