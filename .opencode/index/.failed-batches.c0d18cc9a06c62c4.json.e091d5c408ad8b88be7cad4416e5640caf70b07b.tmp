{"version":1,"chunks":[{"id":"chunk_6419e4d3887a8392","texts":[{"text":"bash function \"main\"\nin figma-wire/scripts/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\n      *)\n        [ -f \"$CONFIG\" ] || { bad \"Unknown server. Pass a URL or create a named server in servers.json.\"; return 1; }\n        local entry\n        entry=$(jq -ec --arg n \"$target\" '.servers[$n] | select(type == \"object\")' \"$CONFIG\") || { bad \"Server name not found in the registry.\"; return 1; }\n        jq -e '(.headerEnv // {}) | type == \"object\" and all(to_entries[]; (.value|type)==\"string\")' <<<\"$entry\" >/dev/null || { bad \"headerEnv must map header names to environment variable names.\"; return 1; }\n        URL=$(jq -r '.url // empty' <<<\"$entry\")\n        STDIO=$(jq -c '.command // empty' <<<\"$entry\")\n        # allow_http honored\n        local allow_http\n        allow_http=$(jq -r '.allow_http // false' <<<\"$entry\")\n        [ \"$allow_http\" != true ] || ALLOW_HTTP=1\n        # headers array with ${VAR} expansion","tokenCount":234}],"storageText":"bash function \"main\"\nin figma-wire/scripts/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\n      *)\n        [ -f \"$CONFIG\" ] || { bad \"Unknown server. Pass a URL or create a named server in servers.json.\"; return 1; }\n        local entry\n        entry=$(jq -ec --arg n \"$target\" '.servers[$n] | select(type == \"object\")' \"$CONFIG\") || { bad \"Server name not found in the registry.\"; return 1; }\n        jq -e '(.headerEnv // {}) | type == \"object\" and all(to_entries[]; (.value|type)==\"string\")' <<<\"$entry\" >/dev/null || { bad \"headerEnv must map header names to environment variable names.\"; return 1; }\n        URL=$(jq -r '.url // empty' <<<\"$entry\")\n        STDIO=$(jq -c '.command // empty' <<<\"$entry\")\n        # allow_http honored\n        local allow_http\n        allow_http=$(jq -r '.allow_http // false' <<<\"$entry\")\n        [ \"$allow_http\" != true ] || ALLOW_HTTP=1\n        # headers array with ${VAR} expansion","content":"      *)\n        [ -f \"$CONFIG\" ] || { bad \"Unknown server. Pass a URL or create a named server in servers.json.\"; return 1; }\n        local entry\n        entry=$(jq -ec --arg n \"$target\" '.servers[$n] | select(type == \"object\")' \"$CONFIG\") || { bad \"Server name not found in the registry.\"; return 1; }\n        jq -e '(.headerEnv // {}) | type == \"object\" and all(to_entries[]; (.value|type)==\"string\")' <<<\"$entry\" >/dev/null || { bad \"headerEnv must map header names to environment variable names.\"; return 1; }\n        URL=$(jq -r '.url // empty' <<<\"$entry\")\n        STDIO=$(jq -c '.command // empty' <<<\"$entry\")\n        # allow_http honored\n        local allow_http\n        allow_http=$(jq -r '.allow_http // false' <<<\"$entry\")\n        [ \"$allow_http\" != true ] || ALLOW_HTTP=1\n        # headers array with ${VAR} expansion","contentHash":"18c2a6d6cf6611ca","metadata":{"filePath":"skills/figma-wire/scripts/mcp-wire.sh","startLine":386,"endLine":397,"chunkType":"function_definition","name":"main","language":"bash","hash":"18c2a6d6cf6611ca"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.678Z"}
{"version":1,"chunks":[{"id":"chunk_3fd0fe39796d06a7","texts":[{"text":"bash function \"main\"\nin figma-wire/scripts/mcp-wire.sh\nPurpose: HTTP/API, file operations, configuration\n\n        allow_http=$(jq -r '.allow_http // false' <<<\"$entry\")\n        [ \"$allow_http\" != true ] || ALLOW_HTTP=1\n        # headers array with ${VAR} expansion\n        local hline varname\n        while IFS= read -r hline; do\n          [ -n \"$hline\" ] || continue\n          # expand ${VAR}\n          while [[ \"$hline\" =~ \\$\\{([A-Za-z_][A-Za-z_0-9]*)\\} ]]; do\n            varname=\"${BASH_REMATCH[1]}\"\n            [ -n \"${!varname:-}\" ] || { bad \"Required header environment variable is unset: $varname\"; return 1; }\n            hline=\"${hline//\\$\\{$varname\\}/${!varname}}\"\n          done","tokenCount":173}],"storageText":"bash function \"main\"\nin figma-wire/scripts/mcp-wire.sh\nPurpose: HTTP/API, file operations, configuration\n\n        allow_http=$(jq -r '.allow_http // false' <<<\"$entry\")\n        [ \"$allow_http\" != true ] || ALLOW_HTTP=1\n        # headers array with ${VAR} expansion\n        local hline varname\n        while IFS= read -r hline; do\n          [ -n \"$hline\" ] || continue\n          # expand ${VAR}\n          while [[ \"$hline\" =~ \\$\\{([A-Za-z_][A-Za-z_0-9]*)\\} ]]; do\n            varname=\"${BASH_REMATCH[1]}\"\n            [ -n \"${!varname:-}\" ] || { bad \"Required header environment variable is unset: $varname\"; return 1; }\n            hline=\"${hline//\\$\\{$varname\\}/${!varname}}\"\n          done","content":"        allow_http=$(jq -r '.allow_http // false' <<<\"$entry\")\n        [ \"$allow_http\" != true ] || ALLOW_HTTP=1\n        # headers array with ${VAR} expansion\n        local hline varname\n        while IFS= read -r hline; do\n          [ -n \"$hline\" ] || continue\n          # expand ${VAR}\n          while [[ \"$hline\" =~ \\$\\{([A-Za-z_][A-Za-z_0-9]*)\\} ]]; do\n            varname=\"${BASH_REMATCH[1]}\"\n            [ -n \"${!varname:-}\" ] || { bad \"Required header environment variable is unset: $varname\"; return 1; }\n            hline=\"${hline//\\$\\{$varname\\}/${!varname}}\"\n          done","contentHash":"b71716c684c4de02","metadata":{"filePath":"skills/figma-wire/scripts/mcp-wire.sh","startLine":395,"endLine":406,"chunkType":"function_definition","name":"main","language":"bash","hash":"b71716c684c4de02"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.678Z"}
{"version":1,"chunks":[{"id":"chunk_0db42f223d2e68ac","texts":[{"text":"bash function \"emit_result\"\nin figma-design/scripts/mcp-wire.sh\nPurpose: error handling\n\n    if ! jq -e '.result | type == \"object\" and has(\"content\")' <<<\"$data\" >/dev/null; then jq '.result' <<<\"$data\"\n    elif jq -e '.result | (.content|length)==0 and has(\"structuredContent\")' <<<\"$data\" >/dev/null; then jq '.result.structuredContent' <<<\"$data\"; fi\n  fi\n  if jq -e '.result.isError == true' <<<\"$data\" >/dev/null; then bad \"Tool reported an error.\"; return 1; fi\n}","tokenCount":118}],"storageText":"bash function \"emit_result\"\nin figma-design/scripts/mcp-wire.sh\nPurpose: error handling\n\n    if ! jq -e '.result | type == \"object\" and has(\"content\")' <<<\"$data\" >/dev/null; then jq '.result' <<<\"$data\"\n    elif jq -e '.result | (.content|length)==0 and has(\"structuredContent\")' <<<\"$data\" >/dev/null; then jq '.result.structuredContent' <<<\"$data\"; fi\n  fi\n  if jq -e '.result.isError == true' <<<\"$data\" >/dev/null; then bad \"Tool reported an error.\"; return 1; fi\n}","content":"    if ! jq -e '.result | type == \"object\" and has(\"content\")' <<<\"$data\" >/dev/null; then jq '.result' <<<\"$data\"\n    elif jq -e '.result | (.content|length)==0 and has(\"structuredContent\")' <<<\"$data\" >/dev/null; then jq '.result.structuredContent' <<<\"$data\"; fi\n  fi\n  if jq -e '.result.isError == true' <<<\"$data\" >/dev/null; then bad \"Tool reported an error.\"; return 1; fi\n}","contentHash":"aa597b6894e654ae","metadata":{"filePath":"skills/figma-design/scripts/mcp-wire.sh","startLine":245,"endLine":249,"chunkType":"function_definition","name":"emit_result","language":"bash","hash":"aa597b6894e654ae"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.678Z"}
{"version":1,"chunks":[{"id":"chunk_862e6c44eab071d7","texts":[{"text":"bash function \"main\"\nin figma-design/scripts/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\nmain() (\n  local HEADERS=() SESSION_HEADERS=() args=() URL='' STDIO='' TIMEOUT=90 JSON_OUT=0 DRY_RUN=0 ALLOW_HTTP=0 PREFIX='' SESSION_ID='' TRANSPORT='session' REPLY='sse'\n  local CONFIG=\"${MCP_WIRE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/mcp-wire/servers.json}\" WORK='' SERVER_PID=''\n  cleanup() { if [ -n \"${SERVER_PID:-}\" ]; then kill \"$SERVER_PID\" 2>/dev/null; wait \"$SERVER_PID\" 2>/dev/null; fi; if [ -n \"${SESSION_ID:-}\" ] && [ -n \"${URL:-}\" ]; then curl -q -sS --max-time 2 -X DELETE \"$URL\" -H \"Mcp-Session-Id: $SESSION_ID\" >/dev/null 2>&1 || true; fi; [ -z \"${WORK:-}\" ] || rm -rf \"$WORK\"; }\n  trap cleanup EXIT INT TERM\n  while [ $# -gt 0 ]; do\n    case \"$1\" in\n      --json) JSON_OUT=1; shift ;;\n      --dry-run) DRY_RUN=1; shift ;;\n      --allow-http) ALLOW_HTTP=1; shift ;;\n      --header|--header-env|--timeout|--config|--stdio|-o)\n        [ $# -ge 2 ] && [ -n \"$2\" ] || { bad \"Missing value for $1.\"; return 1; }","tokenCount":259}],"storageText":"bash function \"main\"\nin figma-design/scripts/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\nmain() (\n  local HEADERS=() SESSION_HEADERS=() args=() URL='' STDIO='' TIMEOUT=90 JSON_OUT=0 DRY_RUN=0 ALLOW_HTTP=0 PREFIX='' SESSION_ID='' TRANSPORT='session' REPLY='sse'\n  local CONFIG=\"${MCP_WIRE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/mcp-wire/servers.json}\" WORK='' SERVER_PID=''\n  cleanup() { if [ -n \"${SERVER_PID:-}\" ]; then kill \"$SERVER_PID\" 2>/dev/null; wait \"$SERVER_PID\" 2>/dev/null; fi; if [ -n \"${SESSION_ID:-}\" ] && [ -n \"${URL:-}\" ]; then curl -q -sS --max-time 2 -X DELETE \"$URL\" -H \"Mcp-Session-Id: $SESSION_ID\" >/dev/null 2>&1 || true; fi; [ -z \"${WORK:-}\" ] || rm -rf \"$WORK\"; }\n  trap cleanup EXIT INT TERM\n  while [ $# -gt 0 ]; do\n    case \"$1\" in\n      --json) JSON_OUT=1; shift ;;\n      --dry-run) DRY_RUN=1; shift ;;\n      --allow-http) ALLOW_HTTP=1; shift ;;\n      --header|--header-env|--timeout|--config|--stdio|-o)\n        [ $# -ge 2 ] && [ -n \"$2\" ] || { bad \"Missing value for $1.\"; return 1; }","content":"main() (\n  local HEADERS=() SESSION_HEADERS=() args=() URL='' STDIO='' TIMEOUT=90 JSON_OUT=0 DRY_RUN=0 ALLOW_HTTP=0 PREFIX='' SESSION_ID='' TRANSPORT='session' REPLY='sse'\n  local CONFIG=\"${MCP_WIRE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/mcp-wire/servers.json}\" WORK='' SERVER_PID=''\n  cleanup() { if [ -n \"${SERVER_PID:-}\" ]; then kill \"$SERVER_PID\" 2>/dev/null; wait \"$SERVER_PID\" 2>/dev/null; fi; if [ -n \"${SESSION_ID:-}\" ] && [ -n \"${URL:-}\" ]; then curl -q -sS --max-time 2 -X DELETE \"$URL\" -H \"Mcp-Session-Id: $SESSION_ID\" >/dev/null 2>&1 || true; fi; [ -z \"${WORK:-}\" ] || rm -rf \"$WORK\"; }\n  trap cleanup EXIT INT TERM\n  while [ $# -gt 0 ]; do\n    case \"$1\" in\n      --json) JSON_OUT=1; shift ;;\n      --dry-run) DRY_RUN=1; shift ;;\n      --allow-http) ALLOW_HTTP=1; shift ;;\n      --header|--header-env|--timeout|--config|--stdio|-o)\n        [ $# -ge 2 ] && [ -n \"$2\" ] || { bad \"Missing value for $1.\"; return 1; }","contentHash":"ee0b6ca82e436e04","metadata":{"filePath":"skills/figma-design/scripts/mcp-wire.sh","startLine":251,"endLine":262,"chunkType":"function_definition","name":"main","language":"bash","hash":"ee0b6ca82e436e04"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.678Z"}
{"version":1,"chunks":[{"id":"chunk_a6382b5792b90026","texts":[{"text":"bash function \"main\"\nin figma-design/scripts/mcp-wire.sh\nPurpose: HTTP/API, configuration\n\n      --allow-http) ALLOW_HTTP=1; shift ;;\n      --header|--header-env|--timeout|--config|--stdio|-o)\n        [ $# -ge 2 ] && [ -n \"$2\" ] || { bad \"Missing value for $1.\"; return 1; }\n        case \"$1\" in\n          --header) HEADERS+=(\"$2\") ;;\n          --header-env)\n            local hn=\"${2%%=*}\" en=\"${2#*=}\"\n            [[ \"$en\" =~ ^[A-Za-z_][A-Za-z_0-9]*$ ]] && [[ \"$hn\" =~ ^[A-Za-z0-9-]+$ ]] || { bad \"Use --header-env Header=ENV_NAME.\"; return 1; }\n            [ -n \"${!en:-}\" ] || { bad \"Required header environment variable is unset.\"; return 1; }\n            HEADERS+=(\"$hn: ${!en}\") ;;\n          --timeout) TIMEOUT=\"$2\" ;; --config) CONFIG=\"$2\" ;; --stdio) STDIO=\"$2\" ;; -o) PREFIX=\"$2\" ;;\n        esac","tokenCount":202}],"storageText":"bash function \"main\"\nin figma-design/scripts/mcp-wire.sh\nPurpose: HTTP/API, configuration\n\n      --allow-http) ALLOW_HTTP=1; shift ;;\n      --header|--header-env|--timeout|--config|--stdio|-o)\n        [ $# -ge 2 ] && [ -n \"$2\" ] || { bad \"Missing value for $1.\"; return 1; }\n        case \"$1\" in\n          --header) HEADERS+=(\"$2\") ;;\n          --header-env)\n            local hn=\"${2%%=*}\" en=\"${2#*=}\"\n            [[ \"$en\" =~ ^[A-Za-z_][A-Za-z_0-9]*$ ]] && [[ \"$hn\" =~ ^[A-Za-z0-9-]+$ ]] || { bad \"Use --header-env Header=ENV_NAME.\"; return 1; }\n            [ -n \"${!en:-}\" ] || { bad \"Required header environment variable is unset.\"; return 1; }\n            HEADERS+=(\"$hn: ${!en}\") ;;\n          --timeout) TIMEOUT=\"$2\" ;; --config) CONFIG=\"$2\" ;; --stdio) STDIO=\"$2\" ;; -o) PREFIX=\"$2\" ;;\n        esac","content":"      --allow-http) ALLOW_HTTP=1; shift ;;\n      --header|--header-env|--timeout|--config|--stdio|-o)\n        [ $# -ge 2 ] && [ -n \"$2\" ] || { bad \"Missing value for 