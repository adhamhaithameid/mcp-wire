{"version":1,"chunks":[{"id":"chunk_736601ec165a9e0d","texts":[{"text":"bash function \"stdio_receive\"\nin figma-verify/scripts/mcp-wire.sh\nPurpose: user management, validation, error handling, logging, HTTP/API, file operations\n\nstdio_receive() {\n  local id=\"$1\" line deadline=$((SECONDS + TIMEOUT)) remaining\n  while [ \"$SECONDS\" -lt \"$deadline\" ]; do\n    remaining=$((deadline - SECONDS))\n    IFS= read -r -t \"$remaining\" line <&4 || break\n    if jq -e --argjson id \"$id\" 'type == \"object\" and .id == $id and (has(\"result\") or has(\"error\"))' <<<\"$line\" >/dev/null 2>&1; then\n      printf '%s\\n' \"$line\"; return 0\n    fi\n    # A one-shot client cannot answer server-initiated requests for user input.\n    if jq -e 'has(\"method\") and has(\"id\")' <<<\"$line\" >/dev/null 2>&1; then\n      stdio_send \"$(jq -c '{jsonrpc:\"2.0\",id:.id,error:{code:-32601,message:\"Client callbacks are not supported\"}}' <<<\"$line\")\" || return 1\n    fi\n  done\n  bad \"No matching stdio response. Check the command and keep server logs on stderr.\"\n  return 1\n}","tokenCount":240}],"storageText":"bash function \"stdio_receive\"\nin figma-verify/scripts/mcp-wire.sh\nPurpose: user management, validation, error handling, logging, HTTP/API, file operations\n\nstdio_receive() {\n  local id=\"$1\" line deadline=$((SECONDS + TIMEOUT)) remaining\n  while [ \"$SECONDS\" -lt \"$deadline\" ]; do\n    remaining=$((deadline - SECONDS))\n    IFS= read -r -t \"$remaining\" line <&4 || break\n    if jq -e --argjson id \"$id\" 'type == \"object\" and .id == $id and (has(\"result\") or has(\"error\"))' <<<\"$line\" >/dev/null 2>&1; then\n      printf '%s\\n' \"$line\"; return 0\n    fi\n    # A one-shot client cannot answer server-initiated requests for user input.\n    if jq -e 'has(\"method\") and has(\"id\")' <<<\"$line\" >/dev/null 2>&1; then\n      stdio_send \"$(jq -c '{jsonrpc:\"2.0\",id:.id,error:{code:-32601,message:\"Client callbacks are not supported\"}}' <<<\"$line\")\" || return 1\n    fi\n  done\n  bad \"No matching stdio response. Check the command and keep server logs on stderr.\"\n  return 1\n}","content":"stdio_receive() {\n  local id=\"$1\" line deadline=$((SECONDS + TIMEOUT)) remaining\n  while [ \"$SECONDS\" -lt \"$deadline\" ]; do\n    remaining=$((deadline - SECONDS))\n    IFS= read -r -t \"$remaining\" line <&4 || break\n    if jq -e --argjson id \"$id\" 'type == \"object\" and .id == $id and (has(\"result\") or has(\"error\"))' <<<\"$line\" >/dev/null 2>&1; then\n      printf '%s\\n' \"$line\"; return 0\n    fi\n    # A one-shot client cannot answer server-initiated requests for user input.\n    if jq -e 'has(\"method\") and has(\"id\")' <<<\"$line\" >/dev/null 2>&1; then\n      stdio_send \"$(jq -c '{jsonrpc:\"2.0\",id:.id,error:{code:-32601,message:\"Client callbacks are not supported\"}}' <<<\"$line\")\" || return 1\n    fi\n  done\n  bad \"No matching stdio response. Check the command and keep server logs on stderr.\"\n  return 1\n}","contentHash":"e5bb6fee85cf00be","metadata":{"filePath":"skills/figma-verify/scripts/mcp-wire.sh","startLine":129,"endLine":144,"chunkType":"function_definition","name":"stdio_receive","language":"bash","hash":"e5bb6fee85cf00be"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:24.003Z"}
{"version":1,"chunks":[{"id":"chunk_280e2d1108ef6296","texts":[{"text":"bash function \"cmd_doctor\"\nin figma-code/scripts/figma-wire.sh\nPurpose: authentication, token management, validation, logging, HTTP/API, file operations\n\n    if [ $json_out -eq 0 ] && [ \"$check_remote\" -eq 1 ]; then\n      if [ \"$PROBE_CODE\" = \"200\" ]; then\n        ok \"Remote MCP (mcp.figma.com) reachable and authenticated\"\n      elif [ \"$PROBE_CODE\" = \"401\" ]; then\n        if [ \"$present\" = \"true\" ] && [ \"$enabled\" != \"false\" ]; then\n          warn \"Remote MCP reachable but unauthenticated — it fails every session (HTTP 401)\"\n          info \"No token? Run: figma-wire remote off    |    Have a token? Run: figma-wire remote token <TOKEN>\"\n        else\n          ok \"Remote MCP reachable, disabled (correct until a token is configured)\"\n        fi\n      else\n        warn \"Remote MCP probe: HTTP ${PROBE_CODE} (offline or proxy issue — harmless for the local path)\"","tokenCount":218}],"storageText":"bash function \"cmd_doctor\"\nin figma-code/scripts/figma-wire.sh\nPurpose: authentication, token management, validation, logging, HTTP/API, file operations\n\n    if [ $json_out -eq 0 ] && [ \"$check_remote\" -eq 1 ]; then\n      if [ \"$PROBE_CODE\" = \"200\" ]; then\n        ok \"Remote MCP (mcp.figma.com) reachable and authenticated\"\n      elif [ \"$PROBE_CODE\" = \"401\" ]; then\n        if [ \"$present\" = \"true\" ] && [ \"$enabled\" != \"false\" ]; then\n          warn \"Remote MCP reachable but unauthenticated — it fails every session (HTTP 401)\"\n          info \"No token? Run: figma-wire remote off    |    Have a token? Run: figma-wire remote token <TOKEN>\"\n        else\n          ok \"Remote MCP reachable, disabled (correct until a token is configured)\"\n        fi\n      else\n        warn \"Remote MCP probe: HTTP ${PROBE_CODE} (offline or proxy issue — harmless for the local path)\"","content":"    if [ $json_out -eq 0 ] && [ \"$check_remote\" -eq 1 ]; then\n      if [ \"$PROBE_CODE\" = \"200\" ]; then\n        ok \"Remote MCP (mcp.figma.com) reachable and authenticated\"\n      elif [ \"$PROBE_CODE\" = \"401\" ]; then\n        if [ \"$present\" = \"true\" ] && [ \"$enabled\" != \"false\" ]; then\n          warn \"Remote MCP reachable but unauthenticated — it fails every session (HTTP 401)\"\n          info \"No token? Run: figma-wire remote off    |    Have a token? Run: figma-wire remote token <TOKEN>\"\n        else\n          ok \"Remote MCP reachable, disabled (correct until a token is configured)\"\n        fi\n      else\n        warn \"Remote MCP probe: HTTP ${PROBE_CODE} (offline or proxy issue — harmless for the local path)\"","contentHash":"75fc4cd0f161d053","metadata":{"filePath":"skills/figma-code/scripts/figma-wire.sh","startLine":400,"endLine":411,"chunkType":"function_definition","name":"cmd_doctor","language":"bash","hash":"75fc4cd0f161d053"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":11,"lastAttempt":"2026-10-17T11:40:24.003Z"}
