{"version":1,"chunks":[{"id":"chunk_e1753f43931d9955","texts":[{"text":"bash function \"local_url_for\"\nin figma-code/scripts/figma-wire.sh\nPurpose: HTTP/API\n\nlocal_url_for() { echo \"http://127.0.0.1:${1}/mcp\"; }","tokenCount":35}],"storageText":"bash function \"local_url_for\"\nin figma-code/scripts/figma-wire.sh\nPurpose: HTTP/API\n\nlocal_url_for() { echo \"http://127.0.0.1:${1}/mcp\"; }","content":"local_url_for() { echo \"http://127.0.0.1:${1}/mcp\"; }","contentHash":"6c0ddde8b03a99bf","metadata":{"filePath":"skills/figma-code/scripts/figma-wire.sh","startLine":78,"endLine":78,"chunkType":"function_definition","name":"local_url_for","language":"bash","hash":"6c0ddde8b03a99bf"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":11,"lastAttempt":"2026-10-17T11:40:23.914Z"}
{"version":1,"chunks":[{"id":"chunk_b43e92b3e250dddc","texts":[{"text":"bash function \"resolve_port\"\nin figma-code/scripts/figma-wire.sh\nPurpose: configuration, state management\n\n# Port precedence: FIGMA_WIRE_PORT env > persisted state > default 3845.\nresolve_port() {\n  if [ -n \"${FIGMA_WIRE_PORT:-}\" ]; then echo \"$FIGMA_WIRE_PORT\"; return 0; fi\n  local p; p=\"$(state_get '.localPort')\"\n  if [ -n \"$p\" ]; then echo \"$p\"; else echo \"3845\"; fi\n}","tokenCount":94}],"storageText":"bash function \"resolve_port\"\nin figma-code/scripts/figma-wire.sh\nPurpose: configuration, state management\n\n# Port precedence: FIGMA_WIRE_PORT env > persisted state > default 3845.\nresolve_port() {\n  if [ -n \"${FIGMA_WIRE_PORT:-}\" ]; then echo \"$FIGMA_WIRE_PORT\"; return 0; fi\n  local p; p=\"$(state_get '.localPort')\"\n  if [ -n \"$p\" ]; then echo \"$p\"; else echo \"3845\"; fi\n}","content":"# Port precedence: FIGMA_WIRE_PORT env > persisted state > default 3845.\nresolve_port() {\n  if [ -n \"${FIGMA_WIRE_PORT:-}\" ]; then echo \"$FIGMA_WIRE_PORT\"; return 0; fi\n  local p; p=\"$(state_get '.localPort')\"\n  if [ -n \"$p\" ]; then echo \"$p\"; else echo \"3845\"; fi\n}","contentHash":"1e9b65863b6a072c","metadata":{"filePath":"skills/figma-code/scripts/figma-wire.sh","startLine":80,"endLine":85,"chunkType":"function_definition","name":"resolve_port","language":"bash","hash":"1e9b65863b6a072c"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":11,"lastAttempt":"2026-10-17T11:40:24.003Z"}
{"version":1,"chunks":[{"id":"chunk_89dba120b6f37f5b","texts":[{"text":"bash function \"find_local_port\"\nin figma-code/scripts/figma-wire.sh\nPurpose: configuration\n\n# Scan the configured port range for a live Dev Mode server.\n# Range format: \"A-B\" (inclusive). Set FIGMA_WIRE_SCAN_PORTS to override.\nfind_local_port() {\n  local first=\"\" p\n  local configured; configured=\"$(resolve_port)\"\n  probe \"$(local_url_for \"$configured\")\"\n  [ \"$PROBE_CODE\" = \"200\" ] && is_devmode_body && { echo \"$configured\"; return 0; }\n  local range=\"${FIGMA_WIRE_SCAN_PORTS:-3845-3854}\"\n  local lo=\"${range%-*}\" hi=\"${range#*-}\"\n  local save_max=\"$PROBE_MAXTIME\"; PROBE_MAXTIME=1\n  for p in $(seq \"$lo\" \"$hi\"); do\n    [ \"$p\" = \"$configured\" ] && continue\n    probe \"$(local_url_for \"$p\")\"\n    if [ \"$PROBE_CODE\" = \"200\" ] && is_devmode_body; then first=\"$p\"; break; fi\n  done\n  PROBE_MAXTIME=\"$save_max\"\n  [ -n \"$first\" ] && { echo \"$first\"; return 0; }\n  return 1\n}","tokenCount":218}],"storageText":"bash function \"find_local_port\"\nin figma-code/scripts/figma-wire.sh\nPurpose: configuration\n\n# Scan the configured port range for a live Dev Mode server.\n# Range format: \"A-B\" (inclusive). Set FIGMA_WIRE_SCAN_PORTS to override.\nfind_local_port() {\n  local first=\"\" p\n  local configured; configured=\"$(resolve_port)\"\n  probe \"$(local_url_for \"$configured\")\"\n  [ \"$PROBE_CODE\" = \"200\" ] && is_devmode_body && { echo \"$configured\"; return 0; }\n  local range=\"${FIGMA_WIRE_SCAN_PORTS:-3845-3854}\"\n  local lo=\"${range%-*}\" hi=\"${range#*-}\"\n  local save_max=\"$PROBE_MAXTIME\"; PROBE_MAXTIME=1\n  for p in $(seq \"$lo\" \"$hi\"); do\n    [ \"$p\" = \"$configured\" ] && continue\n    probe \"$(local_url_for \"$p\")\"\n    if [ \"$PROBE_CODE\" = \"200\" ] && is_devmode_body; then first=\"$p\"; break; fi\n  done\n  PROBE_MAXTIME=\"$save_max\"\n  [ -n \"$first\" ] && { echo \"$first\"; return 0; }\n  return 1\n}","content":"# Scan the configured port range for a live Dev Mode server.\n# Range format: \"A-B\" (inclusive). Set FIGMA_WIRE_SCAN_PORTS to override.\nfind_local_port() {\n  local first=\"\" p\n  local configured; configured=\"$(resolve_port)\"\n  probe \"$(local_url_for \"$configured\")\"\n  [ \"$PROBE_CODE\" = \"200\" ] && is_devmode_body && { echo \"$configured\"; return 0; }\n  local range=\"${FIGMA_WIRE_SCAN_PORTS:-3845-3854}\"\n  local lo=\"${range%-*}\" hi=\"${range#*-}\"\n  local save_max=\"$PROBE_MAXTIME\"; PROBE_MAXTIME=1\n  for p in $(seq \"$lo\" \"$hi\"); do\n    [ \"$p\" = \"$configured\" ] && continue\n    probe \"$(local_url_for \"$p\")\"\n    if [ \"$PROBE_CODE\" = \"200\" ] && is_devmode_body; then first=\"$p\"; break; fi\n  done\n  PROBE_MAXTIME=\"$save_max\"\n  [ -n \"$first\" ] && { echo \"$first\"; return 0; }\n  return 1\n}","contentHash":"2527f3a9de33f824","metadata":{"filePath":"skills/figma-code/scripts/figma-wire.sh","startLine":87,"endLine":105,"chunkType":"function_definition","name":"find_local_port","language":"bash","hash":"2527f3a9de33f824"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":11,"lastAttempt":"2026-10-17T11:40:24.003Z"}
{"version":1,"chunks":[{"id":"chunk_fd7febfde1518775","texts":[{"text":"bash function \"detect_harness\"\nin figma-code/scripts/figma-wire.sh\nPurpose: file operations, data parsing, configuration\n\ndetect_harness() {\n  [ -n \"$HARNESS\" ] && { echo \"$HARNESS\"; return; }\n  [ -n \"${FIGMA_WIRE_HARNESS:-}\" ] && { echo \"$FIGMA_WIRE_HARNESS\"; return; }\n  [ -f \"$HOME/.zcode/cli/config.json\" ] && { echo zcode; return; }\n  [ -f \"$HOME/.claude.json\" ] && { echo claude; return; }\n  [ -f \"$HOME/.cursor/mcp.json\" ] && { echo cursor; return; }\n  [ -f \"$HOME/.codeium/windsurf/mcp_config.json\" ] && { echo windsurf; return; }\n  [ -f \"$HOME/.gemini/settings.json\" ] && { echo gemini; return; }\n  [ -f \"$(vscode_config_path)\" ] && { echo vscode; return; }\n  [ -f \"$HOME/.codex/config.toml\" ] && { echo codex; return; }\n  echo generic\n}","tokenCount":187}],"storageText":"bash function \"detect_harness\"\nin figma-code/scripts/figma-wire.sh\nPurpose: file operations, data parsing, configuration\n\ndetect_harness() {\n  [ -n \"$HARNESS\" ] && { echo \"$HARNESS\"; return; }\n  [ -n \"${FIGMA_WIRE_HARNESS:-}\" ] && { echo \"$FIGMA_WIRE_HARNESS\"; return; }\n  [ -f \"$HOME/.zcode/cli/config.json\" ] && { echo zcode; return; }\n  [ -f \"$HOME/.claude.json\" ] && { echo claude; return; }\n  [ -f \"$HOME/.cursor/mcp.json\" ] && { echo cursor; return; }\n  [ -f \"$HOME/.codeium/windsurf/mcp_config.json\" ] && { echo windsurf; return; }\n  [ -f \"$HOME/.gemini/settings.json\" ] && { echo gemini; return; }\n  [ -f \"$(vscode_config_path)\" ] && { echo vscode; return; }\n  [ -f \"$HOME/.codex/config.toml\" ] && { echo codex; return; }\n  echo generic\n}","content":"detect_harness() {\n  [ -n \"$HARNESS\" ] && { echo \"$HARNESS\"; return; }\n  [ -n \"${FIGMA_WIRE_HARNESS:-}\" ] && { echo \"$FIGMA_WIRE_HARNESS\"; return; }\n  [ -f \"$HOME/.zcode/cli/config.json\" ] && { echo zcode; return; }\n  [ -f \"$HOME/.claude.json\" ] && { echo claude; return; }\n  [ -f \"$HOME/.cursor/mcp.json\" ] && { echo cursor; return; }\n  [ -f \"$HOME/.codeium/windsurf/mcp_config.json\" ] && { echo windsurf; return; }\n  [ -f \"$HOME/.gemini/settings.json\" ] && { echo gemini; return; }\n  [ -f \"$(vscode_config_path)\" ] && { echo vscode; return; }\n  [ -f \"$HOME/.codex/config.toml\" ] && { echo codex; return; }\n  echo generic\n}","contentHash":"696b6ce88151f3ad","metadata":{"filePath":"skills/figma-code/scripts/figma-wire.sh","startLine":110,"endLine":121,"chunkType":"function_definition","name":"detect_harness","language":"bash","hash":"696b6ce88151f3ad"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":11,"lastAttempt":"2026-10-17T11:40:24.003Z"}
