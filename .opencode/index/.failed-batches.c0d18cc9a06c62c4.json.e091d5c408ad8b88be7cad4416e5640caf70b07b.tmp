{"version":1,"chunks":[{"id":"chunk_65f6ff9b36ae22e9","texts":[{"text":"bash function \"main\"\nin figma-pages/scripts/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\n          dir=$(dirname \"$CONFIG\")\n          mkdir -p \"$dir\"; chmod 700 \"$dir\" 2>/dev/null || true\n          local tmpf\n          tmpf=$(mktemp \"$dir/.servers.XXXXXX\") || return 1\n          if [ -f \"$CONFIG\" ]; then cp \"$CONFIG\" \"$tmpf.base\"; else echo '{\"servers\":{}}' > \"$tmpf.base\"; fi\n          # build entry\n          local entry\n          entry=$(jq -nc --arg url \"$url\" --argjson ah \"$allow_http\" '{url:$url,allow_http:($ah==1)}')\n          if [ ${#headers[@]} -gt 0 ]; then\n            local hjson\n            hjson=$(printf '%s\\n' \"${headers[@]}\" | jq -R . | jq -sc .)\n            entry=$(jq -c --argjson h \"$hjson\" '.headers=$h' <<<\"$entry\")","tokenCount":189}],"storageText":"bash function \"main\"\nin figma-pages/scripts/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\n          dir=$(dirname \"$CONFIG\")\n          mkdir -p \"$dir\"; chmod 700 \"$dir\" 2>/dev/null || true\n          local tmpf\n          tmpf=$(mktemp \"$dir/.servers.XXXXXX\") || return 1\n          if [ -f \"$CONFIG\" ]; then cp \"$CONFIG\" \"$tmpf.base\"; else echo '{\"servers\":{}}' > \"$tmpf.base\"; fi\n          # build entry\n          local entry\n          entry=$(jq -nc --arg url \"$url\" --argjson ah \"$allow_http\" '{url:$url,allow_http:($ah==1)}')\n          if [ ${#headers[@]} -gt 0 ]; then\n            local hjson\n            hjson=$(printf '%s\\n' \"${headers[@]}\" | jq -R . | jq -sc .)\n            entry=$(jq -c --argjson h \"$hjson\" '.headers=$h' <<<\"$entry\")","content":"          dir=$(dirname \"$CONFIG\")\n          mkdir -p \"$dir\"; chmod 700 \"$dir\" 2>/dev/null || true\n          local tmpf\n          tmpf=$(mktemp \"$dir/.servers.XXXXXX\") || return 1\n          if [ -f \"$CONFIG\" ]; then cp \"$CONFIG\" \"$tmpf.base\"; else echo '{\"servers\":{}}' > \"$tmpf.base\"; fi\n          # build entry\n          local entry\n          entry=$(jq -nc --arg url \"$url\" --argjson ah \"$allow_http\" '{url:$url,allow_http:($ah==1)}')\n          if [ ${#headers[@]} -gt 0 ]; then\n            local hjson\n            hjson=$(printf '%s\\n' \"${headers[@]}\" | jq -R . | jq -sc .)\n            entry=$(jq -c --argjson h \"$hjson\" '.headers=$h' <<<\"$entry\")","contentHash":"af3f61785029b879","metadata":{"filePath":"skills/figma-pages/scripts/mcp-wire.sh","startLine":341,"endLine":352,"chunkType":"function_definition","name":"main","language":"bash","hash":"af3f61785029b879"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.590Z"}
{"version":1,"chunks":[{"id":"chunk_e154180bbb38d77f","texts":[{"text":"bash function \"main\"\nin figma-pages/scripts/mcp-wire.sh\nPurpose: authentication, logging, caching, data parsing, configuration, state management\n\n            local hjson\n            hjson=$(printf '%s\\n' \"${headers[@]}\" | jq -R . | jq -sc .)\n            entry=$(jq -c --argjson h \"$hjson\" '.headers=$h' <<<\"$entry\")\n          fi\n          jq --arg name \"$name\" --argjson entry \"$entry\" '.servers[$name]=$entry' \"$tmpf.base\" > \"$tmpf\"\n          chmod 600 \"$tmpf\"\n          mv \"$tmpf\" \"$CONFIG\"\n          rm -f \"$tmpf.base\"\n          if [ \"$store_literal\" -eq 1 ]; then echo \"warning: stored literal credential\" >&2; fi\n          ok \"added $name\"\n          return 0 ;;\n        rm)","tokenCount":170}],"storageText":"bash function \"main\"\nin figma-pages/scripts/mcp-wire.sh\nPurpose: authentication, logging, caching, data parsing, configuration, state management\n\n            local hjson\n            hjson=$(printf '%s\\n' \"${headers[@]}\" | jq -R . | jq -sc .)\n            entry=$(jq -c --argjson h \"$hjson\" '.headers=$h' <<<\"$entry\")\n          fi\n          jq --arg name \"$name\" --argjson entry \"$entry\" '.servers[$name]=$entry' \"$tmpf.base\" > \"$tmpf\"\n          chmod 600 \"$tmpf\"\n          mv \"$tmpf\" \"$CONFIG\"\n          rm -f \"$tmpf.base\"\n          if [ \"$store_literal\" -eq 1 ]; then echo \"warning: stored literal credential\" >&2; fi\n          ok \"added $name\"\n          return 0 ;;\n        rm)","content":"            local hjson\n            hjson=$(printf '%s\\n' \"${headers[@]}\" | jq -R . | jq -sc .)\n            entry=$(jq -c --argjson h \"$hjson\" '.headers=$h' <<<\"$entry\")\n          fi\n          jq --arg name \"$name\" --argjson entry \"$entry\" '.servers[$name]=$entry' \"$tmpf.base\" > \"$tmpf\"\n          chmod 600 \"$tmpf\"\n          mv \"$tmpf\" \"$CONFIG\"\n          rm -f \"$tmpf.base\"\n          if [ \"$store_literal\" -eq 1 ]; then echo \"warning: stored literal credential\" >&2; fi\n          ok \"added $name\"\n          return 0 ;;\n        rm)","contentHash":"b9485cf1d78a1d18","metadata":{"filePath":"skills/figma-pages/scripts/mcp-wire.sh","startLine":350,"endLine":361,"chunkType":"function_definition","name":"main","language":"bash","hash":"b9485cf1d78a1d18"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.590Z"}
{"version":1,"chunks":[{"id":"chunk_7444ae960fc71669","texts":[{"text":"bash function \"main\"\nin figma-pages/scripts/mcp-wire.sh\nPurpose: file operations, configuration\n\n          ok \"added $name\"\n          return 0 ;;\n        rm)\n          local name=\"${1:-}\"\n          [ -f \"$CONFIG\" ] || { bad \"No registry.\"; return 1; }\n          jq --arg name \"$name\" 'del(.servers[$name])' \"$CONFIG\" > \"$CONFIG.tmp\" && mv \"$CONFIG.tmp\" \"$CONFIG\"\n          ok \"removed $name\"\n          return 0 ;;\n        *) bad \"Use servers add|list|rm|path.\"; return 1 ;;\n      esac\n      return ;;\n    doctor) doctor=1; shift; if [ $# -eq 0 ]; then","tokenCount":138}],"storageText":"bash function \"main\"\nin figma-pages/scripts/mcp-wire.sh\nPurpose: file operations, configuration\n\n          ok \"added $name\"\n          return 0 ;;\n        rm)\n          local name=\"${1:-}\"\n          [ -f \"$CONFIG\" ] || { bad \"No registry.\"; return 1; }\n          jq --arg name \"$name\" 'del(.servers[$name])' \"$CONFIG\" > \"$CONFIG.tmp\" && mv \"$CONFIG.tmp\" \"$CONFIG\"\n          ok \"removed $name\"\n          return 0 ;;\n        *) bad \"Use servers add|list|rm|path.\"; return 1 ;;\n      esac\n      return ;;\n    doctor) doctor=1; shift; if [ $# -eq 0 ]; then","content":"          ok \"added $name\"\n          return 0 ;;\n        rm)\n          local name=\"${1:-}\"\n          [ -f \"$CONFIG\" ] || { bad \"No registry.\"; return 1; }\n          jq --arg name \"$name\" 'del(.servers[$name])' \"$CONFIG\" > \"$CONFIG.tmp\" && mv \"$CONFIG.tmp\" \"$CONFIG\"\n          ok \"removed $name\"\n          return 0 ;;\n        *) bad \"Use servers add|list|rm|path.\"; return 1 ;;\n      esac\n      return ;;\n    doctor) doctor=1; shift; if [ $# -eq 0 ]; then","contentHash":"0f8174564be89499","metadata":{"filePath":"skills/figma-pages/scripts/mcp-wire.sh","startLine":359,"endLine":370,"chunkType":"function_definition","name":"main","language":"bash","hash":"0f8174564be89499"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.590Z"}
{"version":1,"chunks":[{"id":"chunk_9bf71b4a2be0bae0","texts":[{"text":"bash block\nin scripts/lint-skills.sh\nPurpose: token management, encryption/cryptography, configuration\n\n#!/usr/bin/env bash\nset -u\nROOT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"\ncd \"$ROOT\"\nfail=0\nfor d in skills/*/; do\n  [ -f \"$d/SKILL.md\" ] || continue\n  name=\"$(basename \"$d\")\"\n  # frontmatter name matches folder\n  fm_name=\"$(sed -n 's/^name: *//p' \"$d/SKILL.md\" | head -1)\"\n  [ \"$fm_name\" = \"$name\" ] || { echo \"FAIL $name: frontmatter name mismatch ($fm_name)\"; fail=1; }\n  # description present\n  grep -q '^description:' \"$d/SKILL.md\" || { echo \"FAIL $name: no description\"; fail=1; }\n  # vendored engine match\n  if [ -f \"$d/scripts/mcp-wire.sh\" ]; then\n    cmp -s engine/mcp-wire.sh \"$d/scripts/mcp-wire.sh\" || { echo \"FAIL $name: engine drift\"; fail=1; }\n  fi\ndone\n# secrets patterns\nif grep -RniE 'Bearer [A-Za-z0-9_-]{20,}|figd_[A-Za-z0-9]+' skills/ 2>/dev/null; then echo \"FAIL: secret pattern\"; fail=1; fi\nexit $fail","tokenCount":235}],"storageText":"bash block\nin scripts/lint-skills.sh\nPurpose: token management, encryption/cryptography, configuration\n\n#!/usr/bin/env bash\nset -u\nROOT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"\ncd \"$ROOT\"\nfail=0\nfor d in skills/*/; do\n  [ -f \"$d/SKILL.md\" ] || continue\n  name=\"$(basename \"$d\")\"\n  # frontmatter name matches folder\n  fm_name=\"$(sed -n 's/^name: *//p' \"$d/SKILL.md\" | head -1)\"\n  [ \"$fm_name\" = \"$name\" ] || { echo \"FAIL $name: frontmatter name mismatch ($fm_name)\"; fail=1; }\n  # description present\n  grep -q '^description:' \"$d/SKILL.md\" || { echo \"FAIL $name: no description\"; fail=1; }\n  # vendored engine match\n  if [ -f \"$d/scripts/mcp-wire.sh\" ]; then\n    cmp -s engine/mcp-wire.sh \"$d/scripts/mcp-wire.sh\" || { echo \"FAIL $name: engine drift\"; fail=1; }\n  fi\ndone\n# secrets patterns\nif grep -RniE 'Bearer [A-Za-z0-9_-]{20,}|figd_[A-Za-z0-9]+' skills/ 2>/dev/null; then echo \"FAIL: secret pattern\"; fail=1; fi\nexit $fail","content":"#!/usr/bin/env bash\nset -u\nROOT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"\ncd \"$ROOT\"\nfail=0\nfor d in skills/*/; do\n  [ -f \"$d/SKILL.md\" ] || continue\n  name=\"$(basename \"$d\")\"\n  # frontmatter name matches folder\n  fm_name=\"$(sed -n 's/^name: *//p' \"$d/SKILL.md\" | head -1)\"\n  [ \"$fm_name\" = \"$name\" ] || { echo \"FAIL $name: frontmatter name mismatch ($fm_name)\"; fail=1; }\n  # description present\n  grep -q '^description:' \"$d/SKILL.md\" || { echo \"FAIL $name: no description\"; fail=1; }\n  # vendored engine match\n  if [ -f \"$d/scripts/mcp-wire.sh\" ]; then\n    cmp -s engine/mcp-wire.sh \"$d/scripts/mcp-wire.sh\" || { echo \"FAIL $name: engine drift\"; fail=1; }\n  fi\ndone\n# secrets patterns\nif grep -RniE 'Bearer [A-Za-z0-9_-]{20,}|figd_[A-Za-z0-9]+' skills/ 2>/dev/null; then echo \"FAIL: secret pattern\"; fail=1; fi\nexit $fail","contentHash":"b2007d1d8996b06b","metadata":{"filePath":"scripts/lint-skills.sh","startLine":1,"endLine":21,"chunkType":"block","language":"bash","hash":"b2007d1d8996b06b"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":6,"lastAttempt":"2026-10-17T11:40:23.678Z"}
{"version":1,"chunks":[{"id":"chunk_89687bdcb96cf6d1","texts":[{"text":"bash function \"main\"\nin figma-wire/scripts/mcp-wire.sh\nPurpose: file operations\n\n    while IFS= read -r _h; do\n      [ -n \"$_h\" ] && HEADERS+=(\"$_h\")\n    done <<< \"$MCP_WIRE_HEADERS\"\n  fi\n  set -- ${args[@]+\"${args[@]}\"}\n  [ $# -gt 0 ] || { usage; return 1; }\n  local cmd=\"$1\" target='' doctor=0\n  case \"$cmd\" in\n    servers)\n      shift\n      local sub=\"${1:-list}\"; [ $# -eq 0 ] || shift\n      case \"$sub\" in","tokenCount":103}],"storageText":"bash function \"main\"\nin figma-wire/scripts/mcp-wire.sh\nPurpose: file operations\n\n    while IFS= read -r _h; do\n      [ -n \"$_h\" ] && HEADERS+=(\"$_h\")\n    done <<< \"$MCP_WIRE_HEADERS\"\n  fi\n  set -- ${args[@]+\"${args[@]}\"}\n  [ $# -gt 0 ] || { usage; return 1; }\n  local cmd=\"$1\" target='' doctor=0\n  case \"$cmd\" in\n    servers)\n      shift\n      local sub=\"${1:-list}\"; [ $# -eq 0 ] || shift\n      case \"$sub\" in","content":"    while IFS= read -r _h; do\n      [ -n \"$_h\" ] && HEADERS+=(\"$_h\")\n    done <<< \"$MCP_WIRE_HEADERS\"\n  fi\n  set -- ${args[@]+\"${args[@]}\"}\n  [ $# -gt 0 ] || { usage; return 1; }\n  local cmd=\"$1\" target='' doctor=0\n  case \"$cmd\" in\n    servers)\n      shift\n      local sub=\"${1:-list}\"; [ $# -eq 0 ] || shift\n      case \"$sub\" in","contentHash":"10d265b173485394","metadata":{"filePath":"skills/figma-wire/scripts/mcp-wire.sh","startLine":296,"endLine":307,"chunkType":"function_definition","name":"main","language":"bash","hash":"10d265b173485394"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.678Z"}
{"version":1,"chunks":[{"id":"chunk_aa2a270d0b570766","texts":[{"text":"bash function \"main\"\nin figma-wire/scripts/mcp-wire.sh\nPurpose: caching, HTTP/API, file operations, data parsing, configuration, state management\n\n      shift\n      local sub=\"${1:-list}\"; [ $# -eq 0 ] || shift\n      case \"$sub\" in\n        path) printf '%s\\n' \"$CONFIG\"; return 0 ;;\n        list)\n          if [ ! -f \"$CONFIG\" ]; then echo '[]'; return 0; fi\n          jq -e '.servers | to_entries | map({name:.key,transport:(if .value.command then \"stdio\" else \"http\" end)})' \"$CONFIG\"; return ;;\n        add)\n          local name=\"${1:-}\" url=\"${2:-}\"; shift 2 2>/dev/null || true\n          # parse flags\n          local allow_http=0 store_literal=0 headers=()\n          while [ $# -gt 0 ]; do","tokenCount":174}],"storageText":"bash function \"main\"\nin figma-wire/scripts/mcp-wire.sh\nPurpose: caching, HTTP/API, file operations, data parsing, configuration, state management\n\n      shift\n      local sub=\"${1:-list}\"; [ $# -eq 0 ] || shift\n      case \"$sub\" in\n        path) printf '%s\\n' \"$CONFIG\"; return 0 ;;\n        list)\n          if [ ! -f \"$CONFIG\" ]; then echo '[]'; return 0; fi\n          jq -e '.servers | to_entries | map({name:.key,transport:(if .value.command then \"stdio\" else \"http\" end)})' \"$CONFIG\"; return ;;\n        add)\n          local name=\"${1:-}\" url=\"${2:-}\"; shift 2 2>/dev/null || true\n          # parse flags\n          local allow_http=0 store_literal=0 headers=()\n          while [ $# -gt 0 ]; do","content":"      shift\n      local sub=\"${1:-list}\"; [ $# -eq 0 ] || shift\n      case \"$sub\" in\n        path) printf '%s\\n' \"$CONFIG\"; return 0 ;;\n        list)\n          if [ ! -f \"$CONFIG\" ]; then echo '[]'; return 0; fi\n          jq -e '.servers | to_entries | map({name:.key,transport:(if .value.command then \"stdio\" else \"http\" end)})' \"$CONFIG\"; return ;;\n        add)\n          local name=\"${1:-}\