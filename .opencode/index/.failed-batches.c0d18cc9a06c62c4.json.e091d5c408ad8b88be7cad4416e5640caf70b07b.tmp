{"version":1,"chunks":[{"id":"chunk_b80d6e8a052dd027","texts":[{"text":"bash function \"vscode_config_path\"\nin figma-code/scripts/figma-wire.sh\nPurpose: user management, file operations, data parsing, configuration\n\nvscode_config_path() {\n  case \"$(uname -s)\" in\n    Darwin) echo \"${FIGMA_WIRE_CONFIG:-$HOME/Library/Application Support/Code/User/settings.json}\" ;;\n    *)      echo \"${FIGMA_WIRE_CONFIG:-$HOME/.config/Code/User/settings.json}\" ;;\n  esac\n}","tokenCount":96}],"storageText":"bash function \"vscode_config_path\"\nin figma-code/scripts/figma-wire.sh\nPurpose: user management, file operations, data parsing, configuration\n\nvscode_config_path() {\n  case \"$(uname -s)\" in\n    Darwin) echo \"${FIGMA_WIRE_CONFIG:-$HOME/Library/Application Support/Code/User/settings.json}\" ;;\n    *)      echo \"${FIGMA_WIRE_CONFIG:-$HOME/.config/Code/User/settings.json}\" ;;\n  esac\n}","content":"vscode_config_path() {\n  case \"$(uname -s)\" in\n    Darwin) echo \"${FIGMA_WIRE_CONFIG:-$HOME/Library/Application Support/Code/User/settings.json}\" ;;\n    *)      echo \"${FIGMA_WIRE_CONFIG:-$HOME/.config/Code/User/settings.json}\" ;;\n  esac\n}","contentHash":"e3179ce937664761","metadata":{"filePath":"skills/figma-code/scripts/figma-wire.sh","startLine":125,"endLine":130,"chunkType":"function_definition","name":"vscode_config_path","language":"bash","hash":"e3179ce937664761"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":11,"lastAttempt":"2026-10-17T11:40:24.003Z"}
{"version":1,"chunks":[{"id":"chunk_88d27be01ec02eb1","texts":[{"text":"bash function \"harness_config_path\"\nin figma-code/scripts/figma-wire.sh\nPurpose: file operations, data parsing, configuration\n\nharness_config_path() { # $1 harness -> config path on stdout\n  case \"$1\" in\n    zcode)    echo \"${FIGMA_WIRE_CONFIG:-$HOME/.zcode/cli/config.json}\" ;;\n    claude)   echo \"${FIGMA_WIRE_CONFIG:-$HOME/.claude.json}\" ;;\n    cursor)   echo \"${FIGMA_WIRE_CONFIG:-$HOME/.cursor/mcp.json}\" ;;\n    windsurf) echo \"${FIGMA_WIRE_CONFIG:-$HOME/.codeium/windsurf/mcp_config.json}\" ;;\n    gemini)   echo \"${FIGMA_WIRE_CONFIG:-$HOME/.gemini/settings.json}\" ;;\n    vscode)   vscode_config_path ;;\n    codex)    echo \"${FIGMA_WIRE_CONFIG:-$HOME/.codex/config.toml}\" ;;\n    generic)  echo \"${FIGMA_WIRE_CONFIG:-$HOME/.agents/mcp.json}\" ;;\n    *) return 1 ;;\n  esac\n}","tokenCount":194}],"storageText":"bash function \"harness_config_path\"\nin figma-code/scripts/figma-wire.sh\nPurpose: file operations, data parsing, configuration\n\nharness_config_path() { # $1 harness -> config path on stdout\n  case \"$1\" in\n    zcode)    echo \"${FIGMA_WIRE_CONFIG:-$HOME/.zcode/cli/config.json}\" ;;\n    claude)   echo \"${FIGMA_WIRE_CONFIG:-$HOME/.claude.json}\" ;;\n    cursor)   echo \"${FIGMA_WIRE_CONFIG:-$HOME/.cursor/mcp.json}\" ;;\n    windsurf) echo \"${FIGMA_WIRE_CONFIG:-$HOME/.codeium/windsurf/mcp_config.json}\" ;;\n    gemini)   echo \"${FIGMA_WIRE_CONFIG:-$HOME/.gemini/settings.json}\" ;;\n    vscode)   vscode_config_path ;;\n    codex)    echo \"${FIGMA_WIRE_CONFIG:-$HOME/.codex/config.toml}\" ;;\n    generic)  echo \"${FIGMA_WIRE_CONFIG:-$HOME/.agents/mcp.json}\" ;;\n    *) return 1 ;;\n  esac\n}","content":"harness_config_path() { # $1 harness -> config path on stdout\n  case \"$1\" in\n    zcode)    echo \"${FIGMA_WIRE_CONFIG:-$HOME/.zcode/cli/config.json}\" ;;\n    claude)   echo \"${FIGMA_WIRE_CONFIG:-$HOME/.claude.json}\" ;;\n    cursor)   echo \"${FIGMA_WIRE_CONFIG:-$HOME/.cursor/mcp.json}\" ;;\n    windsurf) echo \"${FIGMA_WIRE_CONFIG:-$HOME/.codeium/windsurf/mcp_config.json}\" ;;\n    gemini)   echo \"${FIGMA_WIRE_CONFIG:-$HOME/.gemini/settings.json}\" ;;\n    vscode)   vscode_config_path ;;\n    codex)    echo \"${FIGMA_WIRE_CONFIG:-$HOME/.codex/config.toml}\" ;;\n    generic)  echo \"${FIGMA_WIRE_CONFIG:-$HOME/.agents/mcp.json}\" ;;\n    *) return 1 ;;\n  esac\n}","contentHash":"a63807206480ae58","metadata":{"filePath":"skills/figma-code/scripts/figma-wire.sh","startLine":132,"endLine":144,"chunkType":"function_definition","name":"harness_config_path","language":"bash","hash":"a63807206480ae58"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":11,"lastAttempt":"2026-10-17T11:40:24.003Z"}
{"version":1,"chunks":[{"id":"chunk_1456fbe90044085f","texts":[{"text":"bash function \"remote_flag_harness\"\nin figma-code/scripts/figma-wire.sh\n\n# Harnesses whose remote entry supports an \"enabled\" flag; the rest drop the entry.\nremote_flag_harness() { case \"$1\" in zcode|claude|cursor|generic) return 0 ;; *) return 1 ;; esac; }","tokenCount":65}],"storageText":"bash function \"remote_flag_harness\"\nin figma-code/scripts/figma-wire.sh\n\n# Harnesses whose remote entry supports an \"enabled\" flag; the rest drop the entry.\nremote_flag_harness() { case \"$1\" in zcode|claude|cursor|generic) return 0 ;; *) return 1 ;; esac; }","content":"# Harnesses whose remote entry supports an \"enabled\" flag; the rest drop the entry.\nremote_flag_harness() { case \"$1\" in zcode|claude|cursor|generic) return 0 ;; *) return 1 ;; esac; }","contentHash":"c96ac9acd44c1152","metadata":{"filePath":"skills/figma-code/scripts/figma-wire.sh","startLine":146,"endLine":147,"chunkType":"function_definition","name":"remote_flag_harness","language":"bash","hash":"c96ac9acd44c1152"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":11,"lastAttempt":"2026-10-17T11:40:24.003Z"}
{"version":1,"chunks":[{"id":"chunk_f36abd3b00d2008a","texts":[{"text":"bash function \"json_set_local\"\nin figma-code/scripts/figma-wire.sh\nPurpose: HTTP/API, file operations, data parsing, configuration\n\n# Write the figma-local server entry into a harness config.\njson_set_local() { # $1 harness  $2 url  $3 file\n  local expr\n  case \"$1\" in\n    zcode|vscode)   expr='.mcp = (.mcp // {}) | .mcp.servers = (.mcp.servers // {}) | .mcp.servers[\"figma-local\"] = {\"type\":\"http\",\"url\":$url}' ;;\n    claude|generic) expr='.mcpServers = (.mcpServers // {}) | .mcpServers[\"figma-local\"] = {\"type\":\"http\",\"url\":$url}' ;;\n    cursor)         expr='.mcpServers = (.mcpServers // {}) | .mcpServers[\"figma-local\"] = {\"url\":$url}' ;;\n    windsurf)       expr='.mcpServers = (.mcpServers // {}) | .mcpServers[\"figma-local\"] = {\"serverUrl\":$url}' ;;\n    gemini)         expr='.mcpServers = (.mcpServers // {}) | .mcpServers[\"figma-local\"] = {\"httpUrl\":$url}' ;;\n    *) return 1 ;;\n  esac\n  local tmp; tmp=\"$(mktemp \"${3}.tmp.XXXXXX\")\"\n  if jq --arg url \"$2\" \"$expr\" \"$3\" > \"$tmp\" 2>/dev/null; then mv -f \"$tmp\" \"$3\"; else rm -f \"$tmp\"; return 1; fi\n}","tokenCount":265}],"storageText":"bash function \"json_set_local\"\nin figma-code/scripts/figma-wire.sh\nPurpose: HTTP/API, file operations, data parsing, configuration\n\n# Write the figma-local server entry into a harness config.\njson_set_local() { # $1 harness  $2 url  $3 file\n  local expr\n  case \"$1\" in\n    zcode|vscode)   expr='.mcp = (.mcp // {}) | .mcp.servers = (.mcp.servers // {}) | .mcp.servers[\"figma-local\"] = {\"type\":\"http\",\"url\":$url}' ;;\n    claude|generic) expr='.mcpServers = (.mcpServers // {}) | .mcpServers[\"figma-local\"] = {\"type\":\"http\",\"url\":$url}' ;;\n    cursor)         expr='.mcpServers = (.mcpServers // {}) | .mcpServers[\"figma-local\"] = {\"url\":$url}' ;;\n    windsurf)       expr='.mcpServers = (.mcpServers // {}) | .mcpServers[\"figma-local\"] = {\"serverUrl\":$url}' ;;\n    gemini)         expr='.mcpServers = (.mcpServers // {}) | .mcpServers[\"figma-local\"] = {\"httpUrl\":$url}' ;;\n    *) return 1 ;;\n  esac\n  local tmp; tmp=\"$(mktemp \"${3}.tmp.XXXXXX\")\"\n  if jq --arg url \"$2\" \"$expr\" \"$3\" > \"$tmp\" 2>/dev/null; then mv -f \"$tmp\" \"$3\"; else rm -f \"$tmp\"; return 1; fi\n}","content":"# Write the figma-local server entry into a harness config.\njson_set_local() { # $1 harness  $2 url  $3 file\n  local expr\n  case \"$1\" in\n    zcode|vscode)   expr='.mcp = (.mcp // {}) | .mcp.servers = (.mcp.servers // {}) | .mcp.servers[\"figma-local\"] = {\"type\":\"http\",\"url\":$url}' ;;\n    claude|generic) expr='.mcpServers = (.mcpServers // {}) | .mcpServers[\"figma-local\"] = {\"type\":\"http\",\"url\":$url}' ;;\n    cursor)         expr='.mcpServers = (.mcpServers // {}) | .mcpServers[\"figma-local\"] = {\"url\":$url}' ;;\n    windsurf)       expr='.mcpServers = (.mcpServers // {}) | .mcpServers[\"figma-local\"] = {\"serverUrl\":$url}' ;;\n    gemini)         expr='.mcpServers = (.mcpServers // {}) | .mcpServers[\"figma-local\"] = {\"httpUrl\":$url}' ;;\n    *) return 1 ;;\n  esac\n  local tmp; tmp=\"$(mktemp \"${3}.tmp.XXXXXX\")\"\n  if jq --arg url \"$2\" \"$expr\" \"$3\" > \"$tmp\" 2>/dev/null; then mv -f \"$tmp\" \"$3\"; else rm -f \"$tmp\"; return 1; fi\n}","contentHash":"fb69ed86aa059d67","metadata":{"filePath":"skills/figma-code/scripts/figma-wire.sh","startLine":149,"endLine":162,"chunkType":"function_definition","name":"json_set_local","language":"bash","hash":"fb69ed86aa059d67"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":11,"lastAttempt":"2026-10-17T11:40:24.003Z"}
{"version":1,"chunks":[{"id":"chunk_754ec89bd60cd4f3","texts":[{"text":"bash function \"local_entry_url\"\nin figma-code/scripts/figma-wire.sh\nPurpose: HTTP/API, file operations\n\nlocal_entry_url() { # $1 harness $2 file -> url or empty\n  case \"$1\" in\n    codex)              toml_block_url \"mcp_servers.figma-local\" \"$2\" ;;\n    zcode|vscode)       jq -r '.mcp.servers[\"figma-local\"].url // empty' \"$2\" 2>/dev/null || true ;;\n    windsurf)           jq -r '.mcpServers[\"figma-local\"].serverUrl // empty' \"$2\" 2>/dev/null || true ;;\n    gemini)             jq -r '.mcpServers[\"figma-local\"].httpUrl // empty' \"$2\" 2>/dev/null || true ;;\n    *)                  jq -r '.mcpServers[\"figma-local\"].url // empty' \"$2\" 2>/dev/null || true ;;\n  esac\n}","tokenCount":167}],"storageText":"bash function \"local_entry_url\"\nin figma-code/scripts/figma-wire.sh\nPurpose: HTTP/API, file operations\n\nlocal_entry_url() { # $1 harness $2 file -> url or empty\n  case \"$1\" in\n    codex)              toml_block_url \"mcp_servers.figma-local\" \"$2\" ;;\n    zcode|vscode)       jq -r '.mcp.servers[\"figma-local\"].url // empty' \"$2\" 2>/dev/null || true ;;\n    windsurf)           jq -r '.mcpServers[\"figma-local\"].serverUrl // empty' \"$2\" 2>/dev/null || true ;;\n    gemini)             jq -r '.mcpServers[\"figma-local\"].httpUrl // empty' \"$2\" 2>/dev/null || true ;;\n    *)                  jq -r '.mcpServers[\"figma-local\"].url // empty' \"$2\" 2>/dev/null || true ;;\n  esac\n}","content":"local_entry_url() { # $1 harness $2 file -> url or empty\n  case \"$1\" in\n    codex)              toml_block_url \"mcp_servers.figma-local\" \"$2\" ;;\n    zcode|vscode)       jq -r '.mcp.servers[\"figma-local\"].url // empty' \"$2\" 2>/dev/null || true ;;\n    windsurf)           jq -r '.mcpServers[\"figma-local\"].serverUrl // empty' \"$2\" 2>/dev/null || true ;;\n    gemini)             jq -r '.mcpServers[\"figma-local\"].httpUrl // empty' \"$2\" 2>/dev/null || 