{"version":1,"chunks":[{"id":"chunk_76530af8cf67c472","texts":[{"text":"bash function \"emit_result\"\nin figma-design/scripts/mcp-wire.sh\nPurpose: HTTP/API, file operations, data parsing, testing\n\n      case \"$itype\" in\n        text|resource|resource_link)\n          itext=$(jq -r '.text // .resource.text // .uri // .resource.uri // empty' <<<\"$item\")\n          if [ -n \"$prefix\" ]; then printf '%s\\n' \"$itext\" >> \"${prefix}.txt\" || return 1; saved=\"$saved ${prefix}.txt\"\n          else printf '%s\\n' \"$itext\"; fi ;;\n        image)\n          img_n=$((img_n+1)); mime=$(jq -r '.mimeType // \"image/png\"' <<<\"$item\")\n          case \"$mime\" in image/png) ext=png ;; image/jpeg) ext=jpg ;; image/webp) ext=webp ;; *) bad \"Unsupported image MIME type; use --json to inspect the response.\"; return 1 ;; esac\n          imgfile=\"${prefix:-${MCP_WIRE_IMAGE_PREFIX:-mcp-wire}}-${img_n}.${ext}\"\n          jq -r '.data // empty' <<<\"$item\" | b64decode >\"$imgfile\" 2>/dev/null || { rm -f \"$imgfile\"; bad \"Invalid image data.\"; return 1; }\n          saved=\"$saved $imgfile\" ;;\n        *)","tokenCount":250}],"storageText":"bash function \"emit_result\"\nin figma-design/scripts/mcp-wire.sh\nPurpose: HTTP/API, file operations, data parsing, testing\n\n      case \"$itype\" in\n        text|resource|resource_link)\n          itext=$(jq -r '.text // .resource.text // .uri // .resource.uri // empty' <<<\"$item\")\n          if [ -n \"$prefix\" ]; then printf '%s\\n' \"$itext\" >> \"${prefix}.txt\" || return 1; saved=\"$saved ${prefix}.txt\"\n          else printf '%s\\n' \"$itext\"; fi ;;\n        image)\n          img_n=$((img_n+1)); mime=$(jq -r '.mimeType // \"image/png\"' <<<\"$item\")\n          case \"$mime\" in image/png) ext=png ;; image/jpeg) ext=jpg ;; image/webp) ext=webp ;; *) bad \"Unsupported image MIME type; use --json to inspect the response.\"; return 1 ;; esac\n          imgfile=\"${prefix:-${MCP_WIRE_IMAGE_PREFIX:-mcp-wire}}-${img_n}.${ext}\"\n          jq -r '.data // empty' <<<\"$item\" | b64decode >\"$imgfile\" 2>/dev/null || { rm -f \"$imgfile\"; bad \"Invalid image data.\"; return 1; }\n          saved=\"$saved $imgfile\" ;;\n        *)","content":"      case \"$itype\" in\n        text|resource|resource_link)\n          itext=$(jq -r '.text // .resource.text // .uri // .resource.uri // empty' <<<\"$item\")\n          if [ -n \"$prefix\" ]; then printf '%s\\n' \"$itext\" >> \"${prefix}.txt\" || return 1; saved=\"$saved ${prefix}.txt\"\n          else printf '%s\\n' \"$itext\"; fi ;;\n        image)\n          img_n=$((img_n+1)); mime=$(jq -r '.mimeType // \"image/png\"' <<<\"$item\")\n          case \"$mime\" in image/png) ext=png ;; image/jpeg) ext=jpg ;; image/webp) ext=webp ;; *) bad \"Unsupported image MIME type; use --json to inspect the response.\"; return 1 ;; esac\n          imgfile=\"${prefix:-${MCP_WIRE_IMAGE_PREFIX:-mcp-wire}}-${img_n}.${ext}\"\n          jq -r '.data // empty' <<<\"$item\" | b64decode >\"$imgfile\" 2>/dev/null || { rm -f \"$imgfile\"; bad \"Invalid image data.\"; return 1; }\n          saved=\"$saved $imgfile\" ;;\n        *)","contentHash":"2b5399c14b799772","metadata":{"filePath":"skills/figma-design/scripts/mcp-wire.sh","startLine":227,"endLine":238,"chunkType":"function_definition","name":"emit_result","language":"bash","hash":"2b5399c14b799772"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.911Z"}
{"version":1,"chunks":[{"id":"chunk_9118982a9b1ae41c","texts":[{"text":"bash function \"emit_result\"\nin figma-design/scripts/mcp-wire.sh\nPurpose: file operations\n\n          jq -r '.data // empty' <<<\"$item\" | b64decode >\"$imgfile\" 2>/dev/null || { rm -f \"$imgfile\"; bad \"Invalid image data.\"; return 1; }\n          saved=\"$saved $imgfile\" ;;\n        *)\n          # Preserve unfamiliar content as data instead of silently dropping it.\n          if [ -n \"$prefix\" ]; then jq . <<<\"$item\" >>\"$prefix.txt\" || return 1; saved=\"$saved $prefix.txt\"\n          else jq . <<<\"$item\"; fi ;;\n      esac\n    done < <(jq -c '.result.content[]?' <<<\"$data\")\n    [ -z \"$saved\" ] || ok \"saved:$saved\"\n    if ! jq -e '.result | type == \"object\" and has(\"content\")' <<<\"$data\" >/dev/null; then jq '.result' <<<\"$data\"\n    elif jq -e '.result | (.content|length)==0 and has(\"structuredContent\")' <<<\"$data\" >/dev/null; then jq '.result.structuredContent' <<<\"$data\"; fi\n  fi","tokenCount":221}],"storageText":"bash function \"emit_result\"\nin figma-design/scripts/mcp-wire.sh\nPurpose: file operations\n\n          jq -r '.data // empty' <<<\"$item\" | b64decode >\"$imgfile\" 2>/dev/null || { rm -f \"$imgfile\"; bad \"Invalid image data.\"; return 1; }\n          saved=\"$saved $imgfile\" ;;\n        *)\n          # Preserve unfamiliar content as data instead of silently dropping it.\n          if [ -n \"$prefix\" ]; then jq . <<<\"$item\" >>\"$prefix.txt\" || return 1; saved=\"$saved $prefix.txt\"\n          else jq . <<<\"$item\"; fi ;;\n      esac\n    done < <(jq -c '.result.content[]?' <<<\"$data\")\n    [ -z \"$saved\" ] || ok \"saved:$saved\"\n    if ! jq -e '.result | type == \"object\" and has(\"content\")' <<<\"$data\" >/dev/null; then jq '.result' <<<\"$data\"\n    elif jq -e '.result | (.content|length)==0 and has(\"structuredContent\")' <<<\"$data\" >/dev/null; then jq '.result.structuredContent' <<<\"$data\"; fi\n  fi","content":"          jq -r '.data // empty' <<<\"$item\" | b64decode >\"$imgfile\" 2>/dev/null || { rm -f \"$imgfile\"; bad \"Invalid image data.\"; return 1; }\n          saved=\"$saved $imgfile\" ;;\n        *)\n          # Preserve unfamiliar content as data instead of silently dropping it.\n          if [ -n \"$prefix\" ]; then jq . <<<\"$item\" >>\"$prefix.txt\" || return 1; saved=\"$saved $prefix.txt\"\n          else jq . <<<\"$item\"; fi ;;\n      esac\n    done < <(jq -c '.result.content[]?' <<<\"$data\")\n    [ -z \"$saved\" ] || ok \"saved:$saved\"\n    if ! jq -e '.result | type == \"object\" and has(\"content\")' <<<\"$data\" >/dev/null; then jq '.result' <<<\"$data\"\n    elif jq -e '.result | (.content|length)==0 and has(\"structuredContent\")' <<<\"$data\" >/dev/null; then jq '.result.structuredContent' <<<\"$data\"; fi\n  fi","contentHash":"42950f89223da581","metadata":{"filePath":"skills/figma-design/scripts/mcp-wire.sh","startLine":236,"endLine":247,"chunkType":"function_definition","name":"emit_result","language":"bash","hash":"42950f89223da581"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.911Z"}
{"version":1,"chunks":[{"id":"chunk_bac91340b5e68564","texts":[{"text":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: authentication, password handling, token management, caching, HTTP/API, encryption/cryptography\n\n          done\n          [[ \"$name\" =~ ^[A-Za-z0-9_.-]+$ ]] || { bad \"Invalid server name.\"; return 1; }\n          case \"$url\" in http://*|https://*) : ;; *) bad \"URL must start with http:// or https://.\"; return 1 ;; esac\n          # refuse literal credentials\n          local h hname hval\n          for h in \"${headers[@]+\"${headers[@]}\"}\"; do\n            hname=\"${h%%:*}\"; hval=\"${h#*: }\"\n            if [ \"$store_literal\" -eq 0 ]; then\n              if echo \"$hname\" | grep -qiE 'auth|token|key|secret|cookie|password'; then\n                if ! echo \"$hval\" | grep -q '\\${'; then\n                  bad \"Refusing literal credential in header '$hname'. Use \\${ENV_VAR} form, or --store-literal.\"\n                  return 1","tokenCount":222}],"storageText":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: authentication, password handling, token management, caching, HTTP/API, encryption/cryptography\n\n          done\n          [[ \"$name\" =~ ^[A-Za-z0-9_.-]+$ ]] || { bad \"Invalid server name.\"; return 1; }\n          case \"$url\" in http://*|https://*) : ;; *) bad \"URL must start with http:// or https://.\"; return 1 ;; esac\n          # refuse literal credentials\n          local h hname hval\n          for h in \"${headers[@]+\"${headers[@]}\"}\"; do\n            hname=\"${h%%:*}\"; hval=\"${h#*: }\"\n            if [ \"$store_literal\" -eq 0 ]; then\n              if echo \"$hname\" | grep -qiE 'auth|token|key|secret|cookie|password'; then\n                if ! echo \"$hval\" | grep -q '\\${'; then\n                  bad \"Refusing literal credential in header '$hname'. Use \\${ENV_VAR} form, or --store-literal.\"\n                  return 1","content":"          done\n          [[ \"$name\" =~ ^[A-Za-z0-9_.-]+$ ]] || { bad \"Invalid server name.\"; return 1; }\n          case \"$url\" in http://*|https://*) : ;; *) bad \"URL must start with http:// or https://.\"; return 1 ;; esac\n          # refuse literal credentials\n          local h hname hval\n          for h in \"${headers[@]+\"${headers[@]}\"}\"; do\n            hname=\"${h%%:*}\"; hval=\"${h#*: }\"\n            if [ \"$store_literal\" -eq 0 ]; then\n              if echo \"$hname\" | grep -qiE 'auth|token|key|secret|cookie|password'; then\n                if ! echo \"$hval\" | grep -q '\\${'; then\n                  bad \"Refusing literal credential in header '$hname'. Use \\${ENV_VAR} form, or --store-literal.\"\n                  return 1","contentHash":"249e27d6df3ec4e6","metadata":{"filePath":"skills/figma-code/scripts/mcp-wire.sh","startLine":323,"endLine":334,"chunkType":"function_definition","name":"main","language":"bash","hash":"249e27d6df3ec4e6"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.911Z"}
{"version":1,"chunks":[{"id":"chunk_39c2d468172308f9","texts":[{"text":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: authentication, caching, file operations, configuration, state management\n\n                if ! echo \"$hval\" | grep -q '\\${'; then\n                  bad \"Refusing literal credential in header '$hname'. Use \\${ENV_VAR} form, or --store-literal.\"\n                  return 1\n                fi\n              fi\n            fi\n          done\n          # atomic write\n          local dir\n          dir=$(dirname \"$CONFIG\")\n          mkdir -p \"$dir\"; chmod 700 \"$dir\" 2>/dev/null || true\n          local tmpf","tokenCount":142}],"storageText":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: authentication, caching, file operations, configuration, state management\n\n                if ! echo \"$hval\" | grep -q '\\${'; then\n                  bad \"Refusing literal credential in header '$hname'. Use \\${ENV_VAR} form, or --store-literal.\"\n                  return 1\n                fi\n              fi\n            fi\n          done\n          # atomic write\n          local dir\n          dir=$(dirname \"$CONFIG\")\n          mkdir -p \"$dir\"; chmod 700 \"$dir\" 2>/dev/null || true\n          local tmpf","content":"                if ! echo \"$hval\" | grep -q '\\${'; then\n                  bad \"Refusing literal credential in header '$hname'. Use \\${ENV_VAR} form, or --store-literal.\"\n                  return 1\n                fi\n              fi\n            fi\n          done\n          # atomic write\n          local dir\n          dir=$(dirname \"$CONFIG\")\n          mkdir -p \"$dir\"; chmod 700 \"$dir\" 2>/dev/null || true\n          local tmpf","contentHash":"0392535aaec6e751","metadata":{"filePath":"skills/figma-code/scripts/mcp-wire.sh","startLine":332,"endLine":343,"chunkType":"function_definition","name":"main","language":"bash","hash":"0392535aaec6e751"}}],"error":"Google 