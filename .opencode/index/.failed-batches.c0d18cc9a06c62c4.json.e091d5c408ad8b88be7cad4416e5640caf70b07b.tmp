{"version":1,"chunks":[{"id":"chunk_ac24b5902bf2c635","texts":[{"text":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: HTTP/API, file operations\n\n  chmod 600 \"$HEADERS_FILE\"\n  connect || return 1\n  data=$(request_all \"$body\" \"$key\") || return 1\n  case \"$cmd\" in\n    doctor) jq -n --arg t \"$TRANSPORT\" --arg r \"$REPLY\" '{ok:true,initialized:true,ping:true,transport:$t,reply:$r}' ;;\n    describe)\n      local tdata\n      tdata=$(jq -ec --arg t \"$tool\" '.result.tools[] | select(.name==$t)' <<<\"$data\") || {\n        bad \"Tool not found. Available tools: $(jq -r '.result.tools[].name' <<<\"$data\" | head -20 | tr '\\n' ' ')\"\n        return 1\n      }\n      jq -r '.name' <<<\"$tdata\"","tokenCount":156}],"storageText":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: HTTP/API, file operations\n\n  chmod 600 \"$HEADERS_FILE\"\n  connect || return 1\n  data=$(request_all \"$body\" \"$key\") || return 1\n  case \"$cmd\" in\n    doctor) jq -n --arg t \"$TRANSPORT\" --arg r \"$REPLY\" '{ok:true,initialized:true,ping:true,transport:$t,reply:$r}' ;;\n    describe)\n      local tdata\n      tdata=$(jq -ec --arg t \"$tool\" '.result.tools[] | select(.name==$t)' <<<\"$data\") || {\n        bad \"Tool not found. Available tools: $(jq -r '.result.tools[].name' <<<\"$data\" | head -20 | tr '\\n' ' ')\"\n        return 1\n      }\n      jq -r '.name' <<<\"$tdata\"","content":"  chmod 600 \"$HEADERS_FILE\"\n  connect || return 1\n  data=$(request_all \"$body\" \"$key\") || return 1\n  case \"$cmd\" in\n    doctor) jq -n --arg t \"$TRANSPORT\" --arg r \"$REPLY\" '{ok:true,initialized:true,ping:true,transport:$t,reply:$r}' ;;\n    describe)\n      local tdata\n      tdata=$(jq -ec --arg t \"$tool\" '.result.tools[] | select(.name==$t)' <<<\"$data\") || {\n        bad \"Tool not found. Available tools: $(jq -r '.result.tools[].name' <<<\"$data\" | head -20 | tr '\\n' ' ')\"\n        return 1\n      }\n      jq -r '.name' <<<\"$tdata\"","contentHash":"f5771f3b951d25ad","metadata":{"filePath":"skills/figma-code/scripts/mcp-wire.sh","startLine":476,"endLine":487,"chunkType":"function_definition","name":"main","language":"bash","hash":"f5771f3b951d25ad"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.681Z"}
{"version":1,"chunks":[{"id":"chunk_2ab4f8df171f2e22","texts":[{"text":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: data parsing\n\n        return 1\n      }\n      jq -r '.name' <<<\"$tdata\"\n      jq -r '.description // empty' <<<\"$tdata\"\n      echo 'arguments:'\n      local props\n      props=$(jq -c '.inputSchema.properties // {}' <<<\"$tdata\")\n      if [ \"$(jq 'length' <<<\"$props\")\" -eq 0 ]; then echo '  (none)'; else\n        jq -r --argjson req \"$(jq -c '.inputSchema.required // []' <<<\"$tdata\")\" '\n          def tstr: if type == \"array\" then (map(tostring)|join(\"|\")) else tostring end;\n          to_entries[] |\n          \"  \" + .key + \" (\" + ((.value.type // \"any\") | tstr) + (if (.key as $k | $req | index($k)) then \", required\" else \"\" end) + \") — \" + (.value.description // \"\")","tokenCount":183}],"storageText":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: data parsing\n\n        return 1\n      }\n      jq -r '.name' <<<\"$tdata\"\n      jq -r '.description // empty' <<<\"$tdata\"\n      echo 'arguments:'\n      local props\n      props=$(jq -c '.inputSchema.properties // {}' <<<\"$tdata\")\n      if [ \"$(jq 'length' <<<\"$props\")\" -eq 0 ]; then echo '  (none)'; else\n        jq -r --argjson req \"$(jq -c '.inputSchema.required // []' <<<\"$tdata\")\" '\n          def tstr: if type == \"array\" then (map(tostring)|join(\"|\")) else tostring end;\n          to_entries[] |\n          \"  \" + .key + \" (\" + ((.value.type // \"any\") | tstr) + (if (.key as $k | $req | index($k)) then \", required\" else \"\" end) + \") — \" + (.value.description // \"\")","content":"        return 1\n      }\n      jq -r '.name' <<<\"$tdata\"\n      jq -r '.description // empty' <<<\"$tdata\"\n      echo 'arguments:'\n      local props\n      props=$(jq -c '.inputSchema.properties // {}' <<<\"$tdata\")\n      if [ \"$(jq 'length' <<<\"$props\")\" -eq 0 ]; then echo '  (none)'; else\n        jq -r --argjson req \"$(jq -c '.inputSchema.required // []' <<<\"$tdata\")\" '\n          def tstr: if type == \"array\" then (map(tostring)|join(\"|\")) else tostring end;\n          to_entries[] |\n          \"  \" + .key + \" (\" + ((.value.type // \"any\") | tstr) + (if (.key as $k | $req | index($k)) then \", required\" else \"\" end) + \") — \" + (.value.description // \"\")","contentHash":"2225394509c19a40","metadata":{"filePath":"skills/figma-code/scripts/mcp-wire.sh","startLine":485,"endLine":496,"chunkType":"function_definition","name":"main","language":"bash","hash":"2225394509c19a40"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":10,"lastAttempt":"2026-10-17T11:40:23.681Z"}
{"version":1,"chunks":[{"id":"chunk_c8eb74fd5ccc51bb","texts":[{"text":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: placeholder(), data parsing\n\n          def tstr: if type == \"array\" then (map(tostring)|join(\"|\")) else tostring end;\n          to_entries[] |\n          \"  \" + .key + \" (\" + ((.value.type // \"any\") | tstr) + (if (.key as $k | $req | index($k)) then \", required\" else \"\" end) + \") — \" + (.value.description // \"\")\n        ' <<<\"$props\"\n      fi\n      echo 'example:'\n      jq -c --argjson req \"$(jq -c '.inputSchema.required // []' <<<\"$tdata\")\" --argjson props \"$props\" '\n        def placeholder($t):\n          if $t == \"string\" then \"...\"\n          elif ($t == \"number\" or $t == \"integer\") then 0\n          elif $t == \"boolean\" then false\n          elif $t == \"array\" then []","tokenCount":185}],"storageText":"bash function \"main\"\nin figma-code/scripts/mcp-wire.sh\nPurpose: placeholder(), data parsing\n\n          def tstr: if type == \"array\" then (map(tostring)|join(\"|\")) else tostring end;\n          to_entries[] |\n          \"  \" + .key + \" (\" + ((.value.type // \"any\") | tstr) + (if (.key as $k | $req | index($k)) then \", required\" else \"\" end) + \") — \" + (.value.description // \"\")\n        ' <<<\"$props\"\n      fi\n      echo 'example:'\n      jq -c --argjson req \"$(jq -c '.inputSchema.required // []' <<<\"$tdata\")\" --argjson props \"$props\" '\n        def placeholder($t):\n          if $t == \"string\" then \"...\"\n          elif ($t == \"number\" or $t == \"integer\") then 0\n          elif $t == \"boolean\" then false\n          elif $t == \"array\" then []","content":"          def tstr: if type == \"array\" then (map(tostring)|join(\"|\")) else tostring end;\n          to_entries[] |\n          \"  \" + .key + \" (\" + ((.value.type // \"any\") | tstr) + (if (.key as $k | $req | index($k)) then \", required\" else \"\" end) + \") — \" + (.value.descri