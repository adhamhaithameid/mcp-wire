{"version":1,"chunks":[{"id":"chunk_f914a4a0db863e10","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\n      jq -n --argjson ok \"$dok\" '{ok:($ok==1),dependencies:[\"bash\",\"curl\",\"jq\",\"base64\"]}'\n      return\n    fi ;;\n  esac\n  if [ -z \"$STDIO\" ]; then target=\"$1\"; shift; fi\n  case \"$target\" in @*) target=\"${target#@}\";; esac\n  if [ -n \"$target\" ]; then\n    case \"$target\" in\n      http://*|https://*) URL=\"$target\" ;;\n      *)\n        [ -f \"$CONFIG\" ] || { bad \"Unknown server. Pass a URL or create a named server in servers.json.\"; return 1; }\n        local entry","tokenCount":139}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\n      jq -n --argjson ok \"$dok\" '{ok:($ok==1),dependencies:[\"bash\",\"curl\",\"jq\",\"base64\"]}'\n      return\n    fi ;;\n  esac\n  if [ -z \"$STDIO\" ]; then target=\"$1\"; shift; fi\n  case \"$target\" in @*) target=\"${target#@}\";; esac\n  if [ -n \"$target\" ]; then\n    case \"$target\" in\n      http://*|https://*) URL=\"$target\" ;;\n      *)\n        [ -f \"$CONFIG\" ] || { bad \"Unknown server. Pass a URL or create a named server in servers.json.\"; return 1; }\n        local entry","content":"      jq -n --argjson ok \"$dok\" '{ok:($ok==1),dependencies:[\"bash\",\"curl\",\"jq\",\"base64\"]}'\n      return\n    fi ;;\n  esac\n  if [ -z \"$STDIO\" ]; then target=\"$1\"; shift; fi\n  case \"$target\" in @*) target=\"${target#@}\";; esac\n  if [ -n \"$target\" ]; then\n    case \"$target\" in\n      http://*|https://*) URL=\"$target\" ;;\n      *)\n        [ -f \"$CONFIG\" ] || { bad \"Unknown server. Pass a URL or create a named server in servers.json.\"; return 1; }\n        local entry","contentHash":"b6d50b97df82b3a3","metadata":{"filePath":"engine/mcp-wire.sh","startLine":377,"endLine":388,"chunkType":"function_definition","name":"main","language":"bash","hash":"b6d50b97df82b3a3"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":4,"lastAttempt":"2026-10-17T11:42:41.746Z"}
{"version":1,"chunks":[{"id":"chunk_7463b4e344d5eaeb","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\n      *)\n        [ -f \"$CONFIG\" ] || { bad \"Unknown server. Pass a URL or create a named server in servers.json.\"; return 1; }\n        local entry\n        entry=$(jq -ec --arg n \"$target\" '.servers[$n] | select(type == \"object\")' \"$CONFIG\") || { bad \"Server name not found in the registry.\"; return 1; }\n        jq -e '(.headerEnv // {}) | type == \"object\" and all(to_entries[]; (.value|type)==\"string\")' <<<\"$entry\" >/dev/null || { bad \"headerEnv must map header names to environment variable names.\"; return 1; }\n        URL=$(jq -r '.url // empty' <<<\"$entry\")\n        STDIO=$(jq -c '.command // empty' <<<\"$entry\")\n        # allow_http honored\n        local allow_http\n        allow_http=$(jq -r '.allow_http // false' <<<\"$entry\")\n        [ \"$allow_http\" != true ] || ALLOW_HTTP=1\n        # headers array with ${VAR} expansion","tokenCount":231}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\n      *)\n        [ -f \"$CONFIG\" ] || { bad \"Unknown server. Pass a URL or create a named server in servers.json.\"; return 1; }\n        local entry\n        entry=$(jq -ec --arg n \"$target\" '.servers[$n] | select(type == \"object\")' \"$CONFIG\") || { bad \"Server name not found in the registry.\"; return 1; }\n        jq -e '(.headerEnv // {}) | type == \"object\" and all(to_entries[]; (.value|type)==\"string\")' <<<\"$entry\" >/dev/null || { bad \"headerEnv must map header names to environment variable names.\"; return 1; }\n        URL=$(jq -r '.url // empty' <<<\"$entry\")\n        STDIO=$(jq -c '.command // empty' <<<\"$entry\")\n        # allow_http honored\n        local allow_http\n        allow_http=$(jq -r '.allow_http // false' <<<\"$entry\")\n        [ \"$allow_http\" != true ] || ALLOW_HTTP=1\n        # headers array with ${VAR} expansion","content":"      *)\n        [ -f \"$CONFIG\" ] || { bad \"Unknown server. Pass a URL or create a named server in servers.json.\"; return 1; }\n        local entry\n        entry=$(jq -ec --arg n \"$target\" '.servers[$n] | select(type == \"object\")' \"$CONFIG\") || { bad \"Server name not found in the registry.\"; return 1; }\n        jq -e '(.headerEnv // {}) | type == \"object\" and all(to_entries[]; (.value|type)==\"string\")' <<<\"$entry\" >/dev/null || { bad \"headerEnv must map header names to environment variable names.\"; return 1; }\n        URL=$(jq -r '.url // empty' <<<\"$entry\")\n        STDIO=$(jq -c '.command // empty' <<<\"$entry\")\n        # allow_http honored\n        local allow_http\n        allow_http=$(jq -r '.allow_http // false' <<<\"$entry\")\n        [ \"$allow_http\" != true ] || ALLOW_HTTP=1\n        # headers array with ${VAR} expansion","contentHash":"18c2a6d6cf6611ca","metadata":{"filePath":"engine/mcp-wire.sh","startLine":386,"endLine":397,"chunkType":"function_definition","name":"main","language":"bash","hash":"18c2a6d6cf6611ca"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":4,"lastAttempt":"2026-10-17T11:42:41.746Z"}
{"version":1,"chunks":[{"id":"chunk_2c7cdd846c1d67b5","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, file operations, configuration\n\n        allow_http=$(jq -r '.allow_http // false' <<<\"$entry\")\n        [ \"$allow_http\" != true ] || ALLOW_HTTP=1\n        # headers array with ${VAR} expansion\n        local hline varname\n        while IFS= read -r hline; do\n          [ -n \"$hline\" ] || continue\n          # expand ${VAR}\n          while [[ \"$hline\" =~ \\$\\{([A-Za-z_][A-Za-z_0-9]*)\\} ]]; do\n            varname=\"${BASH_REMATCH[1]}\"\n            [ -n \"${!varname:-}\" ] || { bad \"Required header environment variable is unset: $varname\"; return 1; }\n            hline=\"${hline//\\$\\{$varname\\}/${!varname}}\"\n          done","tokenCount":170}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, file operations, configuration\n\n        allow_http=$(jq -r '.allow_http // false' <<<\"$entry\")\n        [ \"$allow_http\" != true ] || ALLOW_HTTP=1\n        # headers array with ${VAR} expansion\n        local hline varname\n        while IFS= read -r hline; do\n          [ -n \"$hline\" ] || continue\n          # expand ${VAR}\n          while [[ \"$hline\" =~ \\$\\{([A-Za-z_][A-Za-z_0-9]*)\\} ]]; do\n            varname=\"${BASH_REMATCH[1]}\"\n            [ -n \"${!varname:-}\" ] || { bad \"Required header environment variable is unset: $varname\"; return 1; }\n            hline=\"${hline//\\$\\{$varname\\}/${!varname}}\"\n          done","content":"        allow_http=$(jq -r '.allow_http // false' <<<\"$entry\")\n        [ \"$allow_http\" != true ] || ALLOW_HTTP=1\n        # headers array with ${VAR} expansion\n        local hline varname\n        while IFS= read -r hline; do\n          [ -n \"$hline\" ] || continue\n          # expand ${VAR}\n          while [[ \"$hline\" =~ \\$\\{([A-Za-z_][A-Za-z_0-9]*)\\} ]]; do\n            varname=\"${BASH_REMATCH[1]}\"\n            [ -n \"${!varname:-}\" ] || { bad \"Required header environment variable is unset: $varname\"; return 1; }\n            hline=\"${hline//\\$\\{$varname\\}/${!varname}}\"\n          done","contentHash":"b71716c684c4de02","metadata":{"filePath":"engine/mcp-wire.sh","startLine":395,"endLine":406,"chunkType":"function_definition","name":"main","language":"bash","hash":"b71716c684c4de02"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":4,"lastAttempt":"2026-10-17T11:42:41.746Z"}
{"version":1,"chunks":[{"id":"chunk_02dae9a1fd7d3e93","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: file operations, configuration\n\n            [ -n \"${!varname:-}\" ] || { bad \"Required header environment variable is unset: $varname\"; return 1; }\n            hline=\"${hline//\\$\\{$varname\\}/${!varname}}\"\n          done\n          HEADERS+=(\"$hline\")\n        done < <(jq -r '.headers[]? // empty' <<<\"$entry\")\n        local envname headername\n        while IFS=$'\\t' read -r headername envname; do\n          [ -n \"$headername\" ] || continue\n          [[ \"$envname\" =~ ^[A-Za-z_][A-Za-z_0-9]*$ ]] && [[ \"$headername\" =~ ^[A-Za-z0-9-]+$ ]] || { bad \"Invalid headerEnv entry.\"; return 1; }\n          [ -n \"${!envname:-}\" ] || { bad \"Required header environment variable is unset.\"; return 1; }\n          [[ \"${!envname}\" != *$'\\r'* && \"${!envname}\" != *$'\\n'* ]] || { bad \"Header values cannot contain line breaks.\"; return 1; }\n          HEADERS+=(\"$headername: ${!envname}\")","tokenCount":231}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: file operations, configuration\n\n            [ -n \"${!varname:-}\" ] || { bad \"Required header environment variable is unset: $varname\"; return 1; }\n            hline=\"${hline//\\$\\{$varname\\}/${!varname}}\"\n          done\n          HEADERS+=(\"$hline\")\n        done < <(jq -r '.headers[]? // empty' <<<\"$entry\")\n        local envname headername\n        while IFS=$'\\t' read -r headername envname; do\n          [ -n \"$headername\" ] || continue\n          [[ \"$envname\" =~ ^[A-Za-z_][A-Za-z_0-9]*$ ]] && [[ \"$headername\" =~ ^[A-Za-z0-9-]+$ ]] || { bad \"Invalid headerEnv entry.\"; return 1; }\n          [ -n \"${!envname:-}\" ] || { bad \"Required header environment variable is unset.\"; return 1; }\n          [[ \"${!envname}\" != *$'\\r'* && \"${!envname}\" != *$'\\n'* ]] || { bad \"Header values cannot contain line breaks.\"; return 1; }\n          HEADERS+=(\"$headername: ${!envname}\")","content":"            [ -n \"${!varname:-}\" ] || { bad \"Required header environment variable is unset: $varname\"; return 1; }\n            hline=\"${hline//\\$\\{$varname\\}/${!varname}}\"\n          done\n          HEADERS+=(\"$hline\")\n        done < <(jq -r '.headers[]? // empty' <<<\"$entry\")\n        local envname headername\n        while IFS=$'\\t' read -r headername envname; do\n          [ -n \"$headername\" ] || continue\n          [[ \"$envname\" =~ ^[A-Za-z_][A-Za-z_0-9]*$ ]] && [[ \"$headername\" =~ ^[A-Za-z0-9-]+$ ]] || { bad \"Invalid headerEnv entry.\"; return 1; }\n          [ -n \"${!envname:-}\" ] || { bad \"Required header environment variable is unset.\"; return 1; }\n          [[ \"${!envname}\" != *$'\\r'* && \"${!envname}\" != *$'\\n'* ]] || { bad \"Header values cannot contain line breaks.\"; return 1; }\n          HEADERS+=(\"$headername: ${!envname}\")","contentHash":"becda311edd1b05e","metadata":{"filePath":"engine/mcp-wire.sh","startLine":404,"endLine":415,"chunkType":"function_definition","name":"main","language":"bash","hash":"becda311edd1b05e"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":4,"lastAttempt":"2026-10-17T11:42:41.746Z"}
{"version":1,"chunks":[{"id":"chunk_13eb4b7c25ca1e8e","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\n          [ -n \"${!envname:-}\" ] || { bad \"Required header environment variable is unset.\"; return 1; }\n          [[ \"${!envname}\" != *$'\\r'* && \"${!envname}\" != *$'\\n'* ]] || { bad \"Header values cannot contain line breaks.\"; return 1; }\n          HEADERS+=(\"$headername: ${!envname}\")\n        done < <(jq -r '.headerEnv // {} | to_entries[] | [.key,.value] | @tsv' <<<\"$entry\") ;;\n    esac\n  fi\n  if [ -n \"$STDIO\" ]; then\n    [ -z \"$URL\" ] || { bad \"Choose one transport: URL or stdio.\"; return 1; }\n    jq -e 'type == \"array\" and length > 0 and all(.[]; type == \"string\" and (contains(\"\\n\")|not) and (contains(\"\\u0000\")|not)) and .[0] != \"\"' <<<\"$STDIO\" >/dev/null 2>&1 || { bad \"--stdio requires a JSON command array.\"; return 1; }\n  else\n    case \"$URL\" in\n      https://*) : ;; http://*) [ \"$ALLOW_HTTP\" -eq 1 ] || { bad \"Refusing plain HTTP. Pass --allow-http for trusted development.\"; return 1; } ;;","tokenCount":250}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\n          [ -n \"${!envname:-}\" ] || { bad \"Required header environment variable is unset.\"; return 1; }\n          [[ \"${!envname}\" != *$'\\r'* && \"${!envname}\" != *$'\\n'* ]] || { bad \"Header values cannot contain line breaks.\"; return 1; }\n          HEADERS+=(\"$headername: ${!envname}\")\n        done < <(jq -r '.headerEnv // {} | to_entries[] | [.key,.value] | @tsv' <<<\"$entry\") ;;\n    esac\n  fi\n  if [ -n \"$STDIO\" ]; then\n    [ -z \"$URL\" ] || { bad \"Choose one transport: URL or stdio.\"; return 1; }\n    jq -e 'type == \"array\" and length > 0 and all(.[]; type == \"string\" and (contains(\"\\n\")|not) and (contains(\"\\u0000\")|not)) and .[0] != \"\"' <<<\"$STDIO\" >/dev/null 2>&1 || { bad \"--stdio requires a JSON command array.\"; return 1; }\n  else\n    case \"$URL\" in\n      https://*) : ;; http://*) [ \"$ALLOW_HTTP\" -eq 1 ] || { bad \"Refusing plain HTTP. Pass --allow-http for trusted development.\"; return 1; } ;;","content":"          [ -n \"${!envname:-}\" ] || { bad \"Required header environment variable is unset.\"; return 1; }\n          [[ \"${!envname}\" != *$'\\r'* && \"${!envname}\" != *$'\\n'* ]] || { bad \"Header values cannot contain line breaks.\"; return 1; }\n          HEADERS+=(\"$headername: ${!envname}\")\n        done < <(jq -r '.headerEnv // {} | to_entries[] | [.key,.value] | @tsv' <<<\"$entry\") ;;\n    esac\n  fi\n  if [ -n \"$STDIO\" ]; then\n    [ -z \"$URL\" ] || { bad \"Choose one transport: URL or stdio.\"; return 1; }\n    jq -e 'type == \"array\" and length > 0 and all(.[]; type == \"string\" and (contains(\"\\n\")|not) and (contains(\"\\u0000\")|not)) and .[0] != \"\"' <<<\"$STDIO\" >/dev/null 2>&1 || { bad \"--stdio requires a JSON command array.\"; return 1; }\n  else\n    case \"$URL\" in\n      https://*) : ;; http://*) [ \"$ALLOW_HTTP\" -eq 1 ] || { bad \"Refusing plain HTTP. Pass --allow-http for trusted development.\"; return 1; } ;;","contentHash":"a10ae338ad68139a","metadata":{"filePath":"engine/mcp-wire.sh","startLine":413,"endLine":424,"chunkType":"function_definition","name":"main","language":"bash","hash":"a10ae338ad68139a"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":4,"lastAttempt":"2026-10-17T11:42:41.746Z"}
{"version":1,"chunks":[{"id":"chunk_8d088c5d66ee83cb","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API\n\n  else\n    case \"$URL\" in\n      https://*) : ;; http://*) [ \"$ALLOW_HTTP\" -eq 1 ] || { bad \"Refusing plain HTTP. Pass --allow-http for trusted development.\"; return 1; } ;;\n      *) bad \"Server URL must start with http:// or https://.\"; return 1 ;;\n    esac\n  fi\n  cmd=\"${1:-}\"; [ $# -eq 0 ] || shift\n  [ \"$doctor\" -eq 0 ] || cmd=doctor\n  local method='' params='{}' key='' tool='' body data tool_args='{}'\n  case \"$cmd\" in\n    doctor) method=ping ;;\n    list|describe) method=tools/list; key=tools; tool=\"${1:-}\"; if [ \"$cmd\" = describe ] && [ -z \"$tool\" ]; then bad \"describe requires a tool name.\"; return 1; fi ;;","tokenCount":170}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API\n\n  else\n    case \"$URL\" in\n      https://*) : ;; http://*) [ \"$ALLOW_HTTP\" -eq 1 ] || { bad \"Refusing plain HTTP. Pass --allow-http for trusted development.\"; return 1; } ;;\n      *) bad \"Server URL must start with http:// or https://.\"; return 1 ;;\n    esac\n  fi\n  cmd=\"${1:-}\"; [ $# -eq 0 ] || shift\n  [ \"$doctor\" -eq 0 ] || cmd=doctor\n  local method='' params='{}' key='' tool='' body data tool_args='{}'\n  case \"$cmd\" in\n    doctor) method=ping ;;\n    list|describe) method=tools/list; key=tools; tool=\"${1:-}\"; if [ \"$cmd\" = describe ] && [ -z \"$tool\" ]; then bad \"describe requires a tool name.\"; return 1; fi ;;","content":"  else\n    case \"$URL\" in\n      https://*) : ;; http://*) [ \"$ALLOW_HTTP\" -eq 1 ] || { bad \"Refusing plain HTTP. Pass --allow-http for trusted development.\"; return 1; } ;;\n      *) bad \"Server URL must start with http:// or https://.\"; return 1 ;;\n    esac\n  fi\n  cmd=\"${1:-}\"; [ $# -eq 0 ] || shift\n  [ \"$doctor\" -eq 0 ] || cmd=doctor\n  local method='' params='{}' key='' tool='' body data tool_args='{}'\n  case \"$cmd\"