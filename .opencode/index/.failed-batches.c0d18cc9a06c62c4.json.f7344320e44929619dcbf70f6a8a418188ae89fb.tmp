{"version":1,"chunks":[{"id":"chunk_1b7ca34f87d11274","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: caching, HTTP/API, file operations, data parsing, configuration, state management\n\n      shift\n      local sub=\"${1:-list}\"; [ $# -eq 0 ] || shift\n      case \"$sub\" in\n        path) printf '%s\\n' \"$CONFIG\"; return 0 ;;\n        list)\n          if [ ! -f \"$CONFIG\" ]; then echo '[]'; return 0; fi\n          jq -e '.servers | to_entries | map({name:.key,transport:(if .value.command then \"stdio\" else \"http\" end)})' \"$CONFIG\"; return ;;\n        add)\n          local name=\"${1:-}\" url=\"${2:-}\"; shift 2 2>/dev/null || true\n          # parse flags\n          local allow_http=0 store_literal=0 headers=()\n          while [ $# -gt 0 ]; do","tokenCount":171}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: caching, HTTP/API, file operations, data parsing, configuration, state management\n\n      shift\n      local sub=\"${1:-list}\"; [ $# -eq 0 ] || shift\n      case \"$sub\" in\n        path) printf '%s\\n' \"$CONFIG\"; return 0 ;;\n        list)\n          if [ ! -f \"$CONFIG\" ]; then echo '[]'; return 0; fi\n          jq -e '.servers | to_entries | map({name:.key,transport:(if .value.command then \"stdio\" else \"http\" end)})' \"$CONFIG\"; return ;;\n        add)\n          local name=\"${1:-}\" url=\"${2:-}\"; shift 2 2>/dev/null || true\n          # parse flags\n          local allow_http=0 store_literal=0 headers=()\n          while [ $# -gt 0 ]; do","content":"      shift\n      local sub=\"${1:-list}\"; [ $# -eq 0 ] || shift\n      case \"$sub\" in\n        path) printf '%s\\n' \"$CONFIG\"; return 0 ;;\n        list)\n          if [ ! -f \"$CONFIG\" ]; then echo '[]'; return 0; fi\n          jq -e '.servers | to_entries | map({name:.key,transport:(if .value.command then \"stdio\" else \"http\" end)})' \"$CONFIG\"; return ;;\n        add)\n          local name=\"${1:-}\" url=\"${2:-}\"; shift 