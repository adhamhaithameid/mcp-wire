{"version":1,"chunks":[{"id":"chunk_db7a2d2a8592dfed","texts":[{"text":"bash function \"main\"\nin figma-pages/scripts/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\n      *)\n        [ -f \"$CONFIG\" ] || { bad \"Unknown server. Pass a URL or create a named server in servers.json.\"; return 1; }\n        local entry\n        entry=$(jq -ec --arg n \"$target\" '.servers[$n] | select(type == \"object\")' \"$CONFIG\") || { bad \"Server name not found in the registry.\"; return 1; }\n        jq -e '(.headerEnv // {}) | type == \"object\" and all(to_entries[]; (.value|type)==\"string\")' <<<\"$entry\" >/dev/null || { bad \"headerEnv must map header names to environment variable names.\"; return 1; }\n        URL=$(jq -r '.url // empty' <<<\"$entry\")\n        STDIO=$(jq -c '.command // empty' <<<\"$entry\")\n        # allow_http honored\n        local allow_http\n        allow_http=$(jq -r '.allow_http // false' <<<\"$entry\")\n        [ \"$allow_http\" != true ] || ALLOW_HTTP=1\n        # headers array with ${VAR} expansion","tokenCount":234}],"storageText":"bash function \"main\"\nin figma-pages/scripts/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\n      *)\n        [ -f \"$CONFIG\" ] || { bad \"Unknown server. Pass a URL or create a named server in servers.json.\"; return 1; }\n        local entry\n        entry=$(jq -ec --arg n \"$target\" '.servers[$n] | select(type == \"object\")' \"$CONFIG\") || { bad \"Server name not found in the registry.\"; return 1; }\n        jq -e '(.headerEnv // {}) | type == \"object\" and all(to_entries[]; (.value|type)==\"string\")' <<<\"$entry\" >/dev/null || { bad \"headerEnv must map header names to environment variable names.\"; return 1; }\n        URL=$(jq -r '.url // empty' <<<\"$entry\")\n        STDIO=$(jq -c '.command // empty' <<<\"$entry\")\n        # allow_http honored\n        local allow_http\n        allow_http=$(jq -r '.allow_http // false' <<<\"$entry\")\n        [ \"$allow_http\" != true ] || ALLOW_HTTP=1\n        # headers array with ${VAR} expansion","content":"      *)\n        [ -f \"$CONFIG\" ] || { bad \"Unknown server. Pass a URL or create a named server in servers.json.\"; return 1; }\n        local entry\n        entry=$(jq -ec --arg n \"$target\" '.servers[$n] | select(type == \"object\")' \"$CONFIG\") || { bad \"Server name not found in the registry.\"; return 1; }\n        jq -e '(.headerEnv // {}) | type == \"object\" and all(to_entries[]; (.value|type)==\"string\")' <<<\"$entry\" >/dev/null || { bad \"headerEnv must map header names to environment variable names.\"; return 1; }\n        URL=$(jq -r '.url // empty' <<<\"$entry\")\n        STDIO=$(jq -c '.command // empty' <<<\"$entry\")\n        # allow_http honored\n        local allow_http\n        allow_http=$(jq -r '.allow_http // false' <<<\"$entry\")\n        [ \"$allow_http\" != true ] || ALLOW_HTTP=1\n        # headers array with ${VAR} expansion","contentHash":"18c2a6d6cf6611ca","metadata":{"filePath":"skills/figma-pages/scripts/mcp-wire.sh","startLine":386,"endLine":397,"chunkType":"function_definition","name":"main","language":"bash","hash":"18c2a6d6cf6611ca"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":15,"lastAttempt":"2026-10-17T11:42:41.743Z"}
{"version":1,"chunks":[{"id":"chunk_b71f1e62ddc76f82","texts":[{"text":"bash function \"main\"\nin figma-pages/scripts/mcp-wire.sh\nPurpose: HTTP/API, file operations, configuration\n\n        allow_http=$(jq -r '.allow_http // false' <<<\"$entry\")\n        [ \"$allow_http\" != true ] || ALLOW_HTTP=1\n        # headers array with ${VAR} expansion\n        local hline varname\n        while IFS= read -r hline; do\n          [ -n \"$hline\" ] || continue\n          # expand ${VAR}\n          while [[ \"$hline\" =~ \\$\\{([A-Za-z_][A-Za-z_0-9]*)\\} ]]; do\n            varname=\"${BASH_REMATCH[1]}\"\n            [ -n \"${!varname:-}\" ] || { bad \"Required header environment variable is unset: $varname\"; return 1; }\n            hline=\"${hline//\\$\\{$varname\\}/${!varname}}\"\n          done","tokenCount":173}],"storageText":"bash function \"main\"\nin figma-pages/scripts/mcp-wire.sh\nPurpose: HTTP/API, file operations, configuration\n\n        allow_http=$(jq -r '.allow_http // false' <<<\"$entry\")\n        [ \"$allow_http\" != true ] || ALLOW_HTTP=1\n        # headers array with ${VAR} expansion\n        local hline varname\n        while IFS= read -r hline; do\n          [ -n \"$hline\" ] || continue\n          # expand ${VAR}\n          while [[ \"$hline\" =~ \\$\\{([A-Za-z_][A-Za-z_0-9]*)\\} ]]; do\n            varname=\"${BASH_REMATCH[1]}\"\n            [ -n \"${!varname:-}\" ] || { bad \"Required header environment variable is unset: $varname\"; return 1; }\n            hline=\"${hline//\\$\\{$varname\\}/${!varname}}\"\n          done","content":"        allow_http=$(jq -r '.allow_http // false' <<<\"$entry\")\n        [ \"$allow_http\" != true ] || ALLOW_HTTP=1\n        # headers array with ${VAR} expansion\n        local hline varname\n        while IFS= read -r hline; do\n          [ -n \"$hline\" ] || continue\n          # expand ${VAR}\n          while [[ \"$hline\" =~ \\$\\{([A-Za-z_][A-Za-z_0-9]*)\\} ]]; do\n            varname=\"${BASH_REMATCH[1]}\"\