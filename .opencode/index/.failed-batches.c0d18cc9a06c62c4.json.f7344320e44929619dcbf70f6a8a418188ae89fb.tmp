{"version":1,"chunks":[{"id":"chunk_faa23be1bca34856","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: file operations\n\n  for h in \"${HEADERS[@]+\"${HEADERS[@]}\"}\"; do [[ \"$h\" != *$'\\n'* && \"$h\" != *$'\\r'* ]] || { bad \"Header values cannot contain line breaks.\"; return 1; }; done\n  local hname\n  for h in \"${HEADERS[@]+\"${HEADERS[@]}\"}\"; do\n    [[ \"$h\" != @* ]] || { bad \"Header files are not accepted.\"; return 1; }\n    hname=\"${h%%:*}\"\n    [[ \"$h\" == *:* && \"$hname\" =~ ^[A-Za-z0-9-]+$ ]] || { bad \"Use a header name and value; header files are not accepted.\"; return 1; }\n  done\n  # MCP_WIRE_HEADERS (newline-separated) into HEADERS.\n  if [ -n \"${MCP_WIRE_HEADERS:-}\" ]; then\n    while IFS= read -r _h; do\n      [ -n \"$_h\" ] && HEADERS+=(\"$_h\")\n    done <<< \"$MCP_WIRE_HEADERS\"","tokenCount":183}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: file operations\n\n  for h in \"${HEADERS[@]+\"${HEADERS[@]}\"}\"; do [[ \"$h\" != *$'\\n'* && \"$h\" != *$'\\r'* ]] || { bad \"Header values cannot contain line breaks.\"; return 1; }; done\n  local hname\n  for h in \"${HEADERS[@]+\"${HEADERS[@]}\"}\"; do\n    [[ \"$h\" != @* ]] || { bad \"Header files are not accepted.\"; return 1; }\n    hname=\"${h%%:*}\"\n    [[ \"$h\" == *:* && \"$hname\" =~ ^[A-Za-z0-9-]+$ ]] || { bad \"Use a header name and value; header files are not accepted.\"; return 1; }\n  done\n  # MCP_WIRE_HEADERS (newline-separated) into HEADERS.\n  if [ -n \"${MCP_WIRE_HEADERS:-}\" ]; then\n    while IFS= read -r _h; do\n      [ -n \"$_h\" ] && HEADERS+=(\"$_h\")\n    done <<< \"$MCP_WIRE_HEADERS\"","content":"  for h in \"${HEADERS[@]+\"${HEADERS[@]}\"}\"; do [[ \"$h\" != *$'\\n'* && \"$h\" != *$'\\r'* ]] || { bad \"Header values cannot contain line breaks.\"; return 1; }; done\n  local hname\n  for h in \"${HEADERS[@]+\"${HEADERS[@]}\"}\"; do\n    [[ \"$h\" != @* ]] || { bad \"Header files are not accepted.\"; return 