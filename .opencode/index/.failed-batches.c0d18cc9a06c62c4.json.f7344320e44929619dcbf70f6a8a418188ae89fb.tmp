{"version":1,"chunks":[{"id":"chunk_187d691bdf0e36b2","texts":[{"text":"bash function \"t\"\nin engine/tests/run-tests.sh\n\nt()     { local n=\"$1\"; shift; if \"$@\" > \"$TMP/o\" 2>&1; then PASS=$((PASS+1)); else FAIL=$((FAIL+1)); echo \"FAIL: $n\"; head -5 \"$TMP/o\" | sed 's/^/    /'; fi; }","tokenCount":52}],"storageText":"bash function \"t\"\nin engine/tests/run-tests.sh\n\nt()     { local n=\"$1\"; shift; if \"$@\" > \"$TMP/o\" 2>&1; then PASS=$((PASS+1)); else FAIL=$((FAIL+1)); echo \"FAIL: $n\"; head -5 \"$TMP/o\" | sed 's/^/    /'; fi; }","content":"t()     { local n=\"$1\"; shift; if \"$@\" > \"$TMP/o\" 2>&1; then PASS=$((PASS+1)); else FAIL=$((FAIL+1)); echo \"FAIL: $n\"; head -5 \"$TMP/o\" | sed 's/^/    /'; fi; }","contentHash":"2669191ac4d7bf90","metadata":{"filePath":"engine/tests/run-tests.sh","startLine":12,"endLine":12,"chunkType":"function_definition","name":"t","language":"bash","hash":"2669191ac4d7bf90"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":3,"lastAttempt":"2026-10-17T11:42:41.746Z"}
