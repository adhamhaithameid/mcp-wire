{"version":1,"chunks":[{"id":"chunk_404ce4b07573aae7","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\n          dir=$(dirname \"$CONFIG\")\n          mkdir -p \"$dir\"; chmod 700 \"$dir\" 2>/dev/null || true\n          local tmpf\n          tmpf=$(mktemp \"$dir/.servers.XXXXXX\") || return 1\n          if [ -f \"$CONFIG\" ]; then cp \"$CONFIG\" \"$tmpf.base\"; else echo '{\"servers\":{}}' > \"$tmpf.base\"; fi\n          # build entry\n          local entry\n          entry=$(jq -nc --arg url \"$url\" --argjson ah \"$allow_http\" '{url:$url,allow_http:($ah==1)}')\n          if [ ${#headers[@]} -gt 0 ]; then\n            local hjson\n            hjson=$(printf '%s\\n' \"${headers[@]}\" | jq -R . | jq -sc .)\n            entry=$(jq -c --argjson h \"$hjson\" '.headers=$h' <<<\"$entry\")","tokenCount":186}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\n          dir=$(dirname \"$CONFIG\")\n          mkdir -p \"$dir\"; chmod 700 \"$dir\" 2>/dev/null || true\n          local tmpf\n          tmpf=$(mktemp \"$dir/.servers.XXXXXX\") || return 1\n          if [ -f \"$CONFIG\" ]; then cp \"$CONFIG\" \"$tmpf.base\"; else echo '{\"servers\":{}}' > \"$tmpf.base\"; fi\n          # build entry\n          local entry\n          entry=$(jq -nc --arg url \"$url\" --argjson ah \"$allow_http\" '{url:$url,allow_http:($ah==1)}')\n          if [ ${#headers[@]} -gt 0 ]; then\n            local hjson\n            hjson=$(printf '%s\\n' \"${headers[@]}\" | jq -R . | jq -sc .)\n            entry=$(jq -c --argjson h \"$hjson\" '.headers=$h' <<<\"$entry\")","content":"          dir=$(dirname \"$CONFIG\")\n          mkdir -p \"$dir\"; chmod 700 \"$dir\" 2>/dev/null || true\n          local tmpf\n          tmpf=$(mktemp \"$dir/.servers.XXXXXX\") || return 1\n          if [ -f \"$CONFIG\" ]; then cp \"$CONFIG\" \"$tmpf.base\"; else echo '{\"servers\":{}}' > \"$tmpf.base\"; fi\n          # build entry\n          local entry\n          entry=$(jq -nc --arg url \"$url\" --argjson ah \"$allow_http\" '{url:$url,allow_http:($ah==1)}')\n          if [ ${#headers[@]} -gt 0 ]; then\n            local hjson\n            hjson=$(printf '%s\\n' \"${headers[@]}\" | jq -R . | jq -sc .)\n            entry=$(jq -c --argjson h \"$hjson\" '.headers=$h' <<<\"$entry\")","contentHash":"af3f61785029b879","metadata":{"filePath":"engine/mcp-wire.sh","startLine":341,"endLine":352,"chunkType":"function_definition","name":"main","language":"bash","hash":"af3f61785029b879"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":4,"lastAttempt":"2026-10-17T11:42:41.746Z"}
{"version":1,"chunks":[{"id":"chunk_632cc157336f8c01","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: authentication, logging, caching, data parsing, configuration, state management\n\n            local hjson\n            hjson=$(printf '%s\\n' \"${headers[@]}\" | jq -R . | jq -sc .)\n            entry=$(jq -c --argjson h \"$hjson\" '.headers=$h' <<<\"$entry\")\n          fi\n          jq --arg name \"$name\" --argjson entry \"$entry\" '.servers[$name]=$entry' \"$tmpf.base\" > \"$tmpf\"\n          chmod 600 \"$tmpf\"\n          mv \"$tmpf\" \"$CONFIG\"\n          rm -f \"$tmpf.base\"\n          if [ \"$store_literal\" -eq 1 ]; then echo \"warning: stored literal credential\" >&2; fi\n          ok \"added $name\"\n          return 0 ;;\n        rm)","tokenCount":167}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: authentication, logging, caching, data parsing, configuration, state management\n\n            local hjson\n            hjson=$(printf '%s\\n' \"${headers[@]}\" | jq -R . | jq -sc .)\n            entry=$(jq -c --argjson h \"$hjson\" '.headers=$h' <<<\"$entry\")\n          fi\n          jq --arg name \"$name\" --argjson entry \"$entry\" '.servers[$name]=$entry' \"$tmpf.base\" > \"$tmpf\"\n          chmod 600 \"$tmpf\"\n          mv \"$tmpf\" \"$CONFIG\"\n          rm -f \"$tmpf.base\"\n          if [ \"$store_literal\" -eq 1 ]; then echo \"warning: stored literal credential\" >&2; fi\n          ok \"added $name\"\n          return 0 ;;\n        rm)","content":"            local hjson\n            hjson=$(printf '%s\\n' \"${headers[@]}\" | jq -R . | jq -sc .)\n            entry=$(jq -c --argjson h \"$hjson\" '.headers=$h' <<<\"$entry\")\n          fi\n          jq --arg name \"$name\" --argjson entry \"$entry\" '.servers[$name]=$entry' \"$tmpf.base\" > \"$tmpf\"\n          chmod 600 \"$tmpf\"\n          mv \"$tmpf\" \"$CONFIG\"\n          rm -f \"$tmpf.base\"\n          if [ \"$store_literal\" -eq 1 ]; then echo \"warning: stored literal credential\" >&2; fi\n          ok \"added $name\"\n          return 0 ;;\n        rm)","contentHash":"b9485cf1d78a1d18","metadata":{"filePath":"engine/mcp-wire.sh","startLine":350,"endLine":361,"chunkType":"function_definition","name":"main","language":"bash","hash":"b9485cf1d78a1d18"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":4,"lastAttempt":"2026-10-17T11:42:41.746Z"}
{"version":1,"chunks":[{"id":"chunk_27503995ccbca3d7","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: file operations, configuration\n\n          ok \"added $name\"\n          return 0 ;;\n        rm)\n          local name=\"${1:-}\"\n          [ -f \"$CONFIG\" ] || { bad \"No registry.\"; return 1; }\n          jq --arg name \"$name\" 'del(.servers[$name])' \"$CONFIG\" > \"$CONFIG.tmp\" && mv \"$CONFIG.tmp\" \"$CONFIG\"\n          ok \"removed $name\"\n          return 0 ;;\n        *) bad \"Use servers add|list|rm|path.\"; return 1 ;;\n      esac\n      return ;;\n    doctor) doctor=1; shift; if [ $# -eq 0 ]; then","tokenCount":135}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: file operations, configuration\n\n          ok \"added $name\"\n          return 0 ;;\n        rm)\n          local name=\"${1:-}\"\n          [ -f \"$CONFIG\" ] || { bad \"No registry.\"; return 1; }\n          jq --arg name \"$name\" 'del(.servers[$name])' \"$CONFIG\" > \"$CONFIG.tmp\" && mv \"$CONFIG.tmp\" \"$CONFIG\"\n          ok \"removed $name\"\n          return 0 ;;\n        *) bad \"Use servers add|list|rm|path.\"; return 1 ;;\n      esac\n      return ;;\n    doctor) doctor=1; shift; if [ $# -eq 0 ]; then","content":"          ok \"added $name\"\n          return 0 ;;\n        rm)\n          local name=\"${1:-}\"\n          [ -f \"$CONFIG\" ] || { bad \"No registry.\"; return 1; }\n          jq --arg name \"$name\" 'del(.servers[$name])' \"$CONFIG\" > \"$CONFIG.tmp\" && mv \"$CONFIG.tmp\" \"$CONFIG\"\n          ok \"removed $name\"\n          return 0 ;;\n        *) bad \"Use servers add|list|rm|path.\"; return 1 ;;\n      esac\n      return ;;\n    doctor) doctor=1; shift; if [ $# -eq 0 ]; then","contentHash":"0f8174564be89499","metadata":{"filePath":"engine/mcp-wire.sh","startLine":359,"endLine":370,"chunkType":"function_definition","name":"main","language":"bash","hash":"0f8174564be89499"}}],"error":"Google embedding provider