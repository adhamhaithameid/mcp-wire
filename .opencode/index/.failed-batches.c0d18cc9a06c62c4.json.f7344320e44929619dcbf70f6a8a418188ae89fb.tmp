{"version":1,"chunks":[{"id":"chunk_5eecb30c3d605816","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, configuration\n\n      --allow-http) ALLOW_HTTP=1; shift ;;\n      --header|--header-env|--timeout|--config|--stdio|-o)\n        [ $# -ge 2 ] && [ -n \"$2\" ] || { bad \"Missing value for $1.\"; return 1; }\n        case \"$1\" in\n          --header) HEADERS+=(\"$2\") ;;\n          --header-env)\n            local hn=\"${2%%=*}\" en=\"${2#*=}\"\n            [[ \"$en\" =~ ^[A-Za-z_][A-Za-z_0-9]*$ ]] && [[ \"$hn\" =~ ^[A-Za-z0-9-]+$ ]] || { bad \"Use --header-env Header=ENV_NAME.\"; return 1; }\n            [ -n \"${!en:-}\" ] || { bad \"Required header environment variable is unset.\"; return 1; }\n            HEADERS+=(\"$hn: ${!en}\") ;;\n          --timeout) TIMEOUT=\"$2\" ;; --config) CONFIG=\"$2\" ;; --stdio) STDIO=\"$2\" ;; -o) PREFIX=\"$2\" ;;\n        esac","tokenCount":198}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, configuration\n\n      --allow-http) ALLOW_HTTP=1; shift ;;\n      --header|--header-env|--timeout|--config|--stdio|-o)\n        [ $# -ge 2 ] && [ -n \"$2\" ] || { bad \"Missing value for $1.\"; return 1; }\n        case \"$1\" in\n          --header) HEADERS+=(\"$2\") ;;\n          --header-env)\n            local hn=\"${2%%=*}\" en=\"${2#*=}\"\n            [[ \"$en\" =~ ^[A-Za-z_][A-Za-z_0-9]*$ ]] && [[ \"$hn\" =~ ^[A-Za-z0-9-]+$ ]] || { bad \"Use --header-env Header=ENV_NAME.\"; return 1; }\n            [ -n \"${!en:-}\" ] || { bad \"Required header environment variable is unset.\"; return 1; }\n            HEADERS+=(\"$hn: ${!en}\") ;;\n          --timeout) TIMEOUT=\"$2\" ;; --config) CONFIG=\"$2\" ;; --stdio) STDIO=\"$2\" ;; -o) PREFIX=\"$2\" ;;\n        esac","content":"      --allow-http) ALLOW_HTTP=1; shift ;;\n      --header|--header-env|--timeout|--config|--stdio|-o)\n        [ $# -ge 2 ] && [ -n \"$2\" ] || { bad \"Missing value for $1.\"; return 1; }\n        