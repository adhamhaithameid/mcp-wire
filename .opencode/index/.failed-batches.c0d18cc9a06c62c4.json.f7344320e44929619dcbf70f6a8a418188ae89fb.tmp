{"version":1,"chunks":[{"id":"chunk_5e0abd7565d68c0a","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: error handling, file operations, data parsing, UI rendering\n\n        templates) method=resources/templates/list; key=resourceTemplates ;;\n        read) [ -n \"${2:-}\" ] || { bad \"resources read requires a URI.\"; return 1; }; method=resources/read; params=$(jq -nc --arg uri \"$2\" '{uri:$uri}') ;;\n        *) bad \"Use resources list, templates, or read <uri>.\"; return 1 ;;\n      esac ;;\n    prompts)\n      case \"${1:-list}\" in\n        list) method=prompts/list; key=prompts ;;\n        get) [ -n \"${2:-}\" ] || { bad \"prompts get requires a name.\"; return 1; }; method=prompts/get\n          [ $# -lt 3 ] || tool_args=\"$3\"\n          params=$(jq -nc --arg name \"$2\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" and all($a[];type==\"string\") then {name:$name,arguments:$a} else error(\"string arguments required\") end' 2>/dev/null) || { bad \"Prompt arguments must be a JSON object of strings.\"; return 1; } ;;\n        *) bad \"Use prompts list or get <name>.\"; return 1 ;;\n      esac ;;","tokenCount":258}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: error handling, file operations, data parsing, UI rendering\n\n        templates) method=resources/templates/list; key=resourceTemplates ;;\n        read) [ -n \"${2:-}\" ] || { bad \"resources read requires a URI.\"; return 1; }; method=resources/read; params=$(jq -nc --arg uri \"$2\" '{uri:$uri}') ;;\n        *) bad \"Use resources list, templates, or read <uri>.\"; return 1 ;;\n      esac ;;\n    prompts)\n      case \"${1:-list}\" in\n        list) method=prompts/list; key=prompts ;;\n        get) [ -n \"${2:-}\" ] || { bad \"prompts get requires a name.\"; return 1; }; method=prompts/get\n          [ $# -lt 3 ] || tool_args=\"$3\"\n          params=$(jq -nc --arg name \"$2\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" and all($a[];type==\"string\") then {name:$name,arguments:$a} else error(\"string arguments required\") end' 2>/dev/null) || { bad \"Prompt arguments must be a JSON object of strings.\"; return 1; } ;;\n        *) bad \"Use prompts list or get <name>.\"; return 1 ;;\n      esac ;;","content":"        templates) method=resources/templates/list; key=resourceTemplates ;;\n        read) [ -n \"${2:-}\" ] || { bad \"resources read requires a URI.\"; return 1; }; method=resources/read; params=$(jq -nc --arg uri \"$2\" '{uri:$uri}') ;;\n        *) bad \"Use resources list, templates, or read <uri>.\"; return 1 ;;\n      esac ;;\n    prompts)\n      case \"${1:-list}\" in\n        list) method=prompts/list; key=prompts ;;\n        get) [ -n \"${2:-}\" ] || { bad \"prompts get requires a name.\"; return 1; }; method=prompts/get\n          [ $# -lt 3 ] || tool_args=\"$3\"\n          params=$(jq -nc --arg name \"$2\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" and all($a[];type==\"string\") then {name:$name,arguments:$a} else error(\"string arguments required\") end' 2>/dev/null) || { bad \"Prompt arguments must be a JSON object of strings.\"; return 1; } ;;\n        *) bad \"Use prompts list or get <name>.\"; return 1 ;;\n      esac ;;","contentHash":"fea33331a25c0d90","metadata":{"filePath":"engine/mcp-wire.sh","startLine":449,"endLine":460,"chunkType":"function_definition","name":"main","language":"bash","hash":"fea33331a25c0d90"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":4,"lastAttempt":"2026-10-17T11:42:41.743Z"}
{"version":1,"chunks":[{"id":"chunk_adbf744c51a37e49","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: error handling, HTTP/API, data parsing\n\n          params=$(jq -nc --arg name \"$2\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" and all($a[];type==\"string\") then {name:$name,arguments:$a} else error(\"string arguments required\") end' 2>/dev/null) || { bad \"Prompt arguments must be a JSON object of strings.\"; return 1; } ;;\n        *) bad \"Use prompts list or get <name>.\"; return 1 ;;\n      esac ;;\n    raw)\n      body=\"${1:-}\"\n      jq -e 'type==\"object\" and .jsonrpc==\"2.0\" and (.method|type)==\"string\" and has(\"id\") and (.id != null)' <<<\"$body\" >/dev/null 2>&1 || { bad \"raw requires a JSON-RPC request with an ID.\"; return 1; } ;;\n    *) bad \"Unknown command. Use --help.\"; return 1 ;;\n  esac\n  [ \"$cmd\" = raw ] || body=$(jq -nc --arg m \"$method\" --argjson p \"$params\" '{jsonrpc:\"2.0\",id:2,method:$m,params:$p}')\n  if [ \"$DRY_RUN\" -eq 1 ]; then\n    jq -n --arg transport \"$(if [ -n \"$STDIO\" ]; then echo stdio; else echo http; fi)\" --arg method \"$(jq -r .method <<<\"$body\")\" '{dryRun:true,transport:$transport,method:$method}'\n    return","tokenCount":275}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: error handling, HTTP/API, data parsing\n\n          params=$(jq -nc --arg name \"$2\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" and all($a[];type==\"string\") then {name:$name,arguments:$a} else error(\"string arguments required\") end' 2>/dev/null) || { bad \"Prompt arguments must be a JSON object of strings.\"; return 1; } ;;\n        *) bad \"Use prompts list or get <name>.\"; return 1 ;;\n      esac ;;\n    raw)\n      body=\"${1:-}\"\n      jq -e 'type==\"object\" and .jsonrpc==\"2.0\" and (.method|type)==\"string\" and has(\"id\") and (.id != null)' <<<\"$body\" >/dev/null 2>&1 || { bad \"raw requires a JSON-RPC request with an ID.\"; return 1; } ;;\n    *) bad \"Unknown command. Use --help.\"; return 1 ;;\n  esac\n  [ \"$cmd\" = raw ] || body=$(jq -nc --arg m \"$method\" --argjson p \"$params\" '{jsonrpc:\"2.0\",id:2,method:$m,params:$p}')\n  if [ \"$DRY_RUN\" -eq 1 ]; then\n    jq -n --arg transport \"$(if [ -n \"$STDIO\" ]; then echo stdio; else echo http; fi)\" --arg method \"$(jq -r .method <<<\"$body\")\" '{dryRun:true,transport:$transport,method:$method}'\n    return","content":"          params=$(jq -nc --arg name \"$2\" --argjson a \"$tool_args\" 'if ($a|type)==\"object\" and all($a[];type==\"string\") then {name:$name,arguments:$a} else error(\"string arguments required\") end' 2>/dev/null) || { bad \"Prompt arguments must be a JSON object of strings.\"; return 1; } ;;\n        *) bad \"Use prompts list or get <name>.\"; return 1 ;;\n      esac ;;\n    raw)\n      body=\"${1:-}\"\n      jq -e 'type==\"object\" and .jsonrpc==\"2.0\" and (.method|type)==\"string\" and has(\"id\") and (.id != null)' <<<\"$body\" >/dev/null 2>&1 || { bad \"raw requires a JSON-RPC request with an ID.\"; return 1; } ;;\n    *) bad \"Unknown command. Use --help.\"; return 1 ;;\n  esac\n  [ \"$cmd\" = raw ] || body=$(jq -nc --arg m \"$method\" --argjson p \"$params\" '{jsonrpc:\"2.0\",id:2,method:$m,params:$p}')\n  if [ \"$DRY_RUN\" -eq 1 ]; then\n    jq -n --arg transport \"$(if [ -n \"$STDIO\" ]; then echo stdio; else echo http; fi)\" --arg method \"$(jq -r .method <<<\"$body\")\" '{dryRun:true,transport:$transport,method:$method}'\n    return","contentHash":"27112073cc115cae","metadata":{"filePath":"engine/mcp-wire.sh","startLine":458,"endLine":469,"chunkType":"function_definition","name":"main","language":"bash","hash":"27112073cc115cae"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":4,"lastAttempt":"2026-10-17T11:42:41.743Z"}
{"version":1,"chunks":[{"id":"chunk_be8e45079bc06e55","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, file operations\n\n  if [ \"$DRY_RUN\" -eq 1 ]; then\n    jq -n --arg transport \"$(if [ -n \"$STDIO\" ]; then echo stdio; else echo http; fi)\" --arg method \"$(jq -r .method <<<\"$body\")\" '{dryRun:true,transport:$transport,method:$method}'\n    return\n  fi\n  umask 077\n  WORK=$(mktemp -d) || return 1\n  HEADERS_FILE=\"$WORK/headers.txt\"\n  : > \"$HEADERS_FILE\"\n  for _h in \"${HEADERS[@]+\"${HEADERS[@]}\"}\"; do printf '%s\\n' \"$_h\" >> \"$HEADERS_FILE\"; done\n  chmod 600 \"$HEADERS_FILE\"\n  connect || return 1\n  data=$(request_all \"$body\" \"$key\") || return 1","tokenCount":151}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, file operations\n\n  if [ \"$DRY_RUN\" -eq 1 ]; then\n    jq -n --arg transport \"$(if [ -n \"$STDIO\" ]; then echo stdio; else echo http; fi)\" --arg method \"$(jq -r .method <<<\"$body\")\" '{dryRun:true,transport:$transport,method:$method}'\n    return\n  fi\n  umask 077\n  WORK=$(mktemp -d) || return 1\n  HEADERS_FILE=\"$WORK/headers.txt\"\n  : > \"$HEADERS_FILE\"\n  for _h in \"${HEADERS[@]+\"${HEADERS[@]}\"}\"; do printf '%s\\n' \"$_h\" >> \"$HEADERS_FILE\"; done\n  chmod 600 \"$HEADERS_FILE\"\n  connect || return 1\n  data=$(request_all \"$body\" \"$key\") || return 1","content":"  if [ \"$DRY_RUN\" -eq 1 ]; then\n    jq -n --arg transport \"$(if [ -n \"$STDIO\" ]; then echo stdio; else echo http; fi)\" --arg method \"$(jq -r .method <<<\"$body\")\" '{dryRun:true,transport:$transport,method:$method}'\n    return\n  fi\n  umask 077\n  WORK=$(mktemp -d) || return 1\n  HEADERS_FILE=\"$WORK/headers.txt\"\n  : > \"$HEADERS_FILE\"\n  for _h in \"${HEADERS[@]+\"${HEADERS[@]}\"}\"; do printf '%s\\n' \"$_h\" >> \"$HEADERS_FILE\"; done\n  chmod 600 \"$HEADERS_FILE\"\n  connect || return 1\n  data=$(request_all \"$body\" \"$key\") || return 1","contentHash":"b87a5712f42c82dd","metadata":{"filePath":"engine/mcp-wire.sh","startLine":467,"endLine":478,"chunkType":"function_definition","name":"main","language":"bash","hash":"b87a5712f42c82dd"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":4,"lastAttempt":"2026-10-17T11:42:41.743Z"}
{"version":1,"chunks":[{"id":"chunk_c37f343ad82055c1","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, file operations\n\n  chmod 600 \"$HEADERS_FILE\"\n  connect || return 1\n  data=$(request_all \"$body\" \"$key\") || return 1\n  case \"$cmd\" in\n    doctor) jq -n --arg t \"$TRANSPORT\" --arg r \"$REPLY\" '{ok:true,initialized:true,ping:true,transport:$t,reply:$r}' ;;\n    describe)\n      local tdata\n      tdata=$(jq -ec --arg t \"$tool\" '.result.tools[] | select(.name==$t)' <<<\"$data\") || {\n        bad \"Tool not found. Available tools: $(jq -r '.result.tools[].name' <<<\"$data\" | head -20 | tr '\\n' ' ')\"\n        return 1\n      }\n      jq -r '.name' <<<\"$tdata\"","tokenCount":153}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: HTTP/API, file operations\n\n  chmod 600 \"$HEADERS_FILE\"\n  connect || return 1\n  data=$(request_all \"$body\" \"$key\") || return 1\n  case \"$cmd\" in\n    doctor) jq -n --arg t \"$TRANSPORT\" --arg r \"$REPLY\" '{ok:true,initialized:true,ping:true,transport:$t,reply:$r}' ;;\n    describe)\n      local tdata\n      tdata=$(jq -ec --arg t \"$tool\" '.result.tools[] | select(.name==$t)' <<<\"$data\") || {\n        bad \"Tool not found. Available tools: $(jq -r '.result.tools[].name' <<<\"$data\" | head -20 | tr '\\n' ' ')\"\n        return 1\n      }\n      jq -r '.name' <<<\"$tdata\"","content":"  chmod 600 \"$HEADERS_FILE\"\n  connect || return 1\n  data=$(request_all \"$body\" \"$key\") || return 1\n  case \"$cmd\" in\n    doctor) jq -n --arg t \"$TRANSPORT\" --arg r \"$REPLY\" '{ok:true,initialized:true,ping:true,transport:$t,reply:$r}' ;;\n    describe)\n      local tdata\n      tdata=$(jq -ec --arg t \"$tool\" '.result.tools[] | select(.name==$t)' <<<\"$data\") || {\n        bad \"Tool not found. Available tools: $(jq -r '.result.tools[].name' <<<\"$data\" | head -20 | tr '\\n' ' ')\"\n        return 1\n      }\n      jq -r '.name' <<<\"$tdata\"","contentHash":"f5771f3b951d25ad","metadata":{"filePath":"engine/mcp-wire.sh","startLine":476,"endLine":487,"chunkType":"function_definition","name":"main","language":"bash","hash":"f5771f3b951d25ad"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":4,"lastAttempt":"2026-10-17T11:42:41.743Z"}
{"version":1,"chunks":[{"id":"chunk_cbe0122d9d0ce51d","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: data parsing\n\n        return 1\n      }\n      jq -r '.name' <<<\"$tdata\"\n      jq -r '.description // empty' <<<\"$tdata\"\n      echo 'arguments:'\n      local props\n      props=$(jq -c '.inputSchema.properties // {}' <<<\"$tdata\")\n      if [ \"$(jq 'length' <<<\"$props\")\" -eq 0 ]; then echo '  (none)'; else\n        jq -r --argjson req \"$(jq -c '.inputSchema.required // []' <<<\"$tdata\")\" '\n          def tstr: if type == \"array\" then (map(tostring)|join(\"|\")) else tostring end;\n          to_entries[] |\n          \"  \" + .key + \" (\" + ((.value.type // \"any\") | tstr) + (if (.key as $k | $req | index($k)) then \", required\" else \"\" end) + \") — \" + (.value.description // \"\")","tokenCount":180}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: data parsing\n\n        return 1\n      }\n      jq -r '.name' <<<\"$tdata\"\n      jq -r '.description // empty' <<<\"$tdata\"\n      echo 'arguments:'\n      local props\n      props=$(jq -c '.inputSchema.properties // {}' <<<\"$tdata\")\n      if [ \"$(jq 'length' <<<\"$props\")\" -eq 0 ]; then echo '  (none)'; else\n        jq -r --argjson req \"$(jq -c '.inputSchema.required // []' <<<\"$tdata\")\" '\n          def tstr: if type == \"array\" then (map(tostring)|join(\"|\")) else tostring end;\n          to_entries[] |\n          \"  \" + .key + \" (\" + ((.value.type // \"any\") | tstr) + (if (.key as $k | $req | index($k)) then \", required\" else \"\" end) + \") — \" + (.value.description // \"\")","content":"        return 1\n      }\n      jq -r '.name' <<<\"$tdata\"\n      jq -r '.description // empty' <<<\"$tdata\"\n      echo 'arguments:'\n      local props\n      props=$(jq -c '.inputSchema.properties // {}' <<<\"$tdata\")\n      if [ \"$(jq 'length' <<<\"$props\")\" -eq 0 ]; then echo '  (none)'; else\n        jq -r --argjson req \"$(jq -c '.inputSchema.required // []' <<<\"$tdata\")\" '\n          def tstr: if type == \"array\" then (map(tostring)|join(\"|\")) else tostring end;\n          to_entries[] |\n          \"  \" + .key + \" (\" + ((.value.type // \"any\") | tstr) + (if (.key as $k | $req | index($k)) then \", required\" else \"\" end) + \") — \" + (.value.description // \"\")","contentHash":"2225394509c19a40","metadata":{"filePath":"engine/mcp-wire.sh","startLine":485,"endLine":496,"chunkType":"function_definition","name":"main","language":"bash","hash":"2225394509c19a40"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":4,"lastAttempt":"2026-10-17T11:42:41.743Z"}
{"version":1,"chunks":[{"id":"chunk_2e8a86a0a43c9b73","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: placeholder(), data parsing\n\n          def tstr: if type == \"array\" then (map(tostring)|join(\"|\")) else tostring end;\n          to_entries[] |\n          \"  \" + .key + \" (\" + ((.value.type // \"any\") | tstr) + (if (.key as $k | $req | index($k)) then \", required\" else \"\" end) + \") — \" + (.value.description // \"\")\n        ' <<<\"$props\"\n      fi\n      echo 'example:'\n      jq -c --argjson req \"$(jq -c '.inputSchema.required // []' <<<\"$tdata\")\" --argjson props \"$props\" '\n        def placeholder($t):\n          if $t == \"string\" then \"...\"\n          elif ($t == \"number\" or $t == \"integer\") then 0\n          elif $t == \"boolean\" then false\n          elif $t == \"array\" then []","tokenCount":182}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: placeholder(), data parsing\n\n          def tstr: if type == \"array\" then (map(tostring)|join(\"|\")) else tostring end;\n          to_entries[] |\n          \"  \" + .key + \" (\" + ((.value.type // \"any\") | tstr) + (if (.key as $k | $req | index($k)) then \", required\" else \"\" end) + \") — \" + (.value.description // \"\")\n        ' <<<\"$props\"\n      fi\n      echo 'example:'\n      jq -c --argjson req \"$(jq -c '.inputSchema.required // []' <<<\"$tdata\")\" --argjson props \"$props\" '\n        def placeholder($t):\n          if $t == \"string\" then \"...\"\n          elif ($t == \"number\" or $t == \"integer\") then 0\n          elif $t == \"boolean\" then false\n          elif $t == \"array\" then []","content":"          def tstr: if type == \"array\" then (map(tostring)|join(\"|\")) else tostring end;\n          to_entries[] |\n          \"  \" + .key + \" (\" + ((.value.type // \"any\") | tstr) + (if (.key as $k | $req | index($k)) then \", required\" else \"\" end) + \") — \" + (.value.description // \"\")\n        