{"version":1,"chunks":[{"id":"chunk_a85637a2e3afcf96","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\n\n      -) args+=(\"$1\"); shift ;;\n      -*) bad \"Unknown flag. Use --help.\"; return 1 ;;\n      *) args+=(\"$1\"); shift ;;\n    esac\n  done\n  [[ \"$TIMEOUT\" =~ ^[1-9][0-9]*$ ]] || { bad \"--timeout requires a positive integer.\"; return 1; }\n  local dep\n  for dep in curl jq; do command -v \"$dep\" >/dev/null || { bad \"Missing $dep. Install $dep and retry.\"; return 1; }; done\n  local h\n  for h in \"${HEADERS[@]+\"${HEADERS[@]}\"}\"; do [[ \"$h\" != *$'\\n'* && \"$h\" != *$'\\r'* ]] || { bad \"Header values cannot contain line breaks.\"; return 1; }; done\n  local hname\n  for h in \"${HEADERS[@]+\"${HEADERS[@]}\"}\"; do","tokenCount":161}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\n\n      -) args+=(\"$1\"); shift ;;\n      -*) bad \"Unknown flag. Use --help.\"; return 1 ;;\n      *) args+=(\"$1\"); shift ;;\n    esac\n  done\n  [[ \"$TIMEOUT\" =~ ^[1-9][0-9]*$ ]] || { bad \"--timeout requires a positive integer.\"; return 1; }\n  local dep\n  for dep in curl jq; do command -v \"$dep\" >/dev/null || { bad \"Missing $dep. Install $dep and retry.\"; return 1; }; done\n  local h\n  for h in \"${HEADERS[@]+\"${HEADERS[@]}\"}\"; do [[ \"$h\" != *$'\\n'* && \"$h\" != *$'\\r'* ]] || { bad \"Header values cannot contain line breaks.\"; return 1; }; done\n  local hname\n  for h in \"${HEADERS[@]+\"${HEADERS[@]}\"}\"; do","content":"      -) args+=(\"$1\"); shift ;;\n      -*) bad \"Unknown flag. Use --help.\"; return 1 ;;\n      *) args+=(\"$1\"); shift ;;\n    esac\n  done\n  [[ \"$TIMEOUT\" =~ ^[1-9][0-9]*$ ]] || { bad \"--timeout requires a positive integer.\"; return 1; }\n  local dep\n  for dep in curl jq; do command -v \"$dep\" >/dev/null || { bad \"Missing $dep. Install $dep and retry.\"; return 1; }; done\n  local h\n  for h in \"${HEADERS[@]+\"${HEADERS[@]}\"}\"; do [[ \"$h\" != *$'\\n'* && \"$h\" != *$'\\r'* ]] || {