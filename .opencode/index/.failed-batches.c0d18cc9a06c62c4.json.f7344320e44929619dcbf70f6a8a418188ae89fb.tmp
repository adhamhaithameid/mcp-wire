{"version":1,"chunks":[{"id":"chunk_59bf7eceb7f28724","texts":[{"text":"bash function \"tfail\"\nin engine/tests/run-tests.sh\nPurpose: testing\n\ntfail() { local n=\"$1\"; shift; if \"$@\" > \"$TMP/o\" 2>&1; then FAIL=$((FAIL+1)); echo \"FAIL (expected nonzero): $n\"; else PASS=$((PASS+1)); fi; }","tokenCount":53}],"storageText":"bash function \"tfail\"\nin engine/tests/run-tests.sh\nPurpose: testing\n\ntfail() { local n=\"$1\"; shift; if \"$@\" > \"$TMP/o\" 2>&1; then FAIL=$((FAIL+1)); echo \"FAIL (expected nonzero): $n\"; else PASS=$((PASS+1)); fi; }","content":"tfail() { local n=\"$1\"; shift; if \"$@\" > \"$TMP/o\" 2>&1; then FAIL=$((FAIL+1)); echo \"FAIL (expected nonzero): $n\"; else PASS=$((PASS+1)); fi; }","contentHash":"c52d7c288293af55","metadata":{"filePath":"engine/tests/run-tests.sh","startLine":14,"endLine":14,"chunkType":"function_definition","name":"tfail","language":"bash","hash":"c52d7c288293af55"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":3,"lastAttempt":"2026-10-17T11:42:41.746Z"}
