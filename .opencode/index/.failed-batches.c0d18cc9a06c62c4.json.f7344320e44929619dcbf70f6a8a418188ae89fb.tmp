{"version":1,"chunks":[{"id":"chunk_25fba48cb9f0f5c4","texts":[{"text":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: file operations\n\n  case \"$cmd\" in\n    doctor) method=ping ;;\n    list|describe) method=tools/list; key=tools; tool=\"${1:-}\"; if [ \"$cmd\" = describe ] && [ -z \"$tool\" ]; then bad \"describe requires a tool name.\"; return 1; fi ;;\n    call)\n      method=tools/call; tool=\"${1:-}\"; [ -n \"$tool\" ] || { bad \"call requires a tool name.\"; return 1; }; shift\n      if [ $# -gt 0 ]; then\n        case \"$1\" in\n          -) tool_args=$(cat); shift ;;\n          @*) \n            [ -f \"${1#@}\" ] || { bad \"File not found: ${1#@}\"; return 1; }\n            tool_args=$(cat \"${1#@}\"); shift ;;\n          *) tool_args=\"$1\"; shift ;;","tokenCount":167}],"storageText":"bash function \"main\"\nin engine/mcp-wire.sh\nPurpose: file operations\n\n  case \"$cmd\" in\n    doctor) method=ping ;;\n    list|describe) method=tools/list; key=tools; tool=\"${1:-}\"; if [ \"$cmd\" = describe ] && [ -z \"$tool\" ]; then bad \"describe requires a tool name.\"; return 1; fi ;;\n    call)\n      method=tools/call; tool=\"${1:-}\"; [ -n \"$tool\" ] || { bad \"call requires a tool name.\"; return 1; }; shift\n      if [ $# -gt 0 ]; then\n        case \"$1\" in\n          -) tool_args=$(cat); shift ;;\n          @*) \n            [ -f \"${1#@}\" ] || { bad \"File not found: ${1#@}\"; return 1; }\n            tool_args=$(cat \"${1#@}\"); shift ;;\n          *) tool_args=\"$1\"; shift ;;","content":"  case \"$cmd\" in\n    doctor) method=ping ;;\n    list|describe) method=tools/list; key=tools; tool=\"${1:-}\"; if [ \"$cmd\" = describe ] && [ -z \"$tool\" ]; then bad \"describe requires a tool name.\"; return 1; fi ;;\n    call)\n      method=tools/call; tool=\"${1:-}\"; [ -n \"$tool\" ] || { bad \"call requires a tool name.\"; return 1; }; shift\n      if [ $# -gt 0 ]; then\n        case \"$1\" in\n          -) tool_args=$(cat); shift ;;\n          @*) \n            [ -f \"${1#@}\" ] || { bad \"File not found: ${1#@}\"; return 1; }\n            tool_args=$(cat \"${1#@}\"); shift ;;\n          *) tool_args=\"$1\"; shift ;;","contentHash":"1802825a984e7126","metadata":{"filePath":"engine/mcp-wire.sh","startLine":431,"endLine":442,"chunkType":"function_definition","name":"main","language":"bash","hash":"1802825a984e7126"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":4,"lastAttempt":"2026-10-17T11:42:41.746Z"}
