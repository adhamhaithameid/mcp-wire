{"version":1,"chunks":[{"id":"chunk_172e93b2e895a648","texts":[{"text":"bash function \"main\"\nin figma-pages/scripts/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\n          [ -n \"${!envname:-}\" ] || { bad \"Required header environment variable is unset.\"; return 1; }\n          [[ \"${!envname}\" != *$'\\r'* && \"${!envname}\" != *$'\\n'* ]] || { bad \"Header values cannot contain line breaks.\"; return 1; }\n          HEADERS+=(\"$headername: ${!envname}\")\n        done < <(jq -r '.headerEnv // {} | to_entries[] | [.key,.value] | @tsv' <<<\"$entry\") ;;\n    esac\n  fi\n  if [ -n \"$STDIO\" ]; then\n    [ -z \"$URL\" ] || { bad \"Choose one transport: URL or stdio.\"; return 1; }\n    jq -e 'type == \"array\" and length > 0 and all(.[]; type == \"string\" and (contains(\"\\n\")|not) and (contains(\"\\u0000\")|not)) and .[0] != \"\"' <<<\"$STDIO\" >/dev/null 2>&1 || { bad \"--stdio requires a JSON command array.\"; return 1; }\n  else\n    case \"$URL\" in\n      https://*) : ;; http://*) [ \"$ALLOW_HTTP\" -eq 1 ] || { bad \"Refusing plain HTTP. Pass --allow-http for trusted development.\"; return 1; } ;;","tokenCount":253}],"storageText":"bash function \"main\"\nin figma-pages/scripts/mcp-wire.sh\nPurpose: HTTP/API, data parsing, configuration\n\n          [ -n \"${!envname:-}\" ] || { bad \"Required header environment variable is unset.\"; return 1; }\n          [[ \"${!envname}\" != *$'\\r'* && \"${!envname}\" != *$'\\n'* ]] || { bad \"Header values cannot contain line breaks.\"; return 1; }\n          HEADERS+=(\"$headername: ${!envname}\")\n        done < <(jq -r '.headerEnv // {} | to_entries[] | [.key,.value] | @tsv' <<<\"$entry\") ;;\n    esac\n  fi\n  if [ -n \"$STDIO\" ]; then\n    [ -z \"$URL\" ] || { bad \"Choose one transport: URL or stdio.\"; return 1; }\n    jq -e 'type == \"array\" and length > 0 and all(.[]; type == \"string\" and (contains(\"\\n\")|not) and (contains(\"\\u0000\")|not)) and .[0] != \"\"' <<<\"$STDIO\" >/dev/null 2>&1 || { bad \"--stdio requires a JSON command array.\"; return 1; }\n  else\n    case \"$URL\" in\n      https://*) : ;; http://*) [ \"$ALLOW_HTTP\" -eq 1 ] || { bad \"Refusing plain HTTP. Pass --allow-http for trusted development.\"; return 1; } ;;","content":"          [ -n \"${!envname:-}\" ] || { bad \"Required header environment variable is unset.\"; return 1; }\n          [[ \"${!envname}\" != *$'\\r'* && \"${!envname}\" != *$'\\n'* ]] || { bad \"Header values cannot contain line breaks.\"; return 1; }\n          HEADERS+=(\"$headername: ${!envname}\")\n        done < <(jq -r '.headerEnv // {} | to_entries[] | [.key,.value] | @tsv' <<<\"$entry\") ;;\n    esac\n  fi\n  if [ -n \"$STDIO\" ]; then\n    [ -z \"$URL\" ] || { bad \"Choose one transport: URL or stdio.\"; return 1; }\n    jq -e 'type == \"array\" and length > 0 and all(.[]; type == \"string\" and (contains(\"\\n\")|not) and (contains(\"\\u0000\")|not)) and .[0] != \"\"' <<<\"$STDIO\" >/dev/null 2>&1 || { bad \"--stdio requires a JSON command array.\"; return 1; }\n  else\n    case \"$URL\" in\n      https://*) : ;; http://*) [ \"$ALLOW_HTTP\" -eq 1 ] || { bad \"Refusing plain HTTP. Pass --allow-http for trusted development.\"; return 1; } ;;","contentHash":"a10ae338ad68139a","metadata":{"filePath":"skills/figma-pages/scripts/mcp-wire.sh","startLine":413,"endLine":424,"chunkType":"function_definition","name":"main","language":"bash","hash":"a10ae338ad68139a"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":15,"lastAttempt":"2026-10-17T11:42:41.743Z"}
{"version":1,"chunks":[{"id":"chunk_637433c5e611ebb2","texts":[{"text":"bash function \"main\"\nin figma-pages/scripts/mcp-wire.sh\nPurpose: HTTP/API\n\n  else\n    case \"$URL\" in\n      https://*) : ;; http://*) [ \"$ALLOW_HTTP\" -eq 1 ] || { bad \"Refusing plain HTTP. Pass --allow-http for trusted development.\"; return 1; } ;;\n      *) bad \"Server URL must start with http:// or https://.\"; return 1 ;;\n    esac\n  fi\n  cmd=\"${1:-}\"; [ $# -eq 0 ] || shift\n  [ \"$doctor\" -eq 0 ] || cmd=doctor\n  local method='' params='{}' key='' tool='' body data tool_args='{}'\n  case \"$cmd\" in\n    doctor) method=ping ;;\n    list|describe) method=tools/list; key=tools; tool=\"${1:-}\"; if [ \"$cmd\" = describe ] && [ -z \"$tool\" ]; then bad \"describe requires a tool name.\"; return 1; fi ;;","tokenCount":173}],"storageText":"bash function \"main\"\nin figma-pages/scripts/mcp-wire.sh\nPurpose: HTTP/API\n\n  else\n    case \"$URL\" in\n      https://*) : ;; http://*) [ \"$ALLOW_HTTP\" -eq 1 ] || { bad \"Refusing plain HTTP. Pass --allow-http for trusted development.\"; return 1; } ;;\n      *) bad \"Server URL must start with http:// or https://.\"; return 1 ;;\n    esac\n  fi\n  cmd=\"${1:-}\"; [ $# -eq 0 ] || shift\n  [ \"$doctor\" -eq 0 ] || cmd=doctor\n  local method='' params='{}' key='' tool='' body data tool_args='{}'\n  case \"$cmd\" in\n    doctor) method=ping ;;\n    list|describe) method=tools/list; key=tools; tool=\"${1:-}\"; if [ \"$cmd\" = describe ] && [ -z \"$tool\" ]; then bad \"describe requires a tool name.\"; return 1; fi ;;","content":"  else\n    case \"$URL\" in\n      https://*) : ;; http://*) [ \"$ALLOW_HTTP\" -eq 1 ] || { bad \"Refusing plain HTTP. Pass --allow-http for trusted development.\"; return 1; } ;;\n      *) bad \"Server URL must start with http:// or https://.\"; return 1 ;;\n    esac\n  fi\n  cmd=\"${1:-}\"; [ $# -eq 0 ] || shift\n  [ \"$doctor\" -eq 0 ] || cmd=doctor\n  local method='' params='{}' key='' tool='' body data tool_args='{}'\n  case \"$cmd\" in\n    doctor) method=ping ;;\n    list|describe) method=tools/list; key=tools; tool=\"${1:-}\"; if [ \"$cmd\" = describe ] && [ -z \"$tool\" ]; then bad \"describe requires a tool name.\"; return 1; fi ;;","contentHash":"2657902efd096ff9","metadata":{"filePath":"skills/figma-pages/scripts/mcp-wire.sh","startLine":422,"endLine":433,"chunkType":"function_definition","name":"main","language":"bash","hash":"2657902efd096ff9"}}],"error":"Google embedding provider returned HTTP 400.","attemptCount":15,"lastAttempt":"2026-10-17T11:42:41.743Z"}
